# The Venue @ NCC server configuration.
# Copy to .env and fill in. The server reads ./.env at startup; real environment variables win.
# docker-compose.yml also reads it (env_file) and fixes NODE_ENV, TRUST_PROXY, HOST, PORT, and the paths.
# npm run dev sets NODE_ENV=development, HOST=127.0.0.1, and PUBLIC_ORIGIN=http://localhost:4321 for you.
# Never commit .env.

# ------------------------------------------------------------------ server

# "production" requires SESSION_SECRET and FORM_TOKEN_SECRET and always sets Secure cookies.
# Leave unset for local development. (Docker Compose sets it to production.)
# NODE_ENV=production

# Port and interface the Node server listens on.
PORT=8787
HOST=0.0.0.0

# The public address of the site, used for the same-origin check on form posts and for links in
# emails. An https origin also turns on HSTS and Secure cookies.
PUBLIC_ORIGIN=https://venueatncc.org

# true only when the server sits behind exactly one reverse proxy you control (Caddy, nginx, Fly,
# Render). The client IP for rate limits is then the last X-Forwarded-For entry. Leave false when
# the server is reachable directly, or visitors could fake their IP.
# Behind a proxy with TRUST_PROXY=false, every visitor shares the proxy's address, so one person's
# failed sign-ins or booking requests would lock everyone out. With a CDN in front of Caddy, set
# trusted_proxies in the Caddyfile (see the note there). IPv6 visitors are limited per /64.
TRUST_PROXY=false

# The built site (npm run build:site) that the server also serves.
SITE_DIR=./dist

# The SQLite database file. Its folder is created if needed. Back it up (docs/deploy.md).
DATABASE_PATH=./data/venue.db

# ------------------------------------------------------------------ secrets
# Required in production, at least 32 characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# or: openssl rand -base64 48
# Changing SESSION_SECRET changes the salted IP hashes; changing either one invalidates open forms.
SESSION_SECRET=
FORM_TOKEN_SECRET=

# ------------------------------------------------------------------ email
# Outgoing mail server. Leave SMTP_HOST empty to save emails to OUTBOX_DIR instead of sending.
# SMTP_SECURE=true for port 465 (TLS from the start); false for 587 (STARTTLS).
# Typical settings (confirm with your provider):
#   Microsoft 365:        smtp.office365.com  587  false  (SMTP AUTH must be enabled for the mailbox)
#   Google Workspace:     smtp.gmail.com      587  false  (use an app password)
#   GoDaddy Professional: smtpout.secureserver.net  465  true
#   Zoho Mail:            smtp.zoho.com       465  true
#   Postmark, Amazon SES, Resend, Brevo: use the SMTP host and credentials they give you
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# The sender shown on every email. The SMTP account must be allowed to send as this address.
MAIL_FROM="The Venue @ NCC <faith@venueatncc.org>"

# Who gets the new-inquiry notifications (Reply-To is set to the guest). Guests' replies to their
# confirmation email also go here. IMPORTANT: as of 2026-09-28 venueatncc.org has no MX records,
# so mail to faith@venueatncc.org bounces until a mailbox is set up. Use a working address until then.
NOTIFY_TO=faith@venueatncc.org

# Where emails are saved as .eml and .html files when SMTP_HOST is empty.
OUTBOX_DIR=./data/outbox

# Delete outbox files after this many days (checked hourly). Empty or 0 keeps them all, which is
# the right choice while SMTP is not set up and the outbox is how the team reads new requests.
# The files hold guests' names, emails, and phone numbers, so set this once email is sending.
OUTBOX_RETENTION_DAYS=

# ------------------------------------------------------------------ first admin
# Creates the first admin at startup when there is none yet (ignored afterwards).
# Use at least 12 characters, then remove ADMIN_PASSWORD from this file after the first start
# (the server logs a warning at every start while it is still set).
# Add or reset admins later with the create-admin tool (docs/deploy.md).
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Faith

# ------------------------------------------------------------------ Docker Compose and Caddy only
# The domain Caddy serves (and gets a certificate for), plus a www redirect to it.
# Set a staging name such as new.venueatncc.org to try the server before switching the main domain.
SITE_DOMAIN=venueatncc.org
