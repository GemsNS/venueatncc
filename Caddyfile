# Caddy terminates HTTPS with certificates from Let's Encrypt (issued and renewed automatically)
# and forwards requests to the Node app. Both names must point at this server in DNS first.
# SITE_DOMAIN defaults to venueatncc.org; set it in .env to try a staging name first.
#
# If a CDN or another proxy (Cloudflare, for example) ever sits in front of Caddy, trust it globally
# and pass the real visitor address on, or every visitor shares the CDN's rate limits:
#   servers { trusted_proxies static <CDN address ranges>  client_ip_headers CF-Connecting-IP X-Forwarded-For }
#   reverse_proxy app:8787 { header_up X-Forwarded-For {client_ip} }
# (See docs/deploy.md. Not needed when visitors connect to Caddy directly.)

{
	servers {
		# Clients that send headers or a body very slowly give up the connection instead of holding it.
		timeouts {
			read_header 10s
			read_body 15s
		}
	}
}

www.{$SITE_DOMAIN:venueatncc.org} {
	redir https://{$SITE_DOMAIN:venueatncc.org}{uri} permanent
}

{$SITE_DOMAIN:venueatncc.org} {
	encode zstd gzip
	# The API never takes more than 64 KB (the app enforces the same limit).
	request_body /api/* {
		max_size 64KB
	}
	reverse_proxy app:8787
}
