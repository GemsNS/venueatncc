---
/**
 * The home page hero (redesign-spec.md, HeroVideo; brand.md, Motion): a full-viewport section over a fixed,
 * muted, looping clip of white rose petals on a pink ground (public/media/hero-petals.*, credited in
 * public/media/CREDITS.md), under a bright white veil that keeps the Plum name legible on every frame.
 * The page's content slides up over it, as on the reference. The poster is an image beneath the video, so
 * there is no layout shift and no flash: under prefers-reduced-motion the video is hidden and paused and the
 * poster shows still. It shows no identifiable venue, building, room, or person, and is never a photo of
 * the property. `data-hero` lets the header stay transparent over it and turn solid as it leaves.
 */
import { href } from '../lib/paths';

interface Props {
  /** The id of the heading inside the slot, for aria-labelledby. */
  labelledby: string;
  class?: string;
}

const { labelledby, class: className } = Astro.props;
/*
  The clip and its poster are 2560 x 1440 (cut from the 4K source; public/media/CREDITS.md). Portrait screens
  get their own poster, the middle of the 4K first frame at 9:16 (1216 x 2160), which is the part the cover
  crop shows there, so a phone's still frame is drawn from a file as tall as its screen.
*/
const poster = href('/media/hero-petals-poster.jpg');
const posterPortrait = href('/media/hero-petals-poster-portrait.jpg');
---
<section class:list={['hero', className]} data-hero aria-labelledby={labelledby}>
  <div class="hero__media" aria-hidden="true">
    <picture>
      <source media="(orientation: portrait)" srcset={posterPortrait} width="1216" height="2160" />
      <img class="hero__poster" src={poster} alt="" width="2560" height="1440" decoding="async" fetchpriority="high" />
    </picture>
    <video class="hero__video" muted autoplay loop playsinline preload="auto" poster={poster} tabindex="-1" data-hero-video>
      <source src={href('/media/hero-petals.webm')} type="video/webm" />
      <source src={href('/media/hero-petals.mp4')} type="video/mp4" />
    </video>
    <div class="hero__tint"></div>
    <div class="hero__overlay"></div>
  </div>
  <div class="hero__content container">
    <slot />
  </div>
</section>

<script>
  // Reduced motion: the still poster, and the clip does not play at all.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const apply = () => {
      if (still.matches) {
        video.pause();
        video.removeAttribute('autoplay');
      } else {
        video.play().catch(() => {});
      }
    };
    apply();
    still.addEventListener('change', apply);
  }
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    align-items: center;
    min-height: 100svh;
    /* The bar is transparent over the hero, so the content is centred in the space beneath it. */
    padding-block: calc(var(--nav-h) + 1rem) 2rem;
    margin-top: calc(-1 * var(--nav-h));
  }

  /*
    Fixed to the viewport, behind the page: the content that follows the hero sets its own background and
    slides up over it. The hero makes no stacking context of its own, so the welcome's name can rise above
    the sticky bar while it flies into it (src/pages/index.astro).
  */
  .hero__media {
    position: fixed;
    inset: 0;
    height: 100svh;
    z-index: -1;
    pointer-events: none;
  }

  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  /*
    A bright white veil, strongest in the centre, so the first screen is the brightest surface on the site
    with the petals' pink still showing at its edges (brand.md, version 6): mean luminance 0.90 or more at 390
    and 1440. A brighter veil only raises the contrast of the Plum name, the Cerise "@ NCC", "Welcome to" and
    the line over every frame of the clip (brand.md, "Header and the morph", gives the floors).
  */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 80% 65% at 50% 50%, rgba(255, 255, 255, 0.96), rgba(255, 246, 249, 0.84) 70%, rgba(255, 244, 247, 0.74)),
      linear-gradient(rgba(255, 240, 245, 0.4), rgba(255, 240, 245, 0.4));
  }

  /*
    Portrait screens (phones, tall tablets) crop the 16:9 clip to its middle, where the petals are white and
    the pink ground at the edges is cut away. A pastel Rose Mist wash gives those frames the blush the
    landscape crop shows, and the white veil above it keeps the centre bright. The wash is a plain layer, not
    a blend mode, so a playing video costs the phone's compositor no extra pass while the name flies.
  */
  .hero__tint {
    display: none;
  }

  @media (orientation: portrait) {
    .hero__tint {
      display: block;
      position: absolute;
      inset: 0;
      background: #f9c6d7;
      opacity: 0.3;
    }

    .hero__overlay {
      background:
        radial-gradient(ellipse 90% 45% at 50% 50%, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0) 80%),
        linear-gradient(rgba(255, 248, 250, 0.82), rgba(255, 248, 250, 0.82));
    }
  }

  .hero__content {
    position: relative;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }

  /* Short screens (landscape phones): the bar scrolls, and the hero is as tall as the screen. */
  @media (max-height: 500px) {
    .hero {
      margin-top: 0;
      padding-top: 2rem;
    }
  }
</style>
