---
/**
 * The home page hero (redesign-spec.md, HeroVideo; brand.md, Motion): a full-viewport section over a fixed,
 * muted, looping clip of pink roses on a bright white ground (public/media/hero-roses.*, credited in
 * public/media/CREDITS.md; docs/design/redesign-v7.md, section 6), under a light white veil that keeps the
 * Plum name legible on every frame while the roses stay clearly pink.
 * The page's content slides up over it, as on the reference. The poster is an image beneath the video (the
 * video carries no poster of its own, so the still a screen sees is always the one chosen for it), so there is
 * no layout shift and no flash: under prefers-reduced-motion the video is hidden and paused and the poster
 * shows still. It shows no identifiable venue, building, room, or person, and is never a photo of
 * the property. `data-hero` tells the header (solid White throughout) when to draw its hairline.
 */
import { href } from '../lib/paths';

interface Props {
  /** The id of the heading inside the slot, for aria-labelledby. */
  labelledby: string;
  class?: string;
}

const { labelledby, class: className } = Astro.props;
/*
  Never drawn past its detail (the client's rule 3; brand.md, "The hero loop"). The clip and its poster are the
  full 3840 x 2160 of the 4K source. Narrow portrait screens get a 3:4 cut of the same frames, the middle
  1620 x 2160 (public/media/CREDITS.md), which holds everything the cover crop shows there in fewer bytes. The
  source is 2160 px tall, so the hero is never taller than 2160 device px (see .hero below): with that cap both
  files are drawn at no more than their own size on every screen.
  The landscape sources come first with an explicit query, so a browser that ignores media on a video source
  plays the 4K file. The two queries are exact complements (aspect above 3:4, or wider than 810px).
*/
const poster = href('/media/hero-roses-poster.jpg');
const posterPortrait = href('/media/hero-roses-poster-portrait.jpg');
const wide = '(min-aspect-ratio: 3001/4000), (min-width: 811px)';
const narrow = '(max-aspect-ratio: 3/4) and (max-width: 810px)';
---
<section class:list={['hero', className]} data-hero aria-labelledby={labelledby}>
  <div class="hero__media" aria-hidden="true">
    <picture>
      <source media={narrow} srcset={posterPortrait} width="1620" height="2160" />
      <img class="hero__poster" src={poster} alt="" width="3840" height="2160" decoding="async" fetchpriority="high" />
    </picture>
    <video class="hero__video" muted autoplay loop playsinline preload="auto" tabindex="-1" data-hero-video>
      <source media={wide} src={href('/media/hero-roses.webm')} type="video/webm" />
      <source media={wide} src={href('/media/hero-roses.mp4')} type="video/mp4" />
      <source media={narrow} src={href('/media/hero-roses-portrait.webm')} type="video/webm" />
      <source media={narrow} src={href('/media/hero-roses-portrait.mp4')} type="video/mp4" />
    </video>
    <div class="hero__overlay"></div>
  </div>
  <div class="hero__content container">
    <slot />
  </div>
</section>

<script>
  // Reduced motion: the still poster, and the clip does not play at all.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (video) {
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    const apply = () => {
      if (still.matches) {
        video.pause();
        video.removeAttribute('autoplay');
      } else {
        video.play().catch(() => {});
      }
    };
    apply();
    still.addEventListener('change', apply);
  }
</script>

<style>
  /*
    The hero, and the fixed box its clip fills, are as tall as the screen but never taller than the clip's
    2160 device px: 1080px at 2x, 720px at 3x (the client's rule 3). Most phones' visible height is already
    under 720px with the browser's bars showing; on taller screens the page simply starts a little higher.
  */
  .hero {
    --hero-h: 100svh;
    position: relative;
    display: grid;
    align-items: center;
    min-height: var(--hero-h);
    /* The hero starts under the solid bar, so the content is centred in the space beneath it. */
    padding-block: calc(var(--nav-h) + 1rem) 2rem;
    margin-top: calc(-1 * var(--nav-h));
  }

  /*
    Fixed to the viewport, behind the page: the content that follows the hero sets its own background and
    slides up over it. The hero makes no stacking context of its own, so the welcome's name can rise above
    the sticky bar while it flies into it (src/pages/index.astro).
  */
  .hero__media {
    position: fixed;
    inset: 0 0 auto;
    height: var(--hero-h);
    z-index: -1;
    pointer-events: none;
  }

  .hero__poster,
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
  }

  /*
    A light white veil, strongest behind the welcome, so the roses stay clearly pink and recognisable while
    the Plum name, the Cerise "@ NCC", "Welcome to", and the line keep their contrast over every frame
    (redesign-v7.md, section 6: the centre no stronger than White at 0.5, no colour blend layer, and the
    first screen's mean lightness between 78 and 90; brand.md, "The hero loop", gives the measured values).
  */
  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 85% 50% at 50% 50%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.5) 55%, rgba(255, 255, 255, 0.2) 100%);
  }

  /* Portrait screens show the middle of the clip, one large rose: the veil is a taller band there. */
  @media (orientation: portrait) {
    .hero__overlay {
      background:
        radial-gradient(ellipse 100% 45% at 50% 50%, rgba(255, 255, 255, 0.5), rgba(255, 255, 255, 0.5) 60%, rgba(255, 255, 255, 0.32) 100%);
    }
  }

  .hero__content {
    position: relative;
  }

  @media (min-resolution: 1.5dppx) { .hero { --hero-h: min(100svh, 1440px); } }
  @media (min-resolution: 2dppx) { .hero { --hero-h: min(100svh, 1080px); } }
  @media (min-resolution: 2.5dppx) { .hero { --hero-h: min(100svh, 864px); } }
  @media (min-resolution: 2.625dppx) { .hero { --hero-h: min(100svh, 822px); } }
  @media (min-resolution: 2.75dppx) { .hero { --hero-h: min(100svh, 785px); } }
  @media (min-resolution: 3dppx) { .hero { --hero-h: min(100svh, 720px); } }
  @media (min-resolution: 3.5dppx) { .hero { --hero-h: min(100svh, 617px); } }

  @media (prefers-reduced-motion: reduce) {
    .hero__video {
      display: none;
    }
  }

  /* Short screens (landscape phones): the bar scrolls, and the hero is as tall as the screen. */
  @media (max-height: 500px) {
    .hero {
      margin-top: 0;
      padding-top: 2rem;
    }
  }
</style>
