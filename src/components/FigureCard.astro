---
/**
 * The one card (docs/design/redesign-v7.md, section 2, FigureCard): the photo shown whole in its frame, and
 * under it, on the page surface with no box, the label (Caslon Text, Plum), an optional meta line (Mauve),
 * and an optional italic note. Nothing sits on the photo.
 *
 * With `href` the whole card is one link named by its label, with no enlarge; hover underlines the label
 * and the photo stays still. Without `href` it is a gallery figure: the photo opens in the viewer from the
 * frame or the Enlarge button under it (Figure.astro). A staged photo is declared on the card itself: the
 * page passes a meta line that begins "Styled concept" (the section lead carries the full sentence once).
 */
import Photo from './Photo.astro';
import Figure from './Figure.astro';
import type { VenuePhoto } from '../data/photos';
import { href as toHref } from '../lib/paths';
import { uid } from '../lib/uid';

interface Props {
  photo: VenuePhoto;
  label: string;
  meta?: string;
  note?: string;
  /** Base-relative link. Omit for a gallery figure (tap to enlarge). */
  href?: string;
  /** Rendered width at each breakpoint; the last entry is the phone width, which the portrait file uses too. */
  sizes?: string;
  tall?: boolean;
  priority?: boolean;
  /** Heading level of the label. */
  headingLevel?: 'h2' | 'h3' | 'p';
  class?: string;
}

const {
  photo,
  label,
  meta,
  note,
  href,
  sizes = '(min-width: 75rem) 420px, (min-width: 60rem) 33vw, (min-width: 46.5rem) 46vw, 82vw',
  tall = true,
  priority = false,
  headingLevel = 'h3',
  class: className,
} = Astro.props;

const Heading = headingLevel;
const id = uid('fcard');
---
{
  href ? (
    <a class:list={['fcard', 'fcard--link', className]} href={toHref(href)} aria-labelledby={id}>
      <Photo photo={photo} sizes={sizes} tall={tall} priority={priority} />
      <span class="fcard__text">
        <Heading id={id} class="fcard__label">{label}</Heading>
        {meta && <span class="fcard__meta">{meta}</span>}
        {note && <span class="fcard__note">{note}</span>}
      </span>
    </a>
  ) : (
    <div class:list={['fcard', className]}>
      <Figure photo={photo} sizes={sizes} tall={tall} priority={priority} />
      <span class="fcard__text">
        <Heading class="fcard__label">{label}</Heading>
        {meta && <span class="fcard__meta">{meta}</span>}
        {note && <span class="fcard__note">{note}</span>}
      </span>
    </div>
  )
}

<style>
  .fcard {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    min-width: 0;
    color: var(--label);
    text-decoration: none;
  }

  .fcard--link:hover {
    text-decoration: none;
  }

  .fcard__text {
    display: grid;
    gap: 0.2rem;
  }

  .fcard__label {
    margin: 0;
    color: var(--label);
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.3;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .fcard--link:hover .fcard__label {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--accent-text);
  }

  .fcard__meta {
    font-family: var(--font-serif);
    font-size: var(--t-subhead);
    line-height: 1.45;
    color: var(--label-2);
  }

  .fcard__note {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    color: var(--label-2);
  }

  /* The focus ring goes around the whole card. */
  .fcard--link:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 4px;
    border-radius: var(--r-card);
  }
</style>
