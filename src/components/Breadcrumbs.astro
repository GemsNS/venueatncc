---
import Icon from './Icon.astro';
import { href } from '../lib/paths';

interface Props {
  items: { name: string; path: string }[];
}
const { items } = Astro.props;
---
<nav class="crumbs t-footnote" aria-label="Breadcrumb">
  <ol>
    {
      items.map((item, i) => (
        <li>
          {i < items.length - 1 ? (
            <>
              <a href={href(item.path)}>{item.name}</a>
              <Icon name="chevron-right" class="crumbs__sep" />
            </>
          ) : (
            <span aria-current="page">{item.name}</span>
          )}
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--label-2);
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .crumbs a {
    color: var(--label-2);
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }

  .crumbs a:hover {
    color: var(--accent-text);
  }

  .crumbs [aria-current] {
    color: var(--label);
  }

  .crumbs :global(.crumbs__sep) {
    width: 0.9em;
    height: 0.9em;
    color: var(--label-3);
  }
</style>
