---
/**
 * A sticky row of in-page links under the header (redesign-spec.md, AnchorBar; the reference venue page's
 * tab bar): serif links, horizontally scrollable on phones, the current section marked with an underline as
 * the page scrolls (an intersection observer sets aria-current).
 */
interface Props {
  items: { id: string; label: string }[];
  label?: string;
  class?: string;
}

const { items, label = 'On this page', class: className } = Astro.props;
---
<nav class:list={['anchors', className]} aria-label={label} data-anchors>
  <ul class="anchors__list container">
    {
      items.map((item) => (
        <li>
          <a href={`#${item.id}`} data-anchor={item.id}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<script>
  for (const bar of document.querySelectorAll<HTMLElement>('[data-anchors]')) {
    const links = [...bar.querySelectorAll<HTMLAnchorElement>('[data-anchor]')];
    const targets = links.map((l) => document.getElementById(l.dataset.anchor!)).filter((t): t is HTMLElement => t !== null);
    if (targets.length === 0 || !('IntersectionObserver' in window)) continue;
    let current: string | null = null;
    const set = (id: string | null) => {
      if (id === current) return;
      current = id;
      for (const l of links) {
        const on = l.dataset.anchor === id;
        if (on) l.setAttribute('aria-current', 'location');
        else l.removeAttribute('aria-current');
        if (on) l.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      }
    };
    // The section nearest the top third of the screen is current.
    const pick = () => {
      const line = window.innerHeight * 0.35;
      let best: HTMLElement | null = null;
      for (const t of targets) {
        if (t.getBoundingClientRect().top <= line) best = t;
      }
      set(best?.id ?? null);
    };
    const io = new IntersectionObserver(pick, { rootMargin: '-35% 0px -55% 0px', threshold: [0, 0.5, 1] });
    targets.forEach((t) => io.observe(t));
    window.addEventListener('scroll', pick, { passive: true });
    pick();
  }
</script>

<style>
  .anchors {
    position: sticky;
    top: var(--nav-h);
    z-index: 50;
    background: var(--bg);
    border-block: 1px solid var(--separator);
  }

  .anchors__list {
    display: flex;
    gap: 0.25rem;
    margin-block: 0;
    padding-block: 0;
    padding-inline: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .anchors__list::-webkit-scrollbar {
    display: none;
  }

  /* The container bleeds to the edges on phones, so the row can scroll under the gutter. */
  @media (width < 46.5rem) {
    .anchors__list {
      width: 100%;
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
    }
  }

  .anchors__list a {
    display: inline-flex;
    align-items: center;
    min-height: 52px;
    padding: 0 0.9rem;
    color: var(--label-2);
    font-family: var(--font-serif);
    font-size: var(--t-ui);
    white-space: nowrap;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition:
      color var(--dur-1) ease,
      border-color var(--dur-1) ease;
  }

  .anchors__list li:first-child a {
    padding-left: 0;
  }

  .anchors__list a:hover {
    color: var(--label);
  }

  .anchors__list a[aria-current] {
    color: var(--label);
    border-bottom-color: var(--accent-text);
  }

  .anchors__list a:focus-visible {
    outline-offset: -3px;
    border-radius: var(--r-xs);
  }

  @media (max-height: 500px) {
    .anchors {
      position: static;
    }
  }
</style>
