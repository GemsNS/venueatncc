---
/**
 * A real photograph of the property in a plain frame, shown whole (docs/design/redesign-v7.md, section 1).
 *
 * The frame takes the file's own aspect ratio (3:2 for the landscape files, 4:5 for a portrait file), so
 * nothing is cropped into its subject. With `tall`, phones below 46.5rem get the 4:5 portrait file, in a
 * 4:5 frame, where the photo has one. Nothing is ever drawn over the photo: no badge, no label, no button.
 * Captions, the styled-concept disclosure, and the enlarge affordance belong to Figure.astro, under the
 * frame. The file is served as responsive AVIF and WebP at widths up to the source width.
 *
 * `frame="button"` renders the frame as the figure's enlarge button (Figure.astro passes it); a linked card
 * (FigureCard.astro) keeps the plain frame inside its link.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { VenuePhoto } from '../data/photos';

interface Props {
  photo: VenuePhoto;
  /** Rendered width at each breakpoint, e.g. "(min-width: 64rem) 40vw, 100vw". The last entry is the phone width. */
  sizes?: string;
  /** The page's main image: loads eagerly with high fetch priority. */
  priority?: boolean;
  /** Use the 4:5 portrait file, in a 4:5 frame, on phones (when the photo has one). */
  tall?: boolean;
  /** Rounded corners (var(--r-card)). */
  rounded?: boolean;
  /** The frame element: a plain box, or the enlarge button of a Figure. */
  frame?: 'div' | 'button';
  /** The enlarge button's accessible name (frame="button"). */
  label?: string;
  class?: string;
}

const {
  photo,
  sizes = '(min-width: 75rem) 1200px, 100vw',
  priority = false,
  tall = false,
  rounded = true,
  frame = 'div',
  label,
  class: className,
} = Astro.props;

const useTall = tall && photo.tall !== undefined;

/*
  Up to 3840 so a wide photo stays sharp on a 2x screen. The larger widths exist only where the source is
  that wide, and a browser fetches one only when its screen needs it.
*/
const CANDIDATES = [640, 960, 1280, 1600, 1920, 2400, 2880, 3840];

/*
  Encoder quality. Sharp's defaults (AVIF 50, WebP 80) smear wall texture, foliage and petals into flat
  patches on a large screen; these keep that detail (src/assets/venue/README.md, Resolution).
*/
const AVIF_QUALITY = 60;
const WEBP_QUALITY = 82;

/** Widths up to the source width, always including the source width itself. */
function widthsFor(img: ImageMetadata): number[] {
  const fit = CANDIDATES.filter((w) => w < img.width);
  return [...fit, img.width];
}

async function sources(img: ImageMetadata) {
  const widths = widthsFor(img);
  const fallbackWidth = widths.find((w) => w >= 1280) ?? img.width;
  const [avif, webp] = await Promise.all([
    getImage({ src: img, widths, width: fallbackWidth, format: 'avif', quality: AVIF_QUALITY }),
    getImage({ src: img, widths, width: fallbackWidth, format: 'webp', quality: WEBP_QUALITY }),
  ]);
  return { avif: avif.srcSet.attribute, webp: webp.srcSet.attribute, src: webp.src, width: img.width, height: img.height };
}

const main = await sources(photo.src);
const portrait = useTall && photo.tall ? await sources(photo.tall) : null;
// The frame is the file's own shape, so the photo is never cover-cropped.
const style = [
  `--photo-ratio: ${main.width} / ${main.height}`,
  portrait ? `--photo-ratio-tall: ${portrait.width} / ${portrait.height}` : '',
]
  .filter(Boolean)
  .join('; ');
const Frame = frame;
---
<Frame
  class:list={['photo__frame', { 'photo__frame--rounded': rounded, 'photo__frame--tall': portrait, 'photo__frame--button': frame === 'button' }, className]}
  style={style}
  type={frame === 'button' ? 'button' : undefined}
  aria-label={frame === 'button' ? label : undefined}
  data-zoom-open={frame === 'button' ? '' : undefined}
>
  <picture>
    {
      portrait && (
        <>
          <source media="(max-width: 46.49rem)" type="image/avif" srcset={portrait.avif} sizes={sizes} width={portrait.width} height={portrait.height} />
          <source media="(max-width: 46.49rem)" type="image/webp" srcset={portrait.webp} sizes={sizes} width={portrait.width} height={portrait.height} />
        </>
      )
    }
    <source type="image/avif" srcset={main.avif} sizes={sizes} width={main.width} height={main.height} />
    <img
      class="photo__img"
      src={main.src}
      srcset={main.webp}
      sizes={sizes}
      width={main.width}
      height={main.height}
      alt={photo.alt}
      loading={priority ? 'eager' : 'lazy'}
      fetchpriority={priority ? 'high' : undefined}
      decoding={priority ? undefined : 'async'}
    />
  </picture>
</Frame>

<style>
  .photo__frame {
    display: block;
    position: relative;
    width: 100%;
    aspect-ratio: var(--photo-ratio, 3 / 2);
    overflow: hidden;
    background: var(--fill-2);
  }

  .photo__frame--rounded {
    border-radius: var(--r-card);
  }

  /* Phones get the portrait file, so the frame follows its shape. */
  @media (width < 46.5rem) {
    .photo__frame--tall {
      aspect-ratio: var(--photo-ratio-tall, 4 / 5);
    }
  }

  .photo__frame picture,
  .photo__img {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The frame has the file's ratio, so cover fills it exactly and crops nothing. */
  .photo__img {
    object-fit: cover;
  }

  /* The frame as the enlarge button: nothing drawn over the photo, a zoom cursor, and a focus ring around it. */
  .photo__frame--button {
    padding: 0;
    border: 0;
    font: inherit;
    color: inherit;
    cursor: zoom-in;
  }

  .photo__frame--button:focus-visible {
    outline: 3px solid var(--focus-ring);
    outline-offset: 3px;
  }
</style>
