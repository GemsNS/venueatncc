---
import { site, fullAddress } from '../data/site';
import { events } from '../data/events';
import { mainNav, bookHref } from '../data/nav';
import { href } from '../lib/paths';
import { isDemo } from '../lib/env';

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer__grid">
      <section class="footer__col footer__venue" aria-labelledby="f-venue">
        <h2 id="f-venue">{site.name}</h2>
        <p>{site.tagline}.</p>
        <address>
          <a href={site.address.directionsUrl} rel="noopener" target="_blank">
            {site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postalCode}
            <span class="visually-hidden"> (directions open in a new tab)</span>
          </a>
          <a href={`tel:${site.contact.phoneE164}`}>{site.contact.phone}</a>
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </address>
      </section>

      <nav class="footer__col" aria-labelledby="f-explore">
        <h2 id="f-explore">Explore</h2>
        <ul>
          {mainNav.map((item) => <li><a href={href(item.href)}>{item.label}</a></li>)}
          <li><a href={href(bookHref)}>Check availability</a></li>
        </ul>
      </nav>

      {
        events.length > 0 && (
          <nav class="footer__col" aria-labelledby="f-events">
            <h2 id="f-events">Plan an event</h2>
            <ul>
              {events.map((e) => (
                <li>
                  <a href={href(`/events/${e.slug}/`)}>{e.name}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <section class="footer__col" aria-labelledby="f-church">
        <h2 id="f-church">New Community Church</h2>
        <p>The Venue at NCC is the event space of {site.parent.name}, part of Suffolk since {site.parent.foundingYear}.</p>
        <ul>
          <li><a href={site.parent.url} rel="noopener">wearencc.org</a></li>
          {site.social.map((s) => <li><a href={s.url} rel="noopener me">{s.label}</a></li>)}
        </ul>
      </section>
    </div>

    <div class="footer__legal">
      <p>Copyright © {year} {site.name}. All rights reserved.</p>
      {isDemo && <p>This is a demo. Booking requests stay in your browser and no emails are sent.</p>}
      <p class="footer__addr">{fullAddress}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--bg-grouped);
    color: var(--label-2);
    font-size: var(--t-footnote);
    line-height: 1.5;
    padding-block: 3rem 2rem;
    border-top: 1px solid var(--separator);
  }

  .footer__grid {
    display: grid;
    gap: 2rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  }

  @media (min-width: 1000px) {
    .footer__grid {
      grid-template-columns: 1.3fr 0.8fr 1fr 1.1fr;
    }
  }

  .footer h2 {
    margin-bottom: 0.7rem;
    font-size: var(--t-footnote);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--label);
  }

  .footer ul {
    display: grid;
    gap: 0.45rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer a {
    color: var(--label-2);
  }

  .footer a:hover {
    color: var(--label);
  }

  .footer address {
    display: grid;
    gap: 0.45rem;
    margin-top: 0.8rem;
    font-style: normal;
  }

  .footer__col p + ul {
    margin-top: 0.7rem;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--separator);
    font-size: var(--t-caption);
  }

  .footer__legal p + p {
    margin-top: 0;
  }

  .footer__addr {
    margin-left: auto;
  }

  @media (max-width: 699.98px) {
    .footer__addr {
      margin-left: 0;
    }
  }
</style>
