---
/**
 * Site footer on Deep Olive: the light lockup, contact details, the event pages, and a short list of help
 * links. It does not repeat the header navigation (brand.md, "Redundancy rules"); FAQ is here because the
 * phone tab bar has no FAQ tab. The address appears once, in "Visit and contact".
 */
import Logo from './Logo.astro';
import { site } from '../data/site';
import { events } from '../data/events';
import { bookHref } from '../data/nav';
import { href } from '../lib/paths';
import { isDemo } from '../lib/env';
import { DEMO_ADMIN_EMAIL, DEMO_ADMIN_PASSWORD } from '../lib/api/demo-credentials';

const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <a class="footer__brand" href={href('/')} aria-label={`${site.name}, home`}>
        <Logo variant="lockup" tone="white" height={40} decorative />
      </a>
      <p class="footer__intro">An event venue in {site.address.city}, {site.address.regionName}.</p>
    </div>

    <div class="footer__grid">
      <section class="footer__col" aria-labelledby="f-visit">
        <h2 id="f-visit" class="footer__head">Visit and contact</h2>
        <address>
          <a href={site.address.directionsUrl} rel="noopener" target="_blank">
            {site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postalCode}
            <span class="visually-hidden">, directions open in a new tab</span>
          </a>
          <a href={`tel:${site.contact.phoneE164}`}>{site.contact.phone}</a>
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </address>
        {
          site.social.length > 0 && (
            <ul class="footer__social">
              {site.social.map((s) => <li><a href={s.url} rel="noopener me">{s.label}</a></li>)}
            </ul>
          )
        }
      </section>

      {
        events.length > 0 && (
          <nav class="footer__col footer__col--events" aria-labelledby="f-events">
            <h2 id="f-events" class="footer__head">Plan an event</h2>
            <ul class="footer__events">
              {events.map((e) => (
                <li>
                  <a href={href(`/events/${e.slug}/`)}>{e.name}</a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <nav class="footer__col" aria-labelledby="f-help">
        <h2 id="f-help" class="footer__head">Help</h2>
        <ul>
          <li><a href={href('/faq/')}>Frequently asked questions</a></li>
          <li><a href={`${href(bookHref)}?visit=1`}>Request a visit</a></li>
        </ul>
      </nav>
    </div>

    <div class="footer__legal">
      <p>Copyright © {year} {site.name}. All rights reserved.</p>
      {
        isDemo && (
          <p>
            This is a demo. Booking requests stay in your browser and no emails are sent.{' '}
            <a href={href('/admin/')}>Open the demo admin</a> and sign in as {DEMO_ADMIN_EMAIL} with the password {DEMO_ADMIN_PASSWORD}.
          </p>
        )
      }
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--olive-deep);
    color: var(--on-deep-2);
    font-size: var(--t-footnote);
    line-height: 1.5;
    /* On compact screens the footer's color runs down behind the floating tab bar (--tabbar-space). */
    padding-block: clamp(3rem, 2.5rem + 2vw, 4.5rem) calc(2rem + var(--tabbar-space));
  }

  .footer :focus-visible {
    outline-color: var(--on-deep);
  }

  /*
    After the Deep Olive closing band the two meet, so the footer drops its top padding and a hairline
    separates them instead.
  */
  :global(main:has(> .cta:last-child)) + .footer {
    padding-top: 0;
  }

  :global(main:has(> .cta:last-child)) + .footer .footer__top {
    padding-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    border-top: 1px solid var(--on-deep-line);
  }

  /* Dark mode, on pages without the closing band: a faint sage hairline sets the footer off from the page. */
  @media (prefers-color-scheme: dark) {
    :global(main:not(:has(> .cta:last-child))) + .footer {
      border-top: 1px solid var(--on-deep-line);
    }
  }

  .footer__top {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding-bottom: 2.5rem;
    margin-bottom: 2.5rem;
    border-bottom: 1px solid var(--on-deep-line);
  }

  @media (min-width: 64rem) {
    .footer__top {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
      gap: 3rem;
    }

    .footer__intro {
      justify-self: end;
    }
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer__intro {
    max-width: 34rem;
    color: var(--on-deep);
    font-family: var(--font-serif);
    font-size: clamp(1.125rem, 1.05rem + 0.3vw, 1.3125rem);
    line-height: 1.45;
  }

  .footer__grid {
    display: grid;
    gap: 2rem 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
  }

  /* Wide screens: the event list runs in two columns in the middle. */
  @media (min-width: 64rem) {
    .footer__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr) minmax(0, 1fr);
    }

    .footer__events {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
    }
  }

  /* Interface family: Caslon Display is for titles at 28px and up. Caramel on Deep Olive is 5.2:1. */
  .footer__head {
    margin-bottom: 0.7rem;
    font-family: var(--font);
    font-size: var(--t-footnote);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--on-deep-accent);
  }

  /* Links get 5px of padding above and below instead of list gaps, so each target is at least 28px tall. */
  .footer ul {
    display: grid;
    gap: 0;
    margin: -5px 0 0;
    padding: 0;
    list-style: none;
  }

  .footer li a,
  .footer address a {
    display: inline-block;
    padding-block: 5px;
  }

  /* Touch screens: every link is a full 44px target (HIG). */
  @media (pointer: coarse) {
    .footer li a,
    .footer address a {
      min-height: 44px;
      padding-block: calc((44px - 1.5em) / 2);
    }

    .footer ul,
    .footer address {
      margin-top: min(0px, calc((1.5em - 44px) / 2));
    }
  }

  .footer a {
    color: var(--on-deep-2);
  }

  .footer a:hover {
    color: var(--on-deep);
  }

  .footer address {
    display: grid;
    justify-items: start;
    gap: 0;
    margin-top: -5px;
    font-style: normal;
  }

  .footer address a {
    overflow-wrap: anywhere;
  }

  .footer .footer__social {
    margin-top: 0.7rem;
  }

  .footer__legal a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--on-deep-line);
    font-size: var(--t-caption);
  }

  .footer__legal p + p {
    margin-top: 0;
  }

  /* Forced colors: the band becomes the system background, and the light lockup follows the text color. */
  @media (forced-colors: active) {
    .footer {
      border-top: 1px solid CanvasText;
    }
  }
</style>
