---
/**
 * Site footer on a Blush band behind a top hairline (the card color in dark mode, --footer-bg), in the shape
 * of the reference site's: a large Caslon statement (the brand line), then the lockup with one sentence,
 * "Visit and contact", the site's single contact block (the contact person, address with directions, phone,
 * email), and "Plan your event" with the two requests that have no header link (a visit, an inquiry) and, on
 * compact screens, the FAQ, the only route to /faq/ there; from 46.5rem the header carries FAQ, so the footer
 * does not repeat it, and /faq/ never links to itself. The legal line closes it. It does not repeat the
 * header navigation, the event list, or the booking call to action (brand.md, "Redundancy rules").
 */
import Logo from './Logo.astro';
import { site, cityState } from '../data/site';
import { bookHref, pricingHref } from '../data/nav';
import { href, withoutBase } from '../lib/paths';
import { isDemo } from '../lib/env';
import { DEMO_ADMIN_EMAIL, DEMO_ADMIN_PASSWORD } from '../lib/api/demo-credentials';

const year = new Date().getFullYear();
const path = withoutBase(Astro.url.pathname);
const onFaq = path.startsWith('/faq/');
const onPricing = path.startsWith('/pricing/');
---
<footer class="footer">
  <div class="container">
    <p class="footer__statement t-statement">{site.tagline}.</p>

    <div class="footer__main">
      <div class="footer__brand">
        <a class="footer__home" href={href('/')} aria-label={`${site.name}, home`}>
          <Logo variant="lockup" tone="auto" height={40} decorative />
        </a>
        <p class="footer__blurb">Indoor and outdoor event rentals in {cityState}.</p>
      </div>

      <div class="footer__grid">
        <section class="footer__col" aria-labelledby="f-visit">
          <h2 id="f-visit" class="footer__head">Visit and contact</h2>
          <address>
            <span class="footer__person">{site.contact.contactName}</span>
            <a href={site.address.directionsUrl} rel="noopener" target="_blank">
              {site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postalCode}
              <span class="visually-hidden">, directions open in a new tab</span>
            </a>
            <a href={`tel:${site.contact.phoneE164}`}>{site.contact.phone}</a>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </address>
          {
            site.social.length > 0 && (
              <ul class="footer__social">
                {site.social.map((s) => <li><a href={s.url} rel="noopener me">{s.label}</a></li>)}
              </ul>
            )
          }
        </section>

        <section class="footer__col" aria-labelledby="f-plan">
          <h2 id="f-plan" class="footer__head">Plan your event</h2>
          <ul>
            <li><a href={`${href(bookHref)}?visit=1`}>Request a visit</a></li>
            {!onPricing && <li><a href={href(pricingHref)}>Send an inquiry</a></li>}
            {!onFaq && <li><a class="footer__faq" href={href('/faq/')}>Frequently asked questions</a></li>}
          </ul>
        </section>
      </div>
    </div>

    <div class="footer__legal">
      <p>Copyright © {year} {site.name}. All rights reserved.</p>
      {
        isDemo && (
          <p>
            This is a demo. Booking requests stay in your browser and no emails are sent.{' '}
            <a href={href('/admin/')}>Open the demo admin</a> and sign in as {DEMO_ADMIN_EMAIL} with the password {DEMO_ADMIN_PASSWORD}.
          </p>
        )
      }
    </div>
  </div>
</footer>

<style>
  /*
    Mauve secondary text on Blush is 6.9:1, Berry links 6.5:1, the Plum heading 12.8:1; in dark mode the
    light text, its secondary, and Blossom on the card color. The top hairline sets the footer off from a
    Blush section or the closing band above it.
  */
  .footer {
    background: var(--footer-bg);
    border-top: 1px solid var(--separator);
    color: var(--label-2);
    font-size: var(--t-footnote);
    line-height: 1.5;
    /* On compact screens the footer's color runs down behind the floating tab bar (--tabbar-space). */
    padding-block: clamp(3rem, 2.5rem + 2vw, 5rem) calc(2rem + var(--tabbar-space));
  }

  /* The brand line, large and quiet, above everything else. */
  .footer__statement {
    max-width: 22ch;
    margin-bottom: clamp(2.5rem, 2rem + 2vw, 4rem);
    color: var(--label);
  }

  .footer__main {
    display: grid;
    gap: 2.5rem;
    justify-items: start;
    padding-top: clamp(2rem, 1.5rem + 1.5vw, 3rem);
    border-top: 1px solid var(--separator);
  }

  .footer__brand {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }

  .footer__home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .footer__blurb {
    max-width: 22rem;
  }

  /* Short columns, side by side from the width where both fit, never stretched across the page. */
  .footer__grid {
    display: grid;
    gap: 2rem 4rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 18rem));
  }

  /* From 46.5rem the header carries FAQ, so the footer drops it. */
  @media (min-width: 46.5rem) {
    .footer__faq {
      display: none;
    }
  }

  /*
    Wide screens: one row, the lockup on the left and the two columns beside it, with the address,
    phone, and email side by side.
  */
  @media (min-width: 64rem) {
    .footer__main {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: start;
      gap: 2rem 5rem;
    }

    .footer__grid {
      grid-template-columns: auto auto;
      gap: 2rem 5rem;
    }
  }

  /* Interface family: Caslon Display is for titles at 28px and up. */
  .footer__head {
    margin-bottom: 0.7rem;
    font-family: var(--font);
    font-size: var(--t-footnote);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--label);
  }

  /* Links get 5px of padding above and below instead of list gaps, so each target is at least 28px tall. */
  .footer ul {
    display: grid;
    gap: 0;
    margin: -5px 0 0;
    padding: 0;
    list-style: none;
  }

  .footer li a,
  .footer address a {
    display: inline-block;
    padding-block: 5px;
  }

  /* Touch screens: every link is a full 44px target (HIG). */
  @media (pointer: coarse) {
    .footer li a,
    .footer address a {
      min-height: 44px;
      padding-block: calc((44px - 1.5em) / 2);
    }

    .footer ul,
    .footer address {
      margin-top: min(0px, calc((1.5em - 44px) / 2));
    }
  }

  .footer a {
    color: var(--accent-text);
  }

  /* The contact person, named once, above the address, phone, and email. */
  .footer__person {
    padding-block: 5px;
    color: var(--label);
    font-weight: 600;
  }

  .footer address {
    display: grid;
    justify-items: start;
    gap: 0;
    margin-top: -5px;
    font-style: normal;
  }

  .footer address a {
    overflow-wrap: anywhere;
  }

  .footer .footer__social {
    margin-top: 0.7rem;
  }

  .footer__legal a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--separator);
    font-size: var(--t-caption);
  }

  .footer__legal p + p {
    margin-top: 0;
  }

  /* Forced colors: the band becomes the system background, and the lockup follows the text color. */
  @media (forced-colors: active) {
    .footer {
      border-top: 1px solid CanvasText;
    }
  }
</style>
