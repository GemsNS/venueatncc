---
/**
 * The footer (docs/design/redesign-v7.md, "Version 8"): one short block on a very pale pink (Blush) band
 * under a hairline. The lockup, the three page links and Check Availability, then the address with
 * directions, the phone, and the email, then the legal line. No event list, no repeated navigation groups.
 * Booking is a text link here, not a button: the header carries the button. On Blush: Plum 13.2:1,
 * Mauve 7.1:1, Cerise 5.5:1.
 */
import Logo from './Logo.astro';
import { site } from '../data/site';
import { mainNav, bookHref } from '../data/nav';
import { href } from '../lib/paths';
import { isDemo } from '../lib/env';
import { DEMO_ADMIN_EMAIL, DEMO_ADMIN_PASSWORD } from '../lib/api/demo-credentials';

interface Props {
  /** Where Check Availability goes, base-relative. */
  bookHref?: string;
}

const { bookHref: book = bookHref } = Astro.props;
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="container">
    <div class="footer__main">
      <a class="footer__home" href={href('/')} aria-label={`${site.name}, home`}>
        <Logo variant="lockup" height={40} decorative />
      </a>

      <nav class="footer__nav" aria-label="Footer">
        <ul>
          {mainNav.map((item) => <li><a href={href(item.href)}>{item.label}</a></li>)}
          <li><a href={href(book)}>Check Availability</a></li>
        </ul>
      </nav>

      <address class="footer__contact">
        <a href={site.address.directionsUrl} rel="noopener" target="_blank">
          {site.address.street}, {site.address.city}, {site.address.region} {site.address.postalCode}
          <span class="visually-hidden">, directions open in a new tab</span>
        </a>
        <a href={`tel:${site.contact.phoneE164}`}>{site.contact.phone}</a>
        <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      </address>
    </div>

    <div class="footer__legal">
      <p>Copyright © {year} {site.name}. All rights reserved.</p>
      {
        site.social.length > 0 && (
          <ul class="footer__social">
            {site.social.map((s) => <li><a href={s.url} rel="noopener me">{s.label}</a></li>)}
          </ul>
        )
      }
      {
        isDemo && (
          <p>
            This is a demo. Booking requests stay in your browser and no emails are sent.{' '}
            <a href={href('/admin/')}>Open the demo admin</a> and sign in as {DEMO_ADMIN_EMAIL} with the password {DEMO_ADMIN_PASSWORD}.
          </p>
        )
      }
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--footer-bg);
    border-top: 1px solid var(--separator);
    color: var(--label-2);
    font-size: var(--t-subhead);
    line-height: 1.5;
    padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem) calc(1.5rem + env(safe-area-inset-bottom));
  }

  .footer a {
    color: var(--label);
  }

  /* Phones: the lockup, the links, and the contact lines stacked. From 60rem the three in one row. */
  .footer__main {
    display: grid;
    gap: 1.5rem 3rem;
    align-items: start;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--separator);
  }

  @media (min-width: 60rem) {
    .footer__main {
      grid-template-columns: auto minmax(0, 1fr) auto;
    }
  }

  .footer__home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    justify-self: start;
  }

  .footer__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__contact {
    display: grid;
    justify-items: start;
    font-style: normal;
  }

  @media (min-width: 60rem) {
    .footer__nav ul {
      justify-content: center;
    }

    .footer__contact {
      justify-items: end;
      text-align: right;
    }
  }

  /* Every link is a full 44px target (HIG). */
  .footer__nav a,
  .footer__contact a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-serif);
    font-size: var(--t-ui);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .footer__nav a:hover,
  .footer__contact a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .footer__legal {
    display: grid;
    gap: 0.4rem;
    padding-top: 1.25rem;
    font-size: var(--t-footnote);
  }

  .footer__legal p + p {
    margin-top: 0;
  }

  .footer__legal a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .footer__social {
    display: flex;
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (forced-colors: active) {
    .footer {
      border-top: 1px solid CanvasText;
    }
  }
</style>
