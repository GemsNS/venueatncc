---
/**
 * The footer (redesign-spec.md, Footer): the site's one dark surface, Plum, in the shape of the reference's
 * footer. Row one: a one-line statement with Check Availability on the left and three link columns on the
 * right (Explore: the main navigation; Plan: a visit and an inquiry, the two requests with no header link;
 * Visit: the address with
 * directions, the phone, the email, and the contact person, the site's contact block). Row two: the very
 * large centred serif statement (the brand line). Row three: the white lockup and the legal line. The
 * statement names the spaces only; what a booking includes is said on the home page and The Space
 * (brand.md, "Redundancy rules"). Blush text on Plum is 12.8:1, Pink 7.3:1, white 14.2:1.
 */
import Logo from './Logo.astro';
import { site, cityState } from '../data/site';
import { mainNav, bookHref, pricingHref } from '../data/nav';
import { href } from '../lib/paths';
import { isDemo } from '../lib/env';
import { DEMO_ADMIN_EMAIL, DEMO_ADMIN_PASSWORD } from '../lib/api/demo-credentials';

interface Props {
  /** Where Check Availability goes, base-relative. Event pages pass /book/?event=<slug>. */
  bookHref?: string;
}

const { bookHref: book = bookHref } = Astro.props;
const year = new Date().getFullYear();
const hall = site.spaces.find((s) => s.id === 'indoor')?.name ?? 'The Hall';
const grove = site.spaces.find((s) => s.id === 'outdoor')?.name ?? 'The Grove';
---
<footer class="footer">
  <div class="container">
    <div class="footer__top">
      <div class="footer__intro">
        <p class="footer__blurb">Indoor and outdoor event rentals in {cityState}: {hall}, The Main Hall, and {grove}, on one property.</p>
        <a class="btn btn--light" href={href(book)}>Check Availability</a>
      </div>

      <div class="footer__cols">
        <section class="footer__col" aria-labelledby="f-explore">
          <h2 id="f-explore" class="footer__head">Explore</h2>
          <ul>
            {mainNav.map((item) => <li><a href={href(item.href)}>{item.label}</a></li>)}
          </ul>
        </section>

        <section class="footer__col" aria-labelledby="f-plan">
          <h2 id="f-plan" class="footer__head">Plan</h2>
          <ul>
            <li><a href={`${href(bookHref)}?visit=1`}>Request a visit</a></li>
            <li><a href={href(pricingHref)}>Send an inquiry</a></li>
          </ul>
        </section>

        <section class="footer__col" aria-labelledby="f-visit">
          <h2 id="f-visit" class="footer__head">Visit</h2>
          <address>
            <a href={site.address.directionsUrl} rel="noopener" target="_blank">
              {site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postalCode}
              <span class="visually-hidden">, directions open in a new tab</span>
            </a>
            <a href={`tel:${site.contact.phoneE164}`}>{site.contact.phone}</a>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
            <span class="footer__person">{site.contact.contactName}</span>
          </address>
        </section>
      </div>
    </div>

    <p class="footer__statement t-statement">{site.tagline}.</p>

    <div class="footer__bottom">
      <a class="footer__home" href={href('/')} aria-label={`${site.name}, home`}>
        <Logo variant="lockup" tone="white" height={36} decorative />
      </a>
      <div class="footer__legal">
        <p>Copyright © {year} {site.name}. All rights reserved.</p>
        {
          site.social.length > 0 && (
            <ul class="footer__social">
              {site.social.map((s) => <li><a href={s.url} rel="noopener me">{s.label}</a></li>)}
            </ul>
          )
        }
        {
          isDemo && (
            <p>
              This is a demo. Booking requests stay in your browser and no emails are sent.{' '}
              <a href={href('/admin/')}>Open the demo admin</a> and sign in as {DEMO_ADMIN_EMAIL} with the password {DEMO_ADMIN_PASSWORD}.
            </p>
          )
        }
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--footer-bg);
    color: var(--on-dark-2);
    font-size: var(--t-subhead);
    line-height: 1.5;
    padding-block: clamp(3rem, 2.5rem + 2vw, 4.5rem) calc(2rem + env(safe-area-inset-bottom));
  }

  .footer a {
    color: var(--on-dark);
  }

  .footer a.btn--light {
    color: var(--ink);
  }

  .footer__top {
    display: grid;
    gap: 2.5rem 4rem;
    align-items: start;
  }

  @media (min-width: 64rem) {
    .footer__top {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }

  .footer__intro {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  /* The statement, in the serif at 18px, Blush on Plum. */
  .footer__blurb {
    max-width: 28rem;
    font-family: var(--font-serif);
    font-size: 1.125rem;
    line-height: 1.5;
    color: var(--on-dark);
  }

  /* Phones: Explore and Plan side by side, Visit beneath at full width, so the email never breaks. */
  .footer__cols {
    display: grid;
    gap: 2rem 2.5rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .footer__col:last-child {
    grid-column: 1 / -1;
  }

  @media (min-width: 40rem) {
    .footer__cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .footer__col:last-child {
      grid-column: auto;
    }
  }

  /* The column heads: small letterspaced serif, Pink. */
  .footer__head {
    margin-bottom: 0.6rem;
    font-family: var(--font-serif);
    font-size: var(--t-caption);
    font-weight: 400;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-accent);
  }

  .footer ul {
    display: grid;
    margin: -5px 0 0;
    padding: 0;
    list-style: none;
  }

  /* Links get 5px of padding above and below instead of list gaps, so each target is at least 28px tall. */
  .footer li a,
  .footer address a {
    display: inline-block;
    padding-block: 5px;
    font-family: var(--font-serif);
    font-size: var(--t-ui);
    text-decoration: none;
  }

  .footer li a:hover,
  .footer address a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* Touch screens: every link is a full 44px target (HIG). */
  @media (pointer: coarse) {
    .footer li a,
    .footer address a {
      min-height: 44px;
      padding-block: calc((44px - 1.5em) / 2);
    }

    .footer ul,
    .footer address {
      margin-top: min(0px, calc((1.5em - 44px) / 2));
    }
  }

  .footer address {
    display: grid;
    justify-items: start;
    margin-top: -5px;
    font-style: normal;
  }

  .footer address a {
    overflow-wrap: anywhere;
  }

  .footer__person {
    padding-block: 5px;
    font-family: var(--font-serif);
    font-size: var(--t-ui);
    color: var(--on-dark-2);
  }

  /* The brand line: very large, centred, white. */
  .footer__statement {
    margin-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
    text-align: center;
    color: var(--on-dark);
  }

  .footer__bottom {
    display: grid;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(251, 241, 243, 0.18);
  }

  @media (min-width: 48rem) {
    .footer__bottom {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: center;
    }

    .footer__legal {
      text-align: right;
      justify-items: end;
    }
  }

  .footer__home {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    justify-self: start;
  }

  .footer__legal {
    display: grid;
    gap: 0.4rem;
    font-size: var(--t-footnote);
  }

  .footer__legal p + p {
    margin-top: 0;
  }

  .footer__legal a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .footer__social {
    display: flex;
    gap: 1rem;
  }

  @media (forced-colors: active) {
    .footer {
      border-top: 1px solid CanvasText;
    }
  }
</style>
