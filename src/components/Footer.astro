---
/**
 * Site footer on a light Frost band behind a top hairline (Navy in dark mode, --footer-bg): the lockup in
 * its own Navy ink (Logo tone auto), then "Visit and contact", the site's single contact block
 * (address with directions, phone, email). On compact screens it adds one link to the FAQ, the only route
 * to /faq/ there, where the tab bar has no FAQ tab and the header nav is hidden; from 46.5rem the header
 * carries FAQ, so the footer does not repeat it, and /faq/ never links to itself. It does not repeat the
 * header navigation, the event list, or the booking call to action (brand.md, "Redundancy rules").
 * From 64rem the lockup and the contact block share one row.
 */
import Logo from './Logo.astro';
import { site } from '../data/site';
import { href, withoutBase } from '../lib/paths';
import { isDemo } from '../lib/env';
import { DEMO_ADMIN_EMAIL, DEMO_ADMIN_PASSWORD } from '../lib/api/demo-credentials';

const year = new Date().getFullYear();
const onFaq = withoutBase(Astro.url.pathname).startsWith('/faq/');
---
<footer class="footer">
  <div class="container">
    <div class="footer__main">
      <a class="footer__brand" href={href('/')} aria-label={`${site.name}, home`}>
        <Logo variant="lockup" tone="auto" height={40} decorative />
      </a>

      <div class="footer__grid">
        <section class="footer__col" aria-labelledby="f-visit">
          <h2 id="f-visit" class="footer__head">Visit and contact</h2>
          <address>
            <a href={site.address.directionsUrl} rel="noopener" target="_blank">
              {site.address.street}<br />{site.address.city}, {site.address.region} {site.address.postalCode}
              <span class="visually-hidden">, directions open in a new tab</span>
            </a>
            <a href={`tel:${site.contact.phoneE164}`}>{site.contact.phone}</a>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </address>
          {!onFaq && <a class="footer__faq" href={href('/faq/')}>Frequently asked questions</a>}
          {
            site.social.length > 0 && (
              <ul class="footer__social">
                {site.social.map((s) => <li><a href={s.url} rel="noopener me">{s.label}</a></li>)}
              </ul>
            )
          }
        </section>

      </div>
    </div>

    <div class="footer__legal">
      <p>Copyright © {year} {site.name}. All rights reserved.</p>
      {
        isDemo && (
          <p>
            This is a demo. Booking requests stay in your browser and no emails are sent.{' '}
            <a href={href('/admin/')}>Open the demo admin</a> and sign in as {DEMO_ADMIN_EMAIL} with the password {DEMO_ADMIN_PASSWORD}.
          </p>
        )
      }
    </div>
  </div>
</footer>

<style>
  /*
    Slate secondary text on Frost is 6.6:1, Deep Blue links 8.5:1, the Navy heading 13.4:1; in dark mode
    Ice, Mist, and the light text on Navy. The top hairline sets the footer off from a Frost section or
    the closing band above it.
  */
  .footer {
    background: var(--footer-bg);
    border-top: 1px solid var(--separator);
    color: var(--label-2);
    font-size: var(--t-footnote);
    line-height: 1.5;
    /* On compact screens the footer's color runs down behind the floating tab bar (--tabbar-space). */
    padding-block: clamp(3rem, 2.5rem + 2vw, 4.5rem) calc(2rem + var(--tabbar-space));
  }

  /* The lockup above the contact block, with space rather than a rule between them. */
  .footer__main {
    display: grid;
    gap: 2.25rem;
    justify-items: start;
  }

  .footer__brand {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  /* Short columns, side by side from the width where both fit, never stretched across the page. */
  .footer__grid {
    display: grid;
    gap: 2rem 4rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 18rem));
  }

  /* The FAQ link sits under the contact details. From 46.5rem the header carries FAQ, so the footer drops it. */
  .footer__faq {
    display: inline-block;
    margin-top: 0.5rem;
    padding-block: 5px;
  }

  @media (min-width: 46.5rem) {
    .footer__faq {
      display: none;
    }
  }

  @media (pointer: coarse) {
    .footer__faq {
      min-height: 44px;
      padding-block: calc((44px - 1.5em) / 2);
    }
  }

  /*
    Wide screens: one row, the lockup on the left and the contact block beside it, with the address,
    phone, and email side by side.
  */
  @media (min-width: 64rem) {
    .footer__main {
      grid-template-columns: auto minmax(0, 1fr);
      align-items: start;
      gap: 2rem 5rem;
    }

    .footer__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Interface family: Caslon Display is for titles at 28px and up. */
  .footer__head {
    margin-bottom: 0.7rem;
    font-family: var(--font);
    font-size: var(--t-footnote);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--label);
  }

  /* Links get 5px of padding above and below instead of list gaps, so each target is at least 28px tall. */
  .footer ul {
    display: grid;
    gap: 0;
    margin: -5px 0 0;
    padding: 0;
    list-style: none;
  }

  .footer li a,
  .footer address a {
    display: inline-block;
    padding-block: 5px;
  }

  /* Touch screens: every link is a full 44px target (HIG). */
  @media (pointer: coarse) {
    .footer li a,
    .footer address a {
      min-height: 44px;
      padding-block: calc((44px - 1.5em) / 2);
    }

    .footer ul,
    .footer address {
      margin-top: min(0px, calc((1.5em - 44px) / 2));
    }
  }

  .footer a {
    color: var(--accent-text);
  }

  .footer address {
    display: grid;
    justify-items: start;
    gap: 0;
    margin-top: -5px;
    font-style: normal;
  }

  .footer address a {
    overflow-wrap: anywhere;
  }

  /* Wide screens: the address, phone, and email side by side. */
  @media (min-width: 64rem) {
    .footer address {
      grid-auto-flow: column;
      justify-content: start;
      align-items: start;
      column-gap: 3rem;
    }
  }

  .footer .footer__social {
    margin-top: 0.7rem;
  }

  .footer__legal a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin-top: 2.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--separator);
    font-size: var(--t-caption);
  }

  .footer__legal p + p {
    margin-top: 0;
  }

  /* Forced colors: the band becomes the system background, and the lockup follows the text color. */
  @media (forced-colors: active) {
    .footer {
      border-top: 1px solid CanvasText;
    }
  }
</style>
