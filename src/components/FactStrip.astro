---
/** The venue's key facts as a row of pills: the two spaces, parking, and the lowest rate. */
import Icon from './Icon.astro';
import { site } from '../data/site';
import { priceSummary, formatUSD } from '../shared/pricing';
import type { IconName } from '../shared/icons';

interface Props {
  class?: string;
  center?: boolean;
}
const { class: className, center = false } = Astro.props;
const hall = site.spaces.find((s) => s.id === 'indoor');
const grove = site.spaces.find((s) => s.id === 'outdoor');
const { fromHourly } = priceSummary();

const facts: { icon: IconName; text: string }[] = [
  { icon: 'building', text: `${hall?.name} up to ${hall?.capacity}` },
  { icon: 'tree', text: `${grove?.name} up to ${grove?.capacity}` },
  { icon: 'parking', text: 'On-site parking' },
  { icon: 'tag', text: `Rates from ${formatUSD(fromHourly)} an hour` },
];
---
<ul class:list={['facts', { 'facts--center': center }, className]} aria-label="Venue at a glance">
  {
    facts.map((f) => (
      <li class="pill">
        <Icon name={f.icon} />
        {f.text}
      </li>
    ))
  }
</ul>

<style>
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .facts--center {
    justify-content: center;
  }
</style>
