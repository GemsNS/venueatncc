---
/**
 * Luminous purple placeholder scene, shown until real venue photos are added to src/assets/venue/.
 * Decorative only, so it is hidden from assistive technology.
 */
import { archSceneSvg } from '../lib/archScene';
import { uid } from '../lib/uid';

interface Props {
  variant?: number;
  muntins?: boolean;
  window?: boolean;
  width?: number;
  height?: number;
}
const { variant = 0, muntins = false, window: showWindow = false, width = 400, height = 500 } = Astro.props;
const svg = archSceneSvg({
  variant,
  muntins,
  window: showWindow,
  width,
  height,
  id: uid('scene'),
  attrs: 'class="scene" aria-hidden="true" focusable="false" width="100%" height="100%"',
});
---
<Fragment set:html={svg} />

<style>
  :global(.scene) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
