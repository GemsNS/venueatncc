---
/**
 * The one card (redesign-spec.md, PhotoCard): a photo in a 12px frame with the label and a meta line inside
 * the photo (the reference's venue cards), and the Styled Concept badge on a staged photo. With `href` the
 * whole card is a link named by its label; without one it is a figure whose photo opens in the full-screen
 * viewer (Photo.astro). The frame is 3:2 on regular screens and, with `tall`, the 4:5 portrait file on
 * phones, so no photo is cropped into its subject.
 *
 * The label sits on a frosted White strip along the bottom of the photo (brand.md, version 6, "Photo card
 * labels"), the same glass as the hero caption panels: White at 0.78, blurred, with a white hairline on top.
 * At 0.78 the strip is at least that bright over any photo, even a black one, so the Plum label keeps more
 * than 9:1 and the Mauve meta line more than 4.5:1 without tuning per photo. Without backdrop-filter, and
 * under reduced transparency or increased contrast, the strip is near-solid White.
 */
import Photo from './Photo.astro';
import type { VenuePhoto } from '../data/photos';
import { href as toHref } from '../lib/paths';
import { uid } from '../lib/uid';

interface Props {
  photo: VenuePhoto;
  label: string;
  meta?: string;
  /** Base-relative link. Omit for a gallery card (tap to enlarge). */
  href?: string;
  /** Rendered width at each breakpoint; the last entry is the phone width, which the portrait file uses too. */
  sizes?: string;
  tall?: boolean;
  ratio?: string;
  priority?: boolean;
  /** Heading level of the label. */
  headingLevel?: 'h2' | 'h3' | 'p';
  class?: string;
}

const {
  photo,
  label,
  meta,
  href,
  sizes = '(min-width: 75rem) 420px, (min-width: 60rem) 33vw, (min-width: 46.5rem) 46vw, 82vw',
  tall = true,
  ratio = '3 / 2',
  priority = false,
  headingLevel = 'h3',
  class: className,
} = Astro.props;

const Heading = headingLevel;
const id = uid('pcard');
const Tag = href ? 'a' : 'div';
---
<Tag class:list={['pcard', { 'pcard--link': href, 'pcard--zoom': !href }, className]} href={href ? toHref(href) : undefined} aria-labelledby={href ? id : undefined}>
  <Photo photo={photo} ratio={ratio} tall={tall} rounded={false} caption={false} zoom={!href} priority={priority} sizes={sizes} class="pcard__photo">
    <span class="pcard__text">
      <Heading id={id} class="pcard__label">{label}</Heading>
      {meta && <span class="pcard__meta">{meta}</span>}
    </span>
  </Photo>
</Tag>

<style>
  .pcard {
    display: block;
    position: relative;
    border-radius: var(--r-card);
    overflow: hidden;
    isolation: isolate;
    color: var(--ink);
    text-decoration: none;
    transition: transform var(--dur-2) var(--ease-spring);
  }

  .pcard--link:hover {
    text-decoration: none;
  }

  .pcard--link:hover :global(.photo__img) {
    transform: scale(1.03);
  }

  .pcard :global(.photo__img) {
    transition: transform var(--dur-3) var(--ease-out);
  }

  .pcard :global(.photo__frame) {
    border-radius: var(--r-card);
  }

  /*
    The frosted strip: White at 0.78 over the photo, blurred and slightly saturated, with a white hairline
    along its top edge. It sits under the enlarge button (z-index 2 on a gallery card), which is transparent
    apart from its small icon, so the icon shows at the strip's right end and a tap anywhere opens the viewer.
  */
  .pcard__text {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    display: grid;
    gap: 0.15rem;
    padding: 0.9rem 1.25rem 1rem;
    border-top: 1px solid var(--frost-border);
    background: rgb(255 255 255 / 0.78);
    -webkit-backdrop-filter: var(--frost-blur);
    backdrop-filter: var(--frost-blur);
    pointer-events: none;
  }

  /* A gallery card's enlarge icon sits at the strip's right end; the text stops short of it. */
  .pcard--zoom .pcard__text {
    padding-right: calc(36px + 1.5rem);
  }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .pcard__text {
      background: rgb(255 255 255 / 0.9);
    }
  }

  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .pcard__text {
      background: rgb(255 255 255 / 0.96);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .pcard :global(.photo__zoom) {
    z-index: 2;
  }

  .pcard__label {
    margin: 0;
    color: var(--ink);
    font-family: var(--font-serif);
    font-size: var(--t-title-3);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .pcard__meta {
    font-family: var(--font-serif);
    font-size: var(--t-subhead);
    color: var(--mauve);
  }

  .pcard--link:focus-visible {
    outline-offset: -3px;
    border-radius: var(--r-card);
  }

  @media (forced-colors: active) {
    .pcard__text {
      border-top-color: CanvasText;
      background: Canvas;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pcard--link:hover :global(.photo__img) {
      transform: none;
    }
  }
</style>
