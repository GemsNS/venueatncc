---
/**
 * Drifting petals: a small procedural animation the site draws itself on a canvas behind the home page
 * welcome (docs/design/brand.md, "Motion and graphics"). It is decoration in the brand's own pastels,
 * Rose Mist, Petal, and Pink, at low opacity, so the Plum text over it keeps its contrast; it never
 * stands in for a photo of the property, and no footage or third-party graphic is used.
 *
 * Reduced motion: no animation loop; a few petals are drawn once, still. The loop also pauses while the
 * tab is hidden or the welcome is scrolled out of view, the canvas is capped at 2x device pixels, and
 * the whole thing is aria-hidden: it carries no information.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---
<canvas class:list={['petals', className]} data-petals aria-hidden="true"></canvas>

<script>
  const PETAL_COLORS = ['239, 197, 208', '246, 223, 229', '233, 169, 187'];

  interface Petal {
    x: number;
    y: number;
    r: number;
    tilt: number;
    spin: number;
    vy: number;
    sway: number;
    phase: number;
    color: string;
    alpha: number;
  }

  function start(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    let w = 0;
    let h = 0;
    let dpr = 1;
    let petals: Petal[] = [];
    let raf = 0;
    let visible = true;
    let last = 0;

    const rand = (a: number, b: number) => a + Math.random() * (b - a);

    function make(fromTop: boolean): Petal {
      const r = rand(7, 15);
      return {
        x: rand(0, w),
        y: fromTop ? rand(-h * 0.2, -r * 2) : rand(0, h),
        r,
        tilt: rand(0, Math.PI * 2),
        spin: rand(-0.35, 0.35),
        vy: rand(9, 18),
        sway: rand(10, 26),
        phase: rand(0, Math.PI * 2),
        color: PETAL_COLORS[Math.floor(rand(0, PETAL_COLORS.length))],
        // At most 0.6: Mauve text over a Pink petal on Blush then keeps 4.9:1 (Plum 9.2:1, Berry 4.7:1).
        alpha: rand(0.4, 0.6),
      };
    }

    function resize() {
      const rect = canvas.getBoundingClientRect();
      w = Math.max(1, Math.round(rect.width));
      h = Math.max(1, Math.round(rect.height));
      dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
      // About one petal per 45,000 square pixels, between 8 and 22.
      const count = Math.max(8, Math.min(22, Math.round((w * h) / 45000)));
      petals = Array.from({ length: count }, () => make(false));
      draw();
    }

    function petal(p: Petal) {
      ctx!.save();
      ctx!.translate(p.x, p.y);
      ctx!.rotate(p.tilt);
      ctx!.fillStyle = `rgba(${p.color}, ${p.alpha})`;
      ctx!.beginPath();
      // A petal: two curves from the stem point to the tip.
      ctx!.moveTo(0, -p.r);
      ctx!.bezierCurveTo(p.r * 0.9, -p.r * 0.7, p.r * 0.75, p.r * 0.6, 0, p.r);
      ctx!.bezierCurveTo(-p.r * 0.75, p.r * 0.6, -p.r * 0.9, -p.r * 0.7, 0, -p.r);
      ctx!.closePath();
      ctx!.fill();
      ctx!.restore();
    }

    function draw() {
      ctx!.clearRect(0, 0, w, h);
      for (const p of petals) petal(p);
    }

    function step(now: number) {
      raf = 0;
      const dt = Math.min(0.05, (now - (last || now)) / 1000);
      last = now;
      for (const p of petals) {
        p.phase += dt * 0.9;
        p.y += p.vy * dt;
        p.x += Math.sin(p.phase) * p.sway * dt;
        p.tilt += p.spin * dt;
        if (p.y > h + p.r * 2 || p.x < -p.r * 3 || p.x > w + p.r * 3) Object.assign(p, make(true));
      }
      draw();
      if (visible && !reduced.matches) raf = requestAnimationFrame(step);
    }

    function play() {
      if (raf || reduced.matches || !visible) return;
      last = 0;
      raf = requestAnimationFrame(step);
    }

    function pause() {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
    }

    resize();
    play();

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(resize, 120);
    });
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : play()));
    new IntersectionObserver(
      (entries) => {
        visible = entries.some((e) => e.isIntersecting);
        if (visible) play();
        else pause();
      },
      { threshold: 0 },
    ).observe(canvas);
    reduced.addEventListener('change', () => (reduced.matches ? pause() : play()));
  }

  document.querySelectorAll<HTMLCanvasElement>('[data-petals]').forEach(start);
</script>

<style>
  .petals {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>
