---
/**
 * DEPRECATED. Use Photo.astro.
 * A thin wrapper kept only so pages build until their owners switch to <Photo>. The arch shape and the
 * placeholder scene are gone: it renders the photo as a plain rectangle, and nothing when there is no photo.
 * The shape, variant, muntins and window props are accepted and ignored.
 */
import Photo from './Photo.astro';
import type { VenuePhoto } from '../data/photos';

interface Props {
  photo?: VenuePhoto | null;
  sizes?: string;
  priority?: boolean;
  ratio?: string;
  shape?: 'arch' | 'panel';
  variant?: number;
  muntins?: boolean;
  window?: boolean;
  class?: string;
  caption?: string;
}

const { photo = null, sizes, priority = false, ratio = '3 / 2', class: className, caption } = Astro.props;
---
{photo && <Photo photo={photo} sizes={sizes} priority={priority} ratio={ratio} class={className} caption={caption} />}
