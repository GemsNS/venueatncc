---
/**
 * The signature shape of the site: an arched window with a fine brass trim.
 * Shows a venue photo when one is provided, otherwise the illustrated scene.
 *
 * Photos are cropped to the window's aspect ratio at build time, so every srcset
 * candidate matches the frame and the browser's width-based choice stays sharp.
 */
import { Picture } from 'astro:assets';
import type { VenuePhoto } from '../data/photos';
import ArchScene from './ArchScene.astro';

interface Props {
  photo?: VenuePhoto | null;
  /** Rendered width of the window at each breakpoint, e.g. "(min-width: 900px) 40vw, 90vw". */
  sizes?: string;
  /** Eager-load and prioritise when the arch is the largest thing above the fold. */
  priority?: boolean;
  /** Aspect ratio of the window, "width / height". */
  ratio?: string;
  trim?: boolean;
  variant?: number;
  class?: string;
  caption?: string;
}

const {
  photo = null,
  sizes = '(min-width: 1000px) 480px, 90vw',
  priority = false,
  ratio = '4 / 5',
  trim = true,
  variant = 0,
  class: className = '',
  caption,
} = Astro.props;

const [rw, rh] = ratio.split('/').map((n) => Number.parseFloat(n));
const candidateWidths = [360, 540, 720, 960, 1280, 1600];

// The widest crop the source can supply at this ratio without upscaling.
const maxCropW = photo ? Math.min(photo.src.width, Math.floor((photo.src.height * rw) / rh)) : 0;
const photoWidths = photo
  ? (() => {
      const fit = candidateWidths.filter((w) => w <= maxCropW);
      return fit.length > 0 ? fit : [maxCropW];
    })()
  : [];
const cropW = photoWidths.at(-1) ?? 0;
const cropH = Math.round((cropW * rh) / rw);
const figCaption = caption ?? photo?.caption;
---
<figure class:list={['arch', className]} style={`--arch-ratio: ${ratio}`}>
  <div class:list={['arch__frame', { 'arch__frame--trim': trim }]}>
    <div class="arch__window">
      {
        photo ? (
          <Picture
            src={photo.src}
            alt={photo.alt}
            width={cropW}
            height={cropH}
            fit="cover"
            position={photo.crop ?? 'center'}
            widths={photoWidths}
            sizes={sizes}
            formats={['avif', 'webp']}
            loading={priority ? 'eager' : 'lazy'}
            fetchpriority={priority ? 'high' : 'auto'}
            decoding={priority ? 'sync' : 'async'}
            class="arch__img"
          />
        ) : (
          <ArchScene variant={variant} />
        )
      }
    </div>
  </div>
  {figCaption && <figcaption class="arch__caption">{figCaption}</figcaption>}
</figure>

<style>
  .arch {
    margin: 0;
  }

  .arch__frame {
    position: relative;
  }

  .arch__window {
    position: relative;
    aspect-ratio: var(--arch-ratio, 4 / 5);
    overflow: hidden;
    /* Oversized radii collapse to half the width: a true semicircular head. */
    border-radius: 100vmax 100vmax var(--radius) var(--radius);
    background: var(--navy);
    isolation: isolate;
  }

  .arch__frame--trim {
    padding: clamp(8px, 1.4vw, 14px);
  }

  .arch__frame--trim::before {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid var(--brass);
    border-radius: 100vmax 100vmax var(--radius) var(--radius);
    pointer-events: none;
  }

  .arch__window :global(picture),
  .arch__window :global(.arch__img) {
    width: 100%;
    height: 100%;
  }

  .arch__window :global(.arch__img) {
    object-fit: cover;
  }

  .arch__caption {
    margin-top: 0.9rem;
    font-size: var(--step--1);
    color: var(--ink-2);
    text-align: center;
  }
</style>
