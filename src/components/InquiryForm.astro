---
/**
 * Event inquiry form. Posts to site.contact.formEndpoint (Formspree, Web3Forms, or any
 * service that accepts a standard form POST). Works without JavaScript; with JavaScript
 * it submits in place and shows the result inline.
 */
import { site } from '../data/site';
import { events } from '../data/events';

interface Props {
  /** Preselect an event type by slug. */
  preselect?: string;
}
const { preselect } = Astro.props;
const endpoint = site.contact.formEndpoint;

// Formspree and Web3Forms use different names for the spam trap and the email subject.
const isFormspree = Boolean(endpoint?.includes('formspree.io'));
const trapName = isFormspree ? '_gotcha' : 'botcheck';
const subjectName = isFormspree ? '_subject' : 'subject';
---
{
  endpoint && (
    <form
      class="inquiry"
      action={endpoint}
      method="POST"
      data-inquiry
      data-trap={trapName}
      aria-describedby="inquiry-note"
    >
      {Object.entries(site.contact.formHiddenFields).map(([name, value]) => (
        <input type="hidden" name={name} value={value} />
      ))}
      <input type="hidden" name={subjectName} value="New event inquiry from venueatncc.org" />

      <div class="inquiry__grid">
        <div class="field">
          <label for="inq-name">Your name</label>
          <input id="inq-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="inq-email">Email</label>
          <input id="inq-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="inq-phone">Phone <span class="field__optional">(optional)</span></label>
          <input id="inq-phone" name="phone" type="tel" autocomplete="tel" />
        </div>
        <div class="field">
          <label for="inq-type">Type of event</label>
          <select id="inq-type" name="event_type" required>
            <option value="">Choose one</option>
            {events.map((e) => (
              <option value={e.name} selected={e.slug === preselect}>
                {e.name}
              </option>
            ))}
            <option value="Other">Something else</option>
          </select>
        </div>
        <div class="field">
          <label for="inq-date">Event date <span class="field__optional">(optional)</span></label>
          <input id="inq-date" name="event_date" type="date" aria-describedby="inq-date-hint" />
          <p class="field__hint" id="inq-date-hint">Leave blank if you are still deciding.</p>
        </div>
        <div class="field">
          <label for="inq-guests">About how many guests? <span class="field__optional">(optional)</span></label>
          <input id="inq-guests" name="guest_count" type="number" inputmode="numeric" min="1" step="1" />
        </div>
        <div class="field field--full">
          <label for="inq-message">Tell us about your event <span class="field__optional">(optional)</span></label>
          <textarea id="inq-message" name="message" rows="5"></textarea>
        </div>
      </div>

      <div class="inquiry__trap" aria-hidden="true">
        <label for="inq-hp">Leave this field empty</label>
        <input id="inq-hp" name={trapName} type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="inquiry__footer">
        <button class="btn btn--primary" type="submit">Send inquiry</button>
        <p class="inquiry__note muted" id="inquiry-note">
          Prefer to talk? Call <a href={`tel:${site.contact.phoneE164}`}>{site.contact.phone}</a>.
        </p>
      </div>
      <p class="inquiry__status" role="status" aria-live="polite" data-inquiry-status></p>
    </form>
  )
}

<script>
  const form = document.querySelector<HTMLFormElement>('[data-inquiry]');
  const status = form?.querySelector<HTMLElement>('[data-inquiry-status]');
  if (form && status) {
    const show = (message: string, kind: 'success' | 'error') => {
      status.className = `inquiry__status is-${kind}`;
      status.textContent = message;
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      status.className = 'inquiry__status';
      status.textContent = '';

      const trap = form.querySelector<HTMLInputElement>(`input[name="${form.dataset.trap}"]`);
      if (trap && trap.value) {
        // Almost certainly a bot. Behave as if it worked, without sending anything.
        form.reset();
        show('Inquiry sent. We will follow up about your date.', 'success');
        return;
      }

      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (button) {
        button.disabled = true;
        button.textContent = 'Sending…';
      }

      let res: Response | undefined;
      try {
        res = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });
      } catch {
        show('Your inquiry did not send. Check your connection and try again, or call us instead.', 'error');
      }

      if (res) {
        if (res.ok) {
          form.reset();
          show('Inquiry sent. We will follow up about your date.', 'success');
        } else {
          show('Your inquiry was not accepted. Check that each required field is filled in, then try again, or call us instead.', 'error');
        }
      }

      if (button) {
        button.disabled = false;
        button.textContent = 'Send inquiry';
      }
    });
  }
</script>

<style>
  .inquiry {
    display: grid;
    gap: 1.5rem;
  }

  .inquiry__grid {
    display: grid;
    gap: 1.25rem 1.5rem;
  }

  @media (min-width: 640px) {
    .inquiry__grid {
      grid-template-columns: 1fr 1fr;
    }

    .field--full {
      grid-column: 1 / -1;
    }
  }

  .field {
    display: grid;
    gap: 0.4rem;
    align-content: start;
  }

  .field label {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .field__optional,
  .field__hint {
    font-weight: 400;
    color: var(--ink-2);
    font-size: var(--step--1);
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.85rem;
    border: 1.5px solid #aeb7c7;
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    font: inherit;
    font-size: 1rem;
  }

  /* Equal heights so paired controls line up (the date input renders taller by default). */
  .field input,
  .field select {
    height: 3.25rem;
  }

  .field textarea {
    resize: vertical;
  }

  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--cobalt);
    outline-offset: 1px;
  }

  .inquiry__trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .inquiry__footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .inquiry__status {
    font-weight: 500;
  }

  .inquiry__status.is-success {
    padding: 0.9rem 1rem;
    border-left: 3px solid var(--pine);
    background: #eaf1ee;
  }

  .inquiry__status.is-error {
    padding: 0.9rem 1rem;
    border-left: 3px solid #a3312a;
    background: #f8ebea;
  }
</style>
