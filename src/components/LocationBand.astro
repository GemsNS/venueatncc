---
/** Where the venue is: an inset grouped contact list beside a lazily loaded map. */
import Icon from './Icon.astro';
import { site, fullAddress } from '../data/site';

interface Props {
  heading?: string;
  lead?: string;
}
const {
  heading = 'Find us in north Suffolk',
  lead = 'On Godwin Boulevard at New Community Church, with parking on site.',
} = Astro.props;
// The address alone, so the pin is not labeled with the church's older Google listing name.
const mapSrc = `https://www.google.com/maps?q=${encodeURIComponent(fullAddress)}&z=14&output=embed`;
---
<section class="section section--grouped location" aria-labelledby="location-heading">
  <div class="container location__grid">
    <div class="location__copy">
      <div class="section-head">
        <h2 id="location-heading">{heading}</h2>
        <p class="t-lead">{lead}</p>
      </div>
      <ul class="list-group location__list">
        <li>
          <div class="list-row list-row--icon">
            <span class="icon-tile"><Icon name="map-pin" /></span>
            <div class="list-row__main">
              <div class="t-headline">{site.name}</div>
              <div class="list-row__detail">{fullAddress}</div>
            </div>
          </div>
        </li>
        <li>
          <a class="list-row list-row--icon location__link" href={`tel:${site.contact.phoneE164}`}>
            <span class="icon-tile"><Icon name="phone" /></span>
            <span class="list-row__main">
              <span class="t-headline location__value">{site.contact.phone}</span>
              <span class="list-row__detail">Call us</span>
            </span>
          </a>
        </li>
        <li>
          <a class="list-row list-row--icon location__link" href={`mailto:${site.contact.email}`}>
            <span class="icon-tile"><Icon name="mail" /></span>
            <span class="list-row__main">
              <span class="t-headline location__value">{site.contact.email}</span>
              <span class="list-row__detail">We reply by email</span>
            </span>
          </a>
        </li>
        <li>
          <div class="list-row list-row--icon">
            <span class="icon-tile"><Icon name="parking" /></span>
            <div class="list-row__main">
              <div class="t-headline">Parking included</div>
              <div class="list-row__detail">On-site parking with every booking</div>
            </div>
          </div>
        </li>
      </ul>
      <div class="btn-row">
        <a class="btn btn--tinted" href={site.address.directionsUrl} rel="noopener" target="_blank">
          <Icon name="arrow-up-right" />
          Get Directions<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </div>
    </div>
    <div class="location__map">
      {
        /*
          Out of the tab order: the map adds focus stops with no visible focus, and the directions
          link, address and phone beside it carry the same information. Screen readers still get the title.
        */
      }
      <iframe
        title={`Map showing ${site.name} at ${fullAddress}`}
        src={mapSrc}
        loading="lazy"
        tabindex="-1"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>

<style>
  .location__grid {
    display: grid;
    gap: 2.5rem clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  @media (min-width: 900px) {
    .location__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    }
  }

  .location__copy {
    display: grid;
    gap: 1.5rem;
  }

  .location__copy .section-head {
    margin-bottom: 0.5rem;
  }

  /* Rows sit inside list items here, so draw the inset separators between items. */
  .location__list > li + li > .list-row::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(1.1rem + 44px + 0.9rem);
    right: 0;
    border-top: 1px solid var(--separator);
  }

  /* The phone and email rows are links end to end, so the whole row is the target. */
  .location__link {
    color: var(--label);
    text-decoration: none;
    transition: background-color var(--dur-1) ease;
  }

  .location__link:hover {
    text-decoration: none;
    background: var(--fill-3);
  }

  /* The list clips its corners, so the focus ring sits inside the row. */
  .location__link:focus-visible {
    outline-offset: -3px;
    border-radius: 0;
  }

  .location__link .list-row__main {
    display: grid;
  }

  .location__value {
    color: var(--accent-text);
    overflow-wrap: anywhere;
  }

  .location__map {
    aspect-ratio: 4 / 3;
    border-radius: var(--r-xl);
    overflow: hidden;
    background: var(--fill-2);
    box-shadow: var(--shadow-2);
  }

  .location__map iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  /* HIG: slightly dim bright imagery in dark mode. No inversion, so the pin keeps its real color. */
  @media (prefers-color-scheme: dark) {
    .location__map iframe {
      filter: brightness(0.82);
    }
  }
</style>
