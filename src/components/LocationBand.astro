---
/**
 * Arrival, on the home page: the drive at dusk beside a heading, one lead, the parking row, and directions.
 * The address, phone, and email are in the footer, the site's single contact block (brand.md, "Redundancy
 * rules"), so they are not listed here. Get Directions is tinted: the closing band keeps the page's one
 * filled call to action.
 */
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { site } from '../data/site';
import { photoByName } from '../data/photos';

interface Props {
  heading?: string;
  lead?: string;
}
const {
  heading = 'Find us in north Suffolk',
  lead = 'On Godwin Boulevard, a short drive from downtown Suffolk.',
} = Astro.props;
const photo = photoByName('approach-dusk');
---
<section class="section section--grouped location" aria-labelledby="location-heading">
  <div class="container location__grid">
    {
      photo && (
        <Photo
          photo={photo}
          class="location__photo"
          sizes="(min-width: 75rem) 640px, (min-width: 56rem) 52vw, 100vw"
        />
      )
    }
    <div class="location__copy">
      <div class="section-head">
        <h2 id="location-heading">{heading}</h2>
        <p class="t-lead">{lead}</p>
      </div>
      <div class="list-group">
        <div class="list-row list-row--icon">
          <span class="icon-tile"><Icon name="parking" /></span>
          <div class="list-row__main">
            <div class="t-headline">On-site parking</div>
            <div class="list-row__detail">A large paved lot, included with every booking</div>
          </div>
        </div>
      </div>
      <div class="btn-row">
        <a class="btn btn--tinted" href={site.address.directionsUrl} rel="noopener" target="_blank">
          <Icon name="arrow-up-right" />
          Get Directions<span class="visually-hidden">, opens in a new tab</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .location__grid {
    display: grid;
    gap: 2.5rem clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .location__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }

  .location__copy {
    display: grid;
    gap: 1.5rem;
  }

  .location__copy .section-head {
    margin-bottom: 0.5rem;
  }
</style>
