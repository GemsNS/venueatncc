---
/** Arrival: the drive at dusk beside the address, contact rows, parking, and directions. */
import Icon from './Icon.astro';
import Photo from './Photo.astro';
import { site, fullAddress } from '../data/site';
import { photoByName } from '../data/photos';

interface Props {
  heading?: string;
  lead?: string;
}
const {
  heading = 'Find us in north Suffolk',
  lead = 'On Godwin Boulevard at New Community Church, a few minutes from downtown Suffolk, with parking on site.',
} = Astro.props;
const photo = photoByName('approach-dusk');
---
<section class="section section--grouped location" aria-labelledby="location-heading">
  <div class="container location__grid">
    {
      photo && (
        <Photo
          photo={photo}
          class="location__photo"
          sizes="(min-width: 75rem) 640px, (min-width: 56rem) 52vw, 100vw"
        />
      )
    }
    <div class="location__copy">
      <div class="section-head">
        <h2 id="location-heading">{heading}</h2>
        <p class="t-lead">{lead}</p>
      </div>
      <ul class="list-group location__list">
        <li>
          <a class="list-row list-row--icon location__link" href={site.address.directionsUrl} rel="noopener" target="_blank">
            <span class="icon-tile"><Icon name="map-pin" /></span>
            <span class="list-row__main">
              <span class="t-headline">{site.name}</span>
              <span class="list-row__detail">{fullAddress}</span>
            </span>
            <Icon name="arrow-up-right" class="location__chevron" />
            <span class="visually-hidden">, directions open in a new tab</span>
          </a>
        </li>
        <li>
          <a class="list-row list-row--icon location__link" href={`tel:${site.contact.phoneE164}`}>
            <span class="icon-tile"><Icon name="phone" /></span>
            <span class="list-row__main">
              <span class="t-headline location__value">{site.contact.phone}</span>
              <span class="list-row__detail">Call us</span>
            </span>
          </a>
        </li>
        <li>
          <a class="list-row list-row--icon location__link" href={`mailto:${site.contact.email}`}>
            <span class="icon-tile"><Icon name="mail" /></span>
            <span class="list-row__main">
              <span class="t-headline location__value">{site.contact.email}</span>
              <span class="list-row__detail">We reply by email</span>
            </span>
          </a>
        </li>
        <li>
          <div class="list-row list-row--icon">
            <span class="icon-tile"><Icon name="parking" /></span>
            <div class="list-row__main">
              <div class="t-headline">On-site parking</div>
              <div class="list-row__detail">A large paved lot, included with every booking</div>
            </div>
          </div>
        </li>
      </ul>
      <div class="btn-row">
        <a class="btn btn--filled" href={site.address.directionsUrl} rel="noopener" target="_blank">
          <Icon name="arrow-up-right" />
          Get Directions<span class="visually-hidden">, opens in a new tab</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .location__grid {
    display: grid;
    gap: 2.5rem clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 56rem) {
    .location__grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }

  .location__copy {
    display: grid;
    gap: 1.5rem;
  }

  .location__copy .section-head {
    margin-bottom: 0.5rem;
  }

  .location__list {
    box-shadow: var(--shadow-1);
  }

  /* Rows sit inside list items here, so draw the inset separators between items. */
  .location__list > li + li > .list-row::before {
    content: '';
    position: absolute;
    top: 0;
    left: calc(1.1rem + 44px + 0.9rem);
    right: 0;
    border-top: 1px solid var(--separator);
  }

  /* The address, phone and email rows are links end to end, so the whole row is the target. */
  .location__link {
    color: var(--label);
    text-decoration: none;
    transition: background-color var(--dur-1) ease;
  }

  .location__link:hover {
    text-decoration: none;
    background: var(--fill-3);
  }

  /* The list clips its corners, so the focus ring sits inside the row. */
  .location__link:focus-visible {
    outline-offset: -3px;
    border-radius: 0;
  }

  .location__link .list-row__main {
    display: grid;
  }

  .location__value {
    color: var(--accent-text);
    overflow-wrap: anywhere;
  }

  .location__link :global(.location__chevron) {
    color: var(--label-3);
  }
</style>
