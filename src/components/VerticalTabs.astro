---
/**
 * The reference venue page's highlights (redesign-spec.md, VerticalTabs): a left list of section names on a
 * hairline rail, the current one marked, beside the panels (each a photo, a serif sub-head, and copy) on the
 * right. Built as in-page anchors and stacked panels, so it needs no script to work; a small observer marks
 * the current name as the page scrolls. Phones turn the list into a scrollable row above the panels.
 *
 * Pass one named slot per item, named by its id:
 *   <VerticalTabs items={[{ id: 'hall', label: 'The Hall' }]}><div slot="hall">...</div></VerticalTabs>
 */
interface Props {
  items: { id: string; label: string }[];
  label?: string;
  class?: string;
}

const { items, label = 'Sections', class: className } = Astro.props;
---
<div class:list={['vtabs', className]} data-vtabs>
  <nav class="vtabs__nav" aria-label={label}>
    <ul class="vtabs__list">
      {
        items.map((item) => (
          <li>
            <a href={`#${item.id}`} data-vtab={item.id}>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="vtabs__panels">
    {
      items.map((item) => (
        <section class="vtabs__panel" id={item.id} aria-label={item.label} data-vtab-panel>
          <slot name={item.id} />
        </section>
      ))
    }
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-vtabs]')) {
    const links = [...root.querySelectorAll<HTMLAnchorElement>('[data-vtab]')];
    const panels = [...root.querySelectorAll<HTMLElement>('[data-vtab-panel]')];
    if (panels.length === 0) continue;
    let current: string | null = null;
    // On phones the list is a row: scroll the row itself to the current name, never the window (a window
    // scroll would pull the page back to the row on every change and cancel a running anchor scroll).
    const reveal = (l: HTMLElement) => {
      const list = l.closest('ul');
      if (!list || list.scrollWidth <= list.clientWidth) return;
      const r = l.getBoundingClientRect();
      const lr = list.getBoundingClientRect();
      list.scrollBy({ left: r.left - lr.left - (lr.width - r.width) / 2 });
    };
    const pick = () => {
      const line = window.innerHeight * 0.4;
      let best = panels[0];
      for (const p of panels) {
        if (p.getBoundingClientRect().top <= line) best = p;
      }
      if (best.id === current) return;
      current = best.id;
      for (const l of links) {
        const on = l.dataset.vtab === current;
        if (on) l.setAttribute('aria-current', 'location');
        else l.removeAttribute('aria-current');
        if (on) reveal(l);
      }
    };
    window.addEventListener('scroll', pick, { passive: true });
    window.addEventListener('resize', pick);
    pick();
  }
</script>

<style>
  .vtabs {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem 4rem;
    align-items: start;
  }

  /* Neither column grows past its track: the phone row scrolls inside the gutter instead of widening the page. */
  .vtabs__nav,
  .vtabs__panels {
    min-width: 0;
  }

  @media (min-width: 60rem) {
    .vtabs {
      grid-template-columns: minmax(12rem, 1fr) minmax(0, 2.2fr);
    }

    .vtabs__nav {
      position: sticky;
      top: calc(var(--nav-h) + 4.5rem);
    }
  }

  .vtabs__list {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .vtabs__list::-webkit-scrollbar {
    display: none;
  }

  /* Phones: a scrollable row that bleeds to the screen's edges. */
  @media (width < 60rem) {
    .vtabs__list {
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      border-bottom: 1px solid var(--separator);
    }
  }

  .vtabs__list a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.9rem;
    color: var(--label-2);
    font-family: var(--font-serif);
    font-size: var(--t-ui);
    white-space: nowrap;
    text-decoration: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    transition:
      color var(--dur-1) ease,
      border-color var(--dur-1) ease;
  }

  .vtabs__list a[aria-current] {
    color: var(--label);
    border-bottom-color: var(--accent-text);
  }

  .vtabs__list a:hover {
    color: var(--label);
  }

  /* Regular screens: the reference's vertical list on a hairline rail, the current name marked on the rail. */
  @media (min-width: 60rem) {
    .vtabs__list {
      flex-direction: column;
      gap: 0;
      border-left: 1px solid var(--separator);
      overflow: visible;
    }

    .vtabs__list a {
      min-height: 40px;
      padding: 0 1rem;
      margin: 0;
      border-bottom: 0;
      border-left: 2px solid transparent;
      margin-left: -1px;
    }

    .vtabs__list a[aria-current] {
      border-left-color: var(--accent-text);
    }
  }

  .vtabs__panels {
    display: grid;
    gap: clamp(3rem, 2rem + 3vw, 5rem);
  }

  .vtabs__panel {
    /* An anchor lands under the sticky bars. */
    scroll-margin-top: calc(var(--nav-h) + 4rem);
    display: grid;
    gap: 1.25rem;
  }

  .vtabs__panel :global(.photo__frame) {
    border-radius: var(--r-card);
  }
</style>
