---
/** The older name of FaqAccordion, kept for pages that still import it. */
import FaqAccordion from './FaqAccordion.astro';

interface Props {
  items: { q: string; a: string }[];
  openFirst?: boolean;
}
const { items, openFirst = false } = Astro.props;
---
<FaqAccordion items={items} openFirst={openFirst} />
