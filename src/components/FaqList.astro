---
/** Questions and answers as an inset grouped list of native disclosure widgets (no script needed). */
interface Props {
  items: { q: string; a: string }[];
  openFirst?: boolean;
}
const { items, openFirst = false } = Astro.props;

// Keep the venue name on one line inside questions.
const NBSP = String.fromCharCode(160);
const keepTogether = (q: string) => q.replace(/The Venue at NCC/g, ['The', 'Venue', 'at', 'NCC'].join(NBSP));
---
<div class="faqs list-group">
  {
    items.map((item, i) => (
      <details class="faq" open={openFirst && i === 0}>
        <summary class="faq__q">
          <span>{keepTogether(item.q)}</span>
          <svg class="icon faq__chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="faq__a">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faqs {
    box-shadow: var(--shadow-1);
  }

  .faq {
    position: relative;
  }

  .faq + .faq::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1.25rem;
    right: 0;
    border-top: 1px solid var(--separator);
  }

  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 56px;
    padding: 0.9rem 1.25rem;
    font-weight: 600;
    font-size: var(--t-body);
    cursor: pointer;
    list-style: none;
  }

  .faq__q span {
    text-wrap: pretty;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__chev {
    color: var(--label-3);
    transition: transform var(--dur-2) var(--ease-spring);
  }

  .faq[open] .faq__chev {
    transform: rotate(180deg);
    color: var(--accent-text);
  }

  .faq__a {
    padding: 0 1.25rem 1.2rem;
    max-width: 62ch;
    color: var(--label-2);
  }
</style>
