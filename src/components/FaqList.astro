---
/** Questions and answers as an inset grouped list of native disclosure widgets (no script needed). */
interface Props {
  items: { q: string; a: string }[];
  openFirst?: boolean;
}
const { items, openFirst = false } = Astro.props;

// Keep "at NCC" on one line inside questions. The whole name would be too wide for a phone at 200% text.
const NBSP = String.fromCharCode(160);
const keepTogether = (q: string) => q.replace(/\bat NCC\b/g, `at${NBSP}NCC`);

// Phone numbers in answers, such as "(757) 555-0142", become tap-to-call links that never break across lines.
// split() with a capturing group keeps each number at an odd index.
const PHONE = /(\(\d{3}\) \d{3}-\d{4})/;
const telHref = (phone: string) => `tel:+1${phone.replace(/\D/g, '')}`;
const withPhoneLinks = (a: string) => a.split(PHONE);
---
<div class="faqs list-group">
  {
    items.map((item, i) => (
      <details class="faq" open={openFirst && i === 0}>
        <summary class="faq__q">
          <span>{keepTogether(item.q)}</span>
          <svg class="icon faq__chev" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </summary>
        <div class="faq__a">
          <p>{withPhoneLinks(item.a).map((part, j) => (j % 2 === 1 ? <a class="faq__tel" href={telHref(part)}>{part}</a> : part))}</p>
        </div>
      </details>
    ))
  }
</div>

<style>
  .faqs {
    box-shadow: var(--shadow-1);
  }

  .faq {
    position: relative;
  }

  .faq + .faq::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1.25rem;
    right: 0;
    border-top: 1px solid var(--separator);
  }

  .faq__q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: 56px;
    padding: 0.9rem 1.25rem;
    font-weight: 600;
    font-size: var(--t-body);
    cursor: pointer;
    list-style: none;
  }

  /* The question gives way to the chevron, and a word too long for the row breaks rather than overflowing. */
  .faq__q span {
    min-width: 0;
    text-wrap: pretty;
    overflow-wrap: anywhere;
  }

  .faq__chev {
    flex: none;
  }

  .faq__q::-webkit-details-marker {
    display: none;
  }

  .faq__chev {
    color: var(--label-3);
    transition: transform var(--dur-2) var(--ease-spring);
  }

  .faq[open] .faq__chev {
    transform: rotate(180deg);
    color: var(--accent-text);
  }

  .faq__a {
    padding: 0 1.25rem 1.2rem;
    max-width: 62ch;
    color: var(--label-2);
  }

  .faq__tel {
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
</style>
