---
/**
 * The reference's card carousel (redesign-spec.md, Carousel): a horizontal, scroll-snapping row of slotted
 * cards that starts at the container's left edge and bleeds to both screen edges, with a progress track of
 * dots and previous and next buttons beneath. `cols` sets how many cards show at once from 60rem
 * (2, 3 or 4); tablets show two; phones show one card at 82 percent of the width, swipeable. When every card fits, the controls
 * hide. The scrollbar is hidden; the buttons and the keyboard (the row is focusable) move it.
 */
interface Props {
  /** Cards across on regular screens (from 56rem): 2, 3 or 4. */
  cols?: 2 | 3 | 4;
  /** Accessible name of the row, e.g. "The spaces". */
  label: string;
  class?: string;
}

const { cols = 3, label, class: className } = Astro.props;
---
<div class:list={['carousel', className]} data-carousel style={`--cols: ${cols}`}>
  <div class="carousel__track" data-carousel-track tabindex="0" role="group" aria-label={label}>
    <slot />
  </div>
  <div class="carousel__controls" data-carousel-controls hidden>
    <div class="carousel__dots" data-carousel-dots aria-hidden="true"></div>
    <div class="carousel__arrows">
      <button type="button" class="btn-round" data-carousel-prev aria-label="Previous">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m15 18-6-6 6-6" /></svg>
      </button>
      <button type="button" class="btn-round" data-carousel-next aria-label="Next">
        <svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9 18 6-6-6-6" /></svg>
      </button>
    </div>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
    const track = root.querySelector<HTMLElement>('[data-carousel-track]')!;
    const controls = root.querySelector<HTMLElement>('[data-carousel-controls]')!;
    const dots = root.querySelector<HTMLElement>('[data-carousel-dots]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]')!;
    // Only the slotted cards: Astro can place a script or style element among them.
    const NOT_CARDS = new Set(['SCRIPT', 'STYLE', 'TEMPLATE', 'LINK']);
    const cards = () => [...track.children].filter((el): el is HTMLElement => el instanceof HTMLElement && !NOT_CARDS.has(el.tagName));

    const step = () => {
      const c = cards();
      return c.length > 1 ? c[1].offsetLeft - c[0].offsetLeft : track.clientWidth;
    };
    const index = () => Math.round(track.scrollLeft / Math.max(1, step()));
    const pages = () => Math.max(1, Math.ceil((track.scrollWidth - track.clientWidth) / Math.max(1, step())) + 1);

    function render() {
      const overflow = track.scrollWidth > track.clientWidth + 2;
      controls.hidden = !overflow;
      if (!overflow) return;
      const n = pages();
      const i = Math.min(n - 1, index());
      if (dots.childElementCount !== n) {
        dots.replaceChildren(...Array.from({ length: n }, () => Object.assign(document.createElement('span'), { className: 'carousel__dot' })));
      }
      [...dots.children].forEach((d, k) => d.classList.toggle('is-current', k === i));
      prev.disabled = track.scrollLeft <= 2;
      next.disabled = track.scrollLeft >= track.scrollWidth - track.clientWidth - 2;
    }

    const go = (dir: 1 | -1) => track.scrollBy({ left: dir * step(), behavior: 'smooth' });
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    track.addEventListener('scroll', render, { passive: true });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        go(1);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        go(-1);
      }
    });
    // A card that takes keyboard focus scrolls fully into view.
    track.addEventListener('focusin', (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>('[data-carousel-track] > *');
      if (card && track.scrollWidth > track.clientWidth) card.scrollIntoView({ block: 'nearest', inline: 'start' });
    });
    if ('ResizeObserver' in window) new ResizeObserver(render).observe(track);
    render();
  }
</script>

<style>
  .carousel {
    --gap: 1rem;
    display: grid;
    gap: 1.25rem;
  }

  /*
    The row bleeds past the container by one gutter on each side, so its first card lines up with the
    heading and the last card shows the screen's edge. Percentages resolve against the content box, the
    container's width, so `cols` cards fit exactly.
  */
  .carousel__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(82%, 22rem);
    gap: var(--gap);
    margin-inline: calc(-1 * var(--gutter));
    padding-inline: var(--gutter);
    scroll-padding-inline: var(--gutter);
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .carousel__track::-webkit-scrollbar {
    display: none;
  }

  .carousel__track > :global(*) {
    scroll-snap-align: start;
    min-width: 0;
  }

  .carousel__track:focus-visible {
    outline-offset: -3px;
  }

  /* Tablets: two cards across; from 60rem the number the page asks for. */
  @media (min-width: 46.5rem) {
    .carousel {
      --gap: 1.5rem;
    }

    .carousel__track {
      grid-auto-columns: calc((100% - var(--gap)) / 2);
    }
  }

  @media (min-width: 60rem) {
    .carousel__track {
      grid-auto-columns: calc((100% - (var(--cols) - 1) * var(--gap)) / var(--cols));
    }
  }

  .carousel__controls[hidden] {
    display: none;
  }

  .carousel__controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    max-width: 100%;
  }

  .carousel__dots {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    min-width: 0;
    overflow: hidden;
  }

  /* The reference's progress track: small dots, the current one a longer bar. The dots are made by script. */
  .carousel__dots :global(.carousel__dot) {
    width: 6px;
    height: 6px;
    border-radius: var(--r-full);
    background: var(--separator-strong);
    transition:
      width var(--dur-2) var(--ease-out),
      background-color var(--dur-2) ease;
  }

  .carousel__dots :global(.carousel__dot.is-current) {
    width: 28px;
    background: var(--label);
  }

  .carousel__arrows {
    display: flex;
    gap: 0.5rem;
  }
</style>
