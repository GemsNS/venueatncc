---
/**
 * The closing call to action on a light Ice-tinted band (--band; Navy in dark mode): a Caslon heading, one
 * sentence, and one Check Availability button. It is the one place that says how booking works (brand.md,
 * "Redundancy rules"), so it carries no second button and no contact line: the header links the other pages
 * and the footer lists the phone. Plain color, no imagery. On the Ice tint the heading is Navy (12.0:1), the
 * sentence Slate (6.0:1), and the button the site's Deep Blue fill with a white label (9.4:1); in dark mode
 * the light text, Ice, and the Sky button on Navy.
 * The section stays the last child of <main>; the footer's top hairline separates the two.
 */
import Icon from './Icon.astro';
import { bookHref as defaultBookHref } from '../data/nav';
import { href } from '../lib/paths';

interface Props {
  heading?: string;
  body?: string;
  /** Where Check Availability goes, as a base-relative path. Event pages pass /book/?event=<slug>. */
  bookHref?: string;
}

const {
  heading = 'See which dates are open.',
  body = 'Choose a date and a space, and send your request in about two minutes. We confirm every booking personally.',
  bookHref = defaultBookHref,
} = Astro.props;
---
<section class="cta" aria-labelledby="cta-heading">
  <div class="container cta__inner">
    <div class="cta__copy">
      <h2 id="cta-heading" class="t-large-title">{heading}</h2>
      <p class="cta__body">{body}</p>
    </div>
    <div class="cta__side">
      <a class="btn btn--filled btn--lg cta__action" href={href(bookHref)}>
        <Icon name="calendar" />
        Check Availability
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--band);
    color: var(--label);
    border-top: 1px solid var(--separator);
  }

  .cta__inner {
    display: grid;
    gap: 2rem 4rem;
    padding-block: clamp(4rem, 3rem + 4vw, 6.5rem);
  }

  @media (min-width: 64rem) {
    .cta__inner {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: end;
    }
  }

  .cta__copy {
    display: grid;
    gap: 1rem;
  }

  .cta h2 {
    color: var(--label);
    max-width: 18ch;
  }

  .cta__body {
    max-width: 38rem;
    color: var(--label-2);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.5;
  }

  .cta__side {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  /* Beside the copy, the button meets the container's right edge on the heading's last row. */
  @media (min-width: 64rem) {
    .cta__side {
      justify-items: end;
    }
  }

  /* Phones: the button spans the band, like a stacked button row. */
  @media (max-width: 479.98px) {
    .cta__action {
      justify-self: stretch;
    }
  }

  @media (forced-colors: active) {
    .cta {
      border-block: 1px solid CanvasText;
    }
  }
</style>
