---
/**
 * Closing call to action on a Deep Plum band: a Caslon heading, one sentence, and two actions.
 * Plain color, no imagery. White text on Deep Plum is 16:1; Lilac is 8.6:1.
 */
import Icon from './Icon.astro';
import { site } from '../data/site';
import { bookHref, pricingHref } from '../data/nav';
import { href, withoutBase } from '../lib/paths';

interface Link {
  label: string;
  href: string;
}

interface Props {
  heading?: string;
  body?: string;
  /** The second button. Defaults to See Pricing, or Read the FAQ on the pricing page itself. */
  secondary?: Link;
}

const path = withoutBase(Astro.url.pathname);
const {
  heading = 'See which dates are open.',
  body = 'Choose a date and a space, see an instant estimate, and send your request in about two minutes. We confirm every booking personally.',
  secondary = path === pricingHref ? { label: 'Read the FAQ', href: '/faq/' } : { label: 'See Pricing', href: pricingHref },
} = Astro.props;
// Never link to the page the visitor is already on.
const showSecondary = secondary.href !== path;
---
<section class="cta" aria-labelledby="cta-heading">
  <div class="container cta__inner">
    <div class="cta__copy">
      <h2 id="cta-heading" class="t-large-title">{heading}</h2>
      <p class="cta__body">{body}</p>
    </div>
    <div class="cta__side">
      <div class="btn-row btn-row--stack cta__actions">
        <a class="btn btn--white btn--lg" href={href(bookHref)}>
          <Icon name="calendar" />
          Check Availability
        </a>
        {showSecondary && <a class="btn btn--outline-white btn--lg" href={href(secondary.href)}>{secondary.label}</a>}
      </div>
      <p class="cta__call">
        Prefer to talk? <a href={`tel:${site.contact.phoneE164}`}>Call {site.contact.phone}</a>
      </p>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--brand-deep);
    color: var(--on-deep);
  }

  /* Dark mode: Deep Plum sits close to the page color, so a faint lilac hairline marks where the band begins. */
  @media (prefers-color-scheme: dark) {
    .cta {
      border-top: 1px solid rgb(205 179 238 / 0.14);
    }
  }

  .cta__inner {
    display: grid;
    gap: 2rem 4rem;
    padding-block: clamp(4rem, 3rem + 4vw, 6.5rem);
  }

  @media (min-width: 64rem) {
    .cta__inner {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: end;
    }
  }

  .cta__copy {
    display: grid;
    gap: 1rem;
  }

  .cta h2 {
    color: #ffffff;
    max-width: 18ch;
  }

  .cta__body {
    max-width: 38rem;
    color: var(--on-deep-2);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.5;
  }

  .cta__side {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  /* Full width, so the stacked buttons on phones span the band. */
  .cta__actions {
    justify-self: stretch;
  }

  .cta__call {
    font-size: var(--t-subhead);
    color: var(--on-deep-2);
  }

  .cta__call a {
    color: #ffffff;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cta :global(:focus-visible) {
    outline-color: #ffffff;
  }

  @media (forced-colors: active) {
    .cta {
      border-block: 1px solid CanvasText;
    }
  }
</style>
