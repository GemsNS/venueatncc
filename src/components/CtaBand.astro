---
/** Closing call to action on a deep purple band lit by the luminous scene. */
import ArchScene from './ArchScene.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { bookHref, pricingHref } from '../data/nav';
import { href } from '../lib/paths';

interface Props {
  heading?: string;
  body?: string;
}
const {
  heading = 'Your date is a few taps away.',
  body = 'See what is open, get an instant estimate, and send your request in about two minutes. We confirm every booking personally.',
} = Astro.props;
---
<section class="cta" aria-labelledby="cta-heading">
  <div class="cta__bg" aria-hidden="true">
    <ArchScene variant={2} width={1200} height={520} />
  </div>
  <div class="container cta__inner">
    <h2 id="cta-heading" class="t-large-title">{heading}</h2>
    <p class="cta__body">{body}</p>
    <div class="btn-row cta__actions">
      <a class="btn btn--white btn--lg" href={href(bookHref)}>
        <Icon name="calendar" />
        Check Availability
      </a>
      <a class="btn btn--glass btn--lg cta__glass" href={href(pricingHref)}>See Pricing</a>
    </div>
    <p class="cta__call">
      Prefer to talk? <a href={`tel:${site.contact.phoneE164}`}>Call {site.contact.phone}</a>
    </p>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: var(--on-night);
    background: var(--night);
  }

  .cta__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cta__inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding-block: clamp(4.5rem, 3rem + 6vw, 8rem);
    text-align: center;
  }

  .cta h2 {
    color: #ffffff;
    max-width: 18ch;
  }

  .cta__body {
    max-width: 40rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    color: rgba(255, 255, 255, 0.86);
  }

  .cta__actions {
    justify-content: center;
    margin-top: 0.5rem;
  }

  .cta__glass {
    color: #ffffff;
    background-color: rgba(255, 255, 255, 0.16);
    border-color: rgba(255, 255, 255, 0.35);
  }

  .cta__glass:hover {
    background-color: rgba(255, 255, 255, 0.24);
  }

  .cta__call {
    font-size: var(--t-subhead);
    color: rgba(255, 255, 255, 0.8);
  }

  .cta__call a {
    color: #ffffff;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cta :global(:focus-visible) {
    outline-color: #ffffff;
  }
</style>
