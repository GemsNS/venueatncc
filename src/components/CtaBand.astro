---
/**
 * The closing call to action on a Deep Olive band: a Caslon heading, one sentence, and one Check Availability
 * button. It is the one place that says how booking works (brand.md, "Redundancy rules"), so it carries no
 * second button and no contact line: the header links the other pages and the footer lists the phone.
 * Plain color, no imagery. Cream text on Deep Olive is 11.1:1; the Caramel button keeps Ink text (6.3:1).
 * The section stays the last child of <main>, which is how the footer knows to meet it with a hairline.
 */
import Icon from './Icon.astro';
import { bookHref as defaultBookHref } from '../data/nav';
import { href } from '../lib/paths';

interface Props {
  heading?: string;
  body?: string;
  /** Where Check Availability goes, as a base-relative path. Event pages pass /book/?event=<slug>. */
  bookHref?: string;
}

const {
  heading = 'See which dates are open.',
  body = 'Choose a date and a space, see an instant estimate, and send your request in about two minutes. We confirm every booking personally.',
  bookHref = defaultBookHref,
} = Astro.props;
---
<section class="cta" aria-labelledby="cta-heading">
  <div class="container cta__inner">
    <div class="cta__copy">
      <h2 id="cta-heading" class="t-large-title">{heading}</h2>
      <p class="cta__body">{body}</p>
    </div>
    <div class="cta__side">
      <a class="btn btn--filled btn--lg cta__action" href={href(bookHref)}>
        <Icon name="calendar" />
        Check Availability
      </a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--olive-deep);
    color: var(--on-deep);
  }

  /* Dark mode: Deep Olive sits close to the page color, so a faint sage hairline marks where the band begins. */
  @media (prefers-color-scheme: dark) {
    .cta {
      border-top: 1px solid var(--on-deep-line);
    }
  }

  .cta__inner {
    display: grid;
    gap: 2rem 4rem;
    padding-block: clamp(4rem, 3rem + 4vw, 6.5rem);
  }

  @media (min-width: 64rem) {
    .cta__inner {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: end;
    }
  }

  .cta__copy {
    display: grid;
    gap: 1rem;
  }

  .cta h2 {
    color: var(--on-deep);
    max-width: 18ch;
  }

  .cta__body {
    max-width: 38rem;
    color: var(--on-deep-2);
    font-size: clamp(1.0625rem, 1rem + 0.3vw, 1.1875rem);
    line-height: 1.5;
  }

  .cta__side {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  /* Phones: the button spans the band, like a stacked button row. */
  @media (max-width: 479.98px) {
    .cta__action {
      justify-self: stretch;
    }
  }

  .cta :global(:focus-visible) {
    outline-color: var(--on-deep);
  }

  @media (forced-colors: active) {
    .cta {
      border-block: 1px solid CanvasText;
    }
  }
</style>
