---
/**
 * Closing call to action on a deep purple band lit by the luminous scene.
 * A scrim darkens the band's lower half, where the scene's glow is brightest, so the white text,
 * the glass button and the white focus ring all keep their contrast.
 */
import ArchScene from './ArchScene.astro';
import Icon from './Icon.astro';
import { site } from '../data/site';
import { bookHref, pricingHref } from '../data/nav';
import { href, withoutBase } from '../lib/paths';

interface Link {
  label: string;
  href: string;
}

interface Props {
  heading?: string;
  body?: string;
  /** The second button. Defaults to See Pricing, or Read the FAQ on the pricing page itself. */
  secondary?: Link;
}

const path = withoutBase(Astro.url.pathname);
// A non-breaking space keeps "a few" together, so the default heading breaks before it.
const nbsp = String.fromCharCode(160);
const {
  heading = `Your date is a${nbsp}few taps away.`,
  body = 'See what is open, get an instant estimate, and send your request in about two minutes. We confirm every booking personally.',
  secondary = path === pricingHref ? { label: 'Read the FAQ', href: '/faq/' } : { label: 'See Pricing', href: pricingHref },
} = Astro.props;
// Never link to the page the visitor is already on.
const showSecondary = secondary.href !== path;
---
<section class="cta" aria-labelledby="cta-heading">
  <div class="cta__bg" aria-hidden="true">
    <ArchScene variant={2} width={1200} height={520} />
  </div>
  <div class="container cta__inner">
    <h2 id="cta-heading" class="t-large-title">{heading}</h2>
    <p class="cta__body">{body}</p>
    <div class="btn-row cta__actions">
      <a class="btn btn--white btn--lg" href={href(bookHref)}>
        <Icon name="calendar" />
        Check Availability
      </a>
      {showSecondary && <a class="btn btn--glass btn--lg cta__glass" href={href(secondary.href)}>{secondary.label}</a>}
    </div>
    <p class="cta__call">
      Prefer to talk? <a href={`tel:${site.contact.phoneE164}`}>Call {site.contact.phone}</a>
    </p>
  </div>
</section>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: var(--on-night);
    background: var(--night);
  }

  .cta__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  /* Scrim: the scene's pale glow sits low in the band, right behind the buttons and the call line. */
  .cta__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      color-mix(in srgb, var(--night) 88%, transparent) 0%,
      color-mix(in srgb, var(--night) 55%, transparent) 45%,
      transparent 80%
    );
  }

  /* In dark mode the band settles fully into night at its lower edge, next to the dark footer. */
  @media (prefers-color-scheme: dark) {
    .cta__bg::after {
      background: linear-gradient(
        to top,
        var(--night) 0%,
        color-mix(in srgb, var(--night) 60%, transparent) 45%,
        transparent 80%
      );
    }
  }

  .cta__inner {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    padding-block: clamp(4.5rem, 3rem + 6vw, 8rem);
    text-align: center;
  }

  .cta h2 {
    color: #ffffff;
    max-width: 18ch;
  }

  .cta__body {
    max-width: 40rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    color: #ffffff;
  }

  .cta__actions {
    justify-content: center;
    margin-top: 0.5rem;
  }

  /* Glass over bright media is dimmed (HIG); here it is a dark night tint with a white edge. */
  .cta__glass {
    color: #ffffff;
    background-color: color-mix(in srgb, var(--night) 55%, transparent);
    border-color: #ffffff;
  }

  .cta__glass:hover {
    background-color: color-mix(in srgb, var(--night) 70%, transparent);
  }

  .cta__call {
    font-size: var(--t-subhead);
    color: #ffffff;
  }

  .cta__call a {
    color: #ffffff;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .cta :global(:focus-visible) {
    outline-color: #ffffff;
  }
</style>
