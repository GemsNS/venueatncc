---
/**
 * The closing band (redesign-spec.md, CtaBand): a heading, one sentence, and one filled Check Availability on
 * Petal, with a hairline above. It is the one place that says how booking
 * works (brand.md, "Redundancy rules"), so it carries no second button and no contact line: the footer
 * lists the phone. The section stays the last child of <main>.
 */
import { bookHref as defaultBookHref } from '../data/nav';
import { href } from '../lib/paths';

interface Props {
  heading?: string;
  body?: string;
  /** Where Check Availability goes, as a base-relative path. Event pages pass /book/?event=<slug>. */
  bookHref?: string;
}

const {
  heading = 'See which dates are open',
  body = 'Choose a date and a space, and send your request in about two minutes. We confirm every booking personally.',
  bookHref = defaultBookHref,
} = Astro.props;
---
<section class="cta band-section" aria-labelledby="cta-heading">
  <div class="container cta__inner">
    <div class="cta__copy">
      <h2 id="cta-heading">{heading}</h2>
      <p class="cta__body t-lead">{body}</p>
    </div>
    <div class="cta__side">
      <a class="btn btn--filled btn--lg cta__action" href={href(bookHref)}>Check Availability</a>
    </div>
  </div>
</section>

<style>
  .cta {
    background: var(--band);
    color: var(--label);
  }

  .cta__inner {
    display: grid;
    gap: 1.75rem 4rem;
    padding-block: clamp(3.5rem, 2.5rem + 4vw, 6rem);
  }

  @media (min-width: 64rem) {
    .cta__inner {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: center;
    }
  }

  .cta__copy {
    display: grid;
    gap: 1rem;
  }

  .cta h2 {
    max-width: 18ch;
    line-height: 1.08;
  }

  .cta__body {
    max-width: 36rem;
    color: var(--label-2);
  }

  .cta__side {
    display: grid;
    justify-items: start;
  }

  @media (min-width: 64rem) {
    .cta__side {
      justify-items: end;
    }
  }

  /* Phones: the button spans the band, like a stacked button row. */
  @media (max-width: 479.98px) {
    .cta__action {
      justify-self: stretch;
    }
  }

  @media (forced-colors: active) {
    .cta {
      border-block: 1px solid CanvasText;
    }
  }
</style>
