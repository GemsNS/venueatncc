---
import { site } from '../data/site';
import { bookHref } from '../data/nav';

const onBook = Astro.url.pathname.startsWith(bookHref);
---
<div class:list={['call-bar', { 'call-bar--single': onBook }]} role="region" aria-label="Quick contact">
  <a class="call-bar__call" href={`tel:${site.contact.phoneE164}`}>Call us</a>
  {!onBook && <a class="call-bar__book" href={bookHref}>Check your date</a>}
</div>

<style>
  .call-bar {
    display: none;
  }

  @media (max-width: 719.98px) {
    .call-bar {
      position: fixed;
      inset: auto 0 0 0;
      z-index: 40;
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 0.5rem;
      padding: 0.6rem var(--gutter) calc(0.6rem + env(safe-area-inset-bottom));
      background: rgba(255, 255, 255, 0.97);
      border-top: 1px solid var(--line);
      box-shadow: 0 -10px 24px -18px rgba(20, 32, 60, 0.5);
    }

    .call-bar--single {
      grid-template-columns: 1fr;
    }

    /* The open menu already offers both actions. */
    :global(.site-header[data-open]) ~ .call-bar {
      display: none;
    }

    .call-bar a {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      border-radius: var(--radius);
      font-weight: 600;
      text-decoration: none;
    }

    .call-bar__call {
      border: 1.5px solid var(--navy);
      color: var(--navy);
    }

    .call-bar__book {
      background: var(--navy);
      color: var(--on-dark);
    }

    :global(body) {
      padding-bottom: calc(72px + env(safe-area-inset-bottom));
    }
  }
</style>
