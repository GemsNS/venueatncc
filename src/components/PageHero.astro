---
/**
 * The inner-page hero (redesign-spec.md, PageHero; the reference's venue page): a full-bleed photograph
 * (the 4:5 file on phones, never cropped into its subject) with a Plum bottom scrim and a rounded, translucent
 * caption panel bottom-left holding an eyebrow, the h1, an optional line of descriptors, and up to three
 * facts (LABEL / value columns; on phones LABEL: value rows, as the reference's mobile venue page sets
 * them). The photo is the page's main image and loads first. A staged photo keeps its badge.
 *
 * `phone="stack"` is for a photo that has no portrait file (the staged event photos, 3:2 only): cover-
 * cropping it into a tall phone frame would cut its scene off at the sides (brand.md, "No cropped
 * subjects"), so below 46.5rem the photo is shown whole, full bleed at its own shape, and the caption sits
 * on the page beneath it in the page's own colors (the way the reference's venues index titles its phone
 * page). From 46.5rem both modes are the same overlay hero.
 */
import Photo from './Photo.astro';
import type { VenuePhoto } from '../data/photos';

interface Props {
  photo: VenuePhoto;
  id: string;
  title: string;
  eyebrow?: string;
  descriptors?: string[];
  facts?: { label: string; value: string }[];
  /**
   * Height of the band on regular screens, as a CSS length. The default fills the screen under the bar, as
   * the reference's venue page does, but never exceeds the 3:2 photo's own height at that width, so a photo
   * whose subject spans its height (the gazebo) keeps its roof and its base on a 1440 x 900 screen.
   */
  height?: string;
  /** Phones: the caption over the portrait photo (default), or the whole photo with the caption beneath. */
  phone?: 'overlay' | 'stack';
  class?: string;
}

const {
  photo,
  id,
  title,
  eyebrow,
  descriptors = [],
  facts = [],
  height = 'min(calc(100svh - var(--nav-h)), 66.67vw)',
  phone = 'overlay',
  class: className,
} = Astro.props;

/*
  Phones: the 4:5 file covers a band at least max(30rem, 80svh) tall (the phone rule below), so it is drawn
  0.8 times that height wide, wider than the screen on most phones.
*/
const PHONE_SIZES = 'max(100vw, 64vh, 24rem)';
---
<section class:list={['phero', className]} aria-labelledby={id} style={`--phero-h: ${height}`} data-phone={phone}>
  <div class="phero__media">
    <Photo photo={photo} ratio="fill" tall rounded={false} priority sizes="100vw" tallSizes={PHONE_SIZES} caption={false} class="phero__photo" />
    <div class="phero__scrim" aria-hidden="true"></div>
  </div>
  <div class="container phero__inner">
    <div class="phero__panel">
      {eyebrow && <p class="phero__eyebrow">{eyebrow}</p>}
      <h1 id={id} class="phero__title">{title}</h1>
      {
        descriptors.length > 0 && (
          <p class="phero__descriptors">
            {descriptors.map((d, i) => (
              <>
                {i > 0 && <span class="phero__dot" aria-hidden="true">·</span>}
                <span>{d}</span>
              </>
            ))}
          </p>
        )
      }
      {
        facts.length > 0 && (
          <dl class="phero__facts">
            {facts.map((f) => (
              <div class="phero__fact">
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <slot />
    </div>
  </div>
</section>

<style>
  .phero {
    position: relative;
    display: grid;
    align-items: end;
    min-height: max(28rem, var(--phero-h));
    isolation: isolate;
    color: var(--white);
  }

  .phero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--panel);
  }

  .phero__media :global(.phero__photo),
  .phero__media :global(.phero__photo .photo__frame) {
    height: 100%;
  }

  /* The Plum scrim under the panel: white type keeps 4.5:1 over any frame. */
  .phero__scrim {
    position: absolute;
    inset: 30% 0 0;
    background: linear-gradient(to bottom, rgb(var(--scrim-rgb) / 0), rgb(var(--scrim-rgb) / 0.62));
    pointer-events: none;
  }

  .phero__inner {
    position: relative;
    z-index: 1;
    padding-block: 1.25rem;
  }

  /* The reference's caption box: rounded, translucent Plum, blurred behind. */
  .phero__panel {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    max-width: 34rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border-radius: var(--r-xl);
    background: rgb(var(--scrim-rgb) / 0.55);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
  }

  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .phero__panel {
      background: rgb(var(--scrim-rgb) / 0.92);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .phero__eyebrow {
    font-family: var(--font-serif);
    font-size: var(--t-footnote);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--on-dark-accent);
  }

  .phero__title {
    color: var(--white);
    font-size: var(--t-large-title);
    line-height: 1.05;
  }

  .phero__descriptors {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    font-family: var(--font-serif);
    font-size: var(--t-headline);
    color: var(--on-dark-2);
  }

  .phero__dot {
    opacity: 0.7;
  }

  .phero__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, auto));
    gap: 0.75rem 2rem;
    width: 100%;
    margin: 0.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid rgba(255, 255, 255, 0.35);
  }

  .phero__fact {
    display: grid;
    gap: 0.2rem;
  }

  .phero__fact dt {
    font-family: var(--font-serif);
    font-size: var(--t-caption);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark-2);
  }

  .phero__fact dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--t-headline);
    color: var(--white);
  }

  /* A link inside the panel takes the panel's color: white over the photo, Plum on the page. */
  .phero__panel :global(.link-more) {
    color: inherit;
  }

  .phero__panel :global(.link-more:focus-visible) {
    outline-color: var(--on-dark-accent);
    outline-offset: 4px;
  }

  @media (width < 46.5rem) {
    .phero {
      min-height: max(30rem, 80svh);
    }

    .phero__panel {
      max-width: none;
      width: 100%;
    }

    /*
      Facts as LABEL: value rows, so three fit without the panel climbing over the photo. The label and the
      value run on as one line of text, so a long value ("Nine to twelve months") wraps under the label
      instead of hanging in a second column.
    */
    .phero__facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }

    .phero__fact {
      display: block;
    }

    .phero__fact dt,
    .phero__fact dd {
      display: inline;
    }

    .phero__fact dt::after {
      content: ':';
      letter-spacing: 0;
      margin-right: 0.4em;
    }

    /* ---------- phone="stack": the photo whole, then the caption on the page ---------- */

    .phero[data-phone='stack'] {
      display: block;
      min-height: 0;
      color: var(--label);
    }

    .phero[data-phone='stack'] .phero__media {
      position: relative;
      inset: auto;
      z-index: auto;
    }

    .phero[data-phone='stack'] .phero__media :global(.phero__photo),
    .phero[data-phone='stack'] .phero__media :global(.phero__photo .photo__frame) {
      height: auto;
    }

    .phero[data-phone='stack'] .phero__media :global(.phero__photo .photo__frame) {
      aspect-ratio: 3 / 2;
    }

    .phero[data-phone='stack'] .phero__scrim {
      display: none;
    }

    .phero[data-phone='stack'] .phero__inner {
      padding-block: 1.75rem 0;
    }

    .phero[data-phone='stack'] .phero__panel {
      padding: 0;
      border-radius: 0;
      background: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    .phero[data-phone='stack'] .phero__eyebrow {
      color: var(--accent-text);
    }

    .phero[data-phone='stack'] .phero__title {
      color: var(--label);
    }

    .phero[data-phone='stack'] .phero__descriptors {
      color: var(--label-2);
    }

    .phero[data-phone='stack'] .phero__facts {
      border-top-color: var(--separator);
    }

    .phero[data-phone='stack'] .phero__fact dt {
      color: var(--label-2);
    }

    .phero[data-phone='stack'] .phero__fact dd {
      color: var(--label);
    }

    .phero[data-phone='stack'] .phero__panel :global(.link-more:focus-visible) {
      outline-color: var(--focus-ring);
    }
  }
</style>
