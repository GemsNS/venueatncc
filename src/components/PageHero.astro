---
/**
 * The inner-page hero (redesign-spec.md, PageHero; the reference's venue page): a full-bleed photograph
 * (the 4:5 file on phones, never cropped into its subject) with a rounded, see-through caption panel
 * bottom-left holding an eyebrow, the h1, an optional line of descriptors, and up to three facts (LABEL /
 * value columns; on phones LABEL: value rows, as the reference's mobile venue page sets them). The photo is
 * the page's main image and loads first. A staged photo keeps its badge.
 *
 * The panel is frosted glass (brand.md, version 6, "Caption panels over photos"): White at `frost` opacity
 * over the photo, blurred (12px, saturate 1.2), with a white hairline, so the photo shows through it. Every
 * line in the panel is Plum: Cerise and Mauve need a near-solid panel to keep 4.5:1 over a dark photo, and
 * Plum lets the panel stay see-through. The text over the composited panel is measured per photo at 390,
 * 768, 1024 and 1440 (the panel screenshotted with its text hidden, the pixels behind each line sampled), and
 * each page passes the lowest opacity at which every line keeps 4.5:1. Without backdrop-filter, and under reduced transparency
 * or increased contrast, the panel is near-solid White.
 *
 * `phone="stack"` is for a photo that has no portrait file (the staged event photos, 3:2 only): cover-
 * cropping it into a tall phone frame would cut its scene off at the sides (brand.md, "No cropped
 * subjects"), so below 46.5rem the photo is shown whole, full bleed at its own shape, and the caption sits
 * on the page beneath it in the page's own colors (the way the reference's venues index titles its phone
 * page). From 46.5rem both modes are the same overlay hero.
 */
import Photo from './Photo.astro';
import type { VenuePhoto } from '../data/photos';

type Frost = { phone: number; wide: number };

/**
 * The caption panel's opacity per hero photo. Two floors apply, and each photo takes the higher:
 *
 * - Legibility: the lowest opacity that keeps every line of Plum at 4.5:1 or better over the composited
 *   panel (worst pixel at the 2nd percentile) at 390, 768, 1024 and 1440 wide and on the common phone
 *   screens 320 x 568, 360 x 640, 375 x 667 and 412 x 915 (the 4:5 cover crop shifts with screen height),
 *   plus a step of margin where the lowest passing value was within 0.2 of 4.5:1.
 * - Appearance: 0.62. Below it, over a dark photo (the outdoor scenes, the gazebo, The Main Hall), the panel
 *   composites to a grey or khaki box rather than white glass; at 0.62 it still lets the photo through and
 *   reads as frosted White. Bright rooms pass both floors lower and keep their lower values.
 *
 * Phones only see the overlay over a photo with a portrait file; the staged event photos stack their caption
 * under the photo there. A photo not listed gets 0.65, which passes over every hero photo measured.
 * brand.md, "Caption panels over photos", lists the measured ratios.
 */
// 2026-10-01: the client found the panels still opaque, so every panel is now White at 0.3 over a brightened
// blur, and each line carries a White glow (below) for legibility where the photo behind it is dark.
const FROST: Record<string, Frost> = {
  'main-hall': { phone: 0.3, wide: 0.3 },
  'styled-wedding-indoor-ceremony': { phone: 0.3, wide: 0.3 },
  'styled-event-weddings': { phone: 0.3, wide: 0.3 },
  'styled-event-receptions-banquets': { phone: 0.3, wide: 0.3 },
  'styled-event-baby-bridal-showers': { phone: 0.3, wide: 0.3 },
  'styled-event-birthday-parties': { phone: 0.3, wide: 0.3 },
  'styled-event-repasts-memorials': { phone: 0.3, wide: 0.3 },
  'styled-event-meetings-trainings': { phone: 0.3, wide: 0.3 },
  'styled-event-graduations-reunions': { phone: 0.3, wide: 0.3 },
  'styled-event-community-events': { phone: 0.3, wide: 0.3 },
  gazebo: { phone: 0.3, wide: 0.3 },
};
const FROST_DEFAULT: Frost = { phone: 0.3, wide: 0.3 };

interface Props {
  photo: VenuePhoto;
  id: string;
  title: string;
  eyebrow?: string;
  descriptors?: string[];
  facts?: { label: string; value: string }[];
  /**
   * Height of the band on regular screens, as a CSS length. The default fills the screen under the bar, as
   * the reference's venue page does, but never exceeds the 3:2 photo's own height at that width, so a photo
   * whose subject spans its height (the gazebo) keeps its roof and its base on a 1440 x 900 screen.
   */
  height?: string;
  /** Phones: the caption over the portrait photo (default), or the whole photo with the caption beneath. */
  phone?: 'overlay' | 'stack';
  /**
   * The caption panel's White opacity over the photo, below 46.5rem and from 46.5rem (phones see the
   * portrait file). Defaults to the measured value for the photo (FROST below).
   */
  frost?: Frost;
  class?: string;
}

const {
  photo,
  id,
  title,
  eyebrow,
  descriptors = [],
  facts = [],
  height = 'min(calc(100svh - var(--nav-h)), 66.67vw)',
  phone = 'overlay',
  frost: frostProp,
  class: className,
} = Astro.props;
const frost = frostProp ?? FROST[photo.name] ?? FROST_DEFAULT;

/*
  Phones: the 4:5 file covers a band at least max(30rem, 80svh) tall (the phone rule below), so it is drawn
  0.8 times that height wide: 64vh on a screen narrower than 16:25 (most phones), at least 24rem, else the
  screen's width. Written as media conditions rather than max(), which not every browser accepts in sizes;
  a browser that dropped it would fall back to 100vw and fetch a file below the hero's size.
*/
const PHONE_SIZES = '(max-aspect-ratio: 16/25) and (min-height: 37.5rem) 64vh, (max-aspect-ratio: 16/25) 24rem, 100vw';
---
<section class:list={['phero', className]} aria-labelledby={id} style={`--phero-h: ${height}; --frost-phone: ${frost.phone}; --frost-wide: ${frost.wide}`} data-phone={phone}>
  <div class="phero__media">
    <Photo photo={photo} ratio="fill" tall rounded={false} priority sizes="100vw" tallSizes={PHONE_SIZES} caption={false} class="phero__photo" />
  </div>
  <div class="container phero__inner">
    <div class="phero__panel">
      {eyebrow && <p class="phero__eyebrow">{eyebrow}</p>}
      <h1 id={id} class="phero__title">{title}</h1>
      {
        descriptors.length > 0 && (
          <p class="phero__descriptors">
            {descriptors.map((d, i) => (
              <>
                {i > 0 && <span class="phero__dot" aria-hidden="true">·</span>}
                <span>{d}</span>
              </>
            ))}
          </p>
        )
      }
      {
        facts.length > 0 && (
          <dl class="phero__facts">
            {facts.map((f) => (
              <div class="phero__fact">
                <dt>{f.label}</dt>
                <dd>{f.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      <slot />
    </div>
  </div>
</section>

<style>
  .phero {
    --frost-alpha: var(--frost-phone);
    position: relative;
    display: grid;
    align-items: end;
    min-height: max(28rem, var(--phero-h));
    isolation: isolate;
    color: var(--label);
  }

  @media (min-width: 46.5rem) {
    .phero {
      --frost-alpha: var(--frost-wide);
    }
  }

  .phero__media {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: var(--panel);
  }

  .phero__media :global(.phero__photo),
  .phero__media :global(.phero__photo .photo__frame) {
    height: 100%;
  }

  .phero__inner {
    position: relative;
    z-index: 1;
    padding-block: 1.25rem;
  }

  /*
    The reference's caption box, made see-through: White at --frost-alpha, the photo blurred and slightly
    saturated behind it, a white hairline, and a soft shadow so its edge reads over a light photo.
  */
  .phero__panel {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    max-width: 34rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border: 1px solid var(--frost-border);
    border-radius: var(--r-xl);
    background: rgb(255 255 255 / var(--frost-alpha));
    -webkit-backdrop-filter: var(--frost-blur);
    backdrop-filter: var(--frost-blur);
    box-shadow: 0 8px 32px rgb(var(--ink-rgb) / 0.08);
  }

  /*
    The panel is mostly clear, so each line carries its own soft White glow: the photo shows through the panel,
    and the glow keeps Plum text at 4.5:1 or better where the photo behind it is dark.
  */
  .phero__panel > :global(*) {
    text-shadow: 0 0 2px rgb(255 255 255), 0 0 8px rgb(255 255 255 / 0.95), 0 0 18px rgb(255 255 255 / 0.8);
  }

  /* No backdrop-filter: the photo is not blurred, so the panel is near-solid White to keep the text legible. */
  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .phero__panel {
      background: rgb(255 255 255 / 0.9);
    }
  }

  @media (prefers-reduced-transparency: reduce), (prefers-contrast: more) {
    .phero__panel {
      background: rgb(255 255 255 / 0.96);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }

  .phero__eyebrow {
    font-family: var(--font-serif);
    font-size: var(--t-footnote);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--label);
  }

  .phero__title {
    color: var(--label);
    font-size: var(--t-large-title);
    line-height: 1.05;
  }

  .phero__descriptors {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    font-family: var(--font-serif);
    font-size: var(--t-headline);
    color: var(--label);
  }

  .phero__dot {
    color: var(--label);
  }

  .phero__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, auto));
    gap: 0.75rem 2rem;
    width: 100%;
    margin: 0.5rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid var(--separator-strong);
  }

  .phero__fact {
    display: grid;
    gap: 0.2rem;
  }

  .phero__fact dt {
    font-family: var(--font-serif);
    font-size: var(--t-caption);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--label);
  }

  .phero__fact dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--t-headline);
    color: var(--label);
  }

  /* A link inside the panel takes the panel's Plum. */
  .phero__panel :global(.link-more) {
    color: inherit;
  }

  .phero__panel :global(.link-more:focus-visible) {
    outline-color: var(--focus-ring);
    outline-offset: 4px;
  }

  @media (forced-colors: active) {
    .phero__panel {
      border-color: CanvasText;
    }
  }

  @media (width < 46.5rem) {
    .phero {
      min-height: max(30rem, 80svh);
    }

    .phero__panel {
      max-width: none;
      width: 100%;
    }

    /*
      Facts as LABEL: value rows, so three fit without the panel climbing over the photo. The label and the
      value run on as one line of text, so a long value ("Nine to twelve months") wraps under the label
      instead of hanging in a second column.
    */
    .phero__facts {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }

    .phero__fact {
      display: block;
      text-wrap: pretty;
    }

    .phero__fact dt,
    .phero__fact dd {
      display: inline;
    }

    .phero__fact dt::after {
      content: ':';
      letter-spacing: 0;
      margin-right: 0.4em;
    }

    /* ---------- phone="stack": the photo whole, then the caption on the page ---------- */

    .phero[data-phone='stack'] {
      display: block;
      min-height: 0;
    }

    .phero[data-phone='stack'] .phero__media {
      position: relative;
      inset: auto;
      z-index: auto;
    }

    .phero[data-phone='stack'] .phero__media :global(.phero__photo),
    .phero[data-phone='stack'] .phero__media :global(.phero__photo .photo__frame) {
      height: auto;
    }

    .phero[data-phone='stack'] .phero__media :global(.phero__photo .photo__frame) {
      aspect-ratio: 3 / 2;
    }

    .phero[data-phone='stack'] .phero__inner {
      padding-block: 1.75rem 0;
    }

    .phero[data-phone='stack'] .phero__panel {
      padding: 0;
      border: 0;
      border-radius: 0;
      background: none;
      box-shadow: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    /* On the page the eyebrow and the fact labels take the site's Cerise and Mauve again. */
    .phero[data-phone='stack'] .phero__eyebrow,
    .phero[data-phone='stack'] .phero__dot {
      color: var(--accent-text);
    }

    .phero[data-phone='stack'] .phero__descriptors,
    .phero[data-phone='stack'] .phero__fact dt {
      color: var(--label-2);
    }

    .phero[data-phone='stack'] .phero__facts {
      border-top-color: var(--separator);
    }
  }
</style>
