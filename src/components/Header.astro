---
/**
 * Glass navigation bar (HIG: navigation floats above content on the Liquid Glass layer).
 * Desktop shows the full nav; on small screens the floating tab bar takes over (TabBar.astro).
 */
import { Image } from 'astro:assets';
import mark from '../assets/brand/ncc-mark.png';
import { site } from '../data/site';
import { mainNav, bookHref } from '../data/nav';
import { href, withoutBase } from '../lib/paths';
import { isDemo } from '../lib/env';

const path = withoutBase(Astro.url.pathname);
const current = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---
<header class="nav" data-nav>
  <div class="nav__inner container">
    <a class="nav__brand" href={href('/')} aria-label={`${site.name}, home`}>
      <Image src={mark} alt="" width={32} height={32} densities={[1, 2]} loading="eager" class="nav__mark" />
      <span class="nav__name">{site.name}</span>
      {isDemo && <span class="badge badge--accent nav__demo">Demo</span>}
    </a>
    <nav class="nav__links" aria-label="Main">
      <ul>
        {
          mainNav.map((item) => (
            <li>
              <a href={href(item.href)} aria-current={path === item.href ? 'page' : current(item.href) ? 'true' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="btn btn--filled btn--sm nav__cta" href={href(bookHref)} aria-current={current(bookHref) ? 'page' : undefined}>
      Check Availability
    </a>
  </div>
</header>

<script>
  // Hairline and stronger glass once the page scrolls under the bar.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const onScroll = () => nav.toggleAttribute('data-scrolled', window.scrollY > 4);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur-2) ease,
      background-color var(--dur-2) ease;
  }

  .nav[data-scrolled] {
    background: var(--glass-bg-strong);
    border-bottom-color: var(--separator);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: var(--nav-h);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    color: var(--label);
    text-decoration: none;
    min-height: 44px;
  }

  .nav__brand:hover {
    text-decoration: none;
  }

  .nav__mark {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--separator);
    background: #fff;
  }

  .nav__name {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }

  .nav__demo {
    margin-left: 0.15rem;
  }

  .nav__links ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.8rem;
    border-radius: var(--r-full);
    color: var(--label);
    font-size: var(--t-subhead);
    font-weight: 500;
    opacity: 0.86;
    transition:
      opacity var(--dur-1) ease,
      background-color var(--dur-1) ease;
  }

  .nav__links a:hover {
    opacity: 1;
    text-decoration: none;
    background: var(--fill-3);
  }

  .nav__links a[aria-current] {
    opacity: 1;
    color: var(--accent-text);
    font-weight: 600;
  }

  @media (max-width: 899.98px) {
    .nav__links {
      display: none;
    }

    .nav__cta {
      --btn-h: 36px;
    }
  }

  /* On phones the floating tab bar's Book tab is the primary action, so the header stays uncluttered. */
  @media (max-width: 479.98px) {
    .nav__cta {
      display: none;
    }
  }
</style>
