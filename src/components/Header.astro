---
/**
 * Glass navigation bar (HIG: navigation floats above content on the Liquid Glass layer).
 * Size classes: regular screens (46.5rem, 744px at default text size, and wider) show the full
 * nav; compact screens hand navigation to the floating tab bar (TabBar.astro). The breakpoints are
 * in rem so that larger text switches to the compact layout sooner instead of overflowing.
 */
import { Image } from 'astro:assets';
import mark from '../assets/brand/ncc-mark.png';
import { site } from '../data/site';
import { mainNav, bookHref } from '../data/nav';
import { href, withoutBase } from '../lib/paths';
import { isDemo } from '../lib/env';

const path = withoutBase(Astro.url.pathname);
const current = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
// On the booking page the call to action would link to the page itself.
const showCta = !current(bookHref);
---
<header class="nav" data-nav>
  <div class="nav__inner container">
    <a class="nav__brand" href={href('/')} aria-label={`${site.name}, home`}>
      <Image src={mark} alt="" width={32} height={32} densities={[1, 2]} loading="eager" class="nav__mark" />
      <span class="nav__name">{site.name}</span>
      {isDemo && <span class="badge badge--accent nav__demo">Demo</span>}
    </a>
    <nav class="nav__links" aria-label="Main">
      <ul>
        {
          mainNav.map((item) => (
            <li>
              <a href={href(item.href)} aria-current={path === item.href ? 'page' : current(item.href) ? 'true' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    {
      showCta && (
        <a class="btn btn--filled btn--sm nav__cta" href={href(bookHref)}>
          Check Availability
        </a>
      )
    }
  </div>
</header>

<script>
  // Hairline and stronger glass once the page scrolls under the bar.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const onScroll = () => nav.toggleAttribute('data-scrolled', window.scrollY > 4);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--glass-bg);
    -webkit-backdrop-filter: var(--glass-blur);
    backdrop-filter: var(--glass-blur);
    border-bottom: 1px solid transparent;
    transition:
      border-color var(--dur-2) ease,
      background-color var(--dur-2) ease;
  }

  .nav[data-scrolled] {
    background: var(--glass-bg-strong);
    border-bottom-color: var(--separator);
  }

  /* min-height, not height: with larger text the bar grows instead of clipping its links. */
  .nav__inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    min-height: var(--nav-h);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-right: auto;
    color: var(--label);
    text-decoration: none;
    min-height: 44px;
  }

  .nav__brand:hover {
    text-decoration: none;
  }

  .nav__mark {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    box-shadow: 0 0 0 1px var(--separator);
    background: #fff;
  }

  /* The white disc is dimmed a little in dark mode (HIG: dim bright images on dark backgrounds). */
  @media (prefers-color-scheme: dark) {
    .nav__mark {
      filter: brightness(0.86);
    }
  }

  /*
    One line whenever it fits; at very large text sizes it wraps rather than pushing the page wider.
    Like an iOS inline navigation title, it stops growing past a point so the bar stays one row; page zoom still scales it.
  */
  .nav__name {
    font-size: min(1.0625rem, 21px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .nav__demo {
    flex: none;
    margin-left: 0.15rem;
    font-size: min(0.75rem, 15px);
  }

  .nav__links ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.8rem;
    border-radius: var(--r-full);
    color: var(--label);
    font-size: var(--t-subhead);
    font-weight: 500;
    opacity: 0.86;
    transition:
      opacity var(--dur-1) ease,
      background-color var(--dur-1) ease;
  }

  .nav__links a:hover {
    opacity: 1;
    text-decoration: none;
    background: var(--fill-3);
  }

  .nav__links a[aria-current] {
    opacity: 1;
    color: var(--accent-text);
    font-weight: 600;
  }

  /* Compact size class: the floating tab bar carries navigation (keep in step with TabBar.astro). */
  @media (width < 46.5rem) {
    .nav__links {
      display: none;
    }
  }

  /*
    Regular but narrow (744px to 1023px at default text size): the mark stands in for the name, so
    the five links and the call to action fit. The brand link keeps its accessible name.
  */
  @media (46.5rem <= width < 64rem) {
    .nav__inner {
      gap: 1rem;
    }

    .nav__name {
      display: none;
    }

    .nav__links a {
      padding: 0 0.6rem;
    }
  }

  /* On phones the floating tab bar's Book tab is the primary action, so the header stays uncluttered. */
  @media (width < 30rem) {
    .nav__cta {
      display: none;
    }
  }

  /* Short screens (landscape phones, 400% zoom): the bar scrolls away with the page to leave room for content. */
  @media (max-height: 500px) {
    .nav {
      position: relative;
    }
  }
</style>
