---
/**
 * The navigation bar (redesign-spec.md, Header): the links on the left, the lockup in the centre, the phone
 * and Check Availability on the right, all in the interface serif. It is transparent over a page's hero
 * (`[data-hero]`, the home video) and turns into a solid Blush bar with a hairline once the hero has scrolled
 * past; pages without a hero get the solid bar after 8px. No glass.
 *
 * Size classes: regular screens (60rem, 960px at default text size, and wider) show the links and the
 * call to action; compact screens show a menu button on the left, the lockup centred, and a round phone
 * button on the right. The menu button opens the full-screen menu (a native dialog: focus trapped, Escape
 * closes, focus returns to the button, the page does not scroll behind it) with large serif links, the
 * filled Check Availability, and the phone. There is no bottom bar.
 *
 * `over="photo"` (a page whose hero is a photograph under the transparent bar) sets white text and the
 * white lockup until the bar turns solid.
 *
 * On the home page (`morph`) the lockup's two words are hidden until the welcome's large name has scrolled
 * into their place (src/pages/index.astro, "The morph"); the page's script then sets data-morphed. Readers
 * who prefer reduced motion, browsers without scripts, and short screens (where the bar scrolls away) see
 * the lockup at once. The morph and the solid bar are both tied to the hero's height, so the name lands in
 * the bar as the bar turns solid.
 */
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site, fullAddress } from '../data/site';
import { mainNav, menuNav, bookHref } from '../data/nav';
import { href, withoutBase } from '../lib/paths';
import { isDemo } from '../lib/env';

interface Props {
  /** Where Check Availability goes, base-relative: '/book/?event=weddings' on an event page. Defaults to '/book/'. */
  ctaHref?: string;
  /** Home only: the lockup's words wait for the welcome's name to arrive (see above). */
  morph?: boolean;
  /** What sits under the transparent bar at the top of the page: a light surface (default) or a photo. */
  over?: 'light' | 'photo';
}

const { ctaHref = bookHref, morph = false, over = 'light' } = Astro.props;
const path = withoutBase(Astro.url.pathname);
const current = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
// On the booking page the call to action would link to the page itself.
const showCta = !current(bookHref);
---
<header class="nav" data-nav data-morph={morph ? '' : undefined} data-over={over}>
  <div class="nav__inner container">
    <div class="nav__left">
      <button type="button" class="btn-round nav__menu" aria-label="Open menu" aria-haspopup="dialog" aria-controls="site-menu" data-menu-open>
        <Icon name="menu" />
      </button>
      <nav class="nav__links" aria-label="Main">
        <ul>
          {
            mainNav.map((item) => (
              <li>
                <a href={href(item.href)} aria-current={path === item.href ? 'page' : current(item.href) ? 'true' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      {isDemo && <span class="badge badge--accent nav__demo">Demo</span>}
    </div>
    <a class="nav__brand" href={href('/')} aria-label={`${site.name}, home`}>
      <Logo variant="lockup" height="var(--lockup-h)" decorative class="nav__lockup" data-lockup="lg" />
    </a>
    <div class="nav__actions">
      <a class="nav__phone" href={`tel:${site.contact.phoneE164}`} aria-label={`Call ${site.contact.phone}`}>
        <Icon name="phone" />
        <span class="nav__phone-num">{site.contact.phone}</span>
      </a>
      {
        showCta && (
          <a class="btn btn--filled btn--sm nav__cta" href={href(ctaHref)}>
            Check Availability
          </a>
        )
      }
    </div>
  </div>
</header>

<dialog class="menu" id="site-menu" aria-label="Menu" data-menu>
  <div class="menu__bar container">
    <button type="button" class="btn-round menu__close" aria-label="Close menu" data-menu-close>
      <Icon name="x" />
    </button>
    <Logo variant="lockup" height="var(--lockup-h)" decorative class="menu__lockup" />
  </div>
  <nav class="menu__nav container" aria-label="Menu">
    <ul class="menu__list">
      {
        menuNav.map((item) => (
          <li>
            <a class="menu__link" href={href(item.href)} aria-current={path === item.href ? 'page' : current(item.href) ? 'true' : undefined}>
              {item.label}
              <Icon name="chevron-right" />
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu__actions">
      {
        showCta && (
          <a class="btn btn--filled btn--lg" href={href(ctaHref)}>
            Check Availability
          </a>
        )
      }
      <a class="btn btn--outline btn--lg" href={`tel:${site.contact.phoneE164}`}>
        <Icon name="phone" />
        Call {site.contact.phone}
      </a>
    </div>
    <p class="menu__address secondary">{fullAddress}</p>
  </nav>
</dialog>

<script>
  // The solid bar: once the hero (the home video) has scrolled past the bar, or after 8px on pages without one.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const threshold = () => (hero ? Math.max(8, hero.offsetHeight - nav.offsetHeight) : 8);
    let limit = threshold();
    const onScroll = () => nav.toggleAttribute('data-solid', window.scrollY >= limit);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => {
      limit = threshold();
      onScroll();
    });
  }

  // The full-screen menu on compact screens.
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (menu && opener) {
    const open = () => {
      menu.showModal();
      document.documentElement.classList.add('menu-open');
      menu.querySelector<HTMLElement>('[data-menu-close]')?.focus();
    };
    const close = () => menu.close();
    opener.addEventListener('click', open);
    menu.querySelector('[data-menu-close]')?.addEventListener('click', close);
    menu.addEventListener('close', () => {
      document.documentElement.classList.remove('menu-open');
      opener.focus();
    });
    // A link inside the menu closes it (same-page anchors would otherwise leave it open).
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });
    // Widening past the compact class closes it, so the page is never left locked behind a hidden dialog.
    const regular = window.matchMedia('(min-width: 60rem)');
    regular.addEventListener('change', () => regular.matches && menu.open && close());
  }
</script>

<style>
  /* Transparent at the top of the page, so the hero runs under it; solid Blush and a hairline on scroll. */
  .nav {
    --lockup-h: 32px;
    position: sticky;
    top: 0;
    z-index: 60;
    background: transparent;
    border-bottom: 1px solid transparent;
    color: var(--label);
    transition:
      border-color var(--dur-2) ease,
      background-color var(--dur-2) ease,
      color var(--dur-2) ease;
  }

  .nav[data-solid] {
    background: var(--bg);
    border-bottom-color: var(--separator);
  }

  /* Over a photo hero: white text and the white lockup until the bar turns solid. */
  .nav[data-over='photo']:not([data-solid]) {
    color: var(--white);
    --logo-ink: var(--white);
    --logo-accent: var(--pink);
  }

  /* Three columns: links, the centred brand, actions. min-height, not height: larger text grows the bar. */
  .nav__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    min-height: var(--nav-h);
  }

  /* Each part keeps its column, so the brand stays centred when the links are hidden. */
  .nav__left {
    grid-column: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    min-width: 0;
  }

  .nav__brand {
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
    min-height: 44px;
  }

  .nav__brand:hover {
    text-decoration: none;
  }

  /*
    Home: the lockup's words are hidden until the welcome's name has morphed into their place, then the
    page's script sets data-morphed (the ring fades in meanwhile, driven by --nav-ring). Readers who prefer
    reduced motion, and browsers without scripts, see the whole lockup at once.
  */
  .nav[data-morph]:not([data-morphed]) :global(.logo [data-part]) {
    opacity: 0;
  }

  .nav[data-morph]:not([data-morphed]) :global(.logo circle),
  .nav[data-morph]:not([data-morphed]) :global(.logo path:not([data-part])),
  /* Phones (the welcome stacks its words): "@ NCC" fades in with the ring while "The Venue" travels. */
  .nav[data-morph][data-morph-stack]:not([data-morphed]) :global(.logo [data-part='at-ncc']) {
    opacity: var(--nav-ring, 0);
  }

  @media (prefers-reduced-motion: reduce), (scripting: none), (max-height: 500px) {
    .nav[data-morph]:not([data-morphed]) :global(.logo [data-part]),
    .nav[data-morph]:not([data-morphed]) :global(.logo circle),
    .nav[data-morph]:not([data-morphed]) :global(.logo path:not([data-part])) {
      opacity: 1;
    }
  }

  .nav__demo {
    flex: none;
    font-size: min(0.75rem, 15px);
  }

  /* A narrow phone (320px), or larger text, has no room beside the lockup and the phone for the demo pill. */
  @media (width < 24rem) {
    .nav__demo {
      display: none;
    }
  }

  .nav__menu {
    border-color: transparent;
  }

  .nav__links ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The reference's serif nav links at 16px. */
  .nav__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    border-radius: var(--r-full);
    color: inherit;
    font-family: var(--font-serif);
    font-size: var(--t-ui);
    font-weight: 400;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color var(--dur-1) ease;
  }

  .nav__links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }

  .nav__links a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--accent-text);
  }

  .nav__actions {
    grid-column: 3;
    display: inline-flex;
    align-items: center;
    justify-content: end;
    justify-self: end;
    gap: 0.75rem;
  }

  /* The phone: the number beside its icon on regular screens, a round 44px button on phones. */
  .nav__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 0.5rem;
    border-radius: var(--r-full);
    color: inherit;
    font-family: var(--font-serif);
    font-size: var(--t-ui);
    white-space: nowrap;
  }

  .nav__phone:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }

  .nav__phone :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* The capsule is the 36px small size; its hit area reaches 44px (hig-web-spec.md, Layout). */
  .nav__cta {
    position: relative;
    font-size: var(--t-ui);
  }

  .nav__cta::before {
    content: '';
    position: absolute;
    inset: -4px 0;
  }

  /* Regular size class: the links and the call to action; no menu button. */
  @media (min-width: 60rem) {
    .nav {
      --lockup-h: 36px;
    }

    .nav__menu {
      display: none;
    }
  }

  /* Compact size class: the menu button, the centred lockup, and the round phone button. */
  @media (width < 60rem) {
    .nav__links,
    .nav__cta {
      display: none;
    }

    .nav__left {
      margin-left: -0.5rem;
    }

    .nav__actions {
      margin-right: -0.5rem;
    }

    .nav__phone {
      width: 44px;
      padding: 0;
      justify-content: center;
    }

    .nav__phone-num {
      position: absolute !important;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  /*
    Regular but narrow (960px to 1119px at default text size, a 1024px tablet included): the lockup at its
    32px minimum, tighter links, the phone as an icon, and no demo pill, so the name, the four links, and
    the call to action fit on one row.
  */
  @media (60rem <= width < 70rem) {
    .nav {
      --lockup-h: 32px;
    }

    .nav__inner {
      gap: 0.5rem;
    }

    .nav__demo {
      display: none;
    }

    .nav__links ul {
      gap: 0;
    }

    .nav__links a {
      padding: 0 0.5rem;
    }

    .nav__phone {
      width: 44px;
      padding: 0;
      justify-content: center;
    }

    .nav__phone-num {
      position: absolute !important;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }

  /* Short screens (landscape phones, 400% zoom): the bar scrolls away with the page to leave room for content. */
  @media (max-height: 500px) {
    .nav {
      position: relative;
    }
  }

  /* ---------- The full-screen menu ---------- */

  .menu {
    --lockup-h: 32px;
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0 0 max(2rem, env(safe-area-inset-bottom));
    border: 0;
    background: var(--bg);
    color: var(--label);
    overflow-y: auto;
  }

  .menu::backdrop {
    background: var(--bg);
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  /* The bar mirrors the header: the close button where the menu button was, the lockup centred. */
  .menu__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    min-height: var(--nav-h);
  }

  .menu__close {
    justify-self: start;
    margin-left: -0.5rem;
    border-color: transparent;
  }

  .menu__nav {
    display: grid;
    gap: 2rem;
    padding-top: 1.5rem;
  }

  .menu__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Large serif links, the reference's menu. */
  .menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    color: var(--label);
    font-family: var(--font-display);
    font-size: min(2.25rem, 10vw);
    line-height: 1.15;
    text-decoration: none;
  }

  .menu__link :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--label-3);
  }

  .menu__link[aria-current] {
    color: var(--accent-text);
  }

  .menu__actions {
    display: grid;
    gap: 0.75rem;
  }

  .menu__address {
    font-family: var(--font-serif);
    font-size: var(--t-callout);
  }

  @media (min-width: 60rem) {
    .menu,
    .menu::backdrop {
      display: none;
    }
  }
</style>
