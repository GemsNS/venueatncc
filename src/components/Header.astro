---
/**
 * The navigation bar (redesign-spec.md, Header): the links on the left, the lockup in the centre, the phone
 * and Check Availability on the right, all in the interface serif. The bar is solid White at every scroll
 * position, the home page included, so its links, phone and buttons never sit on the hero video (the
 * welcome is the only text over the roses; docs/design/redesign-v7.md). It gains a hairline once the hero
 * (`[data-hero]`) has scrolled past, or after 8px on pages without one. No glass.
 *
 * Size classes: regular screens (60rem, 960px at default text size, and wider) show the links and the
 * call to action; compact screens show a menu button on the left, the lockup centred, and a round phone
 * button on the right. The menu button opens the full-screen menu (a native dialog: focus trapped, Escape
 * closes, focus returns to the button, the page does not scroll behind it) with large serif links, the
 * filled Check Availability, and the phone. There is no bottom bar. The menu holds the same short list as
 * the bar, with Home first (docs/design/redesign-v7.md, "Version 8"), and the two actions stay pinned to its
 * foot. No photo ever sits under the bar, so its text is always Plum.
 *
 * On the home page (`morph`) the lockup is hidden until the welcome's large name has flown into its place
 * (src/pages/index.astro, "The morph"), then fades in beneath it on the same scroll timeline and the page's
 * script sets data-morphed. Readers who prefer reduced motion, browsers without scripts, and short screens
 * (where the bar scrolls away) see the lockup at once. The morph and the solid bar are both tied to the
 * hero's height, so the name lands in the bar as the bar turns solid.
 *
 * The lockup is the bar's largest element: 40px tall on phones, 44px on tablets, 46px from 960px and 52px
 * on wider screens (in rem, so it grows with larger text like the rest of the bar), in a bar 64px tall on
 * phones, 72px on tablets and small desktops, and 80px from 1120px (--nav-h in global.css). Where the room
 * beside it runs short (a 320px phone, the first few pixels past 1120px, larger text) it gives way first,
 * never under the brand's 32px minimum, so nothing overlaps. From 1200px the links, the phone, and the call
 * to action are 17px, so they hold their own beside the 52px name.
 * The demo pill shows only where there is room for it: 480px to 959px, and from 1200px.
 */
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { site } from '../data/site';
import { mainNav, menuNav, bookHref } from '../data/nav';
import { href, withoutBase } from '../lib/paths';
import { isDemo } from '../lib/env';

interface Props {
  /** Where Check Availability goes, base-relative: '/book/?event=weddings' on an event page. Defaults to '/book/'. */
  ctaHref?: string;
  /** Home only: the lockup's words wait for the welcome's name to arrive (see above). */
  morph?: boolean;
}

const { ctaHref = bookHref, morph = false } = Astro.props;
const path = withoutBase(Astro.url.pathname);
const current = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
// On the booking page the call to action would link to the page itself.
const showCta = !current(bookHref);
---
<header class="nav" data-nav data-morph={morph ? '' : undefined}>
  <div class="nav__inner container">
    <div class="nav__left">
      <button type="button" class="btn-round nav__menu" aria-label="Open menu" aria-haspopup="dialog" aria-controls="site-menu" data-menu-open>
        <Icon name="menu" />
      </button>
      <nav class="nav__links" aria-label="Main">
        <ul>
          {
            mainNav.map((item) => (
              <li>
                <a href={href(item.href)} aria-current={path === item.href ? 'page' : current(item.href) ? 'true' : undefined}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      {isDemo && <span class="badge badge--accent nav__demo">Demo</span>}
    </div>
    <a class="nav__brand" href={href('/')} aria-label={`${site.name}, home`}>
      <Logo variant="lockup" height="var(--lockup-h)" decorative class="nav__lockup" data-lockup="lg" />
    </a>
    <div class="nav__actions">
      <a class="nav__phone" href={`tel:${site.contact.phoneE164}`} aria-label={`Call ${site.contact.phone}`}>
        <Icon name="phone" />
        <span class="nav__phone-num">{site.contact.phone}</span>
      </a>
      {
        showCta && (
          <a class="btn btn--filled btn--sm nav__cta" href={href(ctaHref)}>
            Check Availability
          </a>
        )
      }
    </div>
  </div>
</header>

<dialog class="menu" id="site-menu" aria-label="Menu" data-menu>
  <div class="menu__bar container">
    <button type="button" class="btn-round menu__close" aria-label="Close menu" data-menu-close>
      <Icon name="x" />
    </button>
    <Logo variant="lockup" height="var(--lockup-h)" decorative class="menu__lockup" />
  </div>
  <nav class="menu__nav container" aria-label="Menu">
    <ul class="menu__list">
      {
        menuNav.map((item) => (
          <li>
            <a class="menu__link" href={href(item.href)} aria-current={path === item.href ? 'page' : current(item.href) ? 'true' : undefined}>
              {item.label}
              <Icon name="chevron-right" />
            </a>
          </li>
        ))
      }
    </ul>
    <div class="menu__actions">
      {
        showCta && (
          <a class="btn btn--filled btn--lg" href={href(ctaHref)}>
            Check Availability
          </a>
        )
      }
      <a class="btn btn--outline btn--lg" href={`tel:${site.contact.phoneE164}`}>
        <Icon name="phone" />
        Call {site.contact.phone}
      </a>
    </div>
  </nav>
</dialog>

<script>
  /*
    The solid bar: once the hero (the home video) has scrolled past the bar while the welcome's name flies
    into it (data-morph), or after 8px otherwise: on pages without a hero, and on the home page when the
    morph is off (reduced motion, short screens), where the welcome scrolls away under the bar.
  */
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  if (nav) {
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const threshold = () => (hero ? Math.max(8, hero.offsetHeight - nav.offsetHeight) : 8);
    let limit = threshold();
    const onScroll = () => nav.toggleAttribute('data-solid', window.scrollY >= (nav.hasAttribute('data-morph') ? limit : 8));
    const onResize = () => {
      limit = threshold();
      onScroll();
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    // The hero or the bar can change height without a window resize (a late font, larger text); the morph
    // measures again then (index.astro), and the solid bar follows, so the two stay tied together.
    if (hero && 'ResizeObserver' in window) {
      const ro = new ResizeObserver(onResize);
      ro.observe(hero);
      ro.observe(nav);
    }
  }

  // The full-screen menu on compact screens.
  const menu = document.querySelector<HTMLDialogElement>('[data-menu]');
  const opener = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  if (menu && opener) {
    const open = () => {
      menu.showModal();
      document.documentElement.classList.add('menu-open');
      menu.querySelector<HTMLElement>('[data-menu-close]')?.focus();
    };
    const close = () => menu.close();
    opener.addEventListener('click', open);
    menu.querySelector('[data-menu-close]')?.addEventListener('click', close);
    menu.addEventListener('close', () => {
      document.documentElement.classList.remove('menu-open');
      opener.focus();
    });
    // A link inside the menu closes it (same-page anchors would otherwise leave it open).
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) close();
    });
    // Widening past the compact class closes it, so the page is never left locked behind a hidden dialog.
    const regular = window.matchMedia('(min-width: 60rem)');
    regular.addEventListener('change', () => regular.matches && menu.open && close());
  }
</script>

<style>
  /* Solid White at every scroll position, so nothing in the bar ever sits on the hero video; a hairline on scroll. */
  /*
    The lockup's height on compact screens: 2.5rem (40px at the default text size, growing with larger text
    like the bar and its buttons' icons), or less where the centre column is narrower (a 320px phone, larger
    text), so it always fits between the two 44px round buttons (each pulled 8px into the gutter): the room
    left is 100vw less both gutters and 76px, and the lockup is 533/100 as wide as tall.
  */
  .nav,
  .menu {
    --lockup-h: clamp(32px, (100vw - 2 * var(--gutter) - 76px) * 0.1876, 2.5rem);
  }

  /* Tablets (compact, from 46.5rem): 2.75rem (44px). */
  @media (46.5rem <= width < 60rem) {
    .nav,
    .menu {
      --lockup-h: clamp(32px, (100vw - 2 * var(--gutter) - 76px) * 0.1876, 2.75rem);
    }
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 60;
    background: var(--bg);
    border-bottom: 1px solid transparent;
    color: var(--label);
    transition: border-color var(--dur-2) ease;
  }

  /* The hairline appears once the hero has scrolled past (or after 8px on pages without one). */
  .nav[data-solid] {
    border-bottom-color: var(--separator);
  }

  /*
    Home: the welcome carries its own Check Availability, so the bar's button waits until the welcome's has
    faded (index.astro sets data-cta-wait until then), and the first screen offers one. Hidden, not just
    transparent, so it cannot be tabbed to. Without the morph (reduced motion, short screens, no scripts)
    the attribute is never set and both show.
  */
  .nav[data-cta-wait] .nav__cta {
    visibility: hidden;
  }

  /* Three columns: links, the centred brand, actions. min-height, not height: larger text grows the bar. */
  .nav__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    min-height: var(--nav-h);
  }

  /* Each part keeps its column, so the brand stays centred when the links are hidden. */
  .nav__left {
    grid-column: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    justify-self: start;
    min-width: 0;
  }

  .nav__brand {
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: inherit;
    text-decoration: none;
    min-height: 44px;
  }

  .nav__brand:hover {
    text-decoration: none;
  }

  /*
    Home: the lockup waits, unseen, while the welcome's name flies into its place; the page's scroll
    timeline then fades it in under the arriving name, which is drawn in exactly the same place, and sets
    data-morphed. Readers who prefer reduced motion, short screens, and browsers without scripts see the
    lockup at once.
  */
  .nav[data-morph] .nav__lockup {
    opacity: 0;
  }

  /*
    A keyboard reader who reaches the home link before the name has landed sees the name it leads to, not a
    focus ring around an empty box. !important, because the scroll timeline's opacity (fill: both) outranks
    a plain declaration and only an important one outranks it.
  */
  .nav[data-morph] .nav__brand:focus-visible .nav__lockup {
    opacity: 1 !important;
  }

  @media (prefers-reduced-motion: reduce), (scripting: none), (max-height: 500px) {
    .nav[data-morph] .nav__lockup {
      opacity: 1;
    }
  }

  .nav__demo {
    flex: none;
    font-size: min(0.75rem, 15px);
  }

  /*
    Phones up to 480px wide have no room for the demo pill between the menu button and the centred
    lockup (it would overlap the ring), so it is left out there; the footer's demo line still says so.
  */
  @media (width < 30rem) {
    .nav__demo {
      display: none;
    }
  }

  /* Nor is there room for it beside the links and the larger lockup from 960px to 1199px. */
  @media (60rem <= width < 75rem) {
    .nav__demo {
      display: none;
    }
  }

  .nav__menu {
    border-color: transparent;
  }

  .nav__links ul {
    display: flex;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The reference's serif nav links at 16px. */
  .nav__links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 0.75rem;
    border-radius: var(--r-full);
    color: inherit;
    font-family: var(--font-serif);
    font-size: var(--t-ui);
    font-weight: 400;
    white-space: nowrap;
    text-decoration: none;
    transition: background-color var(--dur-1) ease;
  }

  .nav__links a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }

  .nav__links a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--accent-text);
  }

  .nav__actions {
    grid-column: 3;
    display: inline-flex;
    align-items: center;
    justify-content: end;
    justify-self: end;
    gap: 0.75rem;
  }

  /* The phone: the number beside its icon on regular screens, a round 44px button on phones. */
  .nav__phone {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 44px;
    padding: 0 0.5rem;
    border-radius: var(--r-full);
    color: inherit;
    font-family: var(--font-serif);
    font-size: var(--t-ui);
    white-space: nowrap;
  }

  .nav__phone:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }

  .nav__phone :global(.icon) {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* The capsule is the 36px small size; its hit area reaches 44px (hig-web-spec.md, Layout). */
  .nav__cta {
    position: relative;
    font-size: var(--t-ui);
  }

  .nav__cta::before {
    content: '';
    position: absolute;
    inset: -4px 0;
  }

  /*
    Regular size class: the links and the call to action; no menu button. The lockup is 52px tall, or less
    where the bar is too narrow for it beside its two sides (each held to 22rem: the links, or the phone and
    the call to action), so larger text shrinks the name before anything can overlap; never under 32px.
  */
  @media (min-width: 60rem) {
    .nav {
      --lockup-h: clamp(32px, (min(100vw - 2 * var(--gutter), var(--max)) - 46rem) * 0.1876, 3.25rem);
    }

    .nav__menu {
      display: none;
    }
  }

  /* Compact size class: the menu button, the centred lockup, and the round phone button. */
  @media (width < 60rem) {
    .nav__links,
    .nav__cta {
      display: none;
    }

    /* The two round buttons carry their own space, so the lockup can take all of the centre. */
    .nav__inner {
      column-gap: 0;
    }

    .nav__left {
      margin-left: -0.5rem;
    }

    .nav__actions {
      margin-right: -0.5rem;
    }

    .nav__phone {
      width: 44px;
      padding: 0;
      justify-content: center;
    }

    .nav__phone-num {
      position: absolute !important;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }

  /*
    Regular but narrow (960px to 1119px at default text size, a 1024px tablet included): the lockup at
    46px, tighter links, and the phone as an icon, so the name, the four links, and the call to action fit
    on one row.
  */
  @media (60rem <= width < 70rem) {
    .nav {
      --lockup-h: clamp(32px, (min(100vw - 2 * var(--gutter), var(--max)) - 37rem) * 0.1876, 2.875rem);
    }

    .nav__inner {
      gap: 0.5rem;
    }

    .nav__links ul {
      gap: 0;
    }

    .nav__links a {
      padding: 0 0.5rem;
    }

    .nav__phone {
      width: 44px;
      padding: 0;
      justify-content: center;
    }

    .nav__phone-num {
      position: absolute !important;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }
  }

  /*
    Wide screens (from 1200px at the default text size): the links, the phone, and the call to action at
    17px, a step up from 16px, so they read beside the 52px name (each side is still held to 22rem).
  */
  @media (min-width: 75rem) {
    .nav__links a,
    .nav__phone,
    .nav__cta {
      font-size: 1.0625rem;
    }
  }

  /* Short screens (landscape phones, 400% zoom): the bar scrolls away with the page to leave room for content. */
  @media (max-height: 500px) {
    .nav {
      position: relative;
    }
  }

  /* ---------- The full-screen menu ---------- */

  .menu {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--label);
    overflow-y: auto;
  }

  .menu::backdrop {
    background: var(--bg);
  }

  :global(html.menu-open) {
    overflow: hidden;
  }

  /* The bar mirrors the header: the close button where the menu button was, the lockup centred. */
  .menu__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    min-height: var(--nav-h);
  }

  .menu__close {
    justify-self: start;
    margin-left: -0.5rem;
    border-color: transparent;
  }

  .menu__nav {
    display: grid;
    gap: 2rem;
    padding-top: 1.5rem;
  }

  .menu__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Large serif links, the reference's menu. */
  .menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    color: var(--label);
    font-family: var(--font-display);
    font-size: min(2.25rem, 10vw);
    line-height: 1.15;
    text-decoration: none;
  }

  .menu__link :global(.icon) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--label-3);
  }

  .menu__link[aria-current] {
    color: var(--accent-text);
  }

  /*
    The two actions stay pinned to the foot of the menu (the dialog is the scroll container), on a White
    ground with a hairline, so Check Availability and Call are on screen however long the list runs.
  */
  .menu__actions {
    position: sticky;
    bottom: 0;
    display: grid;
    gap: 0.75rem;
    margin-inline: calc(-1 * var(--gutter));
    padding: 1rem var(--gutter) max(1rem, env(safe-area-inset-bottom));
    border-top: 1px solid var(--separator);
    background: var(--bg);
  }

  @media (min-width: 60rem) {
    .menu,
    .menu::backdrop {
      display: none;
    }
  }
</style>
