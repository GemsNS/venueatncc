---
/**
 * Event types as photo tiles. Each tile shows the event's photo from the event photo map
 * (eventPhoto in src/data/photos.ts), its name and one line, and links to its landing page.
 * A styled concept carries its "Styled Concept" badge; the caption is left to the event page itself.
 */
import Photo from './Photo.astro';
import { events } from '../data/events';
import { eventPhoto } from '../data/photos';
import { href } from '../lib/paths';
import { uid } from '../lib/uid';

interface Props {
  exclude?: string[];
  only?: string[];
  headingLevel?: 'h2' | 'h3';
  /**
   * 'grid' wraps; 'shelf' swipes sideways with snap points on small screens and becomes a 4-column grid from 900px;
   * 'trio' is three tiles in one row from 48rem and one column below.
   */
  layout?: 'grid' | 'shelf' | 'trio';
}
const { exclude = [], only, headingLevel = 'h3', layout = 'grid' } = Astro.props;
const list = only
  ? only.map((slug) => events.find((e) => e.slug === slug)).filter((e) => e !== undefined)
  : events.filter((e) => !exclude.includes(e.slug));
const Heading = headingLevel;
// The tile is one link named by the event: the photo's description is not part of its name.
const prefix = uid('event');
const sizes =
  layout === 'shelf'
    ? '(min-width: 75rem) 290px, (min-width: 900px) 24vw, min(78vw, 300px)'
    : layout === 'trio'
      ? '(min-width: 75rem) 390px, (min-width: 48rem) 31vw, 92vw'
      : '(min-width: 75rem) 390px, (min-width: 40rem) 48vw, 92vw';
// "&" stays with the word before it, so a wrapped title never starts a line with it ("Repasts &" / "celebrations of life").
const keepAmp = (name: string) => name.replace(/ & /g, '\u00A0& ');
---
{
  list.length > 0 && (
    <ul class:list={['events', `events--${layout}`]}>
      {list.map((e) => {
        const photo = eventPhoto(e.slug);
        const nameId = `${prefix}-${e.slug}`;
        return (
          <li class="events__item">
            <a class="event-card card" href={href(`/events/${e.slug}/`)} aria-labelledby={nameId} aria-describedby={`${nameId}-summary`}>
              {photo && <Photo photo={photo} rounded={false} sizes={sizes} caption={false} class="event-card__photo" />}
              <div class="event-card__body">
                <Heading id={nameId} class="event-card__name t-title-3">
                  {keepAmp(e.name)}
                </Heading>
                <p id={`${nameId}-summary`} class="event-card__summary secondary">
                  {e.summary}
                </p>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  )
}

<script>
  // Browsers leave a partly visible card where it is when it takes keyboard focus. In the shelf,
  // bring the focused card fully into view (the scroll snaps to its start).
  document.querySelectorAll<HTMLElement>('.events--shelf').forEach((shelf) => {
    shelf.addEventListener('focusin', (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>('.event-card');
      if (card && shelf.scrollWidth > shelf.clientWidth) card.scrollIntoView({ block: 'nearest', inline: 'start' });
    });
  });
</script>

<style>
  .events {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .events--grid {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
  }

  .events--trio {
    display: grid;
    gap: 1.25rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 48rem) {
    .events--trio {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .events--shelf {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78%, 300px);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding: 0.5rem var(--gutter) 1.5rem;
    margin-inline: calc(-1 * var(--gutter));
    /* With a mouse there is no swipe, so a thin scrollbar stays as the cue and the handle. */
    scrollbar-width: thin;
  }

  /* Touch screens swipe, and the peeking next card is the cue. */
  @media (pointer: coarse) {
    .events--shelf {
      scrollbar-width: none;
    }

    .events--shelf::-webkit-scrollbar {
      display: none;
    }
  }

  .events--shelf .events__item {
    scroll-snap-align: start;
  }

  /* Wide screens have room for every card: no hidden overflow, no clipped shadows. */
  @media (min-width: 900px) {
    .events--shelf {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 1.25rem;
      overflow: visible;
      scroll-snap-type: none;
      margin-inline: 0;
      padding: 0;
    }
  }

  /* The photo runs to the card's edges; the card's radius clips it. */
  .event-card {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
    color: var(--label);
    text-decoration: none;
    transition:
      transform var(--dur-2) var(--ease-spring),
      box-shadow var(--dur-2) ease;
  }

  .event-card:hover {
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: var(--shadow-3);
  }

  .event-card:focus-visible {
    border-radius: var(--r-lg);
  }

  .event-card__body {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding: 1.1rem 1.25rem 1.1rem;
  }

  .event-card__name {
    text-wrap: balance;
  }

  .event-card__summary {
    font-size: var(--t-subhead);
  }

  /* 200% text on phones: wider cards and tighter padding give the names room. */
  @media (width < 20rem) {
    .events--shelf {
      grid-auto-columns: 88%;
    }

    .event-card__body {
      padding: 0.9rem 1rem;
    }
  }
</style>
