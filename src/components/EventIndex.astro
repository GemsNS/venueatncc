---
/** Event types as cards. Each links to its landing page. */
import Icon from './Icon.astro';
import { events } from '../data/events';
import { eventTypes } from '../data/event-types';
import { href } from '../lib/paths';

interface Props {
  exclude?: string[];
  only?: string[];
  headingLevel?: 'h2' | 'h3';
  /** 'grid' wraps; 'shelf' swipes sideways with snap points on small screens and becomes a 4-column grid from 900px. */
  layout?: 'grid' | 'shelf';
}
const { exclude = [], only, headingLevel = 'h3', layout = 'grid' } = Astro.props;
const list = only
  ? only.map((slug) => events.find((e) => e.slug === slug)).filter((e) => e !== undefined)
  : events.filter((e) => !exclude.includes(e.slug));
const iconFor = (slug: string) => eventTypes.find((t) => t.slug === slug)?.icon ?? 'party-popper';
const Heading = headingLevel;
---
{
  list.length > 0 && (
    <ul class:list={['events', `events--${layout}`]}>
      {list.map((e) => (
        <li class="events__item">
          <a class="event-card card" href={href(`/events/${e.slug}/`)}>
            <span class="icon-tile">
              <Icon name={iconFor(e.slug)} />
            </span>
            <Heading class="event-card__name t-title-3">{e.name}</Heading>
            <p class="event-card__summary secondary">{e.summary}</p>
            <span class="link-more event-card__more">
              Plan yours <Icon name="chevron-right" />
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<script>
  // Browsers leave a partly visible card where it is when it takes keyboard focus. In the shelf,
  // bring the focused card fully into view (the scroll snaps to its start).
  document.querySelectorAll<HTMLElement>('.events--shelf').forEach((shelf) => {
    shelf.addEventListener('focusin', (e) => {
      const card = (e.target as HTMLElement).closest<HTMLElement>('.event-card');
      if (card && shelf.scrollWidth > shelf.clientWidth) card.scrollIntoView({ block: 'nearest', inline: 'start' });
    });
  });
</script>

<style>
  .events {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .events--grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
  }

  .events--shelf {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(78%, 300px);
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
    padding: 0.5rem var(--gutter) 1.5rem;
    margin-inline: calc(-1 * var(--gutter));
    /* With a mouse there is no swipe, so a thin scrollbar stays as the cue and the handle. */
    scrollbar-width: thin;
  }

  /* Touch screens swipe, and the peeking next card is the cue. */
  @media (pointer: coarse) {
    .events--shelf {
      scrollbar-width: none;
    }

    .events--shelf::-webkit-scrollbar {
      display: none;
    }
  }

  .events--shelf .events__item {
    scroll-snap-align: start;
  }

  /* Wide screens have room for every card: no hidden overflow, no clipped shadows. */
  @media (min-width: 900px) {
    .events--shelf {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      overflow: visible;
      scroll-snap-type: none;
      margin-inline: 0;
      padding: 0;
    }
  }

  .event-card {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    height: 100%;
    padding: 1.5rem;
    color: var(--label);
    text-decoration: none;
    transition:
      transform var(--dur-2) var(--ease-spring),
      box-shadow var(--dur-2) ease;
  }

  /* 200% text on phones: wider cards and tighter padding give the names room. */
  @media (width < 20rem) {
    .events--shelf {
      grid-auto-columns: 88%;
    }

    .event-card {
      padding: 1rem;
    }
  }

  .event-card:hover {
    text-decoration: none;
    transform: translateY(-2px);
    box-shadow: var(--shadow-3);
  }

  .event-card__name {
    margin-top: 0.5rem;
  }

  .event-card__summary {
    font-size: var(--t-subhead);
  }

  .event-card__more {
    margin-top: auto;
    padding-top: 0.5rem;
    font-size: var(--t-subhead);
  }
</style>
