---
/**
 * A photo beside copy (redesign-spec.md, ImageTextSplit; the reference's "Getting to" and contact sections):
 * the photo on the left (or right with `flip`), and on the right an eyebrow, a heading, the slotted copy, and
 * the actions (`actions` slot). Phones stack the photo, its caption, then the copy (the copy
 * first with `copyFirst`, for the split that directly follows a page intro). The photo is shown whole
 * at 3:2 (the 4:5 file on phones) with its caption under it, never over it, and opens in the viewer
 * (Figure.astro; docs/design/redesign-v7.md, "Editorial split").
 */
import Figure from './Figure.astro';
import type { VenuePhoto } from '../data/photos';

interface Props {
  photo: VenuePhoto;
  id: string;
  heading: string;
  eyebrow?: string;
  lead?: string;
  flip?: boolean;
  /** The caption under the photo: a string, or true for the photo's own. A staged photo always gets the disclosure. */
  caption?: string | boolean;
  level?: 'h1' | 'h2';
  /** Phones only: the copy above the photo. For the split that directly follows a page intro, so its photo and the intro's never stack back to back. */
  copyFirst?: boolean;
  sizes?: string;
  class?: string;
}

const {
  photo,
  id,
  heading,
  eyebrow,
  lead,
  flip = false,
  copyFirst = false,
  caption = true,
  level = 'h2',
  sizes = '(min-width: 75rem) 620px, (min-width: 60rem) 50vw, 100vw',
  class: className,
} = Astro.props;
const Heading = level;
---
<div class:list={['split', { 'split--flip': flip, 'split--copy-first': copyFirst }, className]}>
  <Figure photo={photo} caption={caption} sizes={sizes} class="split__photo" />
  <div class="split__copy">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <Heading id={id}>{heading}</Heading>
    {lead && <p class="t-lead">{lead}</p>}
    <slot />
    {
      Astro.slots.has('actions') && (
        <div class="btn-row split__actions">
          <slot name="actions" />
        </div>
      )
    }
  </div>
</div>

<style>
  .split {
    display: grid;
    gap: 2rem clamp(2rem, 5vw, 5rem);
    align-items: center;
  }

  .split__copy {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 34rem;
  }

  .split__copy h2,
  .split__copy h1 {
    line-height: 1.08;
  }

  .split__actions {
    margin-top: 0.5rem;
  }

  @media (min-width: 60rem) {
    .split {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }

    .split--flip :global(.split__photo) {
      order: 2;
    }
  }

  @media (width < 60rem) {
    .split--copy-first .split__copy {
      order: -1;
    }
  }
</style>
