---
/**
 * Floating Liquid Glass tab bar for the compact size class (HIG: tab bars for top-level navigation,
 * five tabs at most, floating above content). Hidden from 46.5rem (744px at default text size),
 * where the top nav shows everything. Keep the breakpoint in step with Header.astro.
 * While it shows, it sets --tabbar-space (global.css), which keeps focused controls, sticky bars
 * and the end of the footer clear of it.
 */
import Icon from './Icon.astro';
import { tabNav } from '../data/nav';
import { href, withoutBase } from '../lib/paths';

const path = withoutBase(Astro.url.pathname);
const isCurrent = (h: string) => (h === '/' ? path === '/' : path.startsWith(h));
---
<nav class="tabbar" aria-label="Sections">
  <ul class="tabbar__list">
    {
      tabNav.map((t) => (
        <li>
          <a class="tabbar__tab" href={href(t.href)} aria-current={isCurrent(t.href) ? 'page' : undefined}>
            <Icon name={t.icon} />
            <span>{t.label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tabbar {
    display: none;
  }

  @media (width < 46.5rem) {
    .tabbar {
      display: block;
      position: fixed;
      left: 50%;
      bottom: calc(10px + env(safe-area-inset-bottom));
      z-index: 70;
      width: min(100% - 20px, 440px);
      transform: translateX(-50%);
      padding: 6px;
      border-radius: var(--r-full);
      background: var(--glass-bg-strong);
      -webkit-backdrop-filter: var(--glass-blur);
      backdrop-filter: var(--glass-blur);
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-edge), var(--glass-shadow);
    }

    /* The bar's height (about 66px plus 10px from the edge, more with larger text) and a margin. */
    :global(html:has(.tabbar)) {
      --tabbar-space: calc(76px + 1rem + env(safe-area-inset-bottom));
    }
  }

  /*
    Short screens (landscape phones, 400% zoom): a fixed bar would cover most of the content,
    so the tab bar sits at the end of the page instead.
  */
  @media (width < 46.5rem) and (max-height: 500px) {
    .tabbar {
      position: static;
      width: auto;
      max-width: 440px;
      margin: 16px auto calc(16px + env(safe-area-inset-bottom));
      transform: none;
    }

    :global(html:has(.tabbar)) {
      --tabbar-space: 0px;
    }
  }

  .tabbar__list {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tabbar__tab {
    display: grid;
    justify-items: center;
    gap: 2px;
    min-height: 52px;
    padding: 6px 2px 5px;
    border-radius: var(--r-full);
    color: var(--label-2);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0;
    text-decoration: none;
    transition:
      color var(--dur-1) ease,
      background-color var(--dur-2) var(--ease-spring);
    -webkit-tap-highlight-color: transparent;
  }

  .tabbar__tab:hover {
    text-decoration: none;
    color: var(--label);
  }

  .tabbar__tab span {
    max-width: 100%;
    line-height: 1.2;
    text-align: center;
    overflow-wrap: anywhere;
  }

  .tabbar__tab :global(.icon) {
    width: 24px;
    height: 24px;
  }

  .tabbar__tab[aria-current='page'] {
    color: var(--accent-text);
    background: var(--accent-tint);
  }
</style>
