---
/**
 * Frequently asked questions (redesign-spec.md, "/faq/"; the reference's FAQ pattern on its venue pages).
 *
 * A serif title band on Petal, then one group per topic, all on one page with no topic bar
 * (docs/design/redesign-v7.md, section 5): the topic's serif head on the left and its questions as a
 * hairline accordion on the right, the groups split by hairlines. Answers follow the FAQ rule: one sentence
 * and a link to the fact's home where it has one (src/data/faq.ts). Only questions with an answer are
 * published. Breadcrumbs are for event pages only.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { site } from '../data/site';
import { publishedFaqs, type Faq } from '../data/faq';
import { faqPage } from '../lib/schema';

const hall = site.spaces.find((s) => s.id === 'indoor');
const mainHall = site.spaces.find((s) => s.id === 'main');
const grove = site.spaces.find((s) => s.id === 'outdoor');
const title = 'FAQ | Booking The Venue @ NCC in Suffolk, VA';
const description = `Answers about capacity, hours, rates, deposits, and booking at The Venue @ NCC in Suffolk, VA: ${hall?.name} and ${mainHall?.name} for ${hall?.capacity} guests each, ${grove?.name} for ${grove?.capacity}.`;

const groups = (
  [
    { topic: 'booking', title: 'Booking', blurb: 'Dates, visits, and who can book.' },
    { topic: 'space', title: 'The spaces', blurb: 'Capacity, layouts, and what each space offers.' },
    { topic: 'pricing', title: 'Rates and payments', blurb: 'How rates work and what a rental includes.' },
    { topic: 'about', title: 'About the venue', blurb: 'Where we are and what we host.' },
  ] as { topic: Faq['topic']; title: string; blurb: string }[]
)
  .map((g) => ({ ...g, id: `faq-${g.topic}`, items: publishedFaqs.filter((f) => f.topic === g.topic) }))
  .filter((g) => g.items.length > 0);
---
<BaseLayout title={title} description={description} og="faq" schema={[faqPage(publishedFaqs)]}>
  <section class="band-section title-band" aria-labelledby="page-title">
    <div class="container title-band__inner">
      <p class="eyebrow">Help</p>
      <h1 id="page-title">Frequently asked questions</h1>
      <p class="t-lead">Answers to the questions we hear most about the spaces, rates, and booking.</p>
    </div>
  </section>

  <section class="section faq-body">
    <div class="container">
      {
        groups.map((g) => (
          <section class="faq-group" id={g.id} aria-labelledby={`${g.id}-title`}>
            <div class="faq-group__head">
              <h2 id={`${g.id}-title`} class="t-title-2">
                {g.title}
              </h2>
              <p class="faq-group__blurb">{g.blurb}</p>
            </div>
            <FaqAccordion items={g.items} class="faq-group__list" />
          </section>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Title band (the reference's serif title on a tinted band) ---------- */

  .title-band {
    background: var(--band);
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .title-band__inner {
    display: grid;
    gap: 0.75rem;
  }

  .title-band h1 {
    line-height: 1.05;
  }

  .title-band .t-lead {
    max-width: 36rem;
  }

  @media (forced-colors: active) {
    .title-band {
      border-bottom: 1px solid CanvasText;
    }
  }

  /* ---------- Groups: the head beside the questions, hairlines between groups ---------- */

  .faq-body {
    padding-top: calc(var(--section) * 0.6);
  }

  .faq-group {
    display: grid;
    gap: 1.25rem 3rem;
    padding-block: calc(var(--section) * 0.6);
  }

  .faq-group + .faq-group {
    border-top: 1px solid var(--separator);
  }

  .faq-group:first-child {
    padding-top: 0;
  }

  .faq-group:last-child {
    padding-bottom: 0;
  }

  .faq-group__head {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .faq-group__blurb {
    font-family: var(--font-serif);
    color: var(--label-2);
    max-width: 20rem;
  }

  .faq-group :global(.faq-group__list) {
    max-width: 50rem;
  }

  @media (min-width: 60rem) {
    .faq-group {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 2rem 4rem;
    }

    .faq-group__head {
      position: sticky;
      top: calc(var(--nav-h) + 2rem);
    }
  }
</style>
