---
/**
 * The Space (docs/design/redesign-v7.md, "Version 8"): the title band, one block per space (its photo whole
 * with the caption under it, beside two or three sentences, the capacity, and the key features), a small
 * gallery of further views, and the amenities as one compact list. No page intro photo, no jump links, no
 * visit or "included" sections: the visit request lives on Book, and what the rental includes on Rates & FAQ.
 *
 * Real photos only, each shown once on the page: hall-windows, main-hall, and grove-tables lead the
 * blocks; hall-doors, gazebo, grove-path, and approach-dusk make the gallery. This page is the one home of
 * the features and the amenities; the capacities appear here and on the home page's space cards.
 */
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Figure from '../components/Figure.astro';
import ImageTextSplit from '../components/ImageTextSplit.astro';
import { site } from '../data/site';
import { photoByName, type VenuePhoto } from '../data/photos';
import { abs } from '../lib/schema';
import { withoutBase } from '../lib/paths';

const hall = site.spaces.find((s) => s.id === 'indoor') ?? site.spaces[0];
const mainHall = site.spaces.find((s) => s.id === 'main') ?? site.spaces[1];
const grove = site.spaces.find((s) => s.id === 'outdoor') ?? site.spaces[2];

const title = 'Event spaces in Suffolk, VA | The Venue @ NCC';
const description = `${hall.name} and ${mainHall.name} for up to ${hall.capacity} guests each, and ${grove.name} for up to ${grove.capacity}, at The Venue @ NCC in Suffolk, VA. See each space, its features, and the amenities.`;

interface SpaceBlock {
  id: 'hall' | 'main-hall' | 'grove';
  name: string;
  lead: string;
  capacity: number;
  features: string;
  photo: VenuePhoto | null;
  caption: string;
}

const spaces: SpaceBlock[] = [
  {
    id: 'hall',
    name: hall.name,
    lead: 'A bright indoor room for receptions, dinners, showers, and meetings. Arched windows bring in daylight, the fireplace wall is a natural focal point, and the open floor takes round tables, a long table, or rows of seats.',
    capacity: hall.capacity,
    features: 'Arched windows, a fireplace feature wall, wood-look floors, recessed lighting, a wall-mounted screen, and double doors',
    photo: photoByName('hall-windows'),
    caption: 'The arched windows and the fireplace wall',
  },
  {
    id: 'main-hall',
    name: mainHall.name,
    lead: 'A multi-purpose auditorium for ceremonies, conferences, and celebrations. Rows of upholstered chairs face a raised stage, so every seat has a clear view.',
    capacity: mainHall.capacity,
    features: 'A raised stage, rows of upholstered chairs, a vaulted ceiling, and a wall-mounted screen',
    photo: photoByName('main-hall'),
    caption: 'Stage seating under the vaulted ceiling',
  },
  {
    id: 'grove',
    name: grove.name,
    lead: 'Our outdoor setting for ceremonies, reunions, and gatherings in the open air, with a timber gazebo at its heart and tall pines on every side.',
    capacity: grove.capacity,
    features: 'A timber gazebo, picnic tables on a patio, open lawn, and paths through the trees',
    photo: photoByName('grove-tables'),
    caption: 'Picnic tables and the gazebo',
  },
];

/* Further views, each shown once. */
const gallery = [
  { photo: photoByName('hall-doors'), caption: `${hall.name}: the double doors and the screen` },
  { photo: photoByName('gazebo'), caption: `The gazebo in ${grove.name}` },
  { photo: photoByName('grove-path'), caption: 'The path to the gazebo' },
  { photo: photoByName('approach-dusk'), caption: 'The drive at dusk' },
].filter((g): g is { photo: VenuePhoto; caption: string } => g.photo !== null);

// Structured data lists the photos on this page.
const pagePhotos = [...spaces.map((s) => s.photo), ...gallery.map((g) => g.photo)].filter((p): p is VenuePhoto => p !== null);
const fullImages = await Promise.all(
  pagePhotos.map((p) => getImage({ src: p.src, width: Math.min(1600, p.src.width), format: 'jpg' })),
);
const gallerySchema =
  pagePhotos.length > 0
    ? [
        {
          '@type': 'ImageGallery',
          name: `${site.name} photos`,
          image: pagePhotos.map((p, i) => ({
            '@type': 'ImageObject',
            name: p.caption ?? p.alt,
            description: p.alt,
            contentUrl: abs(withoutBase(fullImages[i].src)),
          })),
        },
      ]
    : [];

const SPLIT_SIZES = '(min-width: 75rem) 620px, (min-width: 60rem) 50vw, 100vw';
const GALLERY_SIZES = '(min-width: 75rem) 584px, (min-width: 46.5rem) 46vw, 100vw';
---
<BaseLayout title={title} description={description} og="the-space" venueDetails schema={gallerySchema}>
  <section class="title-band" aria-labelledby="page-title">
    <div class="container title-band__inner">
      <h1 id="page-title">The Space</h1>
      <p class="t-lead">Two indoor rooms and an outdoor grove among the pines.</p>
    </div>
  </section>

  {
    spaces.map((s, i) => (
      <section id={s.id} class="section sp-target" aria-labelledby={`${s.id}-heading`}>
        <div class="container">
          {s.photo ? (
            <ImageTextSplit photo={s.photo} id={`${s.id}-heading`} heading={s.name} lead={s.lead} caption={s.caption} flip={i % 2 === 1} sizes={SPLIT_SIZES}>
              <dl class="sp-facts">
                <div class="sp-fact">
                  <dt>Capacity</dt>
                  <dd>Up to {s.capacity} guests</dd>
                </div>
                <div class="sp-fact">
                  <dt>Features</dt>
                  <dd>{s.features}</dd>
                </div>
              </dl>
            </ImageTextSplit>
          ) : (
            <div class="section-head">
              <h2 id={`${s.id}-heading`}>{s.name}</h2>
              <p class="t-lead">{s.lead}</p>
            </div>
          )}
        </div>
      </section>
    ))
  }

  {
    gallery.length > 0 && (
      <section id="gallery" class="section sp-target" aria-labelledby="gallery-heading">
        <div class="container">
          <h2 id="gallery-heading" class="sp-head">A closer look</h2>
          <div class="sp-gallery">
            {gallery.map((g) => <Figure photo={g.photo} caption={g.caption} tall={false} sizes={GALLERY_SIZES} />)}
          </div>
        </div>
      </section>
    )
  }

  {
    site.amenities.length > 0 && (
      <section id="amenities" class="section sp-target" aria-labelledby="amenities-heading">
        <div class="container">
          <h2 id="amenities-heading" class="sp-head">Amenities</h2>
          <dl class="sp-amenities">
            {site.amenities.map((a) => (
              <div class="sp-amenity">
                <dt>{a.name}</dt>
                <dd>{a.detail}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Links from the home page and the events page land just under the header. */
  .sp-target {
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }

  .sp-head {
    margin-bottom: var(--section-head);
    line-height: 1.08;
  }

  /* The fact row: LABEL / value pairs on a hairline under the lead. */
  .sp-facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem 2rem;
    width: 100%;
    margin: 0.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--separator);
  }

  @media (min-width: 36rem) {
    .sp-facts {
      grid-template-columns: minmax(7rem, 1fr) minmax(0, 2.6fr);
    }
  }

  .sp-fact,
  .sp-amenity {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .sp-fact dt,
  .sp-amenity dt {
    font-family: var(--font-serif);
    font-size: var(--t-caption);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--label-2);
  }

  .sp-fact dd,
  .sp-amenity dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--t-headline);
    line-height: 1.45;
    color: var(--label);
  }

  /* The gallery: two across from 46.5rem, stacked on phones. */
  .sp-gallery {
    display: grid;
    gap: 2rem 1.5rem;
  }

  @media (min-width: 46.5rem) {
    .sp-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* The amenities: three short items on hairlines, in a row from 48rem. */
  .sp-amenities {
    display: grid;
    gap: 1.75rem 2.5rem;
    margin: 0;
  }

  @media (min-width: 48rem) {
    .sp-amenities {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .sp-amenity {
    padding-top: 1.25rem;
    border-top: 1px solid var(--separator);
  }
</style>
