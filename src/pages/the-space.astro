---
/**
 * The Space: The Hall, The Grove, and The grounds, each as a short spec sheet beside a small gallery of real
 * photos, then a visit request and the closing band. Real photos only, with no toggles and no photo shown
 * twice; only facts the photos show (docs/design/brand.md, Photography).
 *
 * Each fact lives here once (brand.md, Redundancy rules): the capacities in the Capacity rows, parking in
 * the grounds Parking row, the visit request in the visit panel. Booking is the header CTA and the closing
 * band; the address and phone are in the footer.
 */
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { photoByName, photosFor, type VenuePhoto } from '../data/photos';
import { bookHref } from '../data/nav';
import { pricing, formatUSD } from '../shared/pricing';
import { breadcrumbs, abs } from '../lib/schema';
import { href, withoutBase } from '../lib/paths';

const hall = site.spaces.find((s) => s.id === 'indoor') ?? site.spaces[0];
const grove = site.spaces.find((s) => s.id === 'outdoor') ?? site.spaces[1];

const title = 'The Hall and The Grove in Suffolk, VA | The Venue at NCC';
const description = `The Hall for up to ${hall.capacity} guests and The Grove for up to ${grove.capacity} at The Venue at NCC in Suffolk, VA. See both spaces, the grounds, and on-site parking.`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'The Space', path: '/the-space/' },
];

const heroPhoto = photoByName('hall-windows') ?? photosFor('hall')[0] ?? null;

/** A space's real photos in data order, without the hero photo: no photo appears twice on the page. */
function galleryFor(space: 'hall' | 'grove'): VenuePhoto[] {
  const list = photosFor(space);
  const rest = list.filter((p) => p !== heroPhoto);
  return rest.length > 0 ? rest : list;
}

/**
 * Crops for the pair of portrait frames a two-photo gallery uses. The Hall: the fireplace wall, and the double
 * doors with the windows beside them, so neither reads as a second copy of the hero. The grounds: the drive
 * curving toward the entry beside the full view of the lot, so the pair does not show the building twice.
 */
const PAIR_CROPS: Record<string, string> = { 'hall-fireplace': '85% 50%', 'hall-doors': '100% 50%', 'approach-dusk': '0% 50%' };

/** The lowest hourly rate for a space, from the rate card. */
const fromRate = (id: 'indoor' | 'outdoor') => formatUSD(Math.min(...Object.values(pricing.hourly[id])));

interface Row {
  label: string;
  value: string;
}

interface Section {
  id: string;
  heading: string;
  lead: string;
  rows: Row[];
  /** An outside link shown under the spec sheet, opened in a new tab. */
  link?: { label: string; href: string };
  photos: VenuePhoto[];
  /** Gallery first on wide screens, for rhythm down the page. */
  flip: boolean;
  grouped: boolean;
}

const sections: Section[] = [
  {
    id: 'hall',
    heading: hall.name,
    lead: 'Our indoor space: a bright, open room for receptions, dinners, showers, and meetings.',
    rows: [
      { label: 'Capacity', value: `Up to ${hall.capacity} guests` },
      { label: 'In the room', value: 'Arched windows, a fireplace feature wall, dark wood-look floors, recessed lighting, and double doors' },
      { label: 'Rates', value: `From ${fromRate('indoor')} an hour` },
    ],
    photos: galleryFor('hall'),
    flip: false,
    grouped: true,
  },
  {
    id: 'grove',
    heading: grove.name,
    lead: 'Our outdoor space: a wooded setting among tall pines for ceremonies, reunions, and gatherings in the open air.',
    rows: [
      { label: 'Capacity', value: `Up to ${grove.capacity} guests` },
      { label: 'In the grove', value: 'A timber gazebo with a metal roof, picnic tables on a paved patio, open lawn, and paved paths' },
      { label: 'Rates', value: `From ${fromRate('outdoor')} an hour` },
    ],
    photos: galleryFor('grove'),
    flip: true,
    grouped: false,
  },
  {
    id: 'grounds',
    heading: 'The grounds',
    lead: 'A long paved drive leads past open lawn to the building and a large paved lot, minutes from downtown Suffolk.',
    rows: [{ label: 'Parking', value: 'On site, included with every booking' }],
    link: { label: 'Get Directions', href: site.address.directionsUrl },
    photos: ['approach-dusk', 'driveway'].map((n) => photoByName(n)).filter((p): p is VenuePhoto => p !== null),
    flip: false,
    grouped: true,
  },
];

const LEAD_SIZES = '(min-width: 81.25rem) 680px, (min-width: 60rem) 56vw, 94vw';
const SMALL_SIZES = '(min-width: 81.25rem) 335px, (min-width: 60rem) 28vw, (min-width: 36rem) 46vw, 94vw';

// Structured data lists the photos on this page.
const pagePhotos = [...new Set([heroPhoto, ...sections.flatMap((s) => s.photos)].filter((p): p is VenuePhoto => p !== null))];
const fullImages = await Promise.all(
  pagePhotos.map((p) => getImage({ src: p.src, width: Math.min(1600, p.src.width), format: 'jpg' })),
);
const gallerySchema =
  pagePhotos.length > 0
    ? [
        {
          '@type': 'ImageGallery',
          name: `${site.name} photos`,
          image: pagePhotos.map((p, i) => ({
            '@type': 'ImageObject',
            name: p.caption ?? p.alt,
            description: p.alt,
            contentUrl: abs(withoutBase(fullImages[i].src)),
          })),
        },
      ]
    : [];
---
<BaseLayout title={title} description={description} og="the-space" venueDetails schema={[breadcrumbs(crumbs), ...gallerySchema]}>
  <section class="sp-hero" aria-labelledby="space-title">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="sp-hero__head">
        <h1 id="space-title" class="t-large-title">Two spaces, indoors and out</h1>
        <p class="t-lead sp-hero__lead">
          {hall.name} and {grove.name} share one address in Suffolk. Book either space, or both together.
        </p>
      </div>
      {heroPhoto && <Photo photo={heroPhoto} priority ratio="2 / 1" caption class="sp-hero__photo" sizes="(min-width: 81.25rem) 1200px, 94vw" />}
    </div>
  </section>

  {
    sections.map((s) => {
      return (
        <section id={s.id} class:list={['section', { 'section--grouped': s.grouped }]} aria-labelledby={`${s.id}-heading`}>
          <div class:list={['container', 'sp-space', { 'sp-space--flip': s.flip }]}>
            <div class="sp-space__head">
              <h2 id={`${s.id}-heading`} class="t-large-title">{s.heading}</h2>
              <p class="t-serif-lead">{s.lead}</p>
            </div>

            {s.photos.length > 0 && (
              <div class="sp-view">
                <ul class:list={['sp-gallery', { 'sp-gallery--pair': s.photos.length === 2 }]}>
                  {s.photos.map((p, i) => {
                    // Two photos sit side by side as equal portraits; three or more lead with one wide photo.
                    const pair = s.photos.length === 2;
                    const lead = !pair && i === 0;
                    const sizes = lead ? LEAD_SIZES : SMALL_SIZES;
                    const ratio = pair ? '4 / 5' : '3 / 2';
                    const crop = pair ? PAIR_CROPS[p.name] : undefined;
                    return (
                      <li class:list={['sp-gallery__item', { 'sp-gallery__lead': lead }]}>
                        <Photo photo={p} caption ratio={ratio} crop={crop} sizes={sizes} />
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}

            <div class="sp-space__details">
              <dl class="sp-spec">
                {s.rows.map((r) => (
                  <div>
                    <dt>{r.label}</dt>
                    <dd>{r.value}</dd>
                  </div>
                ))}
              </dl>
              {s.link && (
                <a class="btn btn--tinted" href={s.link.href} target="_blank" rel="noopener">
                  <Icon name="arrow-up-right" />
                  {s.link.label}
                  <span class="visually-hidden">, opens in a new tab</span>
                </a>
              )}
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="section" aria-labelledby="visit-heading">
    <div class="container">
      <div class="sp-visit">
        <div class="sp-visit__copy">
          <h2 id="visit-heading" class="t-title-1">Visit before you book</h2>
          <p class="secondary">
            See {hall.name} and {grove.name} in person. Send a visit request and we will arrange a time with you.
          </p>
        </div>
        <div class="btn-row btn-row--stack sp-visit__actions">
          <a class="btn btn--filled" href={`${href(bookHref)}?visit=1`}>Request a Visit</a>
          <a class="btn btn--tinted" href={`tel:${site.contact.phoneE164}`}>
            <Icon name="phone" />
            Call {site.contact.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  /* Hero: the title beside a short lead, then The Hall in a wide rectangle. */
  .sp-hero {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  .sp-hero__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem 3rem;
    margin-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  @media (min-width: 60rem) {
    .sp-hero__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
    }
  }

  .sp-hero h1 {
    max-width: 14ch;
  }

  .sp-hero__lead {
    max-width: 36rem;
  }

  /* Wide on large screens; a calmer 4:3 on phones, where 2:1 is only a sliver. */
  @media (width < 48rem) {
    .sp-hero :global(.sp-hero__photo .photo__frame) {
      aspect-ratio: 4 / 3;
    }
  }

  /*
    Each space: its heading, its photos, then the spec sheet. On wide screens the heading and the spec
    sheet share one column beside the gallery. Source order matches the phone layout, so focus order does too.
  */
  .sp-space {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }

  @media (min-width: 60rem) {
    .sp-space {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'head view'
        'details view';
      gap: 2rem clamp(2.5rem, 5vw, 5rem);
    }

    .sp-space--flip {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas:
        'view head'
        'view details';
    }

    .sp-space__head {
      grid-area: head;
    }

    .sp-view {
      grid-area: view;
    }

    .sp-space__details {
      grid-area: details;
    }
  }

  .sp-space__details {
    display: grid;
    gap: 1.75rem;
    align-content: start;
    justify-items: start;
  }

  .sp-space__head {
    display: grid;
    gap: 1rem;
    max-width: 34rem;
  }

  .sp-spec {
    width: 100%;
    max-width: 34rem;
    margin: 0;
    border-top: 1px solid var(--separator);
  }

  .sp-spec > div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--separator);
  }

  /* Narrow screens and large text: the label sits above its value. */
  @media (width < 30rem) {
    .sp-spec > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .sp-spec dt {
    color: var(--label-2);
    font-size: var(--t-subhead);
    line-height: 1.5;
    padding-top: 0.08em;
  }

  .sp-spec dd {
    margin: 0;
    color: var(--label);
  }

  .sp-view {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .sp-gallery {
    display: grid;
    gap: 1.5rem 1rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 36rem) {
    .sp-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sp-gallery__lead {
      grid-column: 1 / -1;
    }
  }

  .sp-gallery__item {
    min-width: 0;
  }

  /* A pair of portraits: side by side from 36rem, and calmer 3:2 frames stacked on phones. */
  @media (width < 36rem) {
    .sp-gallery--pair :global(.photo__frame) {
      aspect-ratio: 3 / 2;
    }
  }

  /* Small tiles keep their captions short enough to sit under a half-width photo. */
  .sp-gallery__item:not(.sp-gallery__lead) :global(.photo__caption) {
    font-size: 0.9375rem;
  }

  /* The visit request: one quiet Frost panel across the column, the words beside the two actions on wide screens. */
  .sp-visit {
    display: grid;
    gap: 1.5rem 3rem;
    /* In px at the low end, so very large text keeps room for the words inside the panel. */
    padding: max(24px, min(5vw, 2.75rem));
    border-radius: var(--r-xl);
    background: var(--panel);
  }

  @media (min-width: 60rem) {
    .sp-visit {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      align-items: center;
    }

    .sp-visit__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  .sp-visit__copy {
    display: grid;
    gap: 0.75rem;
    max-width: 36rem;
  }

  @media (forced-colors: active) {
    .sp-visit {
      border: 1px solid CanvasText;
    }
  }
</style>
