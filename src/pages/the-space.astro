---
/**
 * The Space (docs/design/redesign-v7.md, "Version 9"): the title band, one block per space (its one photo
 * whole with the caption under it, beside two sentences, the capacity, and the key features), and the
 * amenities as one compact list. No gallery: the client asked for one real photo per subject, so each space
 * shows only its chosen photo (SUBJECT_PHOTO in src/data/photos.ts). No visit or "included" sections: the
 * visit request lives on Book, and what the rental includes on the home page.
 *
 * Each block's id is the space's name (#fireside-room, #stage-hall, #pine-garden). The version 8 ids (#hall,
 * #main-hall, #grove) are kept as empty anchors at the top of the same blocks, so old links still land on
 * the right space. This page is the one home of the features and the amenities; the capacities appear here
 * and on the home page's space cards.
 */
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageTextSplit from '../components/ImageTextSplit.astro';
import { site } from '../data/site';
import { spacePhoto, type VenuePhoto } from '../data/photos';
import { abs } from '../lib/schema';
import { withoutBase } from '../lib/paths';

const fireside = site.spaces.find((s) => s.id === 'indoor') ?? site.spaces[0];
const stageHall = site.spaces.find((s) => s.id === 'main') ?? site.spaces[1];
const pineGarden = site.spaces.find((s) => s.id === 'outdoor') ?? site.spaces[2];

const title = 'Event spaces in Suffolk, VA | The Venue @ NCC';
const description = `${fireside.name} and ${stageHall.name} for up to ${fireside.capacity} guests each, and ${pineGarden.name} for up to ${pineGarden.capacity}, at The Venue @ NCC in Suffolk, VA. See each space, its features, and the amenities.`;

interface SpaceBlock {
  id: 'fireside-room' | 'stage-hall' | 'pine-garden';
  /** The version 8 anchor, kept so old links land here. */
  oldId: 'hall' | 'main-hall' | 'grove';
  name: string;
  lead: string;
  capacity: number;
  features: string;
  photo: VenuePhoto | null;
  caption: string;
}

const spaces: SpaceBlock[] = [
  {
    id: 'fireside-room',
    oldId: 'hall',
    name: fireside.name,
    lead: 'A bright indoor room for receptions, dinners, showers, and meetings. Daylight comes through the arched windows, the fireplace wall is a natural focal point, and the open floor takes round tables, a long table, or rows of seats.',
    capacity: fireside.capacity,
    features: 'Arched windows, a fireplace feature wall, wood-look floors, recessed lighting, a wall-mounted screen, and double doors',
    photo: spacePhoto('hall'),
    caption: 'The arched windows and the fireplace wall',
  },
  {
    id: 'stage-hall',
    oldId: 'main-hall',
    name: stageHall.name,
    lead: 'A multi-purpose auditorium for ceremonies, conferences, and celebrations, where every seat has a clear view of the stage.',
    capacity: stageHall.capacity,
    features: 'A raised stage, rows of red upholstered chairs, a vaulted ceiling, and a wall-mounted screen',
    photo: spacePhoto('main'),
    caption: 'Red seats facing the raised stage',
  },
  {
    id: 'pine-garden',
    oldId: 'grove',
    name: pineGarden.name,
    lead: 'Our outdoor setting for ceremonies, reunions, and gatherings in the open air, with tall pines on every side.',
    capacity: pineGarden.capacity,
    features: 'A timber gazebo, picnic tables on a patio, open lawn, and paths through the trees',
    photo: spacePhoto('grove'),
    caption: 'The gazebo, the patio, and the picnic tables',
  },
];

// Structured data lists the photos on this page.
const pagePhotos = spaces.map((s) => s.photo).filter((p): p is VenuePhoto => p !== null);
const fullImages = await Promise.all(
  pagePhotos.map((p) => getImage({ src: p.src, width: Math.min(1600, p.src.width), format: 'jpg' })),
);
const gallerySchema =
  pagePhotos.length > 0
    ? [
        {
          '@type': 'ImageGallery',
          name: `${site.name} photos`,
          image: pagePhotos.map((p, i) => ({
            '@type': 'ImageObject',
            name: p.caption ?? p.alt,
            description: p.alt,
            contentUrl: abs(withoutBase(fullImages[i].src)),
          })),
        },
      ]
    : [];

const SPLIT_SIZES = '(min-width: 75rem) 620px, (min-width: 60rem) 50vw, 100vw';
---
<BaseLayout title={title} description={description} og="the-space" venueDetails schema={gallerySchema}>
  <section class="title-band" aria-labelledby="page-title">
    <div class="container title-band__inner">
      <h1 id="page-title">The Space</h1>
      <p class="t-lead">Two indoor rooms and an outdoor garden among the pines.</p>
    </div>
  </section>

  {
    spaces.map((s, i) => (
      <section id={s.id} class="section sp-target sp-space" aria-labelledby={`${s.id}-heading`}>
        <span id={s.oldId} class="sp-target sp-alias" aria-hidden="true" />
        <div class="container">
          {s.photo ? (
            <ImageTextSplit photo={s.photo} id={`${s.id}-heading`} heading={s.name} lead={s.lead} caption={s.caption} flip={i % 2 === 1} sizes={SPLIT_SIZES}>
              <dl class="sp-facts">
                <div class="sp-fact">
                  <dt>Capacity</dt>
                  <dd>Up to {s.capacity} guests</dd>
                </div>
                <div class="sp-fact">
                  <dt>Features</dt>
                  <dd>{s.features}</dd>
                </div>
              </dl>
            </ImageTextSplit>
          ) : (
            <div class="section-head">
              <h2 id={`${s.id}-heading`}>{s.name}</h2>
              <p class="t-lead">{s.lead}</p>
            </div>
          )}
        </div>
      </section>
    ))
  }

  {
    site.amenities.length > 0 && (
      <section id="amenities" class="section sp-target" aria-labelledby="amenities-heading">
        <div class="container">
          <h2 id="amenities-heading" class="sp-head">Amenities</h2>
          <dl class="sp-amenities">
            {site.amenities.map((a) => (
              <div class="sp-amenity">
                <dt>{a.name}</dt>
                <dd>{a.detail}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Links from the home page and the events page land just under the header. */
  .sp-target {
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }

  .sp-head {
    margin-bottom: var(--section-head);
    line-height: 1.08;
  }

  /* The fact row: LABEL / value pairs on a hairline under the lead. */
  .sp-facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem 2rem;
    width: 100%;
    margin: 0.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--separator);
  }

  @media (min-width: 36rem) {
    .sp-facts {
      grid-template-columns: minmax(7rem, 1fr) minmax(0, 2.6fr);
    }
  }

  .sp-fact,
  .sp-amenity {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .sp-fact dt,
  .sp-amenity dt {
    font-family: var(--font-serif);
    font-size: var(--t-caption);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--label-2);
  }

  .sp-fact dd,
  .sp-amenity dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--t-headline);
    line-height: 1.45;
    color: var(--label);
  }

  /*
    The version 8 anchor (#hall, #main-hall, #grove): an empty box at the very top of its block, so a link to
    it scrolls exactly as far as the block's own id does.
  */
  .sp-space {
    position: relative;
  }

  .sp-alias {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
  }

  /* The amenities: three short items on hairlines, in a row from 48rem. */
  .sp-amenities {
    display: grid;
    gap: 1.75rem 2.5rem;
    margin: 0;
  }

  @media (min-width: 48rem) {
    .sp-amenities {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .sp-amenity {
    padding-top: 1.25rem;
    border-top: 1px solid var(--separator);
  }
</style>
