---
/**
 * The Space (docs/design/redesign-v7.md, section 5, "/the-space/"), in this order: the page intro (the text
 * beside The Main Hall, with three links that jump to the spaces), each space as an editorial split with
 * its fact row (The Hall and The Grove each followed by two more views as figures), the amenities, the
 * grounds, what the rental includes, and the visit request. Nothing sits on any photo: every photo is
 * shown whole with its caption under it, and there is no in-page sticky bar.
 *
 * Real photos only, each shown once: main-hall (intro), hall-windows, hall-fireplace, hall-doors (The
 * Hall), main-hall-stage (The Main Hall), grove-tables, gazebo, grove-path (The Grove), approach-dusk (the
 * grounds). driveway is the home page's arrival photo and is not on this page.
 *
 * This page is the one home of the capacities, the features, the amenities, the grounds, what the rental
 * includes, and the visit request (redesign-v7.md, section 4). Rates, the address, and the phone and email
 * live on Rates and in the footer.
 */
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Figure from '../components/Figure.astro';
import FeatureStrip from '../components/FeatureStrip.astro';
import ImageTextSplit from '../components/ImageTextSplit.astro';
import Checklist from '../components/Checklist.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { photoByName, type VenuePhoto } from '../data/photos';
import { bookHref } from '../data/nav';
import { breadcrumbs, abs } from '../lib/schema';
import { href, withoutBase } from '../lib/paths';
import type { IconName } from '../shared/icons';

const hall = site.spaces.find((s) => s.id === 'indoor') ?? site.spaces[0];
const mainHall = site.spaces.find((s) => s.id === 'main') ?? site.spaces[1];
const grove = site.spaces.find((s) => s.id === 'outdoor') ?? site.spaces[2];

const title = 'Event spaces in Suffolk, VA | The Venue @ NCC';
const description = `${hall.name} and ${mainHall.name} for up to ${hall.capacity} guests each, and ${grove.name} for up to ${grove.capacity}, at The Venue @ NCC in Suffolk, VA. See the spaces, amenities, and grounds.`;
/** The page's place in the site, for structured data only: breadcrumbs are shown on event pages alone. */
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'The Space', path: '/the-space/' },
];

const introPhoto = photoByName('main-hall');

interface Fact {
  label: string;
  value: string;
}

interface Extra {
  photo: VenuePhoto | null;
  caption: string;
}

interface SpaceSection {
  id: 'hall' | 'main-hall' | 'grove';
  name: string;
  heading: string;
  lead: string;
  facts: Fact[];
  photo: VenuePhoto | null;
  caption: string;
  flip: boolean;
  extras: Extra[];
}

/** The three spaces, each with its primary photo, the facts the photos confirm, and any further views. */
const spaces: SpaceSection[] = [
  {
    id: 'hall',
    name: hall.name,
    heading: 'A bright, open room',
    lead: `${hall.name} is our indoor room for receptions, dinners, showers, meetings, and workshops: daylight from a row of arched windows, a fireplace feature wall as the natural focal point, and an open floor that takes round tables, a long table, or rows of seating.`,
    facts: [
      { label: 'Capacity', value: `Up to ${hall.capacity} guests` },
      { label: 'Features', value: 'Arched windows, a fireplace feature wall, dark wood-look floors, recessed lighting, a wall-mounted screen, and double doors' },
    ],
    photo: photoByName('hall-windows'),
    caption: 'The Hall, with its arched windows and fireplace wall',
    flip: false,
    extras: [
      { photo: photoByName('hall-fireplace'), caption: 'The open floor and the fireplace wall' },
      { photo: photoByName('hall-doors'), caption: 'The double doors and arched windows' },
    ],
  },
  {
    id: 'main-hall',
    name: mainHall.name,
    heading: 'Stage seating under a vaulted ceiling',
    lead: `${mainHall.name} is a high-capacity, multi-purpose auditorium with stage seating, fully equipped for weddings, corporate events, bridal showers, conferences, and large celebrations. Rows of upholstered chairs face the raised stage, so every seat has a clear view.`,
    facts: [
      { label: 'Capacity', value: `Up to ${mainHall.capacity} guests` },
      { label: 'Features', value: 'A raised stage with steps, rows of upholstered chairs, a vaulted ceiling with recessed lighting, and a wall-mounted screen' },
    ],
    photo: photoByName('main-hall-stage'),
    caption: 'The raised stage',
    flip: true,
    extras: [],
  },
  {
    id: 'grove',
    name: grove.name,
    heading: 'Among the pines',
    lead: `${grove.name} is our outdoor setting for ceremonies, reunions, and gatherings in the open air: a timber gazebo at its heart, picnic tables on a paved patio, open lawn, and tall pines on every side.`,
    facts: [
      { label: 'Capacity', value: `Up to ${grove.capacity} guests` },
      { label: 'Features', value: 'A timber gazebo with a metal roof, picnic tables on a patio, open lawn, and paths through the trees' },
    ],
    photo: photoByName('grove-tables'),
    caption: 'Picnic tables and the gazebo',
    flip: false,
    extras: [
      { photo: photoByName('gazebo'), caption: 'The gazebo' },
      { photo: photoByName('grove-path'), caption: 'The path to the gazebo' },
    ],
  },
];

/** The owner's amenities (site.amenities), each with a line icon. */
const AMENITY_ICONS: IconName[] = ['users', 'home', 'sparkles'];
const amenities = site.amenities.map((a, i) => ({ icon: AMENITY_ICONS[i % AMENITY_ICONS.length], name: a.name, text: a.detail }));

const grounds = photoByName('approach-dusk');

// Structured data lists the photos on this page.
const pagePhotos = [
  introPhoto,
  ...spaces.flatMap((s) => [s.photo, ...s.extras.map((e) => e.photo)]),
  grounds,
].filter((p): p is VenuePhoto => p !== null);
const fullImages = await Promise.all(
  pagePhotos.map((p) => getImage({ src: p.src, width: Math.min(1600, p.src.width), format: 'jpg' })),
);
const gallerySchema =
  pagePhotos.length > 0
    ? [
        {
          '@type': 'ImageGallery',
          name: `${site.name} photos`,
          image: pagePhotos.map((p, i) => ({
            '@type': 'ImageObject',
            name: p.caption ?? p.alt,
            description: p.alt,
            contentUrl: abs(withoutBase(fullImages[i].src)),
          })),
        },
      ]
    : [];

const SPLIT_SIZES = '(min-width: 75rem) 620px, (min-width: 60rem) 50vw, 100vw';
const EXTRA_SIZES = '(min-width: 75rem) 620px, (min-width: 46.5rem) 50vw, 100vw';
---
<BaseLayout title={title} description={description} og="the-space" venueDetails schema={[breadcrumbs(crumbs), ...gallerySchema]}>
  <PageIntro
    id="space-title"
    eyebrow="The Space"
    title="Three spaces, indoors and out"
    lead={`Well-maintained indoor and outdoor spaces surrounded by nature, with bright natural light and a dedicated stage area. Book one space, or ${hall.name} and ${grove.name} together.`}
    links={spaces.map((s) => ({ label: s.name, href: `#${s.id}` }))}
    linksLabel="The spaces"
    photo={introPhoto}
    caption="The Main Hall, down the aisle to the stage"
  />

  {
    spaces.map((s) => (
      <section id={s.id} class="section sp-target" aria-labelledby={`${s.id}-heading`}>
        <div class="container">
          {s.photo ? (
            <ImageTextSplit photo={s.photo} id={`${s.id}-heading`} eyebrow={s.name} heading={s.heading} lead={s.lead} caption={s.caption} flip={s.flip} sizes={SPLIT_SIZES}>
              <dl class="sp-facts">
                {s.facts.map((f) => (
                  <div class="sp-fact">
                    <dt>{f.label}</dt>
                    <dd>{f.value}</dd>
                  </div>
                ))}
              </dl>
            </ImageTextSplit>
          ) : (
            <SectionHeading id={`${s.id}-heading`} eyebrow={s.name} heading={s.heading} lead={s.lead} />
          )}
          {s.extras.some((e) => e.photo) && (
            <div class="sp-extras">
              {s.extras.map((e) => e.photo && <Figure photo={e.photo} caption={e.caption} tall={false} sizes={EXTRA_SIZES} />)}
            </div>
          )}
        </div>
      </section>
    ))
  }

  {
    amenities.length > 0 && (
      <section id="amenities" class="section sp-target" aria-labelledby="amenities-heading">
        <div class="container">
          <SectionHeading id="amenities-heading" eyebrow="Amenities" heading="Premium amenities" />
          <FeatureStrip items={amenities} />
        </div>
      </section>
    )
  }

  {
    grounds && (
      <section id="grounds" class="section sp-target" aria-labelledby="grounds-heading">
        <div class="container">
          <ImageTextSplit
            photo={grounds}
            id="grounds-heading"
            eyebrow="The grounds"
            heading="Renovated grounds and on-site parking"
            lead="On Godwin Boulevard in north Suffolk, a long paved drive leads past open lawn to the building and a large paved lot with landscaped islands, so guests park steps from the door."
            caption="The drive at dusk"
            flip
          >
            <Fragment slot="actions">
              <a class="btn btn--outline" href={site.address.directionsUrl} rel="noopener" target="_blank">
                Get Directions<span class="visually-hidden">, opens in a new tab</span>
              </a>
            </Fragment>
          </ImageTextSplit>
        </div>
      </section>
    )
  }

  <section id="included" class="section sp-target" aria-labelledby="included-heading">
    <div class="container sp-included">
      <SectionHeading
        id="included-heading"
        eyebrow="Every booking"
        heading="What the rental includes"
        lead="Every booking comes with the essentials, so you can plan the rest your way."
        class="sp-included__head"
      />
      <Checklist title="Included with the space" items={[...site.included]} class="sp-included__panel" />
    </div>
  </section>

  <section id="visit" class="section sp-target" aria-labelledby="visit-heading">
    <div class="container">
      <SectionHeading
        id="visit-heading"
        eyebrow="Visit"
        heading="Schedule a visit"
        lead="If you are interested in a walk-through or would like more information, please reach out. We would love to schedule a personal tour so you can see how the space fits your vision."
        class="sp-visit__head"
      >
        <Fragment slot="actions">
          <a class="btn btn--filled" href={`${href(bookHref)}?visit=1`}>Request a Visit</a>
          <a class="link-more" href={`tel:${site.contact.phoneE164}`}>Or call {site.contact.phone} <Icon name="chevron-right" /></a>
        </Fragment>
      </SectionHeading>
    </div>
  </section>
</BaseLayout>

<style>
  /* Links from the intro and from the home page land just under the header. */
  .sp-target {
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }

  /* The fact row: LABEL / value pairs on a hairline under the lead. */
  .sp-facts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem 2rem;
    width: 100%;
    margin: 0.25rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--separator);
  }

  @media (min-width: 36rem) {
    .sp-facts {
      grid-template-columns: minmax(7rem, 1fr) minmax(0, 2.6fr);
    }
  }

  .sp-fact {
    display: grid;
    gap: 0.35rem;
    align-content: start;
  }

  .sp-fact dt {
    font-family: var(--font-serif);
    font-size: var(--t-caption);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--label-2);
  }

  .sp-fact dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--t-headline);
    line-height: 1.45;
    color: var(--label);
  }

  /* Further views of a space: two figures in a row under its split, stacked on phones. */
  .sp-extras {
    display: grid;
    gap: 2rem clamp(2rem, 5vw, 5rem);
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
  }

  @media (min-width: 46.5rem) {
    .sp-extras {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem 1.5rem;
    }
  }

  /* What the rental includes: the heading beside one checklist panel. */
  .sp-included {
    display: grid;
    gap: 2rem 4rem;
    align-items: start;
  }

  .sp-included :global(.sp-included__head) {
    margin-bottom: 0;
  }

  @media (min-width: 60rem) {
    .sp-included {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  /* The visit request carries no content under its heading, so the heading keeps no bottom margin. */
  :global(.sp-visit__head) {
    margin-bottom: 0;
  }
</style>
