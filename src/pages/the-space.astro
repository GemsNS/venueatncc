---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArchFrame from '../components/ArchFrame.astro';
import LocationBand from '../components/LocationBand.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { photos, hasPhotos } from '../data/photos';
import { getImage } from 'astro:assets';
import { breadcrumbs, abs } from '../lib/schema';

const title = 'Inside the space | The Venue at NCC, Suffolk, VA';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'The space', path: '/the-space/' },
];

// Until there are photos or confirmed room details, this page is thin, so keep it out of search results.
const hasDetails = site.spaces.length > 0 || site.amenities.length > 0;
const indexable = hasPhotos || hasDetails;

const description = hasPhotos
  ? 'See the event space at The Venue at NCC on Godwin Boulevard in Suffolk, VA. View photos, then call to talk through your event and check your date.'
  : 'The event space of New Community Church on Godwin Boulevard in Suffolk, VA. Photos are coming soon. Call (757) 338-3432 to talk through your event.';

// Full-size, uncropped versions: linked from each gallery tile and listed in the gallery markup.
const fullImages = await Promise.all(
  photos.map((p) => getImage({ src: p.src, width: Math.min(1600, p.src.width), format: 'jpg' })),
);
const galleryImages = photos.map((p, i) => ({
  '@type': 'ImageObject',
  name: p.caption ?? p.alt,
  description: p.alt,
  contentUrl: abs(fullImages[i].src),
}));
const schema = [breadcrumbs(crumbs), ...(photos.length > 0 ? [{ '@type': 'ImageGallery', name: `${site.name} photos`, image: galleryImages }] : [])];

const fmt = (n: number) => n.toLocaleString('en-US');
---
<BaseLayout title={title} description={description} og="the-space" noindex={!indexable} schema={schema} venueDetails={hasDetails}>
  <section class="page-head">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="page-head__copy">
        <h1>Inside The Venue at NCC</h1>
        <p class="lead">
          {
            hasPhotos
              ? 'A look at the event space at New Community Church in Suffolk. Call to talk through how your event would come together here.'
              : 'Photos of the event space at New Community Church are coming soon. Until then, call and we will describe the space and talk through what your event needs.'
          }
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={`tel:${site.contact.phoneE164}`}>Call {site.contact.phone}</a>
          <a class="btn btn--secondary" href="/book/">Check your date</a>
        </div>
      </div>
    </div>
  </section>

  {
    site.spaces.length > 0 && (
      <section class="section" aria-labelledby="rooms-heading">
        <div class="container">
          <div class="section-head">
            <h2 id="rooms-heading">Rooms</h2>
          </div>
          <ul class="rooms">
            {site.spaces.map((room) => (
              <li class="room">
                <h3>{room.name}</h3>
                <p>{room.description}</p>
                {(room.seatedCapacity || room.standingCapacity || room.squareFeet) && (
                  <dl class="room__facts">
                    {room.seatedCapacity && (
                      <div>
                        <dt>Seated</dt>
                        <dd>Up to {fmt(room.seatedCapacity)} guests</dd>
                      </div>
                    )}
                    {room.standingCapacity && (
                      <div>
                        <dt>Standing</dt>
                        <dd>Up to {fmt(room.standingCapacity)} guests</dd>
                      </div>
                    )}
                    {room.squareFeet && (
                      <div>
                        <dt>Size</dt>
                        <dd>{fmt(room.squareFeet)} sq ft</dd>
                      </div>
                    )}
                  </dl>
                )}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  {
    site.amenities.length > 0 && (
      <section class="section section--tight amenities" aria-labelledby="amenities-heading">
        <div class="container">
          <div class="section-head">
            <h2 id="amenities-heading">What is available</h2>
          </div>
          <ul class="amenities__list">
            {site.amenities.map((a) => <li>{a}</li>)}
          </ul>
        </div>
      </section>
    )
  }

  <section class="section gallery-section" aria-labelledby="gallery-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="gallery-heading">Photos</h2>
        {hasPhotos && <p>Select a photo to see it uncropped.</p>}
      </div>
      {
        hasPhotos ? (
          <ul class="gallery">
            {photos.map((p, i) => (
              <li class="gallery__item">
                <a class="gallery__link" href={fullImages[i].src} target="_blank" rel="noopener">
                  <ArchFrame
                    photo={p}
                    variant={i}
                    trim={false}
                    sizes="(min-width: 1224px) 372px, (min-width: 640px) 45vw, 92vw"
                  />
                  <span class="visually-hidden"> (opens the full photo in a new tab)</span>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="gallery-empty">
            <div class="gallery-empty__arch">
              <ArchFrame variant={1} sizes="300px" />
            </div>
            <p class="lead">
              New photos of the venue will appear here. Until then, call{' '}
              <a href={`tel:${site.contact.phoneE164}`}>{site.contact.phone}</a> and we will describe the space.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <LocationBand heading="Where the venue is" />

  <CtaBand />
</BaseLayout>

<style>
  .rooms {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 760px) {
    .rooms {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .room {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .room h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--step-2);
  }

  .room__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
    margin: 0.5rem 0 0;
  }

  .room__facts dt {
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .room__facts dd {
    margin: 0;
    font-weight: 600;
  }

  .amenities {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  .amenities__list {
    columns: 3 14rem;
    column-gap: 3rem;
    margin: 0;
    padding-left: 1.1rem;
  }

  .amenities__list li {
    break-inside: avoid;
    margin-bottom: 0.5rem;
  }

  .gallery {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2.5rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .gallery__link {
    display: block;
    color: inherit;
  }

  .gallery__link:hover :global(.arch__window) {
    outline: 2px solid var(--brass);
    outline-offset: 4px;
  }

  .gallery-empty {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 720px) {
    .gallery-empty {
      grid-template-columns: minmax(200px, 300px) 1fr;
      gap: clamp(2.5rem, 6vw, 6rem);
    }
  }

  .gallery-empty__arch {
    width: min(70%, 300px);
    justify-self: center;
  }

  @media (min-width: 720px) {
    .gallery-empty__arch {
      width: 100%;
    }
  }
</style>
