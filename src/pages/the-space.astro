---
/**
 * The Space: a hero pair of The Hall and The Grove to match the title, then The Hall, The Grove, and The
 * grounds, each as a short spec sheet beside its real photos, then a visit request and the closing band.
 * Real photos only, with no toggles, no photo shown twice, and no two photos of the same view; only facts
 * the photos show (docs/design/brand.md, Photography).
 *
 * Each fact lives here once (brand.md, Redundancy rules): the capacities in the Capacity rows, parking in
 * the grounds Parking row, the visit request in the visit panel. The venue does not publish prices, so each
 * space's Rates row links to /pricing/ (Ask about rates) instead of naming an amount. Booking is the header CTA and the closing
 * band, the page's one filled button; the address and phone are in the footer.
 */
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { photoByName, photosFor, type VenuePhoto } from '../data/photos';
import { bookHref, pricingHref } from '../data/nav';
import { breadcrumbs, abs } from '../lib/schema';
import { href, withoutBase } from '../lib/paths';

const hall = site.spaces.find((s) => s.id === 'indoor') ?? site.spaces[0];
const grove = site.spaces.find((s) => s.id === 'outdoor') ?? site.spaces[1];

const title = 'The Hall and The Grove in Suffolk, VA | The Venue @ NCC';
const description = `The Hall for up to ${hall.capacity} guests and The Grove for up to ${grove.capacity} at The Venue @ NCC in Suffolk, VA. See both spaces, the grounds, and on-site parking.`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'The Space', path: '/the-space/' },
];

/** The hero pair: each space's primary photo, since the page title names both spaces. */
const heroPhotos = [
  { photo: photoByName('hall-windows') ?? photosFor('hall')[0] ?? null, caption: hall.name },
  { photo: photoByName('grove-tables') ?? photosFor('grove')[0] ?? null, caption: grove.name },
].filter((h): h is { photo: VenuePhoto; caption: string } => h.photo !== null);

/**
 * Each section's photos, by name, so every photo on the page is a different view. The hero looks down The
 * Hall to its arched windows, so The Hall's own photo faces the other way, to the double doors and the
 * screen; hall-fireplace, the same view as the hero from a step further back, is not on this page. The
 * hero shows The Grove's picnic tables, so its section has the gazebo up close and the path to it.
 */
const photosNamed = (...names: string[]) => names.map((n) => photoByName(n)).filter((p): p is VenuePhoto => p !== null);

/**
 * Crops for the pair of portrait frames a two-photo gallery uses. The grounds: the drive curving toward the
 * entry beside the full view of the lot. Both grounds photos look up the drive, so the building shows small
 * in each, as the end of the drive.
 */
const PAIR_CROPS: Record<string, string> = { 'approach-dusk': '0% 50%' };

interface Row {
  label: string;
  value: string;
  /** A base-relative path: the value is shown as a link to it. */
  href?: string;
}

/** Rates are quoted personally, so the row links to the inquiry page instead of naming an amount. */
const ratesRow: Row = { label: 'Rates', value: 'Ask about rates', href: pricingHref };

interface Section {
  id: string;
  heading: string;
  lead: string;
  rows: Row[];
  /** An outside link shown under the spec sheet, opened in a new tab. */
  link?: { label: string; href: string };
  photos: VenuePhoto[];
  /** Gallery first on wide screens, for rhythm down the page. */
  flip: boolean;
  grouped: boolean;
}

const sections: Section[] = [
  {
    id: 'hall',
    heading: hall.name,
    lead: 'Our indoor space: a bright, open room for receptions, dinners, showers, and meetings.',
    rows: [
      { label: 'Capacity', value: `Up to ${hall.capacity} guests` },
      { label: 'Features', value: 'Arched windows, a fireplace feature wall, dark wood-look floors, recessed lighting, and double doors' },
      ratesRow,
    ],
    photos: photosNamed('hall-doors'),
    flip: false,
    grouped: true,
  },
  {
    id: 'grove',
    heading: grove.name,
    lead: 'Our outdoor space: a wooded setting among tall pines for ceremonies, reunions, and gatherings in the open air.',
    rows: [
      { label: 'Capacity', value: `Up to ${grove.capacity} guests` },
      { label: 'Features', value: 'A timber gazebo with a metal roof, picnic tables on a patio, open lawn, and paths' },
      ratesRow,
    ],
    photos: photosNamed('gazebo', 'grove-path'),
    flip: true,
    grouped: false,
  },
  {
    id: 'grounds',
    heading: 'The grounds',
    lead: 'On Godwin Boulevard in north Suffolk, a long paved drive leads past open lawn to the building and a large paved lot.',
    rows: [{ label: 'Parking', value: 'On site, included with every booking' }],
    link: { label: 'Get Directions', href: site.address.directionsUrl },
    photos: photosNamed('approach-dusk', 'driveway'),
    flip: false,
    grouped: true,
  },
];

const LEAD_SIZES = '(min-width: 81.25rem) 680px, (min-width: 60rem) 56vw, 94vw';
const SMALL_SIZES = '(min-width: 81.25rem) 335px, (min-width: 60rem) 28vw, (min-width: 36rem) 46vw, 94vw';

// Structured data lists the photos on this page.
const pagePhotos = [...new Set([...heroPhotos.map((h) => h.photo), ...sections.flatMap((s) => s.photos)])];
const fullImages = await Promise.all(
  pagePhotos.map((p) => getImage({ src: p.src, width: Math.min(1600, p.src.width), format: 'jpg' })),
);
const gallerySchema =
  pagePhotos.length > 0
    ? [
        {
          '@type': 'ImageGallery',
          name: `${site.name} photos`,
          image: pagePhotos.map((p, i) => ({
            '@type': 'ImageObject',
            name: p.caption ?? p.alt,
            description: p.alt,
            contentUrl: abs(withoutBase(fullImages[i].src)),
          })),
        },
      ]
    : [];
---
<BaseLayout title={title} description={description} og="the-space" venueDetails schema={[breadcrumbs(crumbs), ...gallerySchema]}>
  <section class="sp-hero" aria-labelledby="space-title">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="sp-hero__head">
        <h1 id="space-title" class="t-large-title">Two spaces, indoors and out</h1>
        <p class="t-lead sp-hero__lead">
          {hall.name} and {grove.name} share one address in Suffolk. Book either space, or both together.
        </p>
      </div>
      {
        heroPhotos.length > 0 && (
          <ul class="sp-hero__pair">
            {heroPhotos.map((h) => (
              <li>
                <Photo photo={h.photo} priority ratio="3 / 2" caption={h.caption} class="sp-hero__photo" sizes="(min-width: 81.25rem) 590px, 47vw" />
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  {
    sections.map((s) => {
      return (
        <section id={s.id} class:list={['section', { 'section--grouped': s.grouped }]} aria-labelledby={`${s.id}-heading`}>
          <div class:list={['container', 'sp-space', { 'sp-space--flip': s.flip }]}>
            <div class="sp-space__head">
              <h2 id={`${s.id}-heading`} class="t-large-title">{s.heading}</h2>
              <p class="t-serif-lead">{s.lead}</p>
            </div>

            {s.photos.length > 0 && (
              <div class="sp-view">
                <ul class:list={['sp-gallery', { 'sp-gallery--pair': s.photos.length === 2 }]}>
                  {s.photos.map((p, i) => {
                    // Two photos sit side by side as equal portraits; one photo, or the first of three or more, is wide.
                    const pair = s.photos.length === 2;
                    const lead = !pair && i === 0;
                    const sizes = lead ? LEAD_SIZES : SMALL_SIZES;
                    const ratio = pair ? '4 / 5' : '3 / 2';
                    const crop = pair ? PAIR_CROPS[p.name] : undefined;
                    return (
                      <li class:list={['sp-gallery__item', { 'sp-gallery__lead': lead }]}>
                        <Photo photo={p} caption ratio={ratio} crop={crop} sizes={sizes} />
                      </li>
                    );
                  })}
                </ul>
              </div>
            )}

            <div class="sp-space__details">
              <dl class="sp-spec">
                {s.rows.map((r) => (
                  <div>
                    <dt>{r.label}</dt>
                    <dd>{r.href ? <a class="sp-spec__link" href={href(r.href)}>{r.value}</a> : r.value}</dd>
                  </div>
                ))}
              </dl>
              {s.link && (
                <a class="btn btn--tinted" href={s.link.href} target="_blank" rel="noopener">
                  <Icon name="arrow-up-right" />
                  {s.link.label}
                  <span class="visually-hidden">, opens in a new tab</span>
                </a>
              )}
            </div>
          </div>
        </section>
      );
    })
  }

  <section class="section" aria-labelledby="visit-heading">
    <div class="container">
      <div class="sp-visit">
        <div class="sp-visit__copy">
          <h2 id="visit-heading" class="t-title-1">Visit before you book</h2>
          <p class="secondary">
            See {hall.name} and {grove.name} in person. Send a visit request and we will arrange a time with you.
          </p>
        </div>
        <div class="btn-row btn-row--stack sp-visit__actions">
          <a class="btn btn--tinted" href={`${href(bookHref)}?visit=1`}>Request a Visit</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand body="Choose a date and a space and send your request in about two minutes. We confirm availability and send your quote personally." />
</BaseLayout>

<style>
  /* Hero: the title beside a short lead, then The Hall and The Grove side by side. */
  .sp-hero {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
  }

  .sp-hero__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem 3rem;
    margin-block: clamp(1.5rem, 1rem + 2vw, 3rem) clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  @media (min-width: 60rem) {
    .sp-hero__head {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: end;
    }
  }

  .sp-hero h1 {
    max-width: 14ch;
  }

  .sp-hero__lead {
    max-width: 36rem;
  }

  .sp-hero__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Portrait frames on phones, where two 3:2 frames side by side would be slivers. */
  @media (width < 36rem) {
    .sp-hero__pair {
      gap: 0.75rem;
    }

    .sp-hero :global(.sp-hero__photo .photo__frame) {
      aspect-ratio: 4 / 5;
    }
  }

  /*
    Each space: its heading, its photos, then the spec sheet. On wide screens the heading and the spec
    sheet share one column beside the gallery. Source order matches the phone layout, so focus order does too.
  */
  .sp-space {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem;
  }

  @media (min-width: 60rem) {
    .sp-space {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'head view'
        'details view';
      gap: 2rem clamp(2.5rem, 5vw, 5rem);
    }

    .sp-space--flip {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      grid-template-areas:
        'view head'
        'view details';
    }

    .sp-space__head {
      grid-area: head;
    }

    .sp-view {
      grid-area: view;
    }

    .sp-space__details {
      grid-area: details;
    }
  }

  .sp-space__details {
    display: grid;
    gap: 1.75rem;
    align-content: start;
    justify-items: start;
  }

  .sp-space__head {
    display: grid;
    gap: 1rem;
    max-width: 34rem;
  }

  .sp-spec {
    width: 100%;
    max-width: 34rem;
    margin: 0;
    border-top: 1px solid var(--separator);
  }

  .sp-spec > div {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    gap: 0.25rem 1rem;
    padding-block: 0.9rem;
    border-bottom: 1px solid var(--separator);
  }

  /* Narrow screens and large text: the label sits above its value. */
  @media (width < 30rem) {
    .sp-spec > div {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .sp-spec dt {
    color: var(--label-2);
    font-size: var(--t-subhead);
    line-height: 1.5;
    padding-top: 0.08em;
  }

  .sp-spec dd {
    margin: 0;
    color: var(--label);
  }

  /* A 44px target that keeps the row the height of its neighbours. */
  .sp-spec__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-block: -10px;
    color: var(--accent-text);
    font-weight: 500;
  }

  .sp-view {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .sp-gallery {
    display: grid;
    gap: 1.5rem 1rem;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 36rem) {
    .sp-gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .sp-gallery__lead {
      grid-column: 1 / -1;
    }
  }

  .sp-gallery__item {
    min-width: 0;
  }

  /* A pair of portraits sits side by side at every width, so a phone does not scroll through two tall frames. */
  .sp-gallery--pair {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 0.75rem;
  }

  @media (min-width: 36rem) {
    .sp-gallery--pair {
      gap: 1.5rem 1rem;
    }
  }

  /* Small tiles keep their captions short enough to sit under a half-width photo. */
  .sp-gallery__item:not(.sp-gallery__lead) :global(.photo__caption),
  .sp-hero__pair :global(.photo__caption) {
    font-size: 0.9375rem;
  }

  /*
    The visit request: one quiet Frost panel across the column, the words beside the action on wide screens.
    Request a Visit is tinted: the closing band's Check Availability is the page's one filled button.
  */
  .sp-visit {
    display: grid;
    gap: 1.5rem 3rem;
    /* In px at the low end, so very large text keeps room for the words inside the panel. */
    padding: max(24px, min(5vw, 2.75rem));
    border-radius: var(--r-xl);
    background: var(--panel);
  }

  @media (min-width: 60rem) {
    .sp-visit {
      grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
      align-items: center;
    }

    .sp-visit__actions {
      flex-direction: column;
      align-items: stretch;
    }
  }

  .sp-visit__copy {
    display: grid;
    gap: 0.75rem;
    max-width: 36rem;
  }

  @media (forced-colors: active) {
    .sp-visit {
      border: 1px solid CanvasText;
    }
  }
</style>
