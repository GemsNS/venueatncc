---
/**
 * The 404 page (redesign-spec.md, "/404"; the reference's not-found page): a full-bleed photo hero with the
 * caption panel, then a short serif lead and a plain list of serif links (Home, Check Availability, Rates,
 * Events). The gazebo is the one photo, so nothing repeats. The page is noindex and carries no closing band:
 * the list already offers Check Availability, and the header does too.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { photoByName } from '../data/photos';
import { bookHref, pricingHref } from '../data/nav';
import { href } from '../lib/paths';

const photo = photoByName('gazebo');
const links = [
  { label: 'Home', href: '/' },
  { label: 'Check Availability', href: bookHref },
  { label: 'Rates', href: pricingHref },
  { label: 'Events', href: '/events/' },
];
---
<BaseLayout
  title={`Page not found | ${site.name}`}
  description="This page does not exist. Find events, rates, and open dates at The Venue @ NCC, an event venue in Suffolk, Virginia."
  noindex
>
  {
    photo ? (
      <PageHero photo={photo} id="nf-title" eyebrow="Page not found" title="This page could not be found" />
    ) : (
      <section class="section">
        <div class="container section-head">
          <p class="eyebrow">Page not found</p>
          <h1 id="nf-title">This page could not be found</h1>
        </div>
      </section>
    )
  }

  <section class="section nf">
    <div class="container nf__inner">
      <p class="nf__lead t-serif-lead">The link may be out of date, or the address may have a typo. These pages can help.</p>
      <ul class="nf__links" aria-label="Helpful pages">
        {
          links.map((l) => (
            <li>
              <a class="nf__link" href={href(l.href)}>
                <span>{l.label}</span>
                <Icon name="chevron-right" />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="nf__phone t-copy secondary">
        Or call us at <a href={`tel:${site.contact.phoneE164}`}>{site.contact.phone}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  /* The container keeps its gutters; the copy and the list set their own measures inside it. */
  .nf__inner {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .nf__lead {
    max-width: 34rem;
  }

  /* The reference's plain list of serif links, each a full-height target. */
  .nf__links {
    display: grid;
    width: 100%;
    max-width: 24rem;
    margin: 0.75rem 0;
    padding: 0;
    list-style: none;
  }

  .nf__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 52px;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--separator);
    font-family: var(--font-serif);
    font-size: var(--t-title-3);
    color: var(--label);
    text-decoration: none;
  }

  .nf__links li:first-child .nf__link {
    border-top: 1px solid var(--separator);
  }

  .nf__link .icon {
    width: 1.1em;
    height: 1.1em;
    color: var(--accent-icon);
    transition: transform var(--dur-2) var(--ease-spring);
  }

  .nf__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .nf__link:hover .icon {
    transform: translateX(3px);
  }

  .nf__phone a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  @media (min-width: 64rem) {
    .nf__inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem 4rem;
      align-items: start;
    }

    .nf__links {
      grid-row: 1 / 3;
      grid-column: 2;
      max-width: 28rem;
      margin: 0;
    }
  }
</style>
