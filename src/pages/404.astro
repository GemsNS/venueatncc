---
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { photoByName } from '../data/photos';
import { bookHref, pricingHref } from '../data/nav';
import { href } from '../lib/paths';

const photo = photoByName('gazebo');
---
<BaseLayout
  title={`Page not found | ${site.name}`}
  description="This page does not exist. Find events, pricing, and open dates at The Venue at NCC, an event venue in Suffolk, Virginia."
  noindex
>
  <section class="section">
    <div class="container nf">
      <div class="nf__copy">
        <h1 class="t-large-title">This page could not be found.</h1>
        <p class="t-lead">The link may be out of date, or the address may have a typo. These pages can help.</p>
        <ul class="list-group nf__links">
          <li><a class="list-row" href={href('/')}><Icon name="home" /><span class="list-row__main">Home</span><Icon name="chevron-right" class="nf__chevron" /></a></li>
          <li><a class="list-row" href={href(bookHref)}><Icon name="calendar" /><span class="list-row__main">Check availability</span><Icon name="chevron-right" class="nf__chevron" /></a></li>
          <li><a class="list-row" href={href(pricingHref)}><Icon name="tag" /><span class="list-row__main">Pricing</span><Icon name="chevron-right" class="nf__chevron" /></a></li>
          <li><a class="list-row" href={href('/events/')}><Icon name="party-popper" /><span class="list-row__main">Events</span><Icon name="chevron-right" class="nf__chevron" /></a></li>
        </ul>
      </div>
      {photo && <Photo photo={photo} tall class="nf__photo" sizes="(min-width: 64rem) 520px, 100vw" />}
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: 3rem 4rem;
    align-items: center;
  }

  @media (min-width: 64rem) {
    .nf {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    }
  }

  .nf__copy {
    display: grid;
    gap: 1.25rem;
  }

  .nf__links {
    max-width: 30rem;
    margin-top: 0.5rem;
    box-shadow: var(--shadow-1);
    border: 1px solid var(--separator);
  }

  .nf__links a {
    color: var(--label);
  }

  .nf__links a:hover {
    text-decoration: none;
    background: var(--fill-3);
  }

  /* The list clips its corners, so the focus ring sits inside the row. */
  .nf__links a:focus-visible {
    outline-offset: -3px;
    border-radius: 0;
  }

  .nf__links :global(.icon) {
    color: var(--accent-text);
  }

  .nf__links :global(.nf__chevron) {
    color: var(--label-3);
  }
</style>
