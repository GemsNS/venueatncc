---
/**
 * The 404 page (docs/design/redesign-v7.md, section 5, "/404"): the page intro with the text beside the
 * gazebo, never over it: the eyebrow, the h1, the lead, a plain list of serif links (Home, Check
 * Availability, The Space, Events, Rates & FAQ), and the phone line. The gazebo is the one photo. The page is
 * noindex and carries no structured data.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { photoByName } from '../data/photos';
import { bookHref, pricingHref } from '../data/nav';
import { href } from '../lib/paths';

const photo = photoByName('gazebo');
const links = [
  { label: 'Home', href: '/' },
  { label: 'Check Availability', href: bookHref },
  { label: 'The Space', href: '/the-space/' },
  { label: 'Events', href: '/events/' },
  { label: 'Rates & FAQ', href: pricingHref },
];
---
<BaseLayout
  title={`Page not found | ${site.name}`}
  description="This page does not exist. Find events, rates, and open dates at The Venue @ NCC, an event venue in Suffolk, Virginia."
  noindex
>
  <PageIntro
    id="nf-title"
    eyebrow="Page not found"
    title="This page could not be found"
    lead="The link may be out of date, or the address may have a typo. These pages can help."
    photo={photo}
    caption="The gazebo in The Grove"
  >
    <ul class="nf__links" aria-label="Helpful pages">
      {
        links.map((l) => (
          <li>
            <a class="nf__link" href={href(l.href)}>
              <span>{l.label}</span>
              <Icon name="chevron-right" />
            </a>
          </li>
        ))
      }
    </ul>
    <p class="nf__phone t-copy">
      Or call us at <a href={`tel:${site.contact.phoneE164}`}>{site.contact.phone}</a>.
    </p>
  </PageIntro>
</BaseLayout>

<style>
  /* The reference's plain list of serif links, each a full-height target. */
  .nf__links {
    display: grid;
    width: 100%;
    max-width: 28rem;
    margin: 0.5rem 0;
    padding: 0;
    list-style: none;
  }

  .nf__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 52px;
    padding-block: 0.6rem;
    border-bottom: 1px solid var(--separator);
    font-family: var(--font-serif);
    font-size: var(--t-title-3);
    color: var(--label);
    text-decoration: none;
  }

  .nf__links li:first-child .nf__link {
    border-top: 1px solid var(--separator);
  }

  .nf__link :global(.icon) {
    width: 1.1em;
    height: 1.1em;
    color: var(--accent-icon);
    transition: transform var(--dur-2) var(--ease-spring);
  }

  .nf__link:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .nf__link:hover :global(.icon) {
    transform: translateX(3px);
  }

  .nf__phone {
    color: var(--label-2);
  }

  .nf__phone a {
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }
</style>
