---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchFrame from '../components/ArchFrame.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
import { bookHref } from '../data/nav';
import { href } from '../lib/paths';
---
<BaseLayout title={`Page not found | ${site.name}`} description="This page does not exist. Find events, pricing, and open dates at The Venue at NCC in Suffolk, VA." noindex>
  <section class="section">
    <div class="container nf">
      <div class="nf__copy">
        <h1 class="t-large-title">This page could not be found.</h1>
        <p class="t-lead">The link may be out of date, or the address may have a typo. Try one of these instead.</p>
        <ul class="list-group nf__links">
          <li><a class="list-row" href={href('/')}><Icon name="home" /><span class="list-row__main">Home</span><Icon name="chevron-right" /></a></li>
          <li><a class="list-row" href={href(bookHref)}><Icon name="calendar" /><span class="list-row__main">Check availability</span><Icon name="chevron-right" /></a></li>
          <li><a class="list-row" href={href('/pricing/')}><Icon name="tag" /><span class="list-row__main">Pricing</span><Icon name="chevron-right" /></a></li>
          <li><a class="list-row" href={href('/events/')}><Icon name="party-popper" /><span class="list-row__main">Events</span><Icon name="chevron-right" /></a></li>
        </ul>
      </div>
      <div class="nf__media">
        <ArchFrame variant={2} sizes="280px" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    display: grid;
    gap: 3rem;
    align-items: center;
  }

  @media (min-width: 820px) {
    .nf {
      grid-template-columns: 1.4fr 1fr;
    }
  }

  .nf__copy {
    display: grid;
    gap: 1.25rem;
  }

  .nf__links {
    box-shadow: var(--shadow-1);
    max-width: 480px;
  }

  .nf__links a {
    color: var(--label);
  }

  .nf__links a:hover {
    text-decoration: none;
    background: var(--fill-3);
  }

  .nf__links :global(.icon) {
    color: var(--accent-text);
  }

  .nf__media {
    width: min(60%, 280px);
    justify-self: center;
  }
</style>
