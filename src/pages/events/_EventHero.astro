---
/**
 * The events pages' hero: PageHero (the reference's venue-page hero) with one adjustment for the staged
 * event photos, which exist only as 3:2 files. PageHero fills its frame with the 4:5 portrait file on
 * phones; without one it would cover-crop the landscape file into a tall frame and cut the scene's sides
 * off (brand.md, "No cropped subjects"). So below 46.5rem this wrapper shows the photo whole, full bleed at
 * its own 3:2 shape, and sets the caption on the Blush page beneath it in the page's own colors (the way
 * the reference's venues index titles its phone page). From 46.5rem the hero is PageHero as built: the
 * photo under the Plum scrim with the translucent caption panel bottom-left, its height capped at 76vw so a
 * tablet crops little from the sides. The staged photo keeps its Styled Concept badge in both layouts.
 */
import PageHero from '../../components/PageHero.astro';
import type { VenuePhoto } from '../../data/photos';

interface Props {
  photo: VenuePhoto;
  id: string;
  title: string;
  eyebrow?: string;
  descriptors?: string[];
  facts?: { label: string; value: string }[];
}

const { photo, id, title, eyebrow, descriptors = [], facts = [] } = Astro.props;
---
<PageHero photo={photo} id={id} title={title} eyebrow={eyebrow} descriptors={descriptors} facts={facts} height="min(72svh, 76vw)" class="ev-hero">
  <slot />
</PageHero>

<style is:global>
  /* A link inside the caption panel takes the panel's color: white over the photo, Plum on the page. */
  .ev-hero .link-more {
    color: inherit;
  }

  .ev-hero .link-more:focus-visible {
    outline-color: var(--on-dark-accent);
    outline-offset: 4px;
  }

  /* Phones: the photo whole, then the caption on the page. Doubled class outranks PageHero's scoped rules. */
  @media (width < 46.5rem) {
    .ev-hero.ev-hero {
      display: block;
      min-height: 0;
      color: var(--label);
    }

    .ev-hero.ev-hero .phero__media {
      position: relative;
      inset: auto;
      z-index: auto;
    }

    .ev-hero.ev-hero .phero__photo,
    .ev-hero.ev-hero .phero__photo .photo__frame {
      height: auto;
    }

    .ev-hero.ev-hero .phero__photo .photo__frame {
      aspect-ratio: 3 / 2;
    }

    .ev-hero.ev-hero .phero__scrim {
      display: none;
    }

    .ev-hero.ev-hero .phero__inner {
      padding-block: 1.75rem 0;
    }

    .ev-hero.ev-hero .phero__panel {
      padding: 0;
      border-radius: 0;
      background: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }

    .ev-hero.ev-hero .phero__eyebrow {
      color: var(--accent-text);
    }

    .ev-hero.ev-hero .phero__title {
      color: var(--label);
    }

    .ev-hero.ev-hero .phero__descriptors {
      color: var(--label-2);
    }

    .ev-hero.ev-hero .phero__facts {
      border-top-color: var(--separator);
    }

    .ev-hero.ev-hero .phero__fact dt {
      color: var(--label-2);
    }

    .ev-hero.ev-hero .phero__fact dd {
      color: var(--label);
    }

    .ev-hero .link-more:focus-visible {
      outline-color: var(--focus-ring);
    }
  }
</style>
