---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchFrame from '../../components/ArchFrame.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EventIndex from '../../components/EventIndex.astro';
import FaqList from '../../components/FaqList.astro';
import FactStrip from '../../components/FactStrip.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { events, type EventType } from '../../data/events';
import { eventTypes } from '../../data/event-types';
import { site } from '../../data/site';
import { eventPhoto } from '../../data/photos';
import { bookHref, pricingHref } from '../../data/nav';
import { breadcrumbs, eventService, faqPage } from '../../lib/schema';
import { href } from '../../lib/paths';
import { priceSummary, formatUSD } from '../../shared/pricing';

export const getStaticPaths = (() =>
  events.map((event, index) => ({ params: { slug: event.slug }, props: { event, index } }))) satisfies GetStaticPaths;

interface Props {
  event: EventType;
  index: number;
}
const { event, index } = Astro.props;
const path = `/events/${event.slug}/`;
const photo = eventPhoto(event.slug);
const icon = eventTypes.find((t) => t.slug === event.slug)?.icon ?? 'party-popper';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Events', path: '/events/' },
  { name: event.name, path },
];
const related = event.related.filter((slug) => slug !== event.slug && events.some((e) => e.slug === slug));
const { fromHourly } = priceSummary();
const bookLink = `${href(bookHref)}?event=${encodeURIComponent(event.slug)}`;

const schema = [
  breadcrumbs(crumbs),
  eventService({ name: `${event.name} at ${site.name}`, description: event.metaDescription, path, serviceType: event.name }),
  ...(event.faqs.length > 0 ? [faqPage(event.faqs)] : []),
];
---
<BaseLayout title={event.metaTitle} description={event.metaDescription} og={event.slug} ogAlt={`${event.name} at ${site.name} in Suffolk, Virginia`} schema={schema}>
  <section class="ev-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="ev-hero__grid">
        <div class="ev-hero__copy">
          <span class="badge badge--accent ev-hero__tag"><Icon name={icon} /> {event.name}</span>
          <h1 class="t-large-title">{event.h1}</h1>
          <p class="t-lead">{event.intro[0]}</p>
          <div class="btn-row">
            <a class="btn btn--filled btn--lg" href={bookLink}>Check Availability</a>
            <a class="link-more" href={href(pricingHref)}>From {formatUSD(fromHourly)} an hour <Icon name="chevron-right" /></a>
          </div>
        </div>
        <div class="ev-hero__media">
          <ArchFrame photo={photo} variant={index} priority sizes="(min-width: 960px) 400px, 72vw" />
        </div>
      </div>
      <FactStrip class="ev-hero__facts" />
    </div>
  </section>

  <section class="section section--grouped">
    <div class="container ev-body">
      <article class="prose ev-article card">
        {event.intro.slice(1).map((p) => <p class="ev-opening">{p}</p>)}
        {
          event.sections.map((s) => (
            <section>
              <h2>{s.heading}</h2>
              {s.body.map((p) => <p>{p}</p>)}
            </section>
          ))
        }
      </article>

      <aside class="ev-aside" aria-labelledby="checklist-heading">
        <div class="card ev-checklist">
          <h2 id="checklist-heading" class="t-title-3">{event.checklist.heading}</h2>
          <ul>
            {
              event.checklist.items.map((item) => (
                <li>
                  <Icon name="check-circle" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
          <a class="btn btn--filled" href={bookLink}>Check Availability</a>
        </div>
      </aside>
    </div>
  </section>

  {
    event.faqs.length > 0 && (
      <section class="section" aria-labelledby="ev-faq-heading">
        <div class="container ev-faq">
          <div class="section-head">
            <h2 id="ev-faq-heading">Questions about {event.name.toLowerCase()}</h2>
            <p class="t-lead">Straight answers before you book.</p>
          </div>
          <FaqList items={event.faqs} />
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section section--grouped" aria-labelledby="related-heading">
        <div class="container">
          <div class="section-head">
            <h2 id="related-heading">Other events at The Venue at NCC</h2>
          </div>
          <EventIndex only={related} />
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>

<style>
  .ev-hero {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .ev-hero__grid {
    display: grid;
    gap: clamp(2rem, 1.5rem + 3vw, 4rem);
    align-items: center;
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  @media (min-width: 960px) {
    .ev-hero__grid {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    }
  }

  .ev-hero__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }

  .ev-hero__tag {
    font-size: var(--t-subhead);
    padding: 0.35rem 0.8rem;
  }

  .ev-hero__copy .btn-row {
    gap: 1.25rem;
  }

  .ev-hero__media {
    width: min(100%, 400px);
    justify-self: center;
  }

  @media (max-width: 959.98px) {
    .ev-hero__media {
      width: min(72%, 340px);
    }
  }

  .ev-hero :global(.ev-hero__facts) {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .ev-body {
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }

  @media (min-width: 1000px) {
    .ev-body {
      grid-template-columns: minmax(0, 1fr) 360px;
    }
  }

  .ev-article {
    padding: clamp(1.5rem, 1rem + 2.5vw, 3rem);
    max-width: none;
  }

  .ev-article section + section,
  .ev-opening + section {
    margin-top: 2.25rem;
  }

  .ev-opening {
    font-size: 1.125rem;
    color: var(--label-2);
  }

  .ev-aside {
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
  }

  @media (max-width: 999.98px) {
    .ev-aside {
      position: static;
    }
  }

  .ev-checklist {
    display: grid;
    gap: 1.1rem;
    padding: 1.75rem;
  }

  .ev-checklist ul {
    display: grid;
    gap: 0.85rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-subhead);
  }

  .ev-checklist li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
    align-items: start;
  }

  .ev-checklist li :global(.icon) {
    color: var(--accent-text);
    margin-top: 0.1em;
  }

  .ev-faq {
    display: grid;
    gap: 2rem clamp(2rem, 6vw, 5rem);
  }

  @media (min-width: 900px) {
    .ev-faq {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }
  }
</style>
