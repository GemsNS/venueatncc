---
/**
 * An event landing page: hero, planning guide and checklist, shared-info line, FAQs, related events,
 * closing band. Copy lives in src/data/events.ts.
 *
 * Photos follow one rule (docs/design/brand.md, "Photography"). The hero is eventPhoto(slug): while the
 * staged set is complete (eventsStaged) it is the event's staged photo, which Photo shows with its
 * Styled Concept badge, under the caption "Styled concept. Décor is not included."; otherwise it is the
 * event's real photo, with no badge and no caption. No image appears twice on a page: the related tiles
 * show other events' staged photos, or no photos at all while the set is incomplete.
 *
 * Facts that are the same for every event (rates, packages, deposits, fees, payments, parking, visits)
 * live on the pricing page and /faq/. This page links to them in one line instead of repeating them.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EventIndex from '../../components/EventIndex.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import Photo from '../../components/Photo.astro';
import { events, type EventType } from '../../data/events';
import { site } from '../../data/site';
import { eventPhoto, eventsStaged, STYLED_CAPTION } from '../../data/photos';
import { bookHref, pricingHref } from '../../data/nav';
import { breadcrumbs, eventService, faqPage } from '../../lib/schema';
import { href } from '../../lib/paths';

export const getStaticPaths = (() => events.map((event) => ({ params: { slug: event.slug }, props: { event } }))) satisfies GetStaticPaths;

interface Props {
  event: EventType;
}
const { event } = Astro.props;
const path = `/events/${event.slug}/`;
const photo = eventPhoto(event.slug);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Events', path: '/events/' },
  { name: event.name, path },
];

// The booking page with this event already chosen. Base-relative: href() adds the base where it renders.
const eventBookPath = `${bookHref}?event=${encodeURIComponent(event.slug)}`;
const visitLink = href(`${eventBookPath}&visit=1`);
const plainName = event.name.replace(/&/g, 'and').toLowerCase();
// Phone numbers in the copy become tap-to-call links that never break across lines.
const PHONE = site.contact.phone;
const tel = `tel:${site.contact.phoneE164}`;
const splitPhone = (text: string) => text.split(PHONE);

// Three related events: the event's own related list first, then the other events in list order. The
// tiles never repeat the hero: with the staged set each tile shows its own event's staged photo, and
// without it every tile is text (EventIndex).
const RELATED_COUNT = 3;
const related = [...new Set([...event.related, ...events.map((e) => e.slug)])]
  .filter((slug) => slug !== event.slug && events.some((e) => e.slug === slug))
  .slice(0, RELATED_COUNT);

const schema = [
  breadcrumbs(crumbs),
  eventService({ name: `${event.name} at ${site.name}`, description: event.metaDescription, path, serviceType: event.name }),
  ...(event.faqs.length > 0 ? [faqPage(event.faqs)] : []),
];
---
<BaseLayout title={event.metaTitle} description={event.metaDescription} og={event.slug} schema={schema} bookPath={eventBookPath}>
  <section class="ev-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="ev-hero__grid">
        <div class="ev-hero__copy">
          <h1 class="t-large-title">{event.h1}</h1>
          <p class="t-lead">{splitPhone(event.intro[0]).map((chunk, i) => (i === 0 ? chunk : <><a class="ev-tel" href={tel}>{PHONE}</a>{chunk}</>))}</p>
        </div>
        {
          photo && (
            <Photo
              photo={photo}
              ratio="3 / 2"
              priority
              caption={eventsStaged ? STYLED_CAPTION : false}
              class="ev-hero__photo"
              sizes="(min-width: 75rem) 680px, (min-width: 64rem) 56vw, calc(100vw - 2rem)"
            />
          )
        }
      </div>
    </div>
  </section>

  <section class="ev-main" aria-label="Planning guide">
    <div class="container ev-body">
      <article class="ev-article">
        {event.intro.slice(1).map((p) => <p class="ev-opening t-serif-lead">{splitPhone(p).map((chunk, i) => (i === 0 ? chunk : <><a class="ev-tel" href={tel}>{PHONE}</a>{chunk}</>))}</p>)}
        {
          event.sections.map((s) => (
            <section class="ev-section">
              <h2>{s.heading}</h2>
              {s.body.map((p) => <p>{splitPhone(p).map((chunk, i) => (i === 0 ? chunk : <><a class="ev-tel" href={tel}>{PHONE}</a>{chunk}</>))}</p>)}
            </section>
          ))
        }
        <p class="ev-shared">
          Every event books from one rate card: the <a href={href(pricingHref)}>pricing page</a> gives an instant estimate for your
          date, and the <a href={href('/faq/')}>FAQ</a> covers payments, parking, and visits.
        </p>
      </article>

      <aside class="ev-aside" aria-labelledby="checklist-heading">
        <div class="ev-checklist">
          <h2 id="checklist-heading" class="t-title-3">{event.checklist.heading}</h2>
          <ul>
            {
              event.checklist.items.map((item) => (
                <li>
                  <Icon name="check-circle" />
                  <span>{splitPhone(item).map((chunk, i) => (i === 0 ? chunk : <><a class="ev-tel" href={tel}>{PHONE}</a>{chunk}</>))}</span>
                </li>
              ))
            }
          </ul>
          <a class="btn btn--tinted ev-checklist__visit" href={visitLink}>Request a Visit</a>
        </div>
      </aside>
    </div>
  </section>

  {
    event.faqs.length > 0 && (
      <section class="section section--grouped" aria-labelledby="ev-faq-heading">
        <div class="container ev-faq">
          <div class="section-head">
            <h2 id="ev-faq-heading">Questions about {plainName}</h2>
          </div>
          <FaqList items={event.faqs} />
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section" aria-labelledby="related-heading">
        <div class="container">
          <div class="section-head">
            <h2 id="related-heading">Other events we host</h2>
          </div>
          <EventIndex only={related} layout="trio" />
        </div>
      </section>
    )
  }

  <CtaBand body="Choose a date and a space, see an instant estimate, and send your request in about two minutes." bookHref={eventBookPath} />
</BaseLayout>

<style>
  /* ---------- Hero: copy beside a rectangular photo ---------- */

  .ev-hero {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .ev-hero__grid {
    display: grid;
    gap: clamp(1.75rem, 1.25rem + 2vw, 3rem);
    align-items: center;
    margin-top: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
  }

  @media (min-width: 64rem) {
    .ev-hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(2.5rem, 4vw, 4rem);
    }
  }

  .ev-hero__copy {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    max-width: 40rem;
  }

  /* ---------- Planning guide and checklist ---------- */

  .ev-main {
    padding-block: clamp(2.5rem, 2rem + 3vw, 4.5rem) var(--section);
    border-top: 1px solid var(--separator);
  }

  .ev-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }

  @media (min-width: 64rem) {
    .ev-body {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
      gap: clamp(3rem, 6vw, 6rem);
    }
  }

  .ev-article {
    max-width: 40rem;
  }

  /* Smaller than the section headings on phones, so the Caslon h2s still lead. */
  .ev-opening {
    font-size: clamp(1.1875rem, 1rem + 0.8vw, 1.5rem);
    margin-bottom: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .ev-section + .ev-section {
    margin-top: clamp(2.25rem, 1.75rem + 2vw, 3rem);
  }

  /* Caslon Display stays at 28px and up (brand.md). */
  .ev-section h2 {
    font-size: min(clamp(1.75rem, 1.5rem + 0.9vw, 2.125rem), 10vw);
    line-height: 1.15;
    margin-bottom: 0.9rem;
  }

  .ev-section p {
    font-size: var(--t-body);
    line-height: 1.6;
    color: var(--label);
  }

  /* The one line that points to the facts every event shares, set apart from the event's own guide. */
  .ev-shared {
    margin-top: clamp(2.25rem, 1.75rem + 2vw, 3rem);
    padding-top: 1.25rem;
    border-top: 1px solid var(--separator);
    font-size: var(--t-body);
    line-height: 1.6;
    color: var(--label-2);
  }

  /* Tap-to-call numbers in the copy stay on one line and are underlined like other inline links. */
  .ev-tel {
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  .ev-aside {
    position: sticky;
    top: calc(var(--nav-h) + 1.5rem);
  }

  @media (max-width: 63.99rem) {
    .ev-aside {
      position: static;
      max-width: 40rem;
    }
  }

  .ev-checklist {
    display: grid;
    gap: 1.25rem;
    padding: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    border-radius: var(--r-lg);
    background: var(--panel);
  }

  .ev-checklist ul {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--t-subhead);
    line-height: 1.45;
  }

  .ev-checklist li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.7rem;
    align-items: start;
  }

  .ev-checklist li :global(.icon) {
    color: var(--accent-icon);
    margin-top: 0.05em;
  }

  .ev-checklist__visit {
    justify-self: start;
    margin-top: 0.25rem;
  }

  /* ---------- FAQ ---------- */

  .ev-faq {
    display: grid;
    gap: 2rem clamp(2rem, 6vw, 5rem);
  }

  @media (min-width: 60rem) {
    .ev-faq {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }
  }
</style>
