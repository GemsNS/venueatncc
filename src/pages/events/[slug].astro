---
/**
 * An event landing page (docs/design/redesign-v7.md, section 5, "/events/[slug]/"): the page intro (the
 * breadcrumbs, the h1, the intro, and the event's spaces as links to their sections on The Space, beside
 * the event's photo), the first planning section beside a second view of the space, the rest of the
 * planning guide, the checklist, the questions, and three other events as text links. Nothing sits on any
 * photo, and there is no in-page sticky bar. Copy lives in src/data/events.ts.
 *
 * Photos follow one rule (docs/design/brand.md, "Photography"). The intro photo is eventPhoto(slug): while
 * the staged set is complete (eventsStaged) it is the event's staged photo, its caption beginning "Styled
 * concept. Décor is not included."; otherwise it is the event's real photo. The second view: on the
 * weddings page the styled indoor ceremony (with its own disclosure); on every other page the real
 * photograph of the event's first space, in a view the staged photo is not made from (ABOUT_PHOTOS below),
 * captioned "<space>, as photographed". No image appears twice on a page.
 *
 * Facts that are the same for every event (rates, deposits, parking, visits) have their homes on Rates,
 * The Space, and the FAQ (redesign-v7.md, section 4); this page links to them (Request a Visit, Ask about
 * rates) beside the checklist instead of repeating them.
 */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ImageTextSplit from '../../components/ImageTextSplit.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Checklist from '../../components/Checklist.astro';
import FaqAccordion from '../../components/FaqAccordion.astro';
import Icon from '../../components/Icon.astro';
import { events, type EventType } from '../../data/events';
import { site, type SpaceId } from '../../data/site';
import { eventPhoto, eventsStaged, photoByName, STAGED_SCENES, type VenuePhoto } from '../../data/photos';
import { bookHref, pricingHref } from '../../data/nav';
import { breadcrumbs, eventService, faqPage } from '../../lib/schema';
import { href } from '../../lib/paths';

export const getStaticPaths = (() => events.map((event) => ({ params: { slug: event.slug }, props: { event } }))) satisfies GetStaticPaths;

interface Props {
  event: EventType;
}
const { event } = Astro.props;
const path = `/events/${event.slug}/`;
const photo = eventPhoto(event.slug);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Events', path: '/events/' },
  { name: event.name, path },
];

// The booking page with this event already chosen. Base-relative: href() adds the base where it renders.
const eventBookPath = `${bookHref}?event=${encodeURIComponent(event.slug)}`;
const visitLink = href(`${eventBookPath}&visit=1`);
const plainName = event.name.replace(/&/g, 'and').toLowerCase();
// Phone numbers in the copy become tap-to-call links that never break across lines.
const PHONE = site.contact.phone;
const tel = `tel:${site.contact.phoneE164}`;
const splitPhone = (text: string) => text.split(PHONE);

/* The event's spaces, the most suitable first, each linking to its section on The Space. */
const SPACE_ANCHORS: Record<SpaceId, string> = { indoor: 'hall', main: 'main-hall', outdoor: 'grove' };
const spaceLinks = event.spaces
  .map((id) => site.spaces.find((s) => s.id === id))
  .filter((s) => s !== undefined)
  .map((s) => ({ label: s.name, href: `/the-space/#${SPACE_ANCHORS[s.id]}` }));

/* The intro photo's caption: a staged photo gets the disclosure first (Figure.astro). */
const introCaption = photo?.styledOf ? (STAGED_SCENES[photo.name] ?? false) : true;

/*
 * The second view. Weddings: the styled indoor ceremony. Others: the real photo of the event's first
 * space in a view the intro's staged photo is not made from (its styledOf), so the two views differ.
 */
const ABOUT_PHOTOS: Record<string, string> = {
  weddings: 'styled-wedding-indoor-ceremony',
  'receptions-banquets': 'hall-doors',
  'baby-bridal-showers': 'hall-doors',
  'birthday-parties': 'hall-doors',
  'repasts-memorials': 'hall-windows',
  'meetings-trainings': 'hall-windows',
  'graduations-reunions': 'gazebo',
  'community-events': 'main-hall',
};
const aboutCandidate = ABOUT_PHOTOS[event.slug] ? photoByName(ABOUT_PHOTOS[event.slug]) : null;
// Never the intro photo itself, and never the real photo the intro photo is made from.
const heroBase = photo?.styledOf ? photo.styledOf.replace(/\.[a-z0-9]+$/i, '') : photo?.name;
const aboutPhoto: VenuePhoto | null =
  aboutCandidate && aboutCandidate.name !== photo?.name && aboutCandidate.name !== heroBase && (eventsStaged || !aboutCandidate.styledOf)
    ? aboutCandidate
    : null;
const aboutSpace = aboutPhoto
  ? site.spaces.find((s) => (s.id === 'indoor' && aboutPhoto.space === 'hall') || (s.id === 'main' && aboutPhoto.space === 'main') || (s.id === 'outdoor' && aboutPhoto.space === 'grove'))
  : undefined;
const aboutCaption = aboutPhoto?.styledOf
  ? (STAGED_SCENES[aboutPhoto.name] ?? false)
  : aboutSpace
    ? `${aboutSpace.name}, as photographed`
    : true;

/*
 * The first planning section describes the spaces, so it sits beside the second view; the guide holds the
 * rest. Without a second view every section is in the guide.
 */
const [firstSection, ...otherSections] = event.sections;
const aboutSection = aboutPhoto ? firstSection : undefined;
const guideSections = aboutPhoto ? otherSections : event.sections;

// Three related events: the event's own related list first, then the other events in list order.
const RELATED_COUNT = 3;
const related = [...new Set([...event.related, ...events.map((e) => e.slug)])]
  .map((slug) => events.find((e) => e.slug === slug))
  .filter((e): e is EventType => e !== undefined && e.slug !== event.slug)
  .slice(0, RELATED_COUNT);

const schema = [
  breadcrumbs(crumbs),
  eventService({ name: `${event.name} at ${site.name}`, description: event.metaDescription, path, serviceType: event.name }),
  ...(event.faqs.length > 0 ? [faqPage(event.faqs)] : []),
];
---
<BaseLayout title={event.metaTitle} description={event.metaDescription} og={event.slug} schema={schema} bookPath={eventBookPath}>
  <PageIntro
    id="event-title"
    eyebrow="Events"
    title={event.h1}
    lead={event.intro[0]}
    links={spaceLinks}
    linksLabel="Spaces for this event"
    photo={photo}
    caption={introCaption}
    breadcrumbs={crumbs}
  >
    {
      event.intro.slice(1).map((p) => (
        <p class="t-copy ev-intro__more">{splitPhone(p).map((chunk, i) => (i === 0 ? chunk : <><a class="ev-tel" href={tel}>{PHONE}</a>{chunk}</>))}</p>
      ))
    }
  </PageIntro>

  {
    aboutPhoto && aboutSection && (
      <section id="about" class="section ev-target" aria-labelledby="about-heading">
        <div class="container">
          <ImageTextSplit photo={aboutPhoto} id="about-heading" eyebrow="About this occasion" heading={aboutSection.heading} caption={aboutCaption} flip copyFirst>
            {aboutSection.body.map((p) => (
              <p class="t-copy ev-copy">{splitPhone(p).map((chunk, i) => (i === 0 ? chunk : <><a class="ev-tel" href={tel}>{PHONE}</a>{chunk}</>))}</p>
            ))}
          </ImageTextSplit>
        </div>
      </section>
    )
  }

  {
    guideSections.length > 0 && (
      <section id="guide" class="section ev-target" aria-labelledby="guide-heading">
        <div class:list={['container', { 'ev-guide-one': guideSections.length === 1 }]}>
          <SectionHeading id="guide-heading" eyebrow="Step by step" heading="Planning guide" class="ev-guide__head" />
          <div class="ev-guide">
            {guideSections.map((s) => (
              <section class="ev-guide__item" aria-label={s.heading}>
                <h3 class="t-title-2">{s.heading}</h3>
                {s.body.map((p) => (
                  <p class="t-copy ev-copy">{splitPhone(p).map((chunk, i) => (i === 0 ? chunk : <><a class="ev-tel" href={tel}>{PHONE}</a>{chunk}</>))}</p>
                ))}
              </section>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section id="checklist" class="section ev-target" aria-labelledby="checklist-heading">
    <div class="container ev-check">
      <div class="ev-check__copy">
        <SectionHeading id="checklist-heading" eyebrow="Checklist" heading={event.checklist.heading} />
        <div class="btn-row ev-check__actions">
          <a class="btn btn--outline" href={visitLink}>Request a Visit</a>
          <a class="link-more" href={href(pricingHref)}>Ask about rates <Icon name="chevron-right" /></a>
        </div>
      </div>
      <Checklist items={event.checklist.items} class="ev-check__panel" />
    </div>
  </section>

  {
    event.faqs.length > 0 && (
      <section id="questions" class="section ev-target" aria-labelledby="questions-heading">
        <div class="container ev-faq">
          <SectionHeading id="questions-heading" eyebrow="Questions" heading={`Questions about ${plainName}`} class="ev-faq__head" />
          <FaqAccordion items={event.faqs} class="ev-faq__list" />
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section id="others" class="section ev-target" aria-labelledby="others-heading">
        <div class="container">
          <SectionHeading id="others-heading" eyebrow="More occasions" heading="Other events we host">
            <Fragment slot="actions">
              <a class="link-more" href={href('/events/')}>See All Events <Icon name="chevron-right" /></a>
            </Fragment>
          </SectionHeading>
          <ul class="ev-links">
            {related.map((e) => (
              <li>
                <a class="ev-link" href={href(`/events/${e.slug}/`)}>
                  <span class="ev-link__name">{e.name}</span>
                  <Icon name="chevron-right" />
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  /* An anchor lands just under the header. */
  .ev-target {
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }

  .ev-intro__more,
  .ev-copy {
    color: var(--label);
  }

  /* Tap-to-call numbers in the copy stay on one line and are underlined like other inline links. */
  .ev-tel {
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }

  /* ---------- Planning guide: serif sub-heads over serif copy, two columns from 60rem ---------- */

  .ev-guide {
    display: grid;
    gap: 2.5rem clamp(2rem, 5vw, 5rem);
  }

  @media (min-width: 60rem) {
    .ev-guide {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /*
    A single remaining section sits beside the heading, the same split as the checklist below, so it never
    reads as half of a missing row.
  */
  @media (min-width: 60rem) {
    .ev-guide-one {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2rem clamp(2rem, 5vw, 5rem);
      align-items: start;
    }

    .ev-guide-one :global(.ev-guide__head) {
      margin-bottom: 0;
    }

    .ev-guide-one .ev-guide {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .ev-guide__item {
    display: grid;
    gap: 1rem;
    align-content: start;
    padding-top: 1.5rem;
    border-top: 1px solid var(--separator);
    max-width: 38rem;
  }

  .ev-guide__item h3 {
    font-weight: 400;
  }

  .ev-guide__item p + p {
    margin-top: 0;
  }

  /* ---------- Checklist: the heading and the two links beside the panel ---------- */

  .ev-check {
    display: grid;
    gap: 2rem clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .ev-check {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .ev-check__copy {
    display: grid;
    gap: 1.5rem;
  }

  .ev-check__copy :global(.section-head) {
    margin-bottom: 0;
  }

  .ev-check__panel {
    max-width: 38rem;
  }

  /* ---------- Questions: the heading beside the accordion ---------- */

  .ev-faq {
    display: grid;
    gap: 1rem clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .ev-faq :global(.ev-faq__head) {
    margin-bottom: 0;
  }

  .ev-faq :global(.ev-faq__list) {
    max-width: 50rem;
  }

  @media (min-width: 60rem) {
    .ev-faq {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    }
  }

  /* ---------- Other events: three serif links on hairlines ---------- */

  .ev-links {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--separator);
  }

  @media (min-width: 60rem) {
    .ev-links {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }

  .ev-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.5rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--separator);
    color: var(--label);
    font-family: var(--font-serif);
    font-size: var(--t-title-3);
    text-decoration: none;
  }

  .ev-link :global(.icon) {
    flex: none;
    width: 1.1em;
    height: 1.1em;
    color: var(--accent-icon);
    transition: transform var(--dur-2) var(--ease-spring);
  }

  .ev-link:hover .ev-link__name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .ev-link:hover :global(.icon) {
    transform: translateX(3px);
  }
</style>
