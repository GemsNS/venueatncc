---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArchFrame from '../../components/ArchFrame.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EventIndex from '../../components/EventIndex.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import InquiryForm from '../../components/InquiryForm.astro';
import { events, type EventType } from '../../data/events';
import { site } from '../../data/site';
import { eventPhoto } from '../../data/photos';
import { bookHref } from '../../data/nav';
import { breadcrumbs, eventService, faqPage } from '../../lib/schema';

export const getStaticPaths = (() =>
  events.map((event, index) => ({ params: { slug: event.slug }, props: { event, index } }))) satisfies GetStaticPaths;

interface Props {
  event: EventType;
  index: number;
}
const { event, index } = Astro.props;
const path = `/events/${event.slug}/`;
const photo = eventPhoto(event.slug);
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Events', path: '/events/' },
  { name: event.name, path },
];
const related = event.related.filter((slug) => slug !== event.slug && events.some((e) => e.slug === slug));

const schema = [
  breadcrumbs(crumbs),
  eventService({
    name: `${event.name} at ${site.name}`,
    description: event.metaDescription,
    path,
    serviceType: event.name,
  }),
  ...(event.faqs.length > 0 ? [faqPage(event.faqs)] : []),
];
---
<BaseLayout
  title={event.metaTitle}
  description={event.metaDescription}
  og={event.slug}
  ogAlt={`${event.name} at ${site.name} in Suffolk, Virginia`}
  schema={schema}
>
  <section class="event-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="event-hero__grid">
        <div class="event-hero__copy">
          <h1>{event.h1}</h1>
          <div class="event-hero__intro">
            <p class="lead">{event.intro[0]}</p>
          </div>
          <div class="btn-row">
            <a class="btn btn--primary" href={bookHref}>Check your date</a>
            <a class="btn btn--secondary" href={`tel:${site.contact.phoneE164}`}>Call {site.contact.phone}</a>
          </div>
        </div>
        <div class="event-hero__arch">
          <ArchFrame photo={photo} variant={index + 1} priority sizes="(min-width: 960px) 380px, 70vw" />
        </div>
      </div>
    </div>
  </section>

  <section class="section event-body">
    <div class="container event-body__grid">
      <article class="prose event-body__article">
        {
          event.intro.length > 1 && (
            <div class="event-body__opening">
              {event.intro.slice(1).map((p) => <p>{p}</p>)}
            </div>
          )
        }
        {
          event.sections.map((s) => (
            <section>
              <h2>{s.heading}</h2>
              {s.body.map((p) => <p>{p}</p>)}
            </section>
          ))
        }
      </article>

      <aside class="event-aside" aria-labelledby="aside-heading">
        <div class="event-aside__card">
          <h2 id="aside-heading">{event.checklist.heading}</h2>
          <ul class="checklist">
            {event.checklist.items.map((item) => <li>{item}</li>)}
          </ul>
          <a class="btn btn--primary event-aside__btn" href={bookHref}>Check your date</a>
        </div>
      </aside>
    </div>
  </section>

  {
    event.faqs.length > 0 && (
      <section class="section section--tight event-faq" aria-labelledby="event-faq-heading">
        <div class="container event-faq__grid">
          <h2 id="event-faq-heading">Questions about {event.name.toLowerCase()}</h2>
          <FaqList items={event.faqs} />
        </div>
      </section>
    )
  }

  {
    site.contact.formEndpoint && (
      <section class="section event-form" aria-labelledby="event-form-heading">
        <div class="container event-form__grid">
          <div class="section-head">
            <h2 id="event-form-heading">Ask about your date</h2>
            <p>Send a few details and we will follow up about availability.</p>
          </div>
          <InquiryForm preselect={event.slug} />
        </div>
      </section>
    )
  }

  {
    related.length > 0 && (
      <section class="section section--tight event-related" aria-labelledby="related-heading">
        <div class="container">
          <h2 id="related-heading" class="event-related__heading">Other events at The Venue at NCC</h2>
          <EventIndex only={related} />
          <p class="event-related__all">
            <a class="text-link" href="/events/">See every kind of event we host</a>
          </p>
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>

<style>
  .event-hero {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(3rem, 2rem + 4vw, 5.5rem);
    background: linear-gradient(180deg, var(--surface) 0%, var(--paper) 100%);
    border-bottom: 1px solid var(--line);
  }

  .event-hero__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    align-items: center;
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  @media (min-width: 960px) {
    .event-hero__grid {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }
  }

  .event-hero__copy {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }

  .event-hero__copy h1 {
    font-size: var(--step-4);
    max-width: 20ch;
  }

  .event-hero__intro {
    max-width: var(--measure);
  }

  .event-hero__intro .lead {
    max-width: none;
  }

  @media (max-width: 599.98px) {
    .event-hero__intro .lead {
      font-size: 1.125rem;
    }
  }

  .event-body__opening {
    margin-bottom: 3rem;
    font-size: 1.125rem;
  }

  .event-hero__arch {
    width: min(100%, 380px);
    justify-self: center;
  }

  @media (max-width: 959.98px) {
    .event-hero__arch {
      width: min(70%, 340px);
    }
  }

  .event-body__grid {
    display: grid;
    gap: 3rem clamp(3rem, 6vw, 6rem);
    align-items: start;
  }

  @media (min-width: 1000px) {
    .event-body__grid {
      grid-template-columns: minmax(0, 1fr) 340px;
    }
  }

  .event-body__article section + section {
    margin-top: 3rem;
  }

  .event-aside {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
  }

  @media (max-width: 999.98px) {
    .event-aside {
      position: static;
    }
  }

  .event-aside__card {
    display: grid;
    gap: 1.25rem;
    padding: 1.75rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-top: 3px solid var(--brass);
    border-radius: var(--radius);
  }

  .event-aside__card h2 {
    font-size: var(--step-2);
    line-height: 1.25;
  }

  .checklist {
    display: grid;
    gap: 0.8rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.975rem;
  }

  .checklist li {
    position: relative;
    padding-left: 1.6rem;
  }

  /* A tiny arch as the list mark. */
  .checklist li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.35em;
    width: 0.7rem;
    height: 0.85rem;
    border: 1.5px solid var(--brass);
    border-radius: 100vmax 100vmax 1px 1px;
  }

  .event-aside__btn {
    width: 100%;
  }

  .event-faq {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  .event-faq__grid {
    display: grid;
    gap: 2rem 4rem;
  }

  @media (min-width: 900px) {
    .event-faq__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }

  .event-faq h2 {
    font-size: var(--step-3);
  }

  .event-form__grid {
    display: grid;
    gap: 2rem;
    max-width: 860px;
  }

  .event-related__heading {
    font-size: var(--step-3);
    margin-bottom: 2rem;
  }

  .event-related__all {
    margin-top: 2rem;
  }
</style>
