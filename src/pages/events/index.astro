---
/**
 * Events (docs/design/redesign-v7.md, "Version 8"): the one page for every occasion. The title band, then
 * each occasion in src/data/events.ts as a compact block with its slug as its id (the old event pages,
 * /events/<slug>/, answer 301 to /events/#<slug>): one photo shown whole with its caption under it, the
 * name, one or two sentences, and the spaces that suit it, each a link to its section on The Space. Then
 * one closing line for any other occasion, with Check Availability, the page's one action.
 *
 * Photos follow the one photo rule (docs/design/brand.md, "Photography"; src/data/photos.ts). While the
 * staged set is complete (eventsStaged) each block shows its event's staged photo, whose caption begins with
 * the disclosure, "Styled concept. Décor is not included." (Figure.astro). Without the staged set the
 * blocks carry no photo: eight events cannot map to eight distinct real photos.
 *
 * Capacities, rates, parking, and visits have their homes elsewhere and are not written here.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Figure from '../../components/Figure.astro';
import { events } from '../../data/events';
import { STAGED_SCENES, eventPhoto, eventsStaged } from '../../data/photos';
import { site, type SpaceId } from '../../data/site';
import { bookHref } from '../../data/nav';
import { abs } from '../../lib/schema';
import { href } from '../../lib/paths';

const title = 'Events at The Venue @ NCC in Suffolk, VA';
const description =
  'Weddings, showers, birthdays, banquets, repasts, meetings, reunions, and community events at The Venue @ NCC in Suffolk, VA, with the spaces that suit each one.';

const itemList = {
  '@type': 'ItemList',
  name: `Events at ${site.name}`,
  itemListElement: events.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: e.name,
    url: abs(`/events/#${e.slug}`),
  })),
};

/* Each space's section on The Space. */
const SPACE_ANCHORS: Record<SpaceId, string> = { indoor: 'hall', main: 'main-hall', outdoor: 'grove' };
const spaceLinks = (ids: SpaceId[]) =>
  ids
    .map((id) => site.spaces.find((s) => s.id === id))
    .filter((s) => s !== undefined)
    .map((s) => ({ label: s.name, href: href(`/the-space/#${SPACE_ANCHORS[s.id]}`) }));

const blocks = events.map((e) => {
  const photo = eventsStaged ? eventPhoto(e.slug) : null;
  return { event: e, photo: photo?.styledOf !== undefined ? photo : null, spaces: spaceLinks(e.spaces) };
});

const SIZES = '(min-width: 75rem) 584px, (min-width: 48rem) 46vw, 100vw';
---
<BaseLayout title={title} description={description} og="events" pageType="CollectionPage" schema={[itemList]}>
  <section class="title-band" aria-labelledby="page-title">
    <div class="container title-band__inner">
      <h1 id="page-title">Events we host</h1>
      <p class="t-lead">Celebrations, gatherings, and meetings, and the spaces that suit each one.</p>
    </div>
  </section>

  <section class="section" aria-label="Occasions">
    <div class="container">
      <ul class="ev-list">
        {
          blocks.map((b) => (
            <li class="ev" id={b.event.slug}>
              {b.photo && <Figure photo={b.photo} caption={STAGED_SCENES[b.photo.name] ?? false} tall={false} sizes={SIZES} />}
              <div class="ev__text">
                <h2 id={`${b.event.slug}-heading`} class="ev__name">{b.event.name}</h2>
                <p class="ev__copy">{b.event.summary}</p>
                <p class="ev__spaces">
                  <span class="ev__label">Suits</span>
                  {b.spaces.map((s, i) => (
                    <>
                      {i > 0 && <span aria-hidden="true"> · </span>}
                      <a href={s.href}>{s.label}</a>
                    </>
                  ))}
                </p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="other-heading">
    <div class="container ev-other">
      <h2 id="other-heading" class="t-title-2">Planning something else?</h2>
      <p class="t-lead">Describe it in your request and we will confirm which space suits it.</p>
      <div class="btn-row">
        <a class="btn btn--filled btn--lg" href={href(bookHref)}>Check Availability</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Two blocks across from 48rem, one on phones; every block lands under the bar when linked to. */
  .ev-list {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 3.5rem) 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .ev-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .ev {
    display: grid;
    gap: 1rem;
    align-content: start;
    min-width: 0;
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }

  .ev__text {
    display: grid;
    gap: 0.5rem;
  }

  .ev__name {
    font-family: var(--font-serif);
    font-size: var(--t-title-3);
    line-height: 1.25;
  }

  .ev__copy {
    font-family: var(--font-serif);
    color: var(--label-2);
  }

  .ev__spaces {
    font-family: var(--font-serif);
    font-size: var(--t-subhead);
    color: var(--label-2);
  }

  .ev__label {
    margin-right: 0.5rem;
    font-size: var(--t-caption);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ev__spaces a {
    display: inline-block;
    min-height: 24px;
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  .ev-other {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
</style>
