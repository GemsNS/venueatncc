---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EventIndex from '../../components/EventIndex.astro';
import CtaBand from '../../components/CtaBand.astro';
import { events } from '../../data/events';
import { site } from '../../data/site';
import { breadcrumbs, abs } from '../../lib/schema';

const title = 'Events we host in Suffolk, VA | The Venue at NCC';
const description =
  'Weddings, banquets, showers, birthdays, repasts, meetings, and community events at The Venue at NCC in Suffolk, VA. Find your event and check your date.';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Events', path: '/events/' },
];
const itemList = {
  '@type': 'ItemList',
  name: `Events at ${site.name}`,
  itemListElement: events.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: e.name,
    url: abs(`/events/${e.slug}/`),
  })),
};
---
<BaseLayout
  title={title}
  description={description}
  og="events"
  pageType="CollectionPage"
  schema={[breadcrumbs(crumbs), itemList]}
>
  <section class="page-head">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="page-head__copy">
        <h1>Events at The Venue at NCC</h1>
        <p class="lead">
          Here are the events you can book at our event space in Suffolk. Choose one for planning ideas, a checklist,
          and the questions to ask before you book.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <EventIndex headingLevel="h2" />
    </div>
  </section>

  <CtaBand heading="Not sure your event fits?" body={`Call ${site.contact.phone} and tell us what you have in mind. We will talk it through with you.`} />
</BaseLayout>

<style>
  .steps-band {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
</style>
