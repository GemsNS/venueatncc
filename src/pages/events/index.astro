---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EventIndex from '../../components/EventIndex.astro';
import FactStrip from '../../components/FactStrip.astro';
import CtaBand from '../../components/CtaBand.astro';
import { events } from '../../data/events';
import { site } from '../../data/site';
import { breadcrumbs, abs } from '../../lib/schema';

const title = 'Events at The Venue at NCC in Suffolk, VA';
const description = `Weddings, showers, birthdays, repasts, meetings, and church events in Suffolk, VA. An indoor hall for ${site.spaces[0].capacity} and an outdoor space for ${site.spaces[1].capacity}.`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Events', path: '/events/' },
];
const itemList = {
  '@type': 'ItemList',
  name: `Events at ${site.name}`,
  itemListElement: events.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: e.name,
    url: abs(`/events/${e.slug}/`),
  })),
};
---
<BaseLayout title={title} description={description} og="events" pageType="CollectionPage" schema={[breadcrumbs(crumbs), itemList]}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="page-hero__copy">
        <h1 class="t-large-title">Every kind of event, one welcoming venue.</h1>
        <p class="t-lead">
          Choose an event for planning ideas, a checklist, and answers to the questions hosts ask most. Anyone can book.
        </p>
        <FactStrip />
      </div>
    </div>
  </section>

  <section class="section section--grouped">
    <div class="container">
      <EventIndex headingLevel="h2" />
    </div>
  </section>

  <CtaBand heading="Planning something else?" body="Tell us what you have in mind. If it fits in a hall for 100 or an outdoor space for 150, we would love to host it." />
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .page-hero__copy {
    display: grid;
    gap: 1.25rem;
    max-width: 48rem;
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }
</style>
