---
/**
 * The events index: the heading and one lead, then every event as a tile. The tiles are the page's
 * imagery, so the hero has no photo, and the venue's facts (capacities, parking, rates) are left to the
 * space cards, The Space, and the pricing page. While the event photos are staged (eventsStaged), one
 * line under the lead says what they show (docs/design/brand.md, "Photography").
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EventIndex from '../../components/EventIndex.astro';
import CtaBand from '../../components/CtaBand.astro';
import { events } from '../../data/events';
import { EVENTS_STYLED_NOTE, eventsStaged } from '../../data/photos';
import { site } from '../../data/site';
import { breadcrumbs, abs } from '../../lib/schema';

const hall = site.spaces.find((s) => s.id === 'indoor');
const grove = site.spaces.find((s) => s.id === 'outdoor');

const title = 'Events at The Venue at NCC in Suffolk, VA';
const description = `Weddings, showers, birthdays, repasts, meetings, and community events in Suffolk, VA. ${hall?.name} holds up to ${hall?.capacity} and ${grove?.name} up to ${grove?.capacity}, with on-site parking.`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Events', path: '/events/' },
];
const itemList = {
  '@type': 'ItemList',
  name: `Events at ${site.name}`,
  itemListElement: events.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: e.name,
    url: abs(`/events/${e.slug}/`),
  })),
};
---
<BaseLayout title={title} description={description} og="events" pageType="CollectionPage" schema={[breadcrumbs(crumbs), itemList]}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="page-hero__copy">
        <h1 class="t-large-title">Weddings, celebrations, and gatherings in Suffolk</h1>
        <p class="t-lead">Choose an occasion for a planning guide, the space that suits it, and a practical checklist.</p>
        {eventsStaged && <p class="page-hero__note">{EVENTS_STYLED_NOTE}</p>}
      </div>
    </div>
  </section>

  <section class="section section--grouped" aria-label="Events we host">
    <div class="container">
      <EventIndex headingLevel="h2" />
    </div>
  </section>

  <CtaBand
    heading="Planning something else?"
    body={`Tell us about it in your request, and we will confirm whether ${hall?.name} or ${grove?.name} suits it.`}
  />
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .page-hero__copy {
    display: grid;
    gap: 1.25rem;
    max-width: 48rem;
    margin-top: clamp(1.25rem, 1rem + 1.5vw, 2.5rem);
  }

  /* Set like a photo caption: it describes the tiles below. */
  .page-hero__note {
    color: var(--label-2);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1rem;
    line-height: 1.4;
  }
</style>
