---
/**
 * Events (docs/design/redesign-v7.md, "Version 8", with the space names of version 9): the one page for every occasion. The title band, then
 * each occasion in src/data/events.ts as a compact block with its slug as its id (the old event pages,
 * /events/<slug>/, answer 301 to /events/#<slug>): the name, one or two sentences, and the spaces that
 * suit it (each a link to its section on The Space), then one photo shown whole with its caption under it.
 * Every block leads with its name, so on phones each photo sits under its own heading. Then
 * one closing line for any other occasion, with Check Availability, the page's one action.
 *
 * Photos follow the one photo rule (docs/design/brand.md, "Photography"; src/data/photos.ts). While the
 * staged set is complete (eventsStaged) each block shows its event's staged photo, whose caption begins with
 * the disclosure, "Styled concept. Décor is not included." (Figure.astro); Weddings adds the indoor
 * ceremony in The Stage Hall beside its gazebo ceremony (SECOND_PHOTO, below). Without the staged set the
 * blocks carry no photo: eight events cannot map to eight distinct real photos.
 *
 * Capacities, rates, parking, hours, and visits have their homes elsewhere and are not written here.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Figure from '../../components/Figure.astro';
import { events } from '../../data/events';
import { STAGED_SCENES, eventPhoto, eventsStaged, photoByName, type VenuePhoto } from '../../data/photos';
import { site, type SpaceId } from '../../data/site';
import { bookHref } from '../../data/nav';
import { abs } from '../../lib/schema';
import { href } from '../../lib/paths';

const title = 'Events at The Venue @ NCC in Suffolk, VA';
const description =
  'Weddings, showers, birthdays, banquets, repasts, meetings, reunions, and community events at The Venue @ NCC in Suffolk, VA, with the spaces that suit each one.';

const itemList = {
  '@type': 'ItemList',
  name: `Events at ${site.name}`,
  itemListElement: events.map((e, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: e.name,
    url: abs(`/events/#${e.slug}`),
  })),
};

/* Each space's section on The Space. */
const SPACE_ANCHORS: Record<SpaceId, string> = { indoor: 'fireside-room', main: 'stage-hall', outdoor: 'pine-garden' };
const spaceLinks = (ids: SpaceId[]) =>
  ids
    .map((id) => site.spaces.find((s) => s.id === id))
    .filter((s) => s !== undefined)
    .map((s) => ({ label: s.name, href: href(`/the-space/#${SPACE_ANCHORS[s.id]}`) }));

/*
  Weddings has a second staged photo, the indoor option its copy names: a ceremony in The Stage Hall
  (styled-wedding-indoor-ceremony; brand.md, "Staged event photos"). Its block spans the full width with
  the outdoor and indoor ceremonies side by side, so neither photo is shrunk and no photo repeats.
*/
const SECOND_PHOTO: Record<string, string> = { weddings: 'styled-wedding-indoor-ceremony' };

const staged = (p: VenuePhoto | null) => (p?.styledOf !== undefined ? p : null);
const blocks = events.map((e) => {
  const photo = staged(eventsStaged ? eventPhoto(e.slug) : null);
  const second = photo && SECOND_PHOTO[e.slug] ? staged(photoByName(SECOND_PHOTO[e.slug])) : null;
  return { event: e, photos: [photo, second].filter((p): p is VenuePhoto => p !== null), spaces: spaceLinks(e.spaces) };
});

const SIZES = '(min-width: 75rem) 584px, (min-width: 48rem) 46vw, 100vw';
---
<BaseLayout title={title} description={description} og="events" pageType="CollectionPage" schema={[itemList]}>
  <section class="title-band" aria-labelledby="page-title">
    <div class="container title-band__inner">
      <h1 id="page-title">Events we host</h1>
      <p class="t-lead">Celebrations, gatherings, and meetings, with the space that suits each one.</p>
    </div>
  </section>

  <section class="section" aria-label="Occasions">
    <div class="container">
      <ul class="ev-list">
        {
          blocks.map((b) => (
            <li class:list={['ev', { 'ev--pair': b.photos.length > 1 }]} id={b.event.slug}>
              <div class="ev__text">
                <h2 id={`${b.event.slug}-heading`} class="ev__name">{b.event.name}</h2>
                <p class="ev__copy">{b.event.summary}</p>
                <p class="ev__spaces">
                  <span class="ev__label">Suits</span>
                  {b.spaces.map((s, i) => (
                    <>
                      {i > 0 && <span aria-hidden="true"> · </span>}
                      <a href={s.href}>{s.label}</a>
                    </>
                  ))}
                </p>
              </div>
              {b.photos.length === 1 && (
                <Figure photo={b.photos[0]} caption={STAGED_SCENES[b.photos[0].name] ?? false} tall={false} sizes={SIZES} />
              )}
              {b.photos.length > 1 && (
                <div class="ev__photos">
                  {b.photos.map((p) => (
                    <Figure photo={p} caption={STAGED_SCENES[p.name] ?? false} tall={false} sizes={SIZES} />
                  ))}
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="other-heading">
    <div class="container ev-other">
      <h2 id="other-heading" class="t-title-2">Planning something else?</h2>
      <p class="t-lead">Describe it in your request and we will confirm which space suits it.</p>
      <div class="btn-row">
        <a class="btn btn--filled btn--lg" href={href(bookHref)}>Check Availability</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /*
    Two blocks across from 48rem, one on phones; every block lands under the bar when linked to. Every block
    reads the same way: its name, copy and spaces, then its photo. From 48rem each block spans two rows of
    the list (subgrid), so the photos in a row start at the same height whatever the length of the copy.
  */
  .ev-list {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 3.5rem) 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .ev-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 0;
    }

    .ev {
      grid-row: span 2;
      grid-template-rows: subgrid;
      row-gap: 1rem;
      padding-bottom: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    }
  }

  .ev {
    display: grid;
    gap: 1rem;
    align-content: start;
    min-width: 0;
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }

  .ev__text {
    display: grid;
    gap: 0.5rem;
  }

  .ev__photos {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }

  /* Weddings: both ceremonies, outdoor and indoor, side by side across the full width, under its heading. */
  @media (min-width: 48rem) {
    .ev--pair {
      grid-column: 1 / -1;
    }

    .ev__photos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }

    .ev--pair .ev__text {
      max-width: 40rem;
    }
  }

  .ev__name {
    font-family: var(--font-serif);
    font-size: var(--t-title-3);
    line-height: 1.25;
  }

  .ev__copy {
    font-family: var(--font-serif);
    color: var(--label-2);
  }

  .ev__spaces {
    font-family: var(--font-serif);
    font-size: var(--t-subhead);
    color: var(--label-2);
  }

  .ev__label {
    margin-right: 0.5rem;
    font-size: var(--t-caption);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ev__spaces a {
    display: inline-block;
    min-height: 24px;
    color: var(--accent-text);
    text-decoration: underline;
    text-underline-offset: 0.18em;
    text-decoration-thickness: 1px;
  }

  .ev-other {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
  }
</style>
