---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import FaqList from '../components/FaqList.astro';
import Photo from '../components/Photo.astro';
import CtaBand from '../components/CtaBand.astro';
import PriceEstimator from '../components/booking/PriceEstimator';
import { site } from '../data/site';
import { publishedFaqs } from '../data/faq';
import { bookHref } from '../data/nav';
import { photoByName } from '../data/photos';
import { pricing, formatUSD, type DayType } from '../shared/pricing';
import { SPACE_NAME, capacityLabel } from '../shared/capacity';
import { todayKey } from '../shared/dates';
import type { SpaceChoice } from '../shared/types';
import { breadcrumbs, rateCatalog, venueRates } from '../lib/schema';
import { href } from '../lib/paths';

const hall = site.spaces.find((s) => s.id === 'indoor');
const grove = site.spaces.find((s) => s.id === 'outdoor');
/** The lowest hourly rate for a space, from the rate card. */
const fromRate = (id: 'indoor' | 'outdoor') => formatUSD(Math.min(...Object.values(pricing.hourly[id])));
const title = 'Venue rental rates in Suffolk, VA | The Venue at NCC';
const description = `Venue rental rates in Suffolk, VA: ${grove?.name} from ${fromRate('outdoor')} an hour and ${hall?.name} from ${fromRate('indoor')}, with on-site parking. Get an instant estimate for your date.`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Pricing', path: '/pricing/' },
];
const spaces: SpaceChoice[] = ['indoor', 'outdoor', 'both'];
const days: DayType[] = ['saturday', 'friday', 'sunday', 'weekday'];
const pricingFaqs = publishedFaqs.filter((f) => f.topic === 'pricing');
const offer = pricing.introOffer && todayKey() <= pricing.introOffer.validUntil ? pricing.introOffer : null;
const packagesByDay = days
  .map((d) => ({ day: d, items: pricing.packages.filter((p) => p.dayType === d) }))
  .filter((g) => g.items.length > 0);
const autoDiscounts = pricing.discounts.filter((d) => d.appliesTo !== 'manual' && d.percent > 0);
const askDiscounts = pricing.discounts.filter((d) => d.appliesTo === 'manual' && d.percent > 0);

const balanceDays = pricing.bookingDeposit.balanceDueDaysBefore;

/**
 * Capacity next to a space. 'both' never gets a single combined figure (it is not confirmed),
 * so it names each space's own limit instead.
 */
const packageSpaceLine = (s: SpaceChoice) => (s === 'both' ? capacityLabel('both') : `${SPACE_NAME[s]}, ${capacityLabel(s).toLowerCase()}`);
const rateHead = (s: SpaceChoice) =>
  s === 'both' ? { name: 'Both spaces', detail: SPACE_NAME.both } : { name: SPACE_NAME[s], detail: capacityLabel(s) };

/** Exactly what every rental includes (site.included). */
const included = site.included;

/** Rental terms: deposit and balance from the pricing module, and the one neutral catering line (brand.md). */
const rentalTerms = [
  pricing.bookingDeposit.type === 'percent'
    ? `A booking deposit of ${pricing.bookingDeposit.value}% of your total reserves your date once we confirm availability.`
    : `A booking deposit of ${formatUSD(pricing.bookingDeposit.value)} reserves your date once we confirm availability.`,
  balanceDays > 0
    ? `The balance is due ${balanceDays} days before your event. For an event within ${balanceDays} days, the full amount is due when you reserve.`
    : null,
  'Catering and décor are arranged separately by the client.',
  'Estimates are confirmed with your final quote.',
].filter((t): t is string => t !== null);

const fees = [
  pricing.fees.cleaning > 0 && { label: 'Cleaning fee', detail: 'Added to every booking.', amount: formatUSD(pricing.fees.cleaning) },
  pricing.fees.damageDepositRefundable > 0 && {
    label: 'Refundable damage deposit',
    detail: 'Returned after your event if there is no damage.',
    amount: formatUSD(pricing.fees.damageDepositRefundable),
  },
].filter((f): f is { label: string; detail: string; amount: string } => Boolean(f));

const photo = photoByName('hall-fireplace');
---
<BaseLayout title={title} description={description} og="pricing" schema={[breadcrumbs(crumbs), rateCatalog(), venueRates()]}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="page-hero__grid">
        <div class="page-hero__copy">
          <h1 class="t-large-title">Transparent rates for every event</h1>
          <p class="t-lead">
            Book {grove?.name} from {fromRate('outdoor')} an hour or {hall?.name} from {fromRate('indoor')}, or reserve a package for
            a set block of time. On-site parking is included, and every fee is listed on this page.
          </p>
          {
            offer && (
              <p class="offer">
                <Icon name="tag" />
                <span>
                  <strong>{offer.name}: {offer.percent}% off the rental</strong> {offer.terms}. It is applied automatically to your
                  estimate.
                </span>
              </p>
            )
          }
        </div>
        {photo && <Photo photo={photo} class="page-hero__photo" sizes="(min-width: 75rem) 560px, 46vw" />}
      </div>
    </div>
  </section>

  <section class="section section--grouped" aria-labelledby="estimate-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="estimate-heading">Estimate your event</h2>
        <p class="t-lead">
          Choose a space, a day, and how long you need it. We apply the best package and any automatic discount. Other special
          rates are confirmed with your quote.
        </p>
      </div>
      <div class="estimator">
        <PriceEstimator client:visible bookHref={href(bookHref)} ssrToday={todayKey()} />
      </div>
    </div>
  </section>

  {
    packagesByDay.length > 0 && (
      <section class="section" aria-labelledby="packages-heading">
        <div class="container">
          <div class="section-head">
            <h2 id="packages-heading">Packages</h2>
            <p class="t-lead">Set blocks of time, priced below the hourly rate.</p>
          </div>
          <div class="pkg-days">
            {packagesByDay.map((g) => (
              <section class="pkg-day" aria-labelledby={`pkg-${g.day}`}>
                <h3 id={`pkg-${g.day}`} class="serif-label">
                  {pricing.dayTypes[g.day].label}
                </h3>
                <ul class="pkg-grid">
                  {g.items.map((p) => (
                    <li class="pkg">
                      <p class="pkg__space secondary t-footnote">{packageSpaceLine(p.space)}</p>
                      <h4 class="t-headline">{p.name}</h4>
                      <p class="pkg__price">
                        <span class="price num">{formatUSD(p.price)}</span>
                        <span class="pkg__hours t-subhead secondary">for {p.hours} hours</span>
                      </p>
                      <p class="t-subhead secondary">{p.description}</p>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--grouped" aria-labelledby="rates-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="rates-heading">Hourly rates</h2>
        <p class="t-lead">Charged by the hour. Your rate depends on the space and the day, and each day has a minimum number of hours.</p>
      </div>

      <div class="card rates rates--table">
        <table class="rates__table">
          <caption class="visually-hidden">Hourly rental rates by day and space</caption>
          <thead>
            <tr>
              <th scope="col">Day</th>
              {
                spaces.map((s) => (
                  <th scope="col">
                    <span class="rates__space">{rateHead(s).name}</span>
                    <span class="rates__cap">{rateHead(s).detail}</span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              days.map((d) => (
                <tr>
                  <th scope="row">
                    <span class="rates__day">{pricing.dayTypes[d].label}</span>
                    <span class="rates__min"><span class="nowrap">{pricing.minimumHours[d]}-hour</span> minimum</span>
                  </th>
                  {spaces.map((s) => (
                    <td>
                      <span class="rates__price price num">{formatUSD(pricing.hourly[s][d])}</span>
                      <span class="rates__unit">an hour</span>
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="rates--stacked">
        {
          spaces.map((s) => (
            <section class="rates-space" aria-labelledby={`rates-${s}`}>
              <h3 id={`rates-${s}`} class="rates-space__head">
                <span class="t-headline">{rateHead(s).name}</span>
                <span class="secondary t-subhead">{rateHead(s).detail}</span>
              </h3>
              <ul class="list-group">
                {days.map((d) => (
                  <li class="list-row">
                    <div class="list-row__main">
                      <div>{pricing.dayTypes[d].label}</div>
                      <div class="list-row__detail"><span class="nowrap">{pricing.minimumHours[d]}-hour</span> minimum</div>
                    </div>
                    <div class="rates__cell">
                      <span class="rates__price price num">{formatUSD(pricing.hourly[s][d])}</span>
                      <span class="rates__unit">an hour</span>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <div class="fee-grid">
        {
          fees.length > 0 && (
            <div class="fees">
              <h3 class="serif-label">Fees</h3>
              <ul class="list-group">
                {fees.map((f) => (
                  <li class="list-row">
                    <div class="list-row__main">
                      <div class="t-headline">{f.label}</div>
                      <div class="list-row__detail">{f.detail}</div>
                    </div>
                    <span class="fees__amount price num">{f.amount}</span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        {
          (autoDiscounts.length > 0 || askDiscounts.length > 0) && (
            <div class="fees">
              <h3 class="serif-label">Special rates</h3>
              <ul class="list-group">
                {autoDiscounts.map((d) => (
                  <li class="list-row">
                    <div class="list-row__main">
                      <div class="t-headline">{d.label}</div>
                      <div class="list-row__detail">Applied automatically to your estimate.</div>
                    </div>
                    <span class="fees__amount">
                      <span class="price num">{d.percent}%</span> <span class="fees__off">off</span>
                    </span>
                  </li>
                ))}
                {askDiscounts.map((d) => (
                  <li class="list-row">
                    <div class="list-row__main">
                      <div class="t-headline">{d.label}</div>
                      <div class="list-row__detail">Mention it in your request.</div>
                    </div>
                    <span class="fees__amount">
                      <span class="price num">{d.percent}%</span> <span class="fees__off">off</span>
                    </span>
                  </li>
                ))}
              </ul>
              <p class="t-footnote secondary fees__note">
                Discounts apply to the rental and do not combine. We apply the best rate that fits your event.
              </p>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="terms-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="terms-heading">Inclusions and terms</h2>
        <p class="t-lead">What every booking includes, and how a reservation works.</p>
      </div>
      <div class="terms-grid">
        <section class="terms card" aria-labelledby="included-heading">
          <h3 id="included-heading" class="serif-label">Included with every rental</h3>
          <ul class="terms__list terms__list--check">
            {
              included.map((item) => (
                <li>
                  <Icon name="check" />
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </section>
        <section class="terms card" aria-labelledby="rental-terms-heading">
          <h3 id="rental-terms-heading" class="serif-label">Rental terms</h3>
          <ul class="terms__list">
            {rentalTerms.map((t) => <li>{t}</li>)}
          </ul>
        </section>
      </div>
    </div>
  </section>

  {
    pricingFaqs.length > 0 && (
      <section class="section" aria-labelledby="pfaq-heading">
        <div class="container pfaq">
          <div class="section-head">
            <h2 id="pfaq-heading">Pricing questions</h2>
            <p class="t-lead">
              Anything else? <a href={`tel:${site.contact.phoneE164}`}>Call {site.contact.phone}</a>.
            </p>
          </div>
          <FaqList items={pricingFaqs} />
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .page-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2.5rem 4rem;
    align-items: center;
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .page-hero__copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    max-width: 40rem;
  }

  /* The photo sits beside the copy on wide screens; phones and tablets go straight to the estimate. */
  .page-hero__grid > :global(.page-hero__photo) {
    display: none;
  }

  @media (min-width: 64rem) {
    .page-hero__grid {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    }

    .page-hero__grid > :global(.page-hero__photo) {
      display: block;
    }
  }

  .offer {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem 1.25rem;
    border-radius: var(--r-md);
    background: var(--accent-tint);
    color: var(--label);
  }

  .offer :global(.icon) {
    color: var(--accent-text);
    margin-top: 0.15em;
  }

  /* The estimator's controls and result are their own surfaces; no wrapper card around them. */
  .estimator {
    min-width: 0;
  }

  /* Prices are set in Libre Caslon Text, regular weight, with lining figures so columns line up. */
  .price {
    font-family: var(--font-serif);
    font-weight: 400;
    font-variant-numeric: lining-nums tabular-nums;
    letter-spacing: -0.01em;
    color: var(--label);
  }

  /* A serif label between 18 and 28px: Libre Caslon Text, not the display cut (brand.md). */
  .serif-label {
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 1.25rem + 0.5vw, 1.625rem);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.005em;
  }

  .pkg-days {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  .pkg-day {
    display: grid;
    gap: 1rem;
  }

  .pkg-day > .serif-label {
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--separator);
  }

  /* Three columns on wide screens, so Saturday's six packages fill two rows exactly. */
  .pkg-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: auto;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 40rem) {
    .pkg-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .pkg-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Space, name, price, and description share row tracks, so prices line up across a row. */
  .pkg {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0.4rem;
    align-items: start;
    padding: 1.5rem;
    border-radius: var(--r-lg);
    background: var(--bg-grouped);
  }

  .pkg__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0 0.5rem;
    margin-top: 0.35rem;
  }

  .pkg__price .price {
    font-size: var(--t-title-1);
    line-height: 1.1;
  }

  .rates {
    padding: 0.5rem clamp(0.5rem, 2vw, 1.5rem);
  }

  .rates__table {
    width: 100%;
    border-collapse: collapse;
  }

  .rates__table th,
  .rates__table td {
    padding: 1.1rem 0.75rem;
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid var(--separator);
  }

  .rates__table tbody tr:last-child th,
  .rates__table tbody tr:last-child td {
    border-bottom: 0;
  }

  .rates__space,
  .rates__day {
    display: block;
    font-weight: 600;
    color: var(--label);
  }

  .rates__cap,
  .rates__min {
    display: block;
    font-size: var(--t-footnote);
    font-weight: 400;
    color: var(--label-2);
  }

  .rates__table td,
  .rates__cell {
    white-space: nowrap;
  }

  .nowrap {
    white-space: nowrap;
  }

  /*
    Rate, fee, and special-rate rows: the label and the amount sit side by side while they fit, and the
    amount drops below the label when they do not (large text on a phone), instead of overlapping it.
  */
  .rates-space :global(.list-row),
  .fees :global(.list-row) {
    flex-wrap: wrap;
    row-gap: 0.25rem;
  }

  .rates-space :global(.list-row__main),
  .fees :global(.list-row__main) {
    flex: 1 1 11rem;
  }

  .rates__cell,
  .fees__amount {
    margin-left: auto;
  }

  .rates__price {
    font-size: 1.5rem;
    line-height: 1.2;
  }

  .rates__unit {
    margin-left: 0.3rem;
    color: var(--label-2);
    font-size: var(--t-footnote);
  }

  .rates--stacked {
    display: none;
  }

  @media (max-width: 679.98px) {
    .rates--table {
      display: none;
    }

    .rates--stacked {
      display: grid;
      gap: 1.75rem;
    }

    .rates-space {
      display: grid;
      gap: 0.6rem;
    }

    .rates-space__head {
      display: grid;
      gap: 0.1rem;
      padding-left: 0.25rem;
    }

    .rates-space__head .t-subhead {
      font-weight: 400;
    }
  }

  .fee-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2rem, 1.5rem + 2vw, 3rem) 2rem;
    margin-top: clamp(2.5rem, 2rem + 2vw, 3.5rem);
  }

  @media (min-width: 64rem) {
    .fee-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }
  }

  .fees {
    display: grid;
    gap: 1rem;
  }

  .fees > .serif-label {
    padding-left: 0.25rem;
  }

  .fees__amount {
    flex: none;
    text-align: right;
    white-space: nowrap;
  }

  .fees__amount.price,
  .fees__amount .price {
    font-size: 1.375rem;
  }

  .fees__off {
    color: var(--label-2);
    font-size: var(--t-footnote);
  }

  .fees__note {
    padding-left: 0.25rem;
  }

  .terms-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
  }

  @media (min-width: 46.5rem) {
    .terms-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }
  }

  .terms {
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1.5rem, 1.25rem + 1vw, 2rem);
    background: var(--bg-grouped);
    box-shadow: none;
  }

  .terms__list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .terms__list li {
    padding-block: 0.8rem;
    border-top: 1px solid var(--separator);
    color: var(--label);
  }

  .terms__list li:first-child {
    border-top: 0;
    padding-top: 0.25rem;
  }

  .terms__list--check li {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    font-weight: 600;
  }

  .terms__list--check :global(.icon) {
    color: var(--accent-text);
  }

  .pkg > p {
    margin: 0;
  }

  .pfaq {
    display: grid;
    gap: 2rem clamp(2rem, 6vw, 5rem);
  }

  @media (min-width: 900px) {
    .pfaq {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }
  }

  /* On the white page the list needs a hairline edge to read as a group. */
  .pfaq :global(.faqs) {
    border: 1px solid var(--separator);
  }
</style>
