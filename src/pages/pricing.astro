---
/**
 * Rates & FAQ (docs/design/redesign-v7.md, "Version 8"). The URL stays /pricing/ so existing links keep
 * working; the old /faq/ answers 301 to #faq.
 *
 * In order: the title band; the rates (the approved wording beside a real photo of The Hall, shown whole
 * with its caption under it, the Call button, and the contact person and email); the booking details, the
 * one home of what the rental includes (#included), how a date is held (#hold), and the hours (#hours);
 * then the questions (#faq), one accordion with no groups, and the FAQPage structured data.
 *
 * Call is the page's one filled button. A date request has one home, the booking page, so there is no
 * second form here: a text link points to it. The venue does not publish prices: no amounts, packages,
 * fees, or estimates appear here, and no price in structured data. The phone appears once, on the button.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ImageTextSplit from '../components/ImageTextSplit.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { site } from '../data/site';
import { href } from '../lib/paths';
import { photoByName } from '../data/photos';
import { publishedFaqs } from '../data/faq';
import { bookHref } from '../data/nav';
import { faqPage } from '../lib/schema';

const title = 'Rates & FAQ | The Venue @ NCC, Suffolk, VA';
const description = `Rates at ${site.name} in ${site.address.city}, VA vary with the season and the day of the week. What the rental includes, how to hold your date, our hours, and answers to common questions.`;

/* The approved wording (brand.md, "No published prices"), without the number: the Call button carries it. */
const ratesLead =
  'Our affordable rates vary with peak season, holidays, and the day of the week. For pricing and special offers, please call us and we will be happy to help you.';

const lowerFirst = (s: string) => s.charAt(0).toLowerCase() + s.slice(1);
const included = site.included.map(lowerFirst);

const details = [
  { id: 'included', title: 'Included', text: `Every rental includes ${included.slice(0, -1).join(', ')}, and ${included[included.length - 1]}.` },
  { id: 'hold', title: 'Holding your date', text: site.depositPolicy },
  { id: 'hours', title: 'Hours', text: `Events can be booked ${site.access.days}, ${site.access.hours}.` },
];

const hallPhoto = photoByName('hall-fireplace');
---
<BaseLayout title={title} description={description} og="pricing" pageType="ContactPage" schema={[faqPage(publishedFaqs)]}>
  <section class="title-band" aria-labelledby="page-title">
    <div class="container title-band__inner">
      <h1 id="page-title">Rates &amp; FAQ</h1>
    </div>
  </section>

  <section id="rates" class="section pr-target" aria-labelledby="rates-heading">
    <div class="container">
      {
        hallPhoto ? (
          <ImageTextSplit photo={hallPhoto} id="rates-heading" heading="Rates by phone" lead={ratesLead} caption="The Hall">
            <Fragment slot="actions">
              <a class="btn btn--filled btn--lg" href={`tel:${site.contact.phoneE164}`}>
                <Icon name="phone" />
                Call {site.contact.phone}
              </a>
              <p class="rates__contact secondary">
                Ask for {site.contact.contactName}, email <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>, or{' '}
                <a href={href(bookHref)}>send a request online</a>.
              </p>
            </Fragment>
          </ImageTextSplit>
        ) : (
          <div class="section-head">
            <h2 id="rates-heading">Rates by phone</h2>
            <p class="t-lead">{ratesLead}</p>
            <div class="btn-row">
              <a class="btn btn--filled btn--lg" href={`tel:${site.contact.phoneE164}`}>
                <Icon name="phone" />
                Call {site.contact.phone}
              </a>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section id="details" class="section pr-target" aria-labelledby="details-heading">
    <div class="container">
      <h2 id="details-heading" class="pr-head">Booking details</h2>
      <dl class="pr-details">
        {
          details.map((d) => (
            <div class="pr-detail pr-target" id={d.id}>
              <dt>{d.title}</dt>
              <dd>{d.text}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="faq" class="section pr-target" aria-labelledby="faq-heading">
    <div class="container pr-faq">
      <h2 id="faq-heading" class="pr-head">Questions</h2>
      <FaqAccordion items={publishedFaqs} class="pr-faq__list" />
    </div>
  </section>
</BaseLayout>

<style>
  /* Links to a section (from the old /faq/, the FAQ answers, and other pages) land under the bar. */
  .pr-target {
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }

  .pr-head {
    margin-bottom: var(--section-head);
    line-height: 1.08;
  }

  /* The contact line takes the row under the Call button. */
  .rates__contact {
    flex-basis: 100%;
    font-family: var(--font-serif);
  }

  .rates__contact a {
    color: var(--accent-text);
  }

  /* ---------- Booking details: three short facts, stacked on phones, in a row from 48rem ---------- */

  .pr-details {
    display: grid;
    gap: 1.75rem 2.5rem;
    margin: 0;
  }

  @media (min-width: 48rem) {
    .pr-details {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .pr-detail {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--separator);
  }

  .pr-detail dt {
    font-family: var(--font-serif);
    font-size: var(--t-caption);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--label-2);
  }

  .pr-detail dd {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--t-headline);
    line-height: 1.45;
    color: var(--label);
  }

  /* ---------- Questions: the heading beside the accordion from 60rem ---------- */

  .pr-faq {
    display: grid;
    gap: 0 4rem;
  }

  .pr-faq :global(.pr-faq__list) {
    max-width: 50rem;
  }

  @media (min-width: 60rem) {
    .pr-faq {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }
</style>
