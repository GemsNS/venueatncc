---
/**
 * Rates and inquiries (docs/design/redesign-v7.md, section 5, "/pricing/ Rates").
 *
 * In order: a serif title band on Petal; the rates split (the approved wording beside a real photo of The
 * Hall, shown whole with its caption under it, the Call button, and the contact person and email); then
 * "Before you book" (#before): the deposit and the building hours, whose one home is this page, beside a
 * link to the booking page and one to what the rental includes (its home is The Space).
 *
 * There is no second request form here: a date request asks for the same things as the booking page (space,
 * date, guests, hours), so it has one home, /book/, and this page is about the rates. Call is the page's one
 * filled button.
 *
 * The venue does not publish prices: no amounts, packages, fees, or estimates appear here, and no price
 * in structured data. The phone number appears once, on the Call button.
 * The URL stays /pricing/ so existing links keep working. Breadcrumbs are for event pages only.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ImageTextSplit from '../components/ImageTextSplit.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { site } from '../data/site';
import { href } from '../lib/paths';
import { photoByName } from '../data/photos';
import { bookHref } from '../data/nav';
import { SETUP_CLEANUP_RULE } from '../shared/booking-rules';

const title = 'Rates and inquiries | The Venue @ NCC, Suffolk, VA';
const description = `Rates at ${site.name} in ${site.address.city}, VA vary with peak season, holidays, and the day of the week. Call or email us about The Hall, The Main Hall, or The Grove.`;

/* The approved wording (brand.md, "No published prices"), without the number: the Call button carries it. */
const ratesLead =
  'Our affordable rates vary with peak season, holidays, and the day of the week. For pricing and special offers, please call us and we will be happy to help you.';

const hallPhoto = photoByName('hall-fireplace');
---
<BaseLayout title={title} description={description} og="pricing" pageType="ContactPage">
  <section class="band-section title-band" aria-labelledby="page-title">
    <div class="container">
      <p class="eyebrow">Rates</p>
      <h1 id="page-title">Rates and inquiries</h1>
    </div>
  </section>

  <section class="section" aria-labelledby="rates-heading">
    <div class="container">
      {
        hallPhoto ? (
          <ImageTextSplit photo={hallPhoto} id="rates-heading" eyebrow="By phone" heading="Our special rates" lead={ratesLead} caption="The Hall">
            <Fragment slot="actions">
              <a class="btn btn--filled btn--lg" href={`tel:${site.contact.phoneE164}`}>
                <Icon name="phone" />
                Call {site.contact.phone}
              </a>
              <p class="rates__contact secondary">
                Ask for {site.contact.contactName}, or email <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>.
              </p>
            </Fragment>
          </ImageTextSplit>
        ) : (
          <SectionHeading id="rates-heading" eyebrow="By phone" heading="Our special rates" lead={ratesLead}>
            <Fragment slot="actions">
              <a class="btn btn--filled btn--lg" href={`tel:${site.contact.phoneE164}`}>
                <Icon name="phone" />
                Call {site.contact.phone}
              </a>
            </Fragment>
          </SectionHeading>
        )
      }
    </div>
  </section>

  <section id="before" class="section before-section" aria-labelledby="before-heading">
    <div class="container before">
      <SectionHeading
        id="before-heading"
        eyebrow="Booking"
        heading="Before you book"
        lead="Choose a date and a space on the booking page, and we confirm availability and your rate personally."
        class="before__head"
      >
        <Fragment slot="actions">
          <a class="link-more" href={href(bookHref)}>Check availability <Icon name="chevron-right" /></a>
        </Fragment>
      </SectionHeading>
      <div class="before__panel">
        <ul class="before__list">
          <li>{site.depositPolicy}</li>
          <li>Events can be booked {site.access.days}, {site.access.hours}. {SETUP_CLEANUP_RULE}</li>
        </ul>
        <a class="link-more" href={href('/the-space/#included')}>What the rental includes <Icon name="chevron-right" /></a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------- Title band (the reference's contact page opens with a serif title on a tinted band) ---------- */

  .title-band {
    background: var(--band);
    padding-block: clamp(2.5rem, 1.5rem + 3vw, 4.5rem);
  }

  .title-band .container {
    display: grid;
    gap: 0.75rem;
  }

  .title-band h1 {
    line-height: 1.05;
  }

  @media (forced-colors: active) {
    .title-band {
      border-bottom: 1px solid CanvasText;
    }
  }

  /* ---------- Rates ---------- */

  /* The contact line takes the row under the Call button. */
  .rates__contact {
    flex-basis: 100%;
    font-family: var(--font-serif);
  }

  .rates__contact a {
    color: var(--accent-text);
  }

  /* ---------- Before you book: the heading beside one small Petal panel ---------- */

  .before-section {
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }

  .before {
    display: grid;
    gap: 2rem clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  @media (min-width: 60rem) {
    .before {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .before :global(.before__head) {
    margin-bottom: 0;
  }

  .before__panel {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    padding: clamp(1.25rem, 1rem + 1vw, 1.75rem);
    border-radius: var(--r-card);
    background: var(--panel);
  }

  .before__list {
    display: grid;
    gap: 0.6rem;
    margin: 0;
    padding-left: 1.1rem;
    font-family: var(--font-serif);
    font-size: var(--t-headline);
    line-height: 1.45;
    color: var(--label);
  }

  @media (forced-colors: active) {
    .before__panel {
      border: 1px solid CanvasText;
    }
  }
</style>
