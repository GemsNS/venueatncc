---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import PriceEstimator from '../components/booking/PriceEstimator';
import { site } from '../data/site';
import { publishedFaqs } from '../data/faq';
import { bookHref } from '../data/nav';
import { pricing, priceSummary, formatUSD, marketContext, type DayType } from '../shared/pricing';
import { capacityLabel } from '../shared/capacity';
import { todayKey } from '../shared/dates';
import type { SpaceChoice } from '../shared/types';
import { breadcrumbs, rateCatalog, venueRates } from '../lib/schema';
import { href } from '../lib/paths';

const { fromHourly } = priceSummary();
const title = 'Venue rental rates in Suffolk, VA | The Venue at NCC';
const description = `Event venue rental rates in Suffolk, VA from ${formatUSD(fromHourly)} an hour. Indoor hall for 100, outdoor space for 150, parking included. Get an instant estimate.`;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Pricing', path: '/pricing/' },
];
const spaces: SpaceChoice[] = ['indoor', 'outdoor', 'both'];
const days: DayType[] = ['saturday', 'friday', 'sunday', 'weekday'];
const pricingFaqs = publishedFaqs.filter((f) => f.topic === 'pricing' || f.topic === 'food');
const deposit =
  pricing.bookingDeposit.type === 'percent' ? `${pricing.bookingDeposit.value}% of your total` : formatUSD(pricing.bookingDeposit.value);
const offer = pricing.introOffer && todayKey() <= pricing.introOffer.validUntil ? pricing.introOffer : null;
const packagesByDay = days
  .map((d) => ({ day: d, items: pricing.packages.filter((p) => p.dayType === d) }))
  .filter((g) => g.items.length > 0);
const autoDiscounts = pricing.discounts.filter((d) => d.appliesTo !== 'manual' && d.percent > 0);
const askDiscounts = pricing.discounts.filter((d) => d.appliesTo === 'manual' && d.percent > 0);
const satIndoorBlock = pricing.packages.find((p) => p.id === 'sat-indoor-6');
const balanceDays = pricing.bookingDeposit.balanceDueDaysBefore;
/**
 * Capacity next to a space. 'both' never gets a single combined figure (it is not confirmed),
 * so it names each space's own limit instead.
 */
const packageSpaceLine = (s: SpaceChoice) =>
  s === 'both' ? capacityLabel('both') : `${pricing.spaces[s].label}, ${capacityLabel(s).toLowerCase()}`;
const rateCapLine = (s: SpaceChoice) => (s === 'both' ? capacityLabel('both') : `Up to ${pricing.spaces[s].capacity}`);
---
<BaseLayout title={title} description={description} og="pricing" schema={[breadcrumbs(crumbs), rateCatalog(), venueRates()]}>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="page-hero__copy">
        <h1 class="hero-h1">
          <span class="kicker">Pricing<span class="visually-hidden">:</span></span>
          <span class="t-large-title"><span class="h-line">Upfront rates.</span> <span class="h-line">An estimate in seconds.</span></span>
        </h1>
        <p class="t-lead">
          Rent the space you need by the hour, from {formatUSD(fromHourly)}, or choose a package. Parking is included, and
          every fee is listed on this page.
        </p>
        {
          offer && (
            <p class="offer">
              <Icon name="sparkles" />
              <span>
                <strong>{offer.label}.</strong> It is applied automatically to your estimate.
              </span>
            </p>
          )
        }
      </div>
    </div>
  </section>

  <section class="section section--grouped" aria-labelledby="estimate-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="estimate-heading">Estimate your event</h2>
        <p class="t-lead">
          Pick a space, a day, and how long you need it. We apply the best package and any automatic discount. Other special
          rates are confirmed with your quote.
        </p>
      </div>
      <div class="estimator">
        <PriceEstimator client:visible bookHref={href(bookHref)} ssrToday={todayKey()} />
      </div>
    </div>
  </section>

  {
    packagesByDay.length > 0 && (
      <section class="section" aria-labelledby="packages-heading">
        <div class="container">
          <div class="section-head">
            <h2 id="packages-heading">Packages</h2>
            <p class="t-lead">Set blocks of time at a better price than the hourly rate.</p>
          </div>
          <div class="pkg-days">
            {packagesByDay.map((g) => (
              <section class="pkg-day" aria-label={pricing.dayTypes[g.day].label}>
                <h3 class="t-title-3">{pricing.dayTypes[g.day].label}</h3>
                <ul class="pkg-grid">
                  {g.items.map((p) => (
                    <li class="card pkg">
                      <p class="pkg__space secondary t-footnote">{packageSpaceLine(p.space)}</p>
                      <h4 class="t-headline">{p.name}</h4>
                      <p class="pkg__price num">
                        {formatUSD(p.price)}
                        <span class="t-subhead secondary"> / {p.hours} hours</span>
                      </p>
                      <p class="t-subhead secondary">{p.description}</p>
                    </li>
                  ))}
                </ul>
              </section>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section--grouped" aria-labelledby="rates-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="rates-heading">Hourly rates</h2>
        <p class="t-lead">For any length of event. Your rate depends on the space and the day.</p>
      </div>

      <div class="card rates rates--table">
        <table class="rates__table">
          <caption class="visually-hidden">Hourly rental rates by day and space</caption>
          <thead>
            <tr>
              <th scope="col">Day</th>
              {
                spaces.map((s) => (
                  <th scope="col">
                    <span class="rates__space">{pricing.spaces[s].label}</span>
                    <span class="rates__cap">{rateCapLine(s)}</span>
                  </th>
                ))
              }
            </tr>
          </thead>
          <tbody>
            {
              days.map((d) => (
                <tr>
                  <th scope="row">
                    <span class="rates__day">{pricing.dayTypes[d].label}</span>
                    <span class="rates__min">{pricing.minimumHours[d]}-hour minimum</span>
                  </th>
                  {spaces.map((s) => (
                    <td class="num">
                      <span class="rates__price">{formatUSD(pricing.hourly[s][d])}</span>
                      <span class="rates__unit">/hour</span>
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <div class="rates--stacked">
        {
          spaces.map((s) => (
            <section class="rates-space">
              <h3 class="t-headline rates-space__head">
                {pricing.spaces[s].label} <span class="secondary t-subhead">{rateCapLine(s)}</span>
              </h3>
              <ul class="list-group">
                {days.map((d) => (
                  <li class="list-row">
                    <div class="list-row__main">
                      <div>{pricing.dayTypes[d].label}</div>
                      <div class="list-row__detail">{pricing.minimumHours[d]}-hour minimum</div>
                    </div>
                    <div class="num">
                      <span class="rates__price">{formatUSD(pricing.hourly[s][d])}</span>
                      <span class="rates__unit">/hour</span>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <div class="fees">
        <h3 class="t-title-2">Deposits and fees</h3>
        <ul class="list-group">
          <li class="list-row list-row--icon">
            <span class="icon-tile"><Icon name="calendar-check" /></span>
            <div class="list-row__main">
              <div class="t-headline">Reserve your date</div>
              <div class="list-row__detail">
                Send your request, we confirm availability, then your booking deposit reserves the date. The booking deposit is
                {deposit}.{
                  balanceDays > 0 &&
                    ` The balance is due ${balanceDays} days before your event. For an event within ${balanceDays} days, the full amount is due when you reserve.`
                }
              </div>
            </div>
          </li>
          {
            pricing.fees.cleaning > 0 && (
              <li class="list-row list-row--icon">
                <span class="icon-tile"><Icon name="sparkles" /></span>
                <div class="list-row__main">
                  <div class="t-headline">Cleaning fee</div>
                  <div class="list-row__detail">{formatUSD(pricing.fees.cleaning)} per event.</div>
                </div>
              </li>
            )
          }
          {
            pricing.fees.damageDepositRefundable > 0 && (
              <li class="list-row list-row--icon">
                <span class="icon-tile"><Icon name="lock" /></span>
                <div class="list-row__main">
                  <div class="t-headline">Refundable damage deposit</div>
                  <div class="list-row__detail">
                    {formatUSD(pricing.fees.damageDepositRefundable)}, returned after your event if there is no damage.
                  </div>
                </div>
              </li>
            )
          }
          <li class="list-row list-row--icon">
            <span class="icon-tile"><Icon name="parking" /></span>
            <div class="list-row__main">
              <div class="t-headline">Parking</div>
              <div class="list-row__detail">Included with every booking.</div>
            </div>
          </li>
        </ul>
      </div>

      {
        (autoDiscounts.length > 0 || askDiscounts.length > 0) && (
          <div class="fees">
            <h3 class="t-title-2">Special rates</h3>
            <ul class="list-group">
              {autoDiscounts.map((d) => (
                <li class="list-row list-row--icon">
                  <span class="icon-tile"><Icon name="tag" /></span>
                  <div class="list-row__main">
                    <div class="t-headline">{d.label}</div>
                    <div class="list-row__detail">{d.percent}% off the rental, applied automatically.</div>
                  </div>
                </li>
              ))}
              {askDiscounts.map((d) => (
                <li class="list-row list-row--icon">
                  <span class="icon-tile"><Icon name="tag" /></span>
                  <div class="list-row__main">
                    <div class="t-headline">{d.label}</div>
                    <div class="list-row__detail">{d.percent}% off the rental. Mention it in your request.</div>
                  </div>
                </li>
              ))}
            </ul>
            <p class="t-footnote secondary fees__note">Discounts do not combine. Automatic rates appear in your estimate; mention any other rate in your request and we apply the best one.</p>
          </div>
        )
      }
    </div>
  </section>

  <section class="section" aria-labelledby="compare-heading">
    <div class="container compare">
      <div class="section-head">
        <h2 id="compare-heading">How we compare</h2>
        <p class="t-lead">
          We checked published rates at {marketContext.venueCount} event venues across Hampton Roads in {marketContext.researched}.
        </p>
      </div>
      <div class="compare__grid">
        <article class="card compare__card">
          <p class="secondary t-subhead">Comparable halls, Saturday, 6 hours</p>
          <p class="compare__num num">
            {formatUSD(marketContext.saturdaySixHourLow)} to {formatUSD(marketContext.saturdaySixHourHigh)}
          </p>
          <p class="t-footnote secondary">Private venue-only halls for 75 to 100 guests. Hall rental only, before fees and tax.</p>
        </article>
        {
          satIndoorBlock && (
            <article class="card compare__card compare__card--ours">
              <p class="t-subhead compare__label">The Venue at NCC, Saturday, 6 hours</p>
              <p class="compare__num num">{formatUSD(satIndoorBlock.price)}</p>
              <p class="t-footnote compare__note">
                Indoor hall block, rental only{offer ? `, or ${formatUSD(Math.round(satIndoorBlock.price * (1 - offer.percent / 100)))} with the founding rate` : ''}.
                {pricing.fees.cleaning > 0 && `The ${formatUSD(pricing.fees.cleaning)} cleaning fee is added to every booking. `}Parking included.
              </p>
            </article>
          )
        }
        <article class="card compare__card">
          <p class="secondary t-subhead">What some nearby halls do not allow</p>
          <ul class="compare__list">
            <li><Icon name="wine" /> Serving alcohol</li>
            <li><Icon name="utensils" /> Bringing any caterer you like</li>
            <li><Icon name="users" /> Booking without church membership or city residency</li>
          </ul>
          <p class="t-footnote secondary">All three are welcome here.</p>
        </article>
      </div>
    </div>
  </section>

  {
    pricingFaqs.length > 0 && (
      <section class="section section--grouped" aria-labelledby="pfaq-heading">
        <div class="container pfaq">
          <div class="section-head">
            <h2 id="pfaq-heading">Pricing questions</h2>
            <p class="t-lead">
              Something else? <a href={`tel:${site.contact.phoneE164}`}>Call {site.contact.phone}</a>.
            </p>
          </div>
          <FaqList items={pricingFaqs} />
        </div>
      </section>
    )
  }

  <CtaBand heading="Found your number? Find your date." />
</BaseLayout>

<style>
  .page-hero {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(2.5rem, 2rem + 3vw, 4.5rem);
  }

  .page-hero__copy {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    max-width: 50rem;
    margin-top: clamp(1.5rem, 1rem + 2vw, 3rem);
  }

  .hero-h1 {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.6rem;
  }

  .kicker {
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.3125rem);
    font-weight: 600;
    color: var(--accent-text);
    letter-spacing: -0.01em;
  }

  /* Each sentence of the H1 on its own line, so it never breaks mid-sentence. */
  .h-line {
    display: block;
  }

  .offer {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem 1.25rem;
    border-radius: var(--r-md);
    background: var(--accent-tint);
    color: var(--label);
  }

  .offer :global(.icon) {
    color: var(--accent-text);
    margin-top: 0.15em;
  }

  /* The estimator's controls and result are their own surfaces; no wrapper card around them. */
  .estimator {
    min-width: 0;
  }

  .pkg-days {
    display: grid;
    gap: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  .pkg-day {
    display: grid;
    gap: 1rem;
  }

  .pkg-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr));
    grid-auto-rows: auto;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Eyebrow, name, price, and description share row tracks, so prices line up across a row. */
  .pkg {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    row-gap: 0.4rem;
    align-items: start;
    padding: 1.5rem;
    background: var(--bg-grouped);
    box-shadow: none;
  }

  .pkg__price {
    font-size: var(--t-title-1);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .rates {
    padding: 0.5rem clamp(0.5rem, 2vw, 1.5rem);
  }

  .rates__table {
    width: 100%;
    border-collapse: collapse;
  }

  .rates__table th,
  .rates__table td {
    padding: 1rem 0.75rem;
    text-align: left;
    vertical-align: middle;
    border-bottom: 1px solid var(--separator);
  }

  .rates__table tbody tr:last-child th,
  .rates__table tbody tr:last-child td {
    border-bottom: 0;
  }

  .rates__space,
  .rates__day {
    display: block;
    font-weight: 600;
    color: var(--label);
  }

  .rates__cap,
  .rates__min {
    display: block;
    font-size: var(--t-footnote);
    font-weight: 400;
    color: var(--label-2);
  }

  .rates__table td {
    white-space: nowrap;
  }

  .rates__price {
    font-size: var(--t-title-3);
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .rates__unit {
    color: var(--label-2);
    font-size: var(--t-footnote);
  }

  .rates--stacked {
    display: none;
  }

  @media (max-width: 679.98px) {
    .rates--table {
      display: none;
    }

    .rates--stacked {
      display: grid;
      gap: 1.5rem;
    }

    .rates-space {
      display: grid;
      gap: 0.6rem;
    }

    .rates-space h3 {
      padding-left: 0.25rem;
    }

    .rates-space__head span {
      display: block;
      font-weight: 400;
    }
  }

  .fees {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
    display: grid;
    gap: 1rem;
  }

  .fees .list-group {
    max-width: 760px;
  }

  .fees__note {
    padding-left: 0.25rem;
  }

  /* One column on phones; two with the list card full width on tablets; three on desktop. */
  .compare__grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: minmax(0, 1fr);
  }

  @media (min-width: 600px) {
    .compare__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .compare__card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 900px) {
    .compare__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .compare__card:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }

  .compare__card {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: 1.75rem;
    background: var(--bg-grouped);
    box-shadow: none;
  }

  .compare__card--ours {
    background: var(--accent-tint);
  }

  .compare__label {
    color: var(--accent-text);
    font-weight: 600;
  }

  /* Secondary gray is under 4.5:1 on the purple tint, so the note uses the primary label color. */
  .compare__note {
    color: var(--label);
  }

  .compare__num {
    font-size: var(--t-title-1);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .compare__list {
    display: grid;
    gap: 0.5rem;
    margin: 0.25rem 0;
    padding: 0;
    list-style: none;
    font-weight: 500;
  }

  .compare__list li {
    display: flex;
    gap: 0.6rem;
    align-items: center;
  }

  .compare__list :global(.icon) {
    color: var(--accent-text);
  }

  .pfaq {
    display: grid;
    gap: 2rem clamp(2rem, 6vw, 5rem);
  }

  @media (min-width: 900px) {
    .pfaq {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }
  }
</style>
