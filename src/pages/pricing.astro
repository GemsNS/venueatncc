---
/**
 * Rates & FAQ (docs/design/redesign-v7.md, "Version 9"). The URL stays /pricing/ so existing links keep
 * working; the old /faq/ answers 301 to #faq.
 *
 * The home page states the essentials once: what is included, the hours, how a date is held, and rates by
 * phone (the approved wording, shortened). This page complements it and never restates those sentences. In
 * order: the title band; your rate (#rates: what to have ready when you call and what the quote covers,
 * beside the one photo of The Stage Hall, with Call); how booking works (#booking: three steps, from the
 * request to the held date); then the questions (#faq), one accordion with no groups, and the FAQPage
 * structured data.
 *
 * Call is the page's one filled button. A date request has one home, the booking page, so there is no
 * second form here: a text link points to it. The venue does not publish prices: no amounts, packages,
 * fees, or estimates appear here, and no price in structured data.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ImageTextSplit from '../components/ImageTextSplit.astro';
import FaqAccordion from '../components/FaqAccordion.astro';
import { site } from '../data/site';
import { href } from '../lib/paths';
import { spacePhoto } from '../data/photos';
import { publishedFaqs } from '../data/faq';
import { bookHref } from '../data/nav';
import { faqPage } from '../lib/schema';

const title = 'Rates & FAQ | The Venue @ NCC, Suffolk, VA';
const description = `How to get a quote from ${site.name} in ${site.address.city}, VA, how booking works, and answers to common questions.`;

/* What a quote needs and covers. The rates sentence itself is on the home page (#essentials). */
const quoteLead =
  'Every rate is quoted for a specific date. Call with your date, the space, your guest count, and the hours you need, and we will give you the rate for that day and any special offer that applies.';

/* How booking works, from the request to the held date. The deposit rule itself is on the home page (#essentials), so step 3 does not name it. */
const steps = [
  { title: 'Check your date', text: 'Choose a date on the booking page to see which spaces are open, and send your request with the details of your event.' },
  { title: 'Get your quote', text: 'We check the calendar and your details and send your quote.' },
  { title: 'Hold the date', text: 'Sign the reservation, and the date is yours.' },
];

const photo = spacePhoto('main');
---
<BaseLayout title={title} description={description} og="pricing" pageType="ContactPage" schema={[faqPage(publishedFaqs)]}>
  <section class="title-band" aria-labelledby="page-title">
    <div class="container title-band__inner">
      <h1 id="page-title">Rates &amp; FAQ</h1>
    </div>
  </section>

  <section id="rates" class="section pr-target" aria-labelledby="rates-heading">
    <div class="container">
      {
        photo ? (
          <ImageTextSplit photo={photo} id="rates-heading" heading="Your rate" lead={quoteLead} caption="The Stage Hall">
            <Fragment slot="actions">
              <a class="btn btn--filled btn--lg" href={`tel:${site.contact.phoneE164}`}>
                <Icon name="phone" />
                Call {site.contact.phone}
              </a>
              <p class="rates__contact secondary">
                Or <a href={href(bookHref)}>send the same details with a date request</a>.
              </p>
            </Fragment>
          </ImageTextSplit>
        ) : (
          <div class="section-head">
            <h2 id="rates-heading">Your rate</h2>
            <p class="t-lead">{quoteLead}</p>
            <div class="btn-row">
              <a class="btn btn--filled btn--lg" href={`tel:${site.contact.phoneE164}`}>
                <Icon name="phone" />
                Call {site.contact.phone}
              </a>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section id="booking" class="section pr-target" aria-labelledby="booking-heading">
    <div class="container">
      <h2 id="booking-heading" class="pr-head">How booking works</h2>
      <ol class="pr-steps">
        {
          steps.map((s, i) => (
            <li class="pr-step">
              <span class="pr-step__n" aria-hidden="true">{i + 1}</span>
              <h3 class="pr-step__title">{s.title}</h3>
              <p class="pr-step__text">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="faq" class="section pr-target" aria-labelledby="faq-heading">
    <div class="container pr-faq">
      <h2 id="faq-heading" class="pr-head">Questions</h2>
      <FaqAccordion items={publishedFaqs} class="pr-faq__list" />
    </div>
  </section>
</BaseLayout>

<style>
  /* Links to a section (from the old /faq/, the FAQ answers, and other pages) land under the bar. */
  .pr-target {
    scroll-margin-top: calc(var(--nav-h) + 1rem);
  }

  .pr-head {
    margin-bottom: var(--section-head);
    line-height: 1.08;
  }

  /* The request link takes the row under the Call button. */
  .rates__contact {
    flex-basis: 100%;
    font-family: var(--font-serif);
  }

  .rates__contact a {
    color: var(--accent-text);
  }

  /* ---------- How booking works: three numbered steps, stacked on phones, in a row from 48rem ---------- */

  .pr-steps {
    display: grid;
    gap: 1.75rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .pr-steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .pr-step {
    display: grid;
    gap: 0.5rem;
    align-content: start;
    padding-top: 1.25rem;
    border-top: 1px solid var(--separator);
  }

  .pr-step__n {
    font-family: var(--font-serif);
    font-size: var(--t-caption);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--label-2);
  }

  .pr-step__title {
    font-weight: 400;
    font-family: var(--font-serif);
    font-size: var(--t-title-3);
    line-height: 1.25;
  }

  .pr-step__text {
    font-family: var(--font-serif);
    font-size: var(--t-headline);
    line-height: 1.45;
    color: var(--label);
  }

  /* ---------- Questions: the heading beside the accordion from 60rem ---------- */

  .pr-faq {
    display: grid;
    gap: 0 4rem;
  }

  .pr-faq :global(.pr-faq__list) {
    max-width: 50rem;
  }

  @media (min-width: 60rem) {
    .pr-faq {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }
  }
</style>
