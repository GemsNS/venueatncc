---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ArchFrame from '../components/ArchFrame.astro';
import EventIndex from '../components/EventIndex.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { photos, heroPhoto, photosTagged } from '../data/photos';
import { breadcrumbs } from '../lib/schema';

const title = 'About The Venue at NCC | New Community Church, Suffolk';
const description =
  'The Venue at NCC is the event space of New Community Church, part of Suffolk, VA since 1997. Learn who we are and how to plan your event with us.';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about/' },
];
// A photo tagged 'about', else any photo other than the home hero, else the hero, else the illustration.
const hero = heroPhoto();
const photo = photosTagged('about')[0] ?? photos.find((p) => p !== hero) ?? hero;
---
<BaseLayout title={title} description={description} og="about" pageType="AboutPage" schema={[breadcrumbs(crumbs)]}>
  <section class="page-head">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="page-head__copy">
        <h1>About The Venue at NCC</h1>
        <p class="lead">
          The Venue at NCC is the event space of {site.parent.name} in Suffolk, Virginia. It can be booked for
          celebrations, milestones, and community gatherings.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about__grid">
      <div class="prose">
        <h2>Part of New Community Church</h2>
        <p>
          {site.parent.name} has been part of the Suffolk community since {site.parent.foundingYear}.
          {' '}{site.parent.pastor} is the church's {site.parent.pastorTitle.toLowerCase()}. The church describes its
          mission simply: to know Christ, love people well, and walk in hope together.
        </p>
        <p>
          Weddings and anniversaries, showers and birthdays, repasts and reunions, meetings and community gatherings
          can all be booked at The Venue at NCC.
        </p>

        <h2>Planning an event with us</h2>
        <p>
          Every booking starts with a conversation. Call {site.contact.phone} with your date, the kind of event, and
          roughly how many guests you expect. We will talk through availability and what your event needs, and then
          reserve your date.
        </p>
        <p>
          The venue is at {site.address.street} in {site.address.city}. If your guests are coming from elsewhere in
          Hampton Roads, share the full address with them early.
        </p>

        <h2>More about the church</h2>
        <p>
          To learn more about the church itself, visit{' '}
          <a href={site.parent.url} rel="noopener">wearencc.org</a>.
        </p>
      </div>
      <div class="about__arch">
        <ArchFrame photo={photo} variant={5} sizes="(min-width: 960px) 360px, 70vw" />
      </div>
    </div>
  </section>

  <section class="section section--tight about-events" aria-labelledby="about-events-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="about-events-heading">Events we host</h2>
      </div>
      <EventIndex />
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .about__grid {
    display: grid;
    gap: 3rem clamp(3rem, 7vw, 7rem);
    align-items: start;
  }

  @media (min-width: 960px) {
    .about__grid {
      grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    }
  }

  .about__arch {
    width: min(70%, 360px);
    justify-self: center;
  }

  @media (min-width: 960px) {
    .about__arch {
      width: 100%;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }
  }

  .about-events {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }
</style>
