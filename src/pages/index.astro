---
/**
 * Home, per docs/design/brand.md "Page direction: Home", in this order:
 * the welcome (the business name as the first screen's one dominant element, which morphs into the header
 * lockup on scroll), the photo band of The Grove with the date checker, the three spaces as real-photo
 * cards, the events, the feature strip, the rates section (the approved wording, a Call button, and a link
 * to the inquiry form), and the arrival band.
 *
 * Each fact has one place on the page (brand.md, "Redundancy rules"): capacities on the space cards,
 * parking in the feature strip, the address in the arrival band, a call to phone for rates in the rates
 * section. The page's one filled button is the date checker's Continue to Booking; the header CTA is tinted.
 * Photos follow the one photo rule (src/data/photos.ts): real photos for the spaces, and event tiles that
 * are all staged or all text. No image appears twice.
 *
 * The morph. The welcome shows the lockup's two words ("The Venue", "@ NCC") as the same outlines the
 * header lockup carries, at display size. The script below measures where each word rests and where its
 * twin sits in the header (the paths tagged data-part in Logo.astro), then, on every scroll frame, moves
 * and scales each word toward its twin with a transform alone (no layout work, so no shift and no jank).
 * When the words arrive (progress 1) the header shows its own lockup and the welcome's words hide; the
 * lockup's ring fades in over the last part of the way (--nav-ring). Readers who prefer reduced motion,
 * short screens (where the bar scrolls away), and browsers without scripts get the header lockup at once.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import Petals from '../components/Petals.astro';
import EventIndex from '../components/EventIndex.astro';
import LocationBand from '../components/LocationBand.astro';
import DateChecker from '../components/booking/DateChecker';
import { site, cityState } from '../data/site';
import { EVENTS_STYLED_NOTE, eventsStaged, heroPhoto, photoByName, photosFor, type VenuePhoto } from '../data/photos';
import { bookHref, pricingHref } from '../data/nav';
import { href } from '../lib/paths';
import type { IconName } from '../shared/icons';

/*
  The photo band: the gazebo under the tall pines of The Grove (grove-pines, tagged 'hero'), a real photo in
  two crops of the original behind grove-path. Phones get the portrait file; wider screens the landscape file,
  nearly the original's full width, from the trunks above the gazebo down through the legs of the front picnic
  table. Its size sets the band's ratio.
*/
const hero = photoByName('grove-pines') ?? heroPhoto();
const heroSize = hero ? `--hero-w: ${hero.src.width}; --hero-h: ${hero.src.height}` : undefined;
const hall = site.spaces.find((s) => s.id === 'indoor');
const mainHall = site.spaces.find((s) => s.id === 'main');
const grove = site.spaces.find((s) => s.id === 'outdoor');
const hallName = hall?.name ?? 'The Hall';
const mainHallName = mainHall?.name ?? 'The Main Hall';
const groveName = grove?.name ?? 'The Grove';

/*
  The three spaces: the teaser for The Space, which carries the full description and the amenities. Each card
  shows its space's primary real photo, its capacity (the only capacity on this page), one sentence on what
  the space is, and a link.
*/
interface SpaceCard {
  id: 'hall' | 'main-hall' | 'grove';
  name: string;
  capacity: number | undefined;
  sentence: string;
  photo: VenuePhoto | undefined;
  href: string;
}
const spaceCards: SpaceCard[] = [
  {
    id: 'hall',
    name: hallName,
    capacity: hall?.capacity,
    sentence: 'Arched windows, a fireplace feature wall, and dark wood-look floors.',
    photo: photosFor('hall')[0],
    href: '/the-space/#hall',
  },
  {
    id: 'main-hall',
    name: mainHallName,
    capacity: mainHall?.capacity,
    sentence: 'A multi-purpose auditorium with stage seating under a vaulted ceiling.',
    photo: photosFor('main')[0],
    href: '/the-space/#main-hall',
  },
  {
    id: 'grove',
    name: groveName,
    capacity: grove?.capacity,
    sentence: 'A timber gazebo and picnic tables on a patio under tall pines.',
    photo: photosFor('grove')[0],
    href: '/the-space/#grove',
  },
];

/* The feature strip: three things true of every booking, each said here and nowhere else on this page. */
const features: { icon: IconName; name: string; text: string }[] = [
  {
    icon: 'building',
    name: 'Indoors and outdoors',
    text: `${hallName}, ${mainHallName}, and ${groveName}, booked on their own or ${hallName} and ${groveName} together.`,
  },
  {
    icon: 'calendar',
    name: 'Full-day access',
    text: 'Book the hours your event needs, from setup to the last farewell, on one property.',
  },
  {
    icon: 'parking',
    name: 'On-site parking',
    text: 'A large paved lot beside the building, included with every booking.',
  },
];

/*
  Every photo shown elsewhere on this page, so the event tiles never repeat one. LocationBand picks the drive
  at dusk itself, so it is named here.
*/
const pagePhotos = [hero?.name, ...spaceCards.map((c) => c.photo?.name), 'approach-dusk'].filter((n): n is string => Boolean(n));

const title = 'Event venue in Suffolk, VA | The Venue @ NCC';
const description = `Welcome to The Venue @ NCC, an event venue in Suffolk, Virginia: ${hallName} and ${mainHallName} for up to ${hall?.capacity} guests each, ${groveName} for up to ${grove?.capacity}. Check your date online.`;
---
<BaseLayout title={title} description={description} og="home" venueDetails morphLogo>
  <section class="welcome" aria-labelledby="hero-title">
    <div class="welcome__bg" aria-hidden="true">
      <Petals />
    </div>
    <div class="welcome__inner container">
      <h1 id="hero-title" class="welcome__h1">
        <span class="welcome__eyebrow" data-welcome-fade>Welcome to</span>
        <span class="welcome__name">
          <span class="visually-hidden">The Venue @ NCC</span>
          <Logo variant="word-the-venue" height="calc(53.07 * var(--u))" decorative class="welcome__word welcome__word--venue" data-part="the-venue" />
          <Logo variant="word-at-ncc" height="calc(38.63 * var(--u))" decorative class="welcome__word welcome__word--ncc" data-part="at-ncc" />
        </span>
      </h1>
      <p class="welcome__line" data-welcome-fade>Event venue in {cityState}</p>
    </div>
  </section>

  <section class="band" aria-label="The Grove and the date checker" style={heroSize}>
    {
      hero && (
        <div class="band__media">
          <Photo photo={hero} ratio="fill" tall rounded={false} priority sizes="100vw" />
        </div>
      )
    }
    <div class="band__checker">
      <DateChecker client:load bookHref={href(bookHref)} />
    </div>
  </section>

  <section class="section" aria-labelledby="spaces-heading">
    <div class="container">
      <div class="section-head section-head--row">
        <div class="section-head__copy">
          <p class="eyebrow">The spaces</p>
          <h2 id="spaces-heading">Three spaces, indoors and out</h2>
          <p class="t-lead">
            Our fully renovated property is available for weddings, receptions, conferences, banquets, memorials, and
            community gatherings, with elegant backdrops, flexible layouts, and full-day access.
          </p>
        </div>
        <div class="section-head__actions">
          <a class="btn btn--tinted" href={href('/the-space/')}>Explore The Space</a>
        </div>
      </div>
      <div class="spaces">
        {
          spaceCards.map((card) => {
            return (
              <article class="space card" aria-labelledby={`space-${card.id}`}>
                {card.photo && (
                  <Photo photo={card.photo} caption={false} sizes="(min-width: 75rem) 370px, (min-width: 56rem) 30vw, 92vw" />
                )}
                <div class="space__body">
                  <h3 id={`space-${card.id}`} class="space__name t-title-1">
                    {card.name}
                  </h3>
                  {card.capacity && (
                    <p class="space__cap badge badge--accent">
                      <Icon name="users" />
                      Up to {card.capacity} guests
                    </p>
                  )}
                  <p class="space__sentence secondary">{card.sentence}</p>
                  <a class="link-more" href={href(card.href)}>
                    Explore {card.name} <Icon name="chevron-right" />
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section section--grouped" aria-labelledby="events-heading">
    <div class="container">
      <div class="section-head section-head--row">
        <div class="section-head__copy">
          <p class="eyebrow">Occasions</p>
          <h2 id="events-heading">Events we host</h2>
          {eventsStaged && <p class="t-lead">{EVENTS_STYLED_NOTE}</p>}
        </div>
        <div class="section-head__actions">
          <a class="link-more" href={href('/events/')}>See All Events <Icon name="chevron-right" /></a>
        </div>
      </div>
      <EventIndex layout="shelf" avoid={pagePhotos} />
    </div>
  </section>

  <section class="section section--tight features" aria-label="What every booking includes">
    <ul class="container features__list">
      {
        features.map((f) => (
          <li class="feature">
            <span class="feature__icon" aria-hidden="true">
              <Icon name={f.icon} />
            </span>
            <div class="feature__text">
              <h3 class="t-headline">{f.name}</h3>
              <p class="secondary">{f.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section rates" aria-labelledby="rates-heading">
    <div class="container rates__inner">
      <div class="rates__copy">
        <p class="eyebrow">Rates</p>
        <h2 id="rates-heading">Our special rates</h2>
        <p class="t-lead">
          Our affordable rates vary with peak season, holidays, and the day of the week. For pricing and special offers,
          please call us and we will be happy to help you.
        </p>
      </div>
      <div class="btn-row rates__action">
        <a class="btn btn--filled btn--lg" href={`tel:${site.contact.phoneE164}`}>
          <Icon name="phone" />
          Call {site.contact.phone}
        </a>
        <a class="link-more rates__link" href={href(pricingHref)}>
          Or send an inquiry <Icon name="chevron-right" />
        </a>
      </div>
    </div>
  </section>

  <LocationBand />
</BaseLayout>

<script>
  /*
    The morph (see the note at the top of this file). Transforms only: each word is translated and scaled
    from where it rests in the welcome to where its twin sits in the header lockup, in step with the scroll.
  */
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const words = [...document.querySelectorAll<SVGSVGElement>('.welcome__word')];
  const fades = [...document.querySelectorAll<HTMLElement>('[data-welcome-fade]')];
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  const short = window.matchMedia('(max-height: 500px)');

  interface Track {
    el: SVGSVGElement;
    rest: { left: number; top: number; width: number };
    to: { left: number; top: number; width: number };
  }

  if (nav && words.length > 0) {
    let tracks: Track[] = [];
    let distance = 1;
    let morphed = false;
    let ticking = false;
    let active = false;

    /** The lockup the header shows at this width (the other is display: none). */
    const lockup = () =>
      [...nav.querySelectorAll<SVGSVGElement>('[data-lockup]')].find((el) => el.getBoundingClientRect().width > 0) ?? null;

    function setMorphed(on: boolean) {
      if (on === morphed) return;
      morphed = on;
      nav!.toggleAttribute('data-morphed', on);
      for (const w of words) w.style.visibility = on ? 'hidden' : '';
    }

    function apply() {
      ticking = false;
      const y = window.scrollY;
      const p = Math.min(1, Math.max(0, y / distance));
      if (p < 1 || !morphed) {
        for (const t of tracks) {
          const s = 1 + (t.to.width / t.rest.width - 1) * p;
          const dx = (t.to.left - t.rest.left) * p;
          const dy = (t.to.top - (t.rest.top - y)) * p;
          t.el.style.transform = `translate3d(${dx.toFixed(2)}px, ${dy.toFixed(2)}px, 0) scale(${s.toFixed(4)})`;
        }
      }
      setMorphed(p >= 1);
      nav!.style.setProperty('--nav-ring', Math.min(1, Math.max(0, (p - 0.55) / 0.45)).toFixed(3));
      const fade = Math.max(0, 1 - p * 2.2).toFixed(3);
      for (const f of fades) f.style.opacity = fade;
    }

    function schedule() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(apply);
    }

    /** Where each word rests (with no transform) and where its twin sits in the header. */
    function measure() {
      const lk = lockup();
      if (!lk) return;
      for (const w of words) w.style.transform = '';
      const y = window.scrollY;
      tracks = words.flatMap((el) => {
        const twin = lk.querySelector<SVGGraphicsElement>(`[data-part="${el.dataset.part}"]`);
        if (!twin) return [];
        const r = el.getBoundingClientRect();
        const t = twin.getBoundingClientRect();
        return [{ el, rest: { left: r.left, top: r.top + y, width: r.width }, to: { left: t.left, top: t.top, width: t.width } }];
      });
      if (tracks.length === 0) return;
      // The morph runs over the scroll that would carry the first word up to the bar, and at least about
      // half a screen, so it is never in a rush: past the natural distance the name hovers at the bar and
      // shrinks into place while the welcome scrolls on beneath it.
      distance = Math.max(tracks[0].rest.top - tracks[0].to.top, Math.min(420, window.innerHeight * 0.48));
      apply();
    }

    function stop() {
      active = false;
      for (const w of words) {
        w.style.transform = '';
        w.style.visibility = '';
      }
      for (const f of fades) f.style.opacity = '';
      nav!.style.removeProperty('--nav-ring');
      nav!.removeAttribute('data-morph');
      nav!.removeAttribute('data-morphed');
    }

    function start() {
      if (still.matches || short.matches) {
        stop();
        return;
      }
      if (!active) {
        active = true;
        nav!.setAttribute('data-morph', '');
        morphed = false;
      }
      measure();
    }

    let resizeTimer = 0;
    const onResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(start, 80);
    };

    window.addEventListener('scroll', () => active && schedule(), { passive: true });
    window.addEventListener('resize', onResize);
    window.addEventListener('load', onResize);
    still.addEventListener('change', start);
    short.addEventListener('change', start);
    // Larger text or a late font can move the welcome; measure again when it changes size.
    const welcome = document.querySelector<HTMLElement>('.welcome');
    if (welcome && 'ResizeObserver' in window) new ResizeObserver(onResize).observe(welcome);
    start();
  }
</script>

<style>
  /* ---------- Welcome ---------- */

  /*
    The first screen: "Welcome to" and the business name, the largest type on the site, centred on the Blush
    surface with drifting petals behind. --u is one unit of the lockup's own grid in pixels: the two words keep
    the lockup's proportions (The Venue is 289.49 units wide and 53.07 tall; @ NCC is 143.5 by 38.63 and sits
    20.47 units lower on the same baseline, 18.69 units to the right), so a scroll later they fit the header
    exactly. On one line the row is 451.68 units wide; phones stack the two words and "The Venue" spans the
    screen (92vw), which also keeps the name whole on a 320px screen.
  */
  .welcome {
    --u: calc(min(92vw, 30rem) / 289.49);
    position: relative;
    background: var(--bg-grouped);
  }

  .welcome__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  .welcome__inner {
    position: relative;
    display: grid;
    justify-items: center;
    gap: clamp(1rem, 0.75rem + 1vw, 1.5rem);
    padding-block: clamp(2.25rem, 1.5rem + 3vw, 4.5rem) clamp(2.5rem, 1.75rem + 3vw, 4.5rem);
    text-align: center;
  }

  .welcome__h1 {
    display: grid;
    justify-items: center;
    gap: clamp(0.5rem, 0.25rem + 1vw, 1.25rem);
    font-weight: 400;
    text-wrap: initial;
  }

  /* A quiet serif line above the name: the reader's eye goes to the name. */
  .welcome__eyebrow {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2rem);
    line-height: 1.2;
    color: var(--label-2);
  }

  .welcome__name {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(12 * var(--u));
    width: 100%;
  }

  .welcome__word {
    position: relative;
    z-index: 61;
    transform-origin: 0 0;
    will-change: transform;
    /* Plum and Berry, whatever the appearance: the name stays the darkest thing on the Blush surface. */
    --logo-ink: var(--label);
    --logo-accent: var(--accent-text);
  }

  .welcome__line {
    font-family: var(--font);
    font-size: var(--t-footnote);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  /* From 46.5rem the two words share one line, as they do in the lockup. */
  @media (min-width: 46.5rem) {
    .welcome {
      --u: calc(min(74vw, 68rem) / 451.68);
    }

    .welcome__name {
      flex-direction: row;
      align-items: flex-start;
      justify-content: center;
      gap: calc(18.69 * var(--u));
    }

    .welcome__word--ncc {
      margin-top: calc(20.47 * var(--u));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .welcome__word {
      will-change: auto;
    }
  }

  /* ---------- The photo band and the date checker ---------- */

  /*
    A photo that is never cropped into its subject: every frame holds the whole gazebo, and a frame's bottom
    edge never runs along a tabletop. The frames are fitted to the two files' framing at 100vw:
      Landscape (grove-pines.jpg, 3500 x 2532): it ends through the legs of the front picnic table. From that
        edge up to the gazebo's roof is 41vw, so a frame keeps the file's bottom edge (--photo-pos 50% 100%)
        and is never shorter than 41vw: it loses sky, never tables. The gazebo spans 27 to 59 percent of the width.
      Portrait (grove-pines-tall.jpg, 7:10): the roof is 69.9vw below its top; the cut between the benches is
        19.6vw above its bottom.
    Phones: the portrait file as a band, then the checker as a card. Wide screens: the landscape file at up to
    78 percent of the screen, with the checker floating on glass at the bottom right, lined up with the
    header and at least 2.5rem clear of the gazebo.
  */
  .band {
    --checker-w: 23.75rem;
    --photo-pos: 50% 100%;
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [content-start] minmax(0, var(--max))
      [content-end] minmax(var(--gutter), 1fr)
      [full-end];
    grid-template-rows: [photo-start] auto [photo-end] auto;
    background: var(--bg-grouped);
  }

  .band__media {
    grid-column: full;
    grid-row: photo;
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: var(--hero-w, 3500) / var(--hero-h, 2532);
    max-height: max(calc(100svh - var(--nav-h) - 5rem), calc(41vw + 3rem));
  }

  .band__media :global(.photo) {
    position: absolute;
    inset: 0;
  }

  .band__checker {
    grid-column: content;
    grid-row: 2;
    padding-block: 1.25rem 2.5rem;
  }

  .band__checker :global(.bk-dc) {
    margin-inline: auto;
  }

  .band__checker :global(:focus-visible) {
    outline-color: var(--focus-ring);
  }

  /* Phones: the portrait file, cut between the benches, keeping the roof from 58vw of height. */
  @media (width < 46.5rem) {
    .band {
      --photo-pos: 50% calc(100% + 19.6vw);
    }

    .band__media {
      aspect-ratio: 7 / 10;
      max-height: min(122.9vw, max(calc(100svh - var(--nav-h) - 16rem), 58vw));
    }
  }

  /* Short, wide screens: the band keeps the roof near its top and ends through the gazebo's posts. */
  @media (height < 36rem) and (min-aspect-ratio: 19 / 10) {
    .band {
      --photo-pos: 50% -28.8vw;
    }

    .band__media {
      max-height: 58svh;
    }
  }

  @media (width >= 64rem) and (height >= 36rem) {
    .band__media {
      aspect-ratio: auto;
      height: min(calc(100vw * var(--hero-h, 2532) / var(--hero-w, 3500)), max(calc(41vw + 3rem), 78svh));
      max-height: none;
    }

    /*
      The gazebo's right side is at 59 percent of the width. Where the header's column would bring the checker
      within 2.5rem of it (very wide screens, larger text), the checker moves out into the margin just enough,
      never past the gutter. Otherwise it lines up with the header exactly.
    */
    .band__checker {
      --edge: max(var(--gutter), calc(50vw - var(--max) / 2));
      grid-column: content;
      grid-row: photo;
      align-self: end;
      justify-self: end;
      z-index: 1;
      width: var(--checker-w);
      margin-right: clamp(calc(var(--gutter) - var(--edge)), calc(40.8vw - var(--edge) - var(--checker-w) - 2.5rem), 0px);
      padding-block: 2.5rem clamp(2rem, 1rem + 1.5vw, 3rem);
    }

    /* The card becomes a glass panel; the glass tokens turn solid under Reduce Transparency and Increase Contrast. */
    .band__checker :global(.bk-dc) {
      max-width: none;
      margin-inline: 0;
      background-color: var(--glass-bg-strong);
      -webkit-backdrop-filter: var(--glass-blur);
      backdrop-filter: var(--glass-blur);
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-edge), var(--glass-shadow);
    }
  }

  /* 64 to 70rem (a 1024px tablet in landscape): a narrower checker keeps 2.5rem clear of the gazebo. */
  @media (64rem <= width < 70rem) and (height >= 36rem) {
    .band {
      --checker-w: 21rem;
    }

    .band__checker :global(.bk-dc__sats .bk-chips) {
      gap: 6px;
    }

    .band__checker :global(.bk-dc__sats .bk-chip) {
      padding-inline: 4px;
    }
  }

  /* ---------- The three spaces ---------- */

  .spaces {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  @media (min-width: 56rem) {
    .spaces {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* 12px around a 20px photo radius makes the card's 32px corner concentric. */
  .space {
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    border-radius: var(--r-xl);
  }

  .space__body {
    display: grid;
    flex: 1;
    align-content: start;
    justify-items: start;
    gap: 0.75rem;
    padding: 1.25rem 0.75rem 0.5rem;
  }

  .space__name {
    margin-top: 0.25rem;
  }

  .space__cap {
    gap: 0.4rem;
    min-height: 28px;
    padding-inline: 0.75rem;
    font-size: var(--t-footnote);
  }

  .space__cap :global(.icon) {
    width: 1rem;
    height: 1rem;
  }

  .space__sentence {
    max-width: 34rem;
  }

  /* ---------- Feature strip ---------- */

  .features {
    border-top: 1px solid var(--separator);
  }

  .features__list {
    display: grid;
    gap: 1.75rem 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .features__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
