---
/**
 * Home (docs/design/redesign-v7.md, section 5, "/ Home"), in this order: the video hero with the welcome
 * over the pink rose clip (the business name as the first screen's one dominant element, which morphs into
 * the header lockup on scroll), the three spaces as figure cards, the date checker beside its copy, the
 * events we host (one staged figure beside the eight event names), and where to find us.
 *
 * Nothing sits on any photo: the cards show each photo whole with the name and the capacity under it, and
 * the splits put their captions under the photo. The welcome over the rose video is the one exception: it
 * is footage, not a photograph of the property.
 *
 * Each fact has one home (redesign-v7.md, section 4): the capacities appear here only on the space cards,
 * which link to their sections on The Space; what the rental includes is on The Space, the rates on Rates,
 * the address here once beside Get Directions (arrival), and in the footer. Booking is the welcome's button
 * and the date checker. Photos follow the one photo rule (src/data/photos.ts): real photos for the spaces
 * and the arrival, one staged photo with its disclosure for the events. No image appears twice.
 *
 * The morph. The welcome's name is the header lockup's own words (Logo, 'lockup-name') on one line at every
 * width, with the lockup's ring ('lockup-ring') beside it, unseen, so it has the very shape it lands on.
 * It moves as one rigid shape, so no part of it ever crosses another: an outer box holds it still on the
 * screen while the page scrolls. Over the first 20% "Welcome to" scrolls away above it (it rises faster than
 * the name) and fades, and the line and the button fade where they stand, below it, while the page slides
 * up over them; then an inner box glides the name up and shrinks it into the header's lockup (an
 * ease-in-out, so it is still moving as it lands) while the ring gathers around it. Over the last 6 pixels
 * the header's own lockup, in exactly the same place, fades in as the name fades out. The morph runs over
 * the hero's height less the bar, the same distance after which the header turns solid (Header.astro), so
 * the name lands as the bar appears.
 *
 * Every part is a transform or an opacity on a scroll timeline, so the compositor moves the name in the
 * same frame as the scroll: no script runs per frame, nothing reads layout while scrolling, and nothing
 * animates a filter. The geometry is measured once, and again only when a resize, a font load, or a change
 * of text size actually moves the hero, the bar, or the lockup (a phone's address bar does not).
 * Browsers without scroll timelines run the same tracks from a frame callback. Readers who prefer reduced
 * motion, short screens (where the bar scrolls away), and browsers without scripts get the header lockup at
 * once and a still welcome.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVideo from '../components/HeroVideo.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Carousel from '../components/Carousel.astro';
import FigureCard from '../components/FigureCard.astro';
import ImageTextSplit from '../components/ImageTextSplit.astro';
import DateChecker from '../components/booking/DateChecker';
import { site, cityState, fullAddress } from '../data/site';
import { events } from '../data/events';
import { EVENTS_STYLED_NOTE, STAGED_SCENES, eventPhoto, eventsStaged, photoByName, photosFor, type VenuePhoto } from '../data/photos';
import { bookHref } from '../data/nav';
import { href } from '../lib/paths';

const hall = site.spaces.find((s) => s.id === 'indoor');
const mainHall = site.spaces.find((s) => s.id === 'main');
const grove = site.spaces.find((s) => s.id === 'outdoor');
const hallName = hall?.name ?? 'The Hall';
const mainHallName = mainHall?.name ?? 'The Main Hall';
const groveName = grove?.name ?? 'The Grove';

/* The three spaces: each card shows its space's primary real photo and its capacity (the only capacity on this page). */
interface SpaceCard {
  name: string;
  capacity: number | undefined;
  photo: VenuePhoto | undefined;
  href: string;
}
const spaceCards: SpaceCard[] = [
  { name: hallName, capacity: hall?.capacity, photo: photosFor('hall')[0], href: '/the-space/#hall' },
  { name: mainHallName, capacity: mainHall?.capacity, photo: photosFor('main')[0], href: '/the-space/#main-hall' },
  { name: groveName, capacity: grove?.capacity, photo: photosFor('grove')[0], href: '/the-space/#grove' },
];

/*
  The events: the weddings staged photo, with its disclosure, beside the eight event names. Without the
  staged set the list stands alone (photos.ts: a staged image or none).
*/
const pagePhotos = new Set([...spaceCards.map((c) => c.photo?.name), 'driveway'].filter((n): n is string => Boolean(n)));
const weddingsPhoto = eventsStaged ? eventPhoto('weddings') : null;
const eventsPhoto = weddingsPhoto?.styledOf !== undefined && !pagePhotos.has(weddingsPhoto.name) ? weddingsPhoto : null;

/* The arrival: the drive and lot in daylight. */
const arrival = photoByName('driveway');

const title = 'Event venue in Suffolk, VA | The Venue @ NCC';
const description = `Welcome to The Venue @ NCC, an event venue in Suffolk, Virginia: ${hallName} and ${mainHallName} for up to ${hall?.capacity} guests each, ${groveName} for up to ${grove?.capacity}. Check your date online.`;
---
<BaseLayout title={title} description={description} og="home" venueDetails morphLogo>
  <HeroVideo labelledby="hero-title" class="welcome">
    <div class="welcome__inner">
      <h1 id="hero-title" class="welcome__h1">
        <span class="welcome__eyebrow" data-morph-eyebrow>Welcome to</span>
        <span class="welcome__name" data-morph-pin>
          <span class="visually-hidden">The Venue @ NCC</span>
          <span class="welcome__fly" data-morph-fly>
            <Logo variant="lockup-ring" height="calc(100 * var(--u))" decorative class="welcome__ring" data-morph-ring="" />
            <Logo variant="lockup-name" height="calc(54 * var(--u))" decorative class="welcome__words" data-morph-words="" />
          </span>
        </span>
      </h1>
      <div class="welcome__below" data-morph-below>
        <p class="welcome__line">Event venue in {cityState}</p>
        <div class="welcome__actions">
          <a class="btn btn--filled btn--lg" href={href(bookHref)}>Check Availability</a>
        </div>
      </div>
    </div>
  </HeroVideo>

  <div class="page">
    <section class="section" aria-labelledby="spaces-heading">
      <div class="container">
        <SectionHeading
          id="spaces-heading"
          eyebrow="The spaces"
          heading="Three spaces, indoors and out"
          lead="Our fully renovated property is available for weddings, receptions, conferences, banquets, memorials, and community gatherings, with elegant backdrops, flexible layouts, and full-day access."
        >
          <Fragment slot="actions">
            <a class="btn btn--outline" href={href('/the-space/')}>Explore The Space</a>
          </Fragment>
        </SectionHeading>
        <Carousel cols={3} label="The spaces">
          {
            spaceCards.map(
              (card) =>
                card.photo && (
                  <FigureCard
                    photo={card.photo}
                    label={card.name}
                    meta={card.capacity ? `Up to ${card.capacity} guests` : undefined}
                    href={card.href}
                    sizes="(min-width: 75rem) 410px, (min-width: 60rem) 31vw, (min-width: 46.5rem) 46vw, 82vw"
                  />
                ),
            )
          }
        </Carousel>
      </div>
    </section>

    <section class="section" aria-labelledby="date-heading">
      <div class="container checker">
        <div class="checker__copy">
          <SectionHeading id="date-heading" eyebrow="Availability" heading="Check a date" lead="See which spaces are open on your day." />
        </div>
        <div class="checker__panel">
          <DateChecker client:load bookHref={href(bookHref)} />
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="events-heading">
      <div class="container">
        {
          eventsPhoto ? (
            <ImageTextSplit
              photo={eventsPhoto}
              id="events-heading"
              eyebrow="Occasions"
              heading="Events we host"
              lead={EVENTS_STYLED_NOTE}
              caption={STAGED_SCENES[eventsPhoto.name] ?? false}
              sizes="(min-width: 75rem) 620px, (min-width: 60rem) 50vw, 100vw"
            >
              <ul class="event-links" aria-label="Events we host">
                {events.map((e) => (
                  <li>
                    <a class="event-link" href={href(`/events/${e.slug}/`)}>{e.name}</a>
                  </li>
                ))}
              </ul>
              <a class="link-more" href={href('/events/')}>See All Events <Icon name="chevron-right" /></a>
            </ImageTextSplit>
          ) : (
            <>
              <SectionHeading id="events-heading" eyebrow="Occasions" heading="Events we host">
                <Fragment slot="actions">
                  <a class="link-more" href={href('/events/')}>See All Events <Icon name="chevron-right" /></a>
                </Fragment>
              </SectionHeading>
              <ul class="event-links" aria-label="Events we host">
                {events.map((e) => (
                  <li>
                    <a class="event-link" href={href(`/events/${e.slug}/`)}>{e.name}</a>
                  </li>
                ))}
              </ul>
            </>
          )
        }
      </div>
    </section>

    {
      arrival && (
        <section class="section" aria-labelledby="location-heading">
          <div class="container">
            <ImageTextSplit
              photo={arrival}
              id="location-heading"
              eyebrow="Getting here"
              heading="Find us in north Suffolk"
              lead={`${fullAddress}.`}
              caption="The drive and the parking lot"
            >
              <Fragment slot="actions">
                <a class="btn btn--outline" href={site.address.directionsUrl} rel="noopener" target="_blank">
                  Get Directions<span class="visually-hidden">, opens in a new tab</span>
                </a>
              </Fragment>
            </ImageTextSplit>
          </div>
        </section>
      )
    }
  </div>
</BaseLayout>

<script>
  /*
    The morph (see the note at the top of this file). Every moving part is a transform or an opacity on a
    scroll timeline, so the browser's compositor runs it in step with the scroll and the page's script does
    no work per frame. The geometry is measured once (and again on resize, font load, or a change of text
    size) and written into the animations as plain numbers.
  */
  import { LOCKUP, NAME_BOX } from '../lib/lockup';

  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const q = <T extends Element>(sel: string) => document.querySelector<T>(sel);
  const pin = q<HTMLElement>('[data-morph-pin]');
  const fly = q<HTMLElement>('[data-morph-fly]');
  const ring = q<SVGSVGElement>('[data-morph-ring]');
  const words = q<SVGSVGElement>('[data-morph-words]');
  const eyebrow = q<HTMLElement>('[data-morph-eyebrow]');
  const below = q<HTMLElement>('[data-morph-below]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  const short = window.matchMedia('(max-height: 500px)');

  /** A move (translate and scale) and an opacity, the only two things the morph animates. */
  interface Pose {
    x?: number;
    y?: number;
    s?: number;
    o?: number;
  }
  /** One element's change between two scroll positions (px from the top), eased or linear. */
  interface Track {
    el: HTMLElement | SVGSVGElement;
    from: Pose;
    to: Pose;
    a: number;
    b: number;
    ease: boolean;
  }

  // An ease-in-out for the name's flight: it sets off gently once the line and the button have gone, travels
  // while the page rises, and is still moving as it lands, so it never parks short of the bar. The browser's
  // timeline takes the cubic Bezier; the fallback solves the same curve.
  const BEZIER = [0.65, 0, 0.35, 1] as const;
  const EASE = `cubic-bezier(${BEZIER.join(', ')})`;
  const ease = (t: number) => {
    const [x1, y1, x2, y2] = BEZIER;
    const at = (p1: number, p2: number, u: number) => 3 * (1 - u) * (1 - u) * u * p1 + 3 * (1 - u) * u * u * p2 + u * u * u;
    let lo = 0;
    let hi = 1;
    for (let i = 0; i < 24; i++) {
      const mid = (lo + hi) / 2;
      if (at(x1, x2, mid) < t) lo = mid;
      else hi = mid;
    }
    return at(y1, y2, (lo + hi) / 2);
  };
  // The share of the morph over which "Welcome to", the line, and the button fade, before the name sets off.
  const FADE = 0.2;

  const style = (p: Pose): Keyframe =>
    p.o !== undefined
      ? { opacity: String(p.o) }
      : { transform: `translate(${(p.x ?? 0).toFixed(2)}px, ${(p.y ?? 0).toFixed(2)}px) scale(${(p.s ?? 1).toFixed(5)})` };

  if (nav && hero && pin && fly && ring && words && eyebrow && below) {
    // Scroll timelines where the browser has them (the compositor runs them); otherwise a frame callback.
    const Timeline = (window as unknown as { ScrollTimeline?: new (o: { source: Element; axis: string }) => AnimationTimeline }).ScrollTimeline;
    let timeline: AnimationTimeline | null = null;
    let anims: Animation[] = [];
    let tracks: Track[] = [];
    let active = false;
    let distance = 1;
    let gone: boolean | null = null;
    let landed: boolean | null = null;
    let ticking = false;
    let geometry = '';

    /** The lockup the header shows at this width. */
    const lockup = () =>
      [...nav.querySelectorAll<SVGSVGElement>('[data-lockup]')].find((el) => el.getBoundingClientRect().width > 0) ?? null;

    const moving = () => [pin, fly, ring, eyebrow, below, ...nav.querySelectorAll<SVGSVGElement>('[data-lockup]')];

    function clear() {
      for (const a of anims) a.cancel();
      anims = [];
      for (const el of moving()) {
        el.style.transform = '';
        el.style.opacity = '';
      }
    }

    /** The fallback: the same tracks, applied in a frame callback when the page scrolls. */
    function frame() {
      ticking = false;
      const y = window.scrollY;
      for (const t of tracks) {
        const raw = Math.min(1, Math.max(0, (y - t.a) / (t.b - t.a)));
        const k = t.ease ? ease(raw) : raw;
        const mix = (f: number | undefined, to: number | undefined, d: number) => (f ?? d) + ((to ?? d) - (f ?? d)) * k;
        const p: Pose =
          t.to.o !== undefined
            ? { o: mix(t.from.o, t.to.o, 1) }
            : { x: mix(t.from.x, t.to.x, 0), y: mix(t.from.y, t.to.y, 0), s: mix(t.from.s, t.to.s, 1) };
        Object.assign(t.el.style, style(p));
      }
    }

    /** States that only change at a threshold: the hidden button, and the name in the bar. */
    function marks() {
      const y = window.scrollY;
      const g = y >= distance * FADE;
      if (g !== gone) {
        gone = g;
        hero!.toggleAttribute('data-welcome-gone', g);
      }
      const l = y >= distance;
      if (l !== landed) {
        landed = l;
        nav!.toggleAttribute('data-morphed', l);
      }
    }

    function onScroll() {
      if (!active) return;
      marks();
      if (!timeline && !ticking) {
        ticking = true;
        requestAnimationFrame(frame);
      }
    }

    /** Where the name rests, where its twin sits in the header, and the tracks between them. */
    function measure() {
      const lk = lockup();
      if (!lk) return;
      // Nothing to do when nothing has moved: a phone's address bar showing or hiding resizes the window but
      // not the hero (100svh), the bar, or the lockup. Rebuilding the animations then would only risk a frame
      // with none applied.
      const lr = lk.getBoundingClientRect();
      const key = [window.innerWidth, hero!.offsetHeight, nav!.offsetHeight, lr.left, lr.top, lr.width, lr.height]
        .map((n) => n.toFixed(2))
        .join();
      if (key === geometry) return;
      geometry = key;
      clear();
      const y = window.scrollY;
      const r = words!.getBoundingClientRect();
      const l = lk.getBoundingClientRect();
      const k = l.height / LOCKUP.height;
      // The header's words, in the viewport (the bar is sticky at the top, so this is where they stay).
      const to = { left: l.left + NAME_BOX.x * k, top: l.top + NAME_BOX.y * k, width: NAME_BOX.width * k };
      // The morph runs over the hero's height less the bar: the same scroll after which the bar turns solid.
      const d = Math.max(1, hero!.offsetHeight - nav!.offsetHeight);
      distance = d;
      const restTop = r.top + y;
      tracks = [
        // The name holds still on the screen while the page scrolls (the hero's video does the same)...
        { el: pin!, from: { y: 0 }, to: { y: d }, a: 0, b: d, ease: false },
        // ...and, once "Welcome to", the line, and the button have faded, glides up into the bar, shrinking to
        // the header's size: one rigid shape, so no part of it ever crosses another.
        { el: fly!, from: {}, to: { x: to.left - r.left, y: to.top - restTop, s: to.width / r.width }, a: d * FADE, b: d, ease: true },
        // The lockup's ring gathers around it on the way in.
        { el: ring!, from: { o: 0 }, to: { o: 1 }, a: d * 0.55, b: d * 0.95, ease: false },
        // "Welcome to" scrolls away above the name (faster than the name rises) and fades.
        { el: eyebrow!, from: { o: 1 }, to: { o: 0 }, a: 0, b: d * FADE, ease: false },
        // The line and the button stay put below the name, fade, and the page slides up over them.
        { el: below!, from: { y: 0 }, to: { y: d }, a: 0, b: d, ease: false },
        { el: below!, from: { o: 1 }, to: { o: 0 }, a: 0, b: d * FADE, ease: false },
        // On landing the header's own lockup, drawn in exactly the same place, takes over: one crossfade over
        // the same few pixels, so the two are never both fully drawn.
        { el: lk, from: { o: 0 }, to: { o: 1 }, a: d - 6, b: d, ease: false },
        { el: fly!, from: { o: 1 }, to: { o: 0 }, a: d - 6, b: d, ease: false },
      ];
      // The same pose as inline styles: a new scroll-linked animation waits a frame before it applies, and
      // these hold everything in place for that frame (a running animation overrides them).
      frame();
      if (timeline) {
        anims = tracks.map((t) =>
          t.el.animate([style(t.from), style(t.to)], {
            timeline,
            rangeStart: `${t.a.toFixed(2)}px`,
            rangeEnd: `${t.b.toFixed(2)}px`,
            easing: t.ease ? EASE : 'linear',
            fill: 'both',
          } as KeyframeAnimationOptions),
        );
      }
      gone = null;
      landed = null;
      marks();
    }

    function stop() {
      active = false;
      geometry = '';
      clear();
      tracks = [];
      hero!.removeAttribute('data-welcome-gone');
      nav!.removeAttribute('data-morph');
      nav!.removeAttribute('data-morphed');
    }

    function start() {
      if (still.matches || short.matches) {
        stop();
        return;
      }
      if (!active) {
        active = true;
        nav!.setAttribute('data-morph', '');
      }
      if (Timeline && !timeline) timeline = new Timeline({ source: document.documentElement, axis: 'block' });
      measure();
    }

    let resizeTimer = 0;
    const onResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(start, 80);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    window.addEventListener('load', onResize);
    still.addEventListener('change', start);
    short.addEventListener('change', start);
    // A late font or larger text moves the welcome or resizes the bar: measure again when either changes size.
    document.fonts?.ready.then(onResize);
    if ('ResizeObserver' in window) {
      const ro = new ResizeObserver(onResize);
      ro.observe(hero);
      ro.observe(nav);
    }
    start();
  }
</script>

<style>
  /* ---------- Welcome ---------- */

  /*
    The first screen: "Welcome to" and the business name, the largest type on the site, centred over the
    roses. The name is the header lockup's own words on one line, at every width, so it has the very shape
    it lands on. --u is one unit of the lockup's grid in pixels: the words are 402.5 units wide (NAME_BOX in
    src/lib/lockup.ts), so they span the container's width on phones (89vw at 390) and 74vw (at most 68rem)
    from 46.5rem. The ring is drawn in the same unit, so the words must never be capped apart from it.
  */
  .welcome__inner {
    --u: calc(min(100vw - 2 * var(--gutter), 40rem) / 402.5);
    display: grid;
    justify-items: center;
    gap: clamp(1.25rem, 0.75rem + 1.5vw, 2rem);
    text-align: center;
  }

  @media (min-width: 46.5rem) {
    .welcome__inner {
      --u: calc(min(74vw, 68rem) / 402.5);
    }
  }

  .welcome__h1 {
    display: grid;
    justify-items: center;
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
    font-weight: 400;
    text-wrap: initial;
  }

  /* A quiet serif line above the name: the reader's eye goes to the name. */
  .welcome__eyebrow {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2rem);
    line-height: 1.2;
    color: var(--label);
  }

  /*
    The name: an outer box that holds it still on the screen while the page scrolls (it rises above the
    sticky bar, z-index 60, on its way in), and an inner box that carries the words and the ring and moves
    and scales as one rigid shape. Nothing animated sits between the outer box and the page, so the stacking
    order holds. The colors are the header lockup's own (Logo's defaults), so the landing is seamless.
  */
  .welcome__name {
    position: relative;
    z-index: 61;
    display: flex;
    justify-content: center;
    width: 100%;
    pointer-events: none;
  }

  .welcome__fly {
    position: relative;
    display: block;
    transform-origin: 0 0;
  }

  /* The ring sits where it sits in the lockup (125 units left of the words, 23 above), unseen until the end. */
  .welcome__ring {
    position: absolute;
    left: calc(-125 * var(--u));
    top: calc(-23 * var(--u));
    opacity: 0;
  }

  .welcome__eyebrow,
  .welcome__line {
    text-shadow: 0 0 12px var(--bg), 0 0 3px var(--bg);
  }

  /*
    The name keeps a soft White halo that hugs its letters, so the Plum words and the Cerise "@ NCC" hold
    their contrast at the glyph edge over the darker rose petals while the veil stays light enough for the
    roses to read as pink (redesign-v7.md, section 6; brand.md, "The hero loop", gives the measured values).
    The filter is static: the morph only moves and fades the box that holds it, and over the solid White bar
    the halo is invisible, so the landing is unchanged.
  */
  .welcome__words {
    filter: drop-shadow(0 0 1px #fff) drop-shadow(0 0 2px #fff) drop-shadow(0 0 3px #fff) drop-shadow(0 0 12px rgb(255 255 255 / 0.8));
  }

  .welcome__below {
    display: grid;
    justify-items: center;
    gap: inherit;
  }

  .welcome__line {
    font-family: var(--font-serif);
    font-size: var(--t-subhead);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* The text color at every size: over the darker rose petals Cerise drops below 4.5:1. */
    color: var(--label);
  }

  .welcome__actions {
    display: flex;
    justify-content: center;
  }

  /* Once the line and the button have faded, the button cannot be reached by a tap or the Tab key. */
  :global([data-welcome-gone]) .welcome__below {
    visibility: hidden;
  }

  /*
    No morph (reduced motion, short screens, no scripts): the ring stays out of sight, and the name scrolls
    away under the bar like the rest of the page instead of over it.
  */
  @media (prefers-reduced-motion: reduce), (max-height: 500px), (scripting: none) {
    .welcome__ring {
      display: none;
    }

    .welcome__name {
      z-index: auto;
    }
  }

  /* ---------- The page over the fixed video ---------- */

  .page {
    position: relative;
    z-index: 1;
    background: var(--bg);
  }

  /* ---------- Check a date ---------- */

  .checker {
    display: grid;
    gap: 2rem 4rem;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .checker {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      justify-content: space-between;
    }
  }

  .checker__copy :global(.section-head) {
    margin-bottom: 0;
  }

  .checker__panel :global(.bk-dc) {
    max-width: none;
    margin-inline: 0;
