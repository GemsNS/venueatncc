---
/**
 * Home, per docs/design/brand.md "Page direction: Home", in this order:
 * the hero on the pines of The Grove with the date checker, the two spaces as real-photo cards, the events,
 * a rates teaser, the arrival band, and the closing band.
 *
 * Each fact has one place on the page (brand.md, "Redundancy rules"): capacities on the space cards,
 * parking and the address in the arrival band, a call to phone for rates in the rates section, and how booking works in the
 * closing band. The hero's one primary button is the date checker's Continue to Booking; the header CTA
 * and the closing band carry Check Availability.
 * Photos follow the one photo rule (src/data/photos.ts): real photos for the spaces, and event tiles that
 * are all staged or all text. No image appears twice.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import EventIndex from '../components/EventIndex.astro';
import LocationBand from '../components/LocationBand.astro';
import DateChecker from '../components/booking/DateChecker';
import { site } from '../data/site';
import { EVENTS_STYLED_NOTE, eventsStaged, heroPhoto, photoByName, photosFor, type VenuePhoto } from '../data/photos';
import { bookHref } from '../data/nav';
import { href } from '../lib/paths';

/*
  The hero: the gazebo under the tall pines of The Grove (grove-pines, tagged 'hero'), a real photo in two
  crops of the original behind grove-path, whose staged version is the community events tile. Phones get the
  portrait file, a framing of its own: the pines at full height, with the copy over their canopy. Wider
  screens get the landscape file, nearly the original's full width (leveled by 2.5 degrees) from the trunks above the gazebo down through
  the legs of the front picnic table. It is named here, not taken from heroPhoto(), because the hero's frames
  below are fitted to its framing. Its size sets the tablet frame's ratio.
*/
const hero = photoByName('grove-pines') ?? heroPhoto();
const heroSize = hero ? `--hero-w: ${hero.src.width}; --hero-h: ${hero.src.height}` : undefined;
const hall = site.spaces.find((s) => s.id === 'indoor');
const grove = site.spaces.find((s) => s.id === 'outdoor');
const hallName = hall?.name ?? 'The Hall';
const groveName = grove?.name ?? 'The Grove';

/*
  The two spaces: the teaser for The Space, which carries the full description. Each card shows its space's
  primary real photo, its capacity (the only capacity on this page), one sentence on what the space is (the
  hero lead already says which is indoors and which is outdoors, and the event tiles below say what each
  hosts), and a link.
*/
interface SpaceCard {
  id: 'hall' | 'grove';
  name: string;
  capacity: number | undefined;
  sentence: string;
  photo: VenuePhoto | undefined;
  href: string;
}
const spaceCards: SpaceCard[] = [
  {
    id: 'hall',
    name: hallName,
    capacity: hall?.capacity,
    sentence: 'Arched windows, a fireplace feature wall, and dark wood-look floors.',
    photo: photosFor('hall')[0],
    href: '/the-space/#hall',
  },
  {
    id: 'grove',
    name: groveName,
    capacity: grove?.capacity,
    sentence: 'A timber gazebo and picnic tables on a patio under tall pines.',
    photo: photosFor('grove')[0],
    href: '/the-space/#grove',
  },
];

/*
  Every photo shown elsewhere on this page, so the event tiles never repeat one. LocationBand picks the drive
  at dusk itself, so it is named here.
*/
const pagePhotos = [hero?.name, ...spaceCards.map((c) => c.photo?.name), 'approach-dusk'].filter((n): n is string => Boolean(n));

const title = 'Event venue in Suffolk, VA | The Venue at NCC';
const description = `An event venue among the pines in Suffolk, Virginia: ${hallName} for up to ${hall?.capacity} guests, ${groveName} for up to ${grove?.capacity}, and on-site parking. Check your date online.`;
---
<BaseLayout title={title} description={description} og="home" venueDetails>
  <section class="hero" aria-labelledby="hero-title" style={heroSize}>
    {
      hero && (
        <div class="hero__media">
          <Photo photo={hero} ratio="fill" tall rounded={false} priority sizes="100vw" />
        </div>
      )
    }
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__h1">
        <span class="hero__kicker">Event venue in Suffolk, Virginia<span class="visually-hidden">:</span></span>
        <span class="hero__title t-display"><span class="hero__line">Celebrate</span> <span class="hero__line">among the pines.</span></span>
      </h1>
      <p class="hero__lead">
        <span class="hero__clause">Host your event indoors in {hallName}</span>
        <span class="hero__clause">or outdoors in {groveName}.</span>
      </p>
    </div>
    <div class="hero__checker">
      <DateChecker client:load bookHref={href(bookHref)} />
    </div>
  </section>

  <section class="section" aria-labelledby="spaces-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="spaces-heading">The Hall and The Grove</h2>
      </div>
      <div class="spaces">
        {
          spaceCards.map((card) => {
            return (
              <article class="space card" aria-labelledby={`space-${card.id}`}>
                {card.photo && (
                  <Photo photo={card.photo} caption={false} sizes="(min-width: 75rem) 570px, (min-width: 56rem) 46vw, 92vw" />
                )}
                <div class="space__body">
                  <h3 id={`space-${card.id}`} class="space__name t-title-1">
                    {card.name}
                  </h3>
                  {card.capacity && (
                    <p class="space__cap">
                      <Icon name="users" />
                      Up to {card.capacity} guests
                    </p>
                  )}
                  <p class="space__sentence secondary">{card.sentence}</p>
                  <a class="link-more" href={href(card.href)}>
                    Explore {card.name} <Icon name="chevron-right" />
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section section--grouped" aria-labelledby="events-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="events-heading">Events we host</h2>
        {eventsStaged && <p class="t-lead">{EVENTS_STYLED_NOTE}</p>}
      </div>
      <EventIndex layout="shelf" avoid={pagePhotos} />
    </div>
  </section>

  <section class="section" aria-labelledby="rates-heading">
    <div class="container rates">
      <div class="rates__copy">
        <h2 id="rates-heading">Our special rates</h2>
        <p class="t-lead">
          Our affordable rates vary with peak season, holidays, and the day of the week. For pricing and special offers,
          please call us and we will be happy to help you.
        </p>
      </div>
      <div class="rates__panel">
        <div class="btn-row rates__action">
          <a class="btn btn--filled btn--lg" href={`tel:${site.contact.phoneE164}`}>
            <Icon name="phone" />
            Call {site.contact.phone}
          </a>
        </div>
      </div>
    </div>
  </section>

  <LocationBand />

</BaseLayout>

<style>
  /* ---------- Hero ---------- */

  /*
    One grid for the hero, and a photo that is never cropped into its subject: every frame holds the whole
    gazebo, the copy never covers it, and a frame's bottom edge never runs along a tabletop.
      Phones (below 46.5rem): the portrait file, full bleed at its own 7:10, so the pines read full height.
        The copy sits over their canopy on a Navy scrim; the date checker follows the photo.
      Tablets (46.5 to 64rem): the landscape file at its own ratio (shorter on short screens), the copy over
        the trunks above the gazebo, the checker after the photo.
      Wide screens (from 64rem): the photo fills the first screen. The title runs across the top, the gazebo
        stands below it, and the checker floats at the bottom right on glass, beside the gazebo.
    Narrow screens, short screens, and larger text move the copy to a Navy panel under the photo (below).

    The frames are fitted to the two files' framing, measured on the files at 100vw (the files always span
    the full width):
      Landscape (grove-pines.jpg, 3500 x 2532, the leveled original nearly edge to edge): it ends through the legs of
        the front picnic table, between its two benches. From that edge up to the gazebo's roof is 40.2vw
        (41vw with the roof's cap); the roof is 32.1vw below the file's top; the gazebo spans 27 to 59
        percent of the width. So a frame with copy over it is never shorter than 41vw plus the copy's
        height, and it keeps the file's bottom edge (--photo-pos 50% 100%): the frame loses sky, never tables.
      Portrait (grove-pines-tall.jpg, 7:10): the roof is 69.9vw below its top; the same cut between the
        benches is 19.6vw above its bottom, and 53.4vw below the roof.
    The DateChecker island renders once (its ids are fixed), so CSS alone moves it.

    Rows: the photo spans the copy row and the rest of its height, so the scrim can follow the copy's own
    height at every text size; then a row for the panel and one for the checker.
  */
  .hero {
    --checker-w: 23.75rem;
    --photo-pos: 50% 100%;
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [content-start] minmax(0, var(--max))
      [content-end] minmax(var(--gutter), 1fr)
      [full-end];
    grid-template-rows: [photo-start copy-start] auto [copy-end] 1fr [photo-end] auto auto;
    background: var(--bg-grouped);
  }

  /*
    Tablets: the landscape file at its own ratio (--hero-w and --hero-h come from the file), shorter on short
    screens so the checker's card shows under it, but never shorter than the copy and the gazebo need
    (above). The width is set, so the max-height shortens the frame instead of narrowing it through the ratio.
  */
  .hero__media {
    grid-column: full;
    grid-row: photo;
    align-self: start;
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: var(--hero-w, 3661) / var(--hero-h, 2648);
    max-height: max(calc(100svh - var(--nav-h) - 5rem), calc(41vw + 15rem));
  }

  .hero__media :global(.photo) {
    position: absolute;
    inset: 0;
  }

  /*
    Legibility scrim in Navy (--navy-rgb): as tall as the copy, dark enough under the lead for 4.5:1 over the
    bright sky between the trunks, then a short fade that ends above the gazebo's roof. The only gradients on
    the site are scrims like this one.
  */
  .hero__scrim {
    grid-column: full;
    grid-row: copy;
    /* Positioned like the photo, so it paints above it. */
    position: relative;
    background: linear-gradient(to bottom, rgb(var(--navy-rgb) / 0.8), rgb(var(--navy-rgb) / 0.62));
  }

  .hero__scrim::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 4.5rem;
    background: linear-gradient(
      to bottom,
      rgb(var(--navy-rgb) / 0.62) 0%,
      rgb(var(--navy-rgb) / 0.36) 32%,
      rgb(var(--navy-rgb) / 0.12) 66%,
      rgb(var(--navy-rgb) / 0) 100%
    );
  }

  .hero__copy {
    grid-column: content;
    grid-row: copy;
    z-index: 1;
    display: grid;
    gap: 1rem;
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.75rem) 0.75rem;
    color: var(--on-navy);
  }

  .hero__h1 {
    display: grid;
    gap: 0.75rem;
    color: var(--on-navy);
  }

  /* Over the photo the kicker is white; on the Navy panel it takes the Mist accent (7.5:1), below. */
  .hero__kicker {
    font-family: var(--font);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--on-navy);
    text-shadow: 0 1px 2px rgb(var(--navy-rgb) / 0.6);
  }

  /*
    With very large text the title stays well above the lead's size, not just the vw cap, and "among the
    pines." still fits one line of a phone at 200% text.
  */
  .hero__title {
    font-size: max(var(--t-display), 1.6rem);
    color: var(--on-navy);
    text-shadow: 0 1px 24px rgb(var(--navy-rgb) / 0.45);
  }

  /*
    When the title needs two lines it breaks after "Celebrate", and when the lead needs two it breaks between
    its clauses; each part still wraps within itself when it must.
  */
  .hero__line,
  .hero__clause {
    display: inline-block;
  }

  .hero__lead {
    max-width: 40rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.5;
    color: var(--on-navy);
    text-shadow: 0 1px 3px rgb(var(--navy-rgb) / 0.6);
  }

  .hero :global(:focus-visible) {
    outline-color: var(--on-navy);
  }

  .hero__checker :global(:focus-visible) {
    outline-color: var(--focus-ring);
  }

  /* Below the wide layout the checker follows the photo, as a plain card on the grouped background. */
  .hero__checker {
    grid-column: content;
    grid-row: 3;
    padding-block: 1.25rem 2.5rem;
  }

  .hero__checker :global(.bk-dc) {
    margin-inline: auto;
  }

  /*
    Phones: the portrait file at its own 7:10, whole, from the sky over the pines to the picnic tables, at
    every phone height, so the copy always has the canopy to itself.
  */
  @media (width < 46.5rem) {
    .hero__media {
      aspect-ratio: 7 / 10;
      max-height: none;
    }

    .hero__copy {
      gap: 0.85rem;
      padding-block: 1.5rem 0.5rem;
    }

    .hero__h1 {
      gap: 0.6rem;
    }
  }

  /*
    Narrow or short screens, and larger text: the copy would reach the gazebo, so it moves to a Navy panel
    that continues from the photo, and the checker follows. The photo becomes a band that keeps the file's
    bottom edge and, at 44vw or more, the gazebo's roof.
  */
  @media (width < 22rem), (height < 36rem) {
    .hero__media {
      max-height: max(calc(100svh - var(--nav-h) - 5rem), 44vw);
    }

    .hero__scrim {
      display: none;
    }

    .hero__copy {
      grid-column: full;
      grid-row: 3;
      gap: 1rem;
      padding: 1.75rem var(--gutter) 2rem;
      background: var(--navy);
    }

    .hero__title,
    .hero__kicker,
    .hero__lead {
      text-shadow: none;
    }

    .hero__kicker {
      color: var(--on-navy-accent);
    }

    .hero__lead {
      color: rgb(255 255 255 / 0.92);
    }

    .hero__checker {
      grid-row: 4;
    }
  }

  /*
    On a phone with the copy on the panel, the photo gives up height first, so the title shows sooner. The
    band ends on the same cut between the benches as the landscape file, and at 58vw or more it keeps the
    gazebo's roof.
  */
  @media (width < 22rem), (width < 46.5rem) and (height < 36rem) {
    .hero {
      --photo-pos: 50% calc(100% + 19.6vw);
    }

    .hero__media {
      max-height: max(calc(100svh - var(--nav-h) - 16rem), 58vw);
    }
  }

  /*
    Short, wide screens (landscape phones, a short window, larger text on a wide screen): the photo takes a
    little over half the screen, so the kicker and the title start on the first screen. The band is too short
    for the whole gazebo, so it keeps the roof near its top and ends through the gazebo's posts and railings,
    above the tables. That holds while the band is at most about 30vw tall in the landscape file and 40vw in
    the portrait file, hence the ratios; less wide short screens keep the whole gazebo (above).
  */
  @media (height < 36rem) and (min-aspect-ratio: 19 / 10) {
    .hero {
      --photo-pos: 50% -28.8vw;
    }

    .hero__media {
      max-height: 58svh;
    }
  }

  @media (width < 46.5rem) and (height < 36rem) and (min-aspect-ratio: 3 / 2) {
    .hero {
      --photo-pos: 50% -65.5vw;
    }

    .hero__media {
      max-height: 58svh;
    }
  }

  /*
    Wide screens: the photo fills the first screen under the header, up to the file's own ratio. On a short
    screen the copy and the gazebo need more height than the screen has (above), so the photo runs on below
    the fold and the checker rises by as much, to stay in the first screen. The title keeps to one line beside
    the checker's column. The checker floats at the bottom right on glass, aligned with the header.
  */
  @media (width >= 64rem) and (height >= 36rem) {
    .hero {
      --screen-h: calc(100svh - var(--nav-h) - 1px);
      /* The copy sits closer to the header here, so it needs 14rem (less on short screens, below). */
      --copy-room: 14rem;
      --frame-h: min(calc(100vw * var(--hero-h, 2648) / var(--hero-w, 3661)), max(var(--screen-h), calc(41vw + var(--copy-room))));
    }

    .hero__media {
      aspect-ratio: auto;
      height: var(--frame-h);
      max-height: none;
    }

    .hero__copy {
      container-type: inline-size;
      max-width: min(60rem, calc(100% - var(--checker-w) - 2rem));
      padding-block: clamp(1.75rem, 6svh - 0.5rem, 3.5rem) 1rem;
    }

    /* One line in the copy's width (the title is 9.7em long); the first value is for browsers without container units. */
    .hero__title {
      font-size: min(max(var(--t-display), 1.6rem), calc((min(100vw - 2 * var(--gutter), var(--max)) - var(--checker-w) - 2rem) / 10));
      font-size: min(max(var(--t-display), 1.6rem), 10cqi);
    }

    /*
      The gazebo's right side is at 59 percent of the width. Where the header's column would bring the checker
      within 2.5rem of it (very wide screens, larger text), the checker moves out into the margin just enough,
      never past the gutter. Otherwise the margin is 0 and the checker lines up with the header exactly.
    */
    .hero__checker {
      --edge: max(var(--gutter), calc(50vw - var(--max) / 2));
      grid-column: content;
      grid-row: photo;
      align-self: end;
      justify-self: end;
      z-index: 1;
      width: var(--checker-w);
      margin-right: clamp(calc(var(--gutter) - var(--edge)), calc(40.8vw - var(--edge) - var(--checker-w) - 2.5rem), 0px);
      padding-block: 2.5rem calc(max(0px, var(--frame-h) - var(--screen-h)) + clamp(2rem, 1rem + 1.5vw, 3rem));
    }

    /*
      The card becomes a glass panel. The glass tokens turn solid under Reduce Transparency, Increase
      Contrast, and where backdrop-filter is not supported (global.css).
    */
    .hero__checker :global(.bk-dc) {
      max-width: none;
      margin-inline: 0;
      background-color: var(--glass-bg-strong);
      -webkit-backdrop-filter: var(--glass-blur);
      backdrop-filter: var(--glass-blur);
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-edge), var(--glass-shadow);
    }
  }

  /*
    64 to 70rem (a 1024px tablet in landscape): a narrower checker keeps 2.5rem clear of the gazebo. Its three
    Saturdays still share one row, with a little less padding so each date keeps to one line with room to spare.
  */
  @media (64rem <= width < 70rem) and (height >= 36rem) {
    .hero {
      --checker-w: 21rem;
    }

    .hero__checker :global(.bk-dc__sats .bk-chips) {
      gap: 6px;
    }

    .hero__checker :global(.bk-dc__sats .bk-chip) {
      padding-inline: 4px;
    }
  }

  /*
    Short wide screens (a 1024 x 768 tablet in landscape, a 1366 x 768 laptop): tighter spacing and a title
    sized to the screen's height keep the copy short, so the photo runs on less far below the fold and the
    date field and Continue to Booking sit higher in the first screen.
  */
  @media (width >= 64rem) and (36rem <= height < 53rem) {
    .hero {
      --copy-room: 12rem;
    }

    .hero__copy {
      gap: 0.75rem;
      padding-block: clamp(1.25rem, 4svh, 2rem) 0.75rem;
    }

    .hero__h1 {
      gap: 0.5rem;
    }

    .hero__title {
      font-size: min(max(var(--t-display), 1.6rem), calc((min(100vw - 2 * var(--gutter), var(--max)) - var(--checker-w) - 2rem) / 10), 7.5svh);
      font-size: min(max(var(--t-display), 1.6rem), 10cqi, 7.5svh);
    }

    .hero__checker {
      padding-top: 1.5rem;
    }
  }

  /* ---------- The two spaces ---------- */

  .spaces {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  @media (min-width: 56rem) {
    .spaces {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* 12px around a 20px photo radius makes the card's 32px corner concentric. */
  .space {
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    border-radius: var(--r-xl);
  }

  .space__body {
    display: grid;
    flex: 1;
    align-content: start;
    justify-items: start;
    gap: 0.75rem;
    padding: 1.25rem 0.75rem 0.5rem;
  }

  .space__name {
    margin-top: 0.25rem;
  }

  .space__cap {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent-text);
    font-weight: 600;
  }

  .space__sentence {
    max-width: 34rem;
  }

  /* ---------- Rates ---------- */

  .rates {
    display: grid;
    gap: 2rem clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .rates {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .rates__copy {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 34rem;
  }

  .rates__action {
    margin-top: 0.5rem;
    padding-inline: 0;
  }

  .rates__panel {
    display: grid;
    gap: 0.85rem;
  }

  /* On the White section the white list is set off by a hairline, not a shadow. */
  .rates__list {
    margin: 0;
    border: 1px solid var(--separator);
  }

  .rates__row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    min-height: 64px;
    padding: 1rem 1.25rem;
  }

  .rates__row + .rates__row::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1.25rem;
    right: 0;
    border-top: 1px solid var(--separator);
  }

  .rates__name {
    font-weight: 600;
  }

  /*
    The price is right-aligned on every row, also when a long name pushes it onto its own line. "from" and
    "an hour" never break inside, so with very large text the price wraps between its parts, not mid-phrase.
  */
  .rates__price {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0 0 0 auto;
    color: var(--label-2);
    font-size: var(--t-subhead);
  }

  .rates__from,
  .rates__unit {
    white-space: nowrap;
  }

  /* 200% text on a phone: the price takes its own line under the name, aligned with it, and the note and button use the full width. */
  @media (width < 20rem) {
    .rates__price {
      margin-left: 0;
      justify-content: flex-start;
    }

    .rates__action,
    .rates__note {
      padding-inline: 0;
    }
  }

  /* A fixed-width, left-aligned number cell, so the three prices line up on the dollar sign. */
  .rates__num {
    min-width: 3.4em;
    text-align: left;
    font-variant-numeric: lining-nums tabular-nums;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.875rem);
    line-height: 1;
