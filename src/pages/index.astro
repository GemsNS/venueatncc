---
/**
 * Home, per docs/design/brand.md "Page direction: Home", in this order:
 * the hero on the pines of The Grove with the date checker, the two spaces as real-photo cards, the events,
 * a rates teaser, the arrival band, and the closing band.
 *
 * Each fact has one place on the page (brand.md, "Redundancy rules"): capacities on the space cards,
 * parking and the address in the arrival band, prices in the rates teaser, and how booking works in the
 * closing band. The hero's one primary button is the date checker's Continue to Booking; the header CTA
 * and the closing band carry Check Availability.
 * Photos follow the one photo rule (src/data/photos.ts): real photos for the spaces, and event tiles that
 * are all staged or all text. No image appears twice.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import EventIndex from '../components/EventIndex.astro';
import LocationBand from '../components/LocationBand.astro';
import CtaBand from '../components/CtaBand.astro';
import DateChecker from '../components/booking/DateChecker';
import { site } from '../data/site';
import { EVENTS_STYLED_NOTE, eventsStaged, heroPhoto, photoByName, photosFor, type VenuePhoto } from '../data/photos';
import { bookHref, pricingHref } from '../data/nav';
import { pricing, priceSummary, formatUSD, type DayType } from '../shared/pricing';
import { href } from '../lib/paths';

/*
  The hero: the gazebo under the tall pines of The Grove (grove-pines), a real photo in two crops. Phones get
  the portrait file, so the pines read full height with the copy over their canopy; wider screens get the
  landscape file. Neither crop is the framing of grove-path, whose staged version is the community events tile.
*/
const hero = photoByName('grove-pines') ?? heroPhoto();
const hall = site.spaces.find((s) => s.id === 'indoor');
const grove = site.spaces.find((s) => s.id === 'outdoor');
const hallName = hall?.name ?? 'The Hall';
const groveName = grove?.name ?? 'The Grove';

/*
  The two spaces: the teaser for The Space, which carries the full description. Each card shows its space's
  primary real photo, its capacity (the only capacity on this page), one sentence on what the space is (the
  hero lead already says which is indoors and which is outdoors, and the event tiles below say what each
  hosts), and a link.
*/
interface SpaceCard {
  id: 'hall' | 'grove';
  name: string;
  capacity: number | undefined;
  sentence: string;
  photo: VenuePhoto | undefined;
  href: string;
}
const spaceCards: SpaceCard[] = [
  {
    id: 'hall',
    name: hallName,
    capacity: hall?.capacity,
    sentence: 'Arched windows, a fireplace feature wall, and dark wood-look floors.',
    photo: photosFor('hall')[0],
    href: '/the-space/#hall',
  },
  {
    id: 'grove',
    name: groveName,
    capacity: grove?.capacity,
    sentence: 'A timber gazebo and picnic tables on a paved patio under tall pines.',
    photo: photosFor('grove')[0],
    href: '/the-space/#grove',
  },
];

/*
  Every photo shown elsewhere on this page, so the event tiles never repeat one. LocationBand picks the drive
  at dusk itself, so it is named here.
*/
const pagePhotos = [hero?.name, ...spaceCards.map((c) => c.photo?.name), 'approach-dusk'].filter((n): n is string => Boolean(n));

/* Rates teaser: the lowest hourly rate for each space, straight from the rate card. */
const spaceNames = { indoor: hallName, outdoor: groveName, both: `${hallName} and ${groveName}` } as const;
const rates = (['indoor', 'outdoor', 'both'] as const).map((id) => {
  const [day, rate] = (Object.entries(pricing.hourly[id]) as [DayType, number][]).reduce((low, cur) => (cur[1] < low[1] ? cur : low));
  return { id, name: spaceNames[id], rate, days: pricing.dayTypes[day].label };
});
const rateDays = [...new Set(rates.map((r) => r.days))];
const { lowestPackage } = priceSummary();
const ratesLead = lowestPackage
  ? `Hourly rates by day and space, and packages from ${formatUSD(lowestPackage)}.`
  : 'Hourly rates by day and space.';
const ratesNote = rateDays.length === 1 ? `Starting rates apply ${rateDays[0]}.` : 'Rates vary by day.';

const title = 'Event venue in Suffolk, VA | The Venue at NCC';
const description = `An event venue among the pines in Suffolk, Virginia: ${hallName} for up to ${hall?.capacity} guests, ${groveName} for up to ${grove?.capacity}, and on-site parking. Check your date online.`;
---
<BaseLayout title={title} description={description} og="home" venueDetails>
  <section class="hero" aria-labelledby="hero-title">
    {
      hero && (
        <div class="hero__media">
          <Photo photo={hero} ratio="fill" tall rounded={false} priority sizes="100vw" />
        </div>
      )
    }
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__h1">
        <span class="hero__kicker">Event venue in Suffolk, Virginia<span class="visually-hidden">:</span></span>
        <span class="hero__title t-display">Celebrate among the pines.</span>
      </h1>
      <p class="hero__lead">
        <span class="hero__clause">Host your event indoors in {hallName}</span>
        <span class="hero__clause">or outdoors in {groveName}.</span>
      </p>
    </div>
    <div class="hero__checker">
      <DateChecker client:load bookHref={href(bookHref)} />
    </div>
  </section>

  <section class="section" aria-labelledby="spaces-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="spaces-heading">Two spaces, one address</h2>
      </div>
      <div class="spaces">
        {
          spaceCards.map((card) => {
            return (
              <article class="space card" aria-labelledby={`space-${card.id}`}>
                {card.photo && (
                  <Photo photo={card.photo} caption={false} sizes="(min-width: 75rem) 570px, (min-width: 56rem) 46vw, 92vw" />
                )}
                <div class="space__body">
                  <h3 id={`space-${card.id}`} class="space__name t-title-1">
                    {card.name}
                  </h3>
                  {card.capacity && (
                    <p class="space__cap">
                      <Icon name="users" />
                      Up to {card.capacity} guests
                    </p>
                  )}
                  <p class="space__sentence secondary">{card.sentence}</p>
                  <a class="link-more" href={href(card.href)}>
                    Explore {card.name} <Icon name="chevron-right" />
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section section--grouped" aria-labelledby="events-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="events-heading">Events we host</h2>
        {eventsStaged && <p class="t-lead">{EVENTS_STYLED_NOTE}</p>}
      </div>
      <EventIndex layout="shelf" avoid={pagePhotos} />
    </div>
  </section>

  <section class="section" aria-labelledby="rates-heading">
    <div class="container rates">
      <div class="rates__copy">
        <h2 id="rates-heading">Clear rates, published up front</h2>
        <p class="t-lead">{ratesLead}</p>
      </div>
      <div class="rates__panel">
        <dl class="list-group rates__list">
          {
            rates.map((r) => (
              <div class="rates__row">
                <dt class="rates__name">{r.name}</dt>
                <dd class="rates__price">
                  <span class="rates__from">from</span>
                  <span class="rates__num num">{formatUSD(r.rate)}</span>
                  <span class="rates__unit">an hour</span>
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="rates__note">{ratesNote}</p>
        <div class="btn-row rates__action">
          <a class="btn btn--tinted" href={href(pricingHref)}>
            <Icon name="tag" />
            See Pricing
          </a>
        </div>
      </div>
    </div>
  </section>

  <LocationBand />

  <CtaBand />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */

  /*
    One grid for the hero, and a photo that is never cropped into its subject: every frame holds the whole
    gazebo, and the copy never covers it.
      Phones (below 46.5rem): the portrait file, full bleed at its own 7:10, so the pines read full height.
        The copy sits over their canopy; the date checker follows the photo.
      Tablets (46.5 to 70rem): the landscape file at its own 3:2 (wider on short screens), the copy over the
        trunks above the gazebo, the checker after the photo.
      Wide screens (from 70rem): the photo fills the first screen. The title runs across the top, the gazebo
        stands below it, and the checker floats at the bottom right on glass, beside the gazebo.
    In the landscape file the gazebo, from its roof to the bottom of the band, stands 31% of the frame's width
    tall at any frame height (the file always spans the full width). So a frame with copy over it is never
    shorter than 32vw plus the copy's height (14 to 15rem, which grows with the text): the copy clears the roof.
    Where the copy would reach the gazebo (larger text, narrow or short screens), it moves to a Navy panel
    under the photo. The DateChecker island renders once (its ids are fixed), so CSS alone moves it.

    Rows: the photo spans the copy row and the rest of its height, so the scrim can follow the copy's own
    height at every text size; then a row for the panel and one for the checker.
  */
  .hero {
    --checker-w: 23.75rem;
    /*
      The vertical crop. A frame wider than the file shows a band of it; the band sits low, so the gazebo keeps
      its roof and floor and the room above it goes to the copy. The file is never cropped at the sides.
    */
    --photo-pos: 50% 85%;
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [content-start] minmax(0, var(--max))
      [content-end] minmax(var(--gutter), 1fr)
      [full-end];
    grid-template-rows: [photo-start copy-start] auto [copy-end] 1fr [photo-end] auto auto;
    background: var(--bg-grouped);
  }

  /*
    Tablets: the landscape file's own 3:2, shorter on short screens so the checker's card shows under it, but
    never shorter than the copy and the gazebo need (above), nor wider than 2.4:1. The width is set, so the
    max-height shortens the frame instead of narrowing it through the ratio.
  */
  .hero__media {
    grid-column: full;
    grid-row: photo;
    align-self: start;
    position: relative;
    overflow: hidden;
    width: 100%;
    aspect-ratio: 3 / 2;
    max-height: max(calc(100svh - var(--nav-h) - 5rem), calc(32vw + 15rem), calc(100vw / 2.4));
  }

  .hero__media :global(.photo) {
    position: absolute;
    inset: 0;
  }

  /*
    Legibility scrim in Navy (--navy-rgb): as tall as the copy, dark enough under the lead for 4.5:1 over the
    bright sky between the trunks, then a short fade that ends above the gazebo's roof. The only gradients on
    the site are scrims like this one.
  */
  .hero__scrim {
    grid-column: full;
    grid-row: copy;
    /* Positioned like the photo, so it paints above it. */
    position: relative;
    background: linear-gradient(to bottom, rgb(var(--navy-rgb) / 0.8), rgb(var(--navy-rgb) / 0.62));
  }

  .hero__scrim::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 4.5rem;
    background: linear-gradient(
      to bottom,
      rgb(var(--navy-rgb) / 0.62) 0%,
      rgb(var(--navy-rgb) / 0.36) 32%,
      rgb(var(--navy-rgb) / 0.12) 66%,
      rgb(var(--navy-rgb) / 0) 100%
    );
  }

  .hero__copy {
    grid-column: content;
    grid-row: copy;
    z-index: 1;
    display: grid;
    gap: 1rem;
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.75rem) 0.75rem;
    color: var(--on-navy);
  }

  .hero__h1 {
    display: grid;
    gap: 0.75rem;
    color: var(--on-navy);
  }

  /* Over the photo the kicker is white; on the Navy panel it takes the Mist accent (7.5:1), below. */
  .hero__kicker {
    font-family: var(--font);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--on-navy);
    text-shadow: 0 1px 2px rgb(var(--navy-rgb) / 0.6);
  }

  /* With very large text the title stays well above the lead's size, not just the vw cap. */
  .hero__title {
    font-size: max(var(--t-display), 1.7rem);
    color: var(--on-navy);
    text-wrap: balance;
    text-shadow: 0 1px 24px rgb(var(--navy-rgb) / 0.45);
  }

  .hero__lead {
    max-width: 40rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.5;
    color: var(--on-navy);
    text-shadow: 0 1px 3px rgb(var(--navy-rgb) / 0.6);
  }

  /* When the sentence needs two lines, it breaks between its clauses; a clause still wraps within itself when it must. */
  .hero__clause {
    display: inline-block;
  }

  .hero :global(:focus-visible) {
    outline-color: var(--on-navy);
  }

  .hero__checker :global(:focus-visible) {
    outline-color: var(--focus-ring);
  }

  /* Below the wide layout the checker follows the photo, as a plain card on the grouped background. */
  .hero__checker {
    grid-column: content;
    grid-row: 3;
    padding-block: 1.5rem 2.5rem;
  }

  .hero__checker :global(.bk-dc) {
    margin-inline: auto;
  }

  /*
    Phones: the portrait file at its own 7:10, whole, from the sky over the pines to the picnic tables, at
    every phone height, so the copy always has the canopy to itself.
  */
  @media (width < 46.5rem) {
    .hero {
      --photo-pos: 50% 70%;
    }

    .hero__media {
      aspect-ratio: 7 / 10;
      max-height: none;
    }

    .hero__copy {
      gap: 0.85rem;
      padding-block: 1.5rem 0.5rem;
    }

    .hero__h1 {
      gap: 0.6rem;
    }
  }

  /*
    Narrow or short screens, and larger text: the copy would reach the gazebo, so it moves to a Navy panel
    that continues from the photo, and the checker follows.
  */
  @media (width < 22rem), (height < 36rem) {
    .hero__media {
      max-height: max(calc(100svh - var(--nav-h) - 5rem), calc(100vw / 2.4));
    }

    .hero__scrim {
      display: none;
    }

    .hero__copy {
      grid-column: full;
      grid-row: 3;
      gap: 1rem;
      padding: 1.75rem var(--gutter) 2rem;
      background: var(--navy);
    }

    .hero__title,
    .hero__kicker,
    .hero__lead {
      text-shadow: none;
    }

    .hero__kicker {
      color: var(--on-navy-accent);
    }

    .hero__lead {
      color: rgb(255 255 255 / 0.92);
    }

    .hero__checker {
      grid-row: 4;
    }
  }

  /*
    On a phone with the copy on the panel, the photo gives up height first, so the title shows sooner. The
    band sits low in the portrait file and stays at most 2.1:1, so it still holds the whole gazebo.
  */
  @media (width < 22rem), (width < 46.5rem) and (height < 36rem) {
    .hero__media {
      max-height: max(calc(100svh - var(--nav-h) - 16rem), calc(100vw / 2.1));
    }
  }

  /*
    Wide screens: the photo fills the first screen under the header, between 3:2 and 2.4:1. On a short
    laptop screen the copy and the gazebo need more height than the screen has (above), so the photo runs on
    below the fold and the checker rises by as much, to stay in the first screen. The title keeps to one line
    beside the checker's column. The checker floats at the bottom right on glass, aligned with the header,
    and on very wide screens moves out just enough to keep clear of the gazebo, which stands at 28 to 59
    percent of the width.
  */
  @media (width >= 70rem) and (height >= 36rem) {
    .hero {
      --screen-h: calc(100svh - var(--nav-h) - 1px);
      /* The copy sits closer to the header on a short screen, so it needs 14rem here. */
      --frame-h: min(calc(100vw / 1.5), max(var(--screen-h), calc(32vw + 14rem), calc(100vw / 2.4)));
    }

    .hero__media {
      aspect-ratio: auto;
      height: var(--frame-h);
      max-height: none;
    }

    .hero__copy {
      container-type: inline-size;
      max-width: min(60rem, calc(100% - var(--checker-w) - 2rem));
      padding-block: clamp(1.75rem, 6svh - 0.5rem, 3.5rem) 1rem;
    }

    .hero__title {
      font-size: min(max(var(--t-display), 1.7rem), 10cqi);
    }

    .hero__checker {
      grid-column: content-start / full-end;
      grid-row: photo;
      align-self: end;
      justify-self: end;
      z-index: 1;
      width: var(--checker-w);
      margin-right: max(var(--gutter), min(calc(50vw - var(--max) / 2), calc(41vw - 26.5rem)));
      padding-block: 2.5rem calc(max(0px, var(--frame-h) - var(--screen-h)) + clamp(2rem, 1rem + 1.5vw, 3rem));
    }

    /*
      The card becomes a glass panel. The glass tokens turn solid under Reduce Transparency, Increase
      Contrast, and where backdrop-filter is not supported (global.css).
    */
    .hero__checker :global(.bk-dc) {
      max-width: none;
      margin-inline: 0;
      background-color: var(--glass-bg-strong);
      -webkit-backdrop-filter: var(--glass-blur);
      backdrop-filter: var(--glass-blur);
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-edge), var(--glass-shadow);
    }
  }

  /* ---------- The two spaces ---------- */

  .spaces {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  @media (min-width: 56rem) {
    .spaces {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* 12px around a 20px photo radius makes the card's 32px corner concentric. */
  .space {
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    border-radius: var(--r-xl);
  }

  .space__body {
    display: grid;
    flex: 1;
    align-content: start;
    justify-items: start;
    gap: 0.75rem;
    padding: 1.25rem 0.75rem 0.5rem;
  }

  .space__name {
    margin-top: 0.25rem;
  }

  .space__cap {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent-text);
    font-weight: 600;
  }

  .space__sentence {
    max-width: 34rem;
  }

  /* ---------- Rates ---------- */

  .rates {
    display: grid;
    gap: 2rem clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .rates {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .rates__copy {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 34rem;
  }

  .rates__action {
    margin-top: 0.5rem;
    padding-inline: 1.25rem;
  }

  .rates__panel {
    display: grid;
    gap: 0.85rem;
  }

  /* On the White section the white list is set off by a hairline, not a shadow. */
  .rates__list {
    margin: 0;
    border: 1px solid var(--separator);
  }

  .rates__row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    min-height: 64px;
    padding: 1rem 1.25rem;
  }

  .rates__row + .rates__row::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1.25rem;
    right: 0;
    border-top: 1px solid var(--separator);
  }

  .rates__name {
    font-weight: 600;
  }

  /*
    The price is right-aligned on every row, also when a long name pushes it onto its own line. "from" and
    "an hour" never break inside, so with very large text the price wraps between its parts, not mid-phrase.
  */
  .rates__price {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0 0 0 auto;
    color: var(--label-2);
    font-size: var(--t-subhead);
  }

  .rates__from,
  .rates__unit {
    white-space: nowrap;
  }

  /* 200% text on a phone: the price takes its own line under the name, aligned with it, and the note and button use the full width. */
  @media (width < 20rem) {
    .rates__price {
      margin-left: 0;
      justify-content: flex-start;
    }

    .rates__action,
    .rates__note {
      padding-inline: 0;
    }
  }

  .rates__num {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.875rem);
    line-height: 1;
    color: var(--label);
  }

  .rates__note {
    padding-inline: 1.25rem;
    color: var(--label-2);
    font-size: var(--t-footnote);
  }
</style>
