---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchFrame from '../components/ArchFrame.astro';
import CtaBand from '../components/CtaBand.astro';
import EventIndex from '../components/EventIndex.astro';
import BookingSteps from '../components/BookingSteps.astro';
import LocationBand from '../components/LocationBand.astro';
import FaqList from '../components/FaqList.astro';
import { site } from '../data/site';
import { photos, hasPhotos, heroPhoto, photosTagged } from '../data/photos';
import { publishedFaqs } from '../data/faq';
import { bookHref } from '../data/nav';

const hero = heroPhoto();
const tagged = photosTagged('space').filter((p) => p !== hero);
// Photos tagged 'space' first, topped up with other photos (never repeating the hero).
const spacePhotos = [...tagged, ...photos.filter((p) => p !== hero && !tagged.includes(p))].slice(0, 3);

const title = 'Event venue in Suffolk, VA | The Venue at NCC';
const description =
  'The Venue at NCC is an event space in Suffolk, VA at New Community Church. Host weddings, showers, birthdays, repasts, and meetings. Call to check your date.';
---
<BaseLayout title={title} description={description} og="home">
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__copy">
        <div class="hero__headline">
          <p class="hero__tagline">{site.tagline}</p>
          <h1>Event venue in Suffolk, Virginia</h1>
        </div>
        <p class="lead">
          The Venue at NCC is an event venue at New Community Church on Godwin Boulevard in Suffolk. Book it for
          weddings, showers, birthdays, repasts, meetings, and community gatherings.
        </p>
        <div class="btn-row">
          <a class="btn btn--primary" href={bookHref}>Check your date</a>
          <a class="btn btn--secondary" href={`tel:${site.contact.phoneE164}`}>Call {site.contact.phone}</a>
        </div>
        <p class="hero__where">
          <span>{site.address.street}, {site.address.city}, {site.address.region} {site.address.postalCode}</span>
          <a href={site.address.directionsUrl} rel="noopener" target="_blank">
            Get directions<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </p>
      </div>
      <div class="hero__arch">
        <ArchFrame photo={hero} priority sizes="(min-width: 960px) 460px, (min-width: 520px) 400px, 80vw" />
      </div>
    </div>
  </section>

  <section class="section home-events" aria-labelledby="events-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="events-heading">What you can host here</h2>
        <p>Each kind of event has its own page with planning ideas and the questions worth asking before you book.</p>
      </div>
      <EventIndex />
    </div>
  </section>

  <section class="section home-space" aria-labelledby="space-heading">
    <div class="container">
      {
        spacePhotos.length > 0 ? (
          <>
            <div class="section-head">
              <h2 id="space-heading">See the space</h2>
              <p>A look inside The Venue at NCC.</p>
            </div>
            <ul class="space-row">
              {spacePhotos.map((p, i) => (
                <li>
                  <ArchFrame photo={p} sizes="(min-width: 1224px) 372px, (min-width: 720px) 30vw, 90vw" variant={i} />
                </li>
              ))}
            </ul>
            <p class="home-space__more">
              <a class="text-link" href="/the-space/">View all photos of the space</a>
            </p>
            {site.amenities.length > 0 && (
              <ul class="amenity-list home-space__amenities">
                {site.amenities.map((a) => <li>{a}</li>)}
              </ul>
            )}
          </>
        ) : (
          <div class="space-intro">
            <div class="space-intro__arch">
              <ArchFrame variant={2} sizes="300px" />
            </div>
            <div class="space-intro__copy">
              <h2 id="space-heading">The space</h2>
              <p class="lead">
                {
                  hasPhotos
                    ? 'See more of the venue on the space page, or call and we will talk through what your event needs.'
                    : 'Photos of the venue are on the way. Until then, call and we will talk through the space and what your event needs.'
                }
              </p>
              {site.amenities.length > 0 && (
                <ul class="amenity-list">
                  {site.amenities.map((a) => <li>{a}</li>)}
                </ul>
              )}
              <div class="btn-row">
                {hasPhotos ? (
                  <a class="btn btn--secondary" href="/the-space/">See the space</a>
                ) : (
                  <a class="btn btn--secondary" href={`tel:${site.contact.phoneE164}`}>Call {site.contact.phone}</a>
                )}
              </div>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <section class="section section--tight home-steps" aria-labelledby="steps-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="steps-heading">How booking works</h2>
      </div>
      <BookingSteps />
    </div>
  </section>

  <LocationBand />

  <section class="section home-church" aria-labelledby="church-heading">
    <div class="container home-church__grid">
      <h2 id="church-heading">Hosted by New Community Church</h2>
      <div class="home-church__copy">
        <p class="lead">
          The Venue at NCC is the event space of {site.parent.name}, a Suffolk congregation since {site.parent.foundingYear},
          led by its {site.parent.pastorTitle.toLowerCase()}, {site.parent.pastor}.
        </p>
        <p>The church's mission is to know Christ, love people well, and walk in hope together.</p>
        <p class="home-church__links">
          <a class="text-link" href="/about/">About the venue</a>
          <a class="text-link" href={site.parent.url} rel="noopener">Visit wearencc.org</a>
        </p>
      </div>
    </div>
  </section>

  {
    publishedFaqs.length > 0 && (
      <section class="section section--tight home-faq" aria-labelledby="faq-heading">
        <div class="container home-faq__grid">
          <div>
            <h2 id="faq-heading">Common questions</h2>
            <p class="home-faq__more">
              <a class="text-link" href="/faq/">All questions and answers</a>
            </p>
          </div>
          <FaqList items={publishedFaqs.slice(0, 4)} />
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 1.5rem + 5vw, 6rem) clamp(3rem, 2rem + 4vw, 6rem);
    background: linear-gradient(180deg, var(--surface) 0%, var(--paper) 100%);
    border-bottom: 1px solid var(--line);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 2rem + 3vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 960px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    }
  }

  .hero__copy {
    display: grid;
    gap: 1.75rem;
    justify-items: start;
  }

  .hero__headline {
    display: grid;
    gap: 0.75rem;
  }

  .hero__tagline {
    font-family: var(--font-display);
    font-size: var(--step-2);
    line-height: 1.25;
    color: var(--ink-2);
  }

  .hero__copy h1 {
    max-width: 13ch;
  }

  .home-space__amenities {
    margin-top: 1.5rem;
  }

  .hero__where {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
    font-size: 0.975rem;
  }

  .hero__where a {
    font-weight: 600;
    color: var(--ink);
  }

  .hero__arch {
    width: min(100%, 460px);
    justify-self: center;
  }

  @media (max-width: 959.98px) {
    .hero__arch {
      width: min(82%, 400px);
    }
  }

  .home-space {
    background: var(--surface);
    border-block: 1px solid var(--line);
  }

  .space-row {
    display: grid;
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 720px) {
    .space-row {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .home-space__more {
    margin-top: 2.5rem;
  }

  .space-intro {
    display: grid;
    gap: 2.5rem;
    align-items: center;
  }

  @media (min-width: 720px) {
    .space-intro {
      grid-template-columns: minmax(200px, 300px) 1fr;
      gap: clamp(2.5rem, 6vw, 6rem);
    }
  }

  .space-intro__arch {
    width: min(70%, 300px);
    justify-self: center;
  }

  @media (min-width: 720px) {
    .space-intro__arch {
      width: 100%;
    }
  }

  .space-intro__copy {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .amenity-list {
    columns: 2 14rem;
    margin: 0;
    padding-left: 1.1rem;
  }

  .home-church__grid {
    display: grid;
    gap: 1.5rem 4rem;
  }

  @media (min-width: 900px) {
    .home-church__grid {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    }
  }

  .home-church__copy {
    display: grid;
    gap: 1.1rem;
  }

  .home-church__copy p + p {
    margin-top: 0;
  }

  .home-church__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
  }

  .home-faq {
    background: var(--surface);
    border-top: 1px solid var(--line);
  }

  .home-faq__grid {
    display: grid;
    gap: 2rem 4rem;
  }

  @media (min-width: 900px) {
    .home-faq__grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    }
  }

  .home-faq__more {
    margin-top: 1.25rem;
  }
</style>
