---
/**
 * Home (docs/design/redesign-spec.md, "Home"), in this order: the video hero with the welcome (the business
 * name as the first screen's one dominant element, which morphs into the header lockup on scroll), the three
 * spaces as photo cards in a carousel, the date checker beside its copy, the events carousel, the feature
 * strip, the rates band (the approved wording, a Call button, and a link to the inquiry form), the arrival
 * split, and the closing band.
 *
 * Each fact has one place on the page (brand.md, "Redundancy rules"): capacities on the space cards, tables,
 * chairs, and parking in the feature strip, the address in the arrival split, a call to phone for rates in
 * the rates band. Photos follow the one photo rule (src/data/photos.ts): real photos for the spaces and the
 * arrival, staged photos with their badge for the events. No image appears twice.
 *
 * The morph. The welcome shows the lockup's two words ("The Venue", "@ NCC") as the same outlines the
 * header lockup carries, at display size. The script below measures where each word rests and where its
 * twin sits in the header (the paths tagged data-part in Logo.astro), then, on every scroll frame, moves
 * and scales each word toward its twin with a transform alone (no layout work, so no shift and no jank).
 * The morph runs over the hero's height less the bar, the same distance after which the header turns solid
 * (Header.astro), so the name lands in the bar as the bar appears. When the words arrive (progress 1) the
 * header shows its own lockup and the welcome's words hide; the lockup's ring fades in over the last part of
 * the way (--nav-ring). Readers who prefer reduced motion, short screens (where the bar scrolls away), and
 * browsers without scripts get the header lockup at once.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroVideo from '../components/HeroVideo.astro';
import Logo from '../components/Logo.astro';
import Icon from '../components/Icon.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Carousel from '../components/Carousel.astro';
import PhotoCard from '../components/PhotoCard.astro';
import FeatureStrip from '../components/FeatureStrip.astro';
import ImageTextSplit from '../components/ImageTextSplit.astro';
import CtaBand from '../components/CtaBand.astro';
import DateChecker from '../components/booking/DateChecker';
import { site, cityState, fullAddress } from '../data/site';
import { events } from '../data/events';
import { EVENTS_STYLED_NOTE, eventPhoto, eventsStaged, photoByName, photosFor, type VenuePhoto } from '../data/photos';
import { bookHref, pricingHref } from '../data/nav';
import { href } from '../lib/paths';
import type { IconName } from '../shared/icons';

const hall = site.spaces.find((s) => s.id === 'indoor');
const mainHall = site.spaces.find((s) => s.id === 'main');
const grove = site.spaces.find((s) => s.id === 'outdoor');
const hallName = hall?.name ?? 'The Hall';
const mainHallName = mainHall?.name ?? 'The Main Hall';
const groveName = grove?.name ?? 'The Grove';

/* The three spaces: each card shows its space's primary real photo, its capacity (the only capacity on this page). */
interface SpaceCard {
  id: 'hall' | 'main-hall' | 'grove';
  name: string;
  capacity: number | undefined;
  photo: VenuePhoto | undefined;
  href: string;
}
const spaceCards: SpaceCard[] = [
  { id: 'hall', name: hallName, capacity: hall?.capacity, photo: photosFor('hall')[0], href: '/the-space/#hall' },
  { id: 'main-hall', name: mainHallName, capacity: mainHall?.capacity, photo: photosFor('main')[0], href: '/the-space/#main-hall' },
  { id: 'grove', name: groveName, capacity: grove?.capacity, photo: photosFor('grove')[0], href: '/the-space/#grove' },
];

/* The events: every tile is that event's staged photo with its badge, or the list is text (photos.ts). */
const pagePhotos = new Set([...spaceCards.map((c) => c.photo?.name), 'approach-dusk'].filter((n): n is string => Boolean(n)));
const eventCards = events.map((e) => ({ event: e, photo: eventsStaged ? eventPhoto(e.slug) : null }));
const eventsWithPhotos = eventsStaged && eventCards.every((c) => c.photo?.styledOf !== undefined && !pagePhotos.has(c.photo.name));

/* The feature strip: four things true of every booking, each said here and nowhere else on this page. */
const features: { icon: IconName; name: string; text: string }[] = [
  {
    icon: 'building',
    name: 'Indoors and outdoors',
    text: `${hallName}, ${mainHallName}, and ${groveName}, booked on their own or ${hallName} and ${groveName} together.`,
  },
  {
    icon: 'calendar',
    name: 'Full-day access',
    text: 'Book the hours your event needs, from setup to the last farewell, on one property.',
  },
  {
    icon: 'check-circle',
    name: 'Tables and chairs included',
    text: 'They come with the rental, and you may use them if you wish.',
  },
  {
    icon: 'parking',
    name: 'On-site parking',
    text: 'A large paved lot beside the building, included with every booking.',
  },
];

const arrival = photoByName('approach-dusk');

const title = 'Event venue in Suffolk, VA | The Venue @ NCC';
const description = `Welcome to The Venue @ NCC, an event venue in Suffolk, Virginia: ${hallName} and ${mainHallName} for up to ${hall?.capacity} guests each, ${groveName} for up to ${grove?.capacity}. Check your date online.`;
---
<BaseLayout title={title} description={description} og="home" venueDetails morphLogo>
  <HeroVideo labelledby="hero-title" class="welcome">
    <div class="welcome__inner">
      <h1 id="hero-title" class="welcome__h1">
        <span class="welcome__eyebrow" data-welcome-fade>Welcome to</span>
        <span class="welcome__name">
          <span class="visually-hidden">The Venue @ NCC</span>
          <Logo variant="word-the-venue" height="calc(53.07 * var(--u))" decorative class="welcome__word welcome__word--venue" data-part="the-venue" />
          <Logo variant="word-at-ncc" height="calc(38.63 * var(--u))" decorative class="welcome__word welcome__word--ncc" data-part="at-ncc" />
        </span>
      </h1>
      <p class="welcome__line" data-welcome-fade>Event venue in {cityState}</p>
      <div class="welcome__actions" data-welcome-fade>
        <a class="btn btn--filled btn--lg" href={href(bookHref)}>Check Availability</a>
      </div>
    </div>
  </HeroVideo>

  <div class="page">
    <section class="section" aria-labelledby="spaces-heading">
      <div class="container">
        <SectionHeading
          id="spaces-heading"
          eyebrow="The spaces"
          heading="Three spaces, indoors and out"
          lead="Our fully renovated property is available for weddings, receptions, conferences, banquets, memorials, and community gatherings, with elegant backdrops, flexible layouts, and full-day access."
        >
          <Fragment slot="actions">
            <a class="btn btn--filled" href={href('/the-space/')}>Explore The Space</a>
            <a class="link-more" href={href('/events/')}>See All Events <Icon name="chevron-right" /></a>
          </Fragment>
        </SectionHeading>
        <Carousel cols={3} label="The spaces">
          {
            spaceCards.map(
              (card) =>
                card.photo && (
                  <PhotoCard
                    photo={card.photo}
                    label={card.name}
                    meta={card.capacity ? `Up to ${card.capacity} guests` : undefined}
                    href={card.href}
                    sizes="(min-width: 75rem) 410px, (min-width: 46.5rem) 31vw, 82vw"
                  />
                ),
            )
          }
        </Carousel>
      </div>
    </section>

    <section class="section" aria-labelledby="date-heading">
      <div class="container checker">
        <div class="checker__copy">
          <SectionHeading
            id="date-heading"
            eyebrow="Availability"
            heading="Check a date"
            lead="See which spaces are open on your day, then send your request in about two minutes. We confirm every booking personally."
          />
        </div>
        <div class="checker__panel">
          <DateChecker client:load bookHref={href(bookHref)} />
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="events-heading">
      <div class="container">
        <SectionHeading id="events-heading" eyebrow="Occasions" heading="Events we host" lead={eventsWithPhotos ? EVENTS_STYLED_NOTE : undefined}>
          <Fragment slot="actions">
            <a class="btn btn--outline" href={href('/events/')}>See All Events</a>
          </Fragment>
        </SectionHeading>
        {
          eventsWithPhotos ? (
            <Carousel cols={4} label="Events we host">
              {eventCards.map(
                (c) =>
                  c.photo && (
                    <PhotoCard
                      photo={c.photo}
                      label={c.event.name}
                      href={`/events/${c.event.slug}/`}
                      sizes="(min-width: 75rem) 300px, (min-width: 46.5rem) 23vw, 82vw"
                    />
                  ),
              )}
            </Carousel>
          ) : (
            <ul class="event-links">
              {events.map((e) => (
                <li>
                  <a class="link-more" href={href(`/events/${e.slug}/`)}>
                    {e.name} <Icon name="chevron-right" />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </section>

    <section class="section" aria-labelledby="included-heading">
      <div class="container">
        <SectionHeading id="included-heading" eyebrow="Every booking" heading="What every booking includes" />
        <FeatureStrip items={features} />
      </div>
    </section>

    <section class="section band-section rates" aria-labelledby="rates-heading">
      <div class="container">
        <SectionHeading
          id="rates-heading"
          eyebrow="Rates"
          heading="Our special rates"
          lead="Our affordable rates vary with peak season, holidays, and the day of the week. For pricing and special offers, please call us and we will be happy to help you."
        >
          <Fragment slot="actions">
            <a class="btn btn--filled" href={`tel:${site.contact.phoneE164}`}>
              <Icon name="phone" />
              Call {site.contact.phone}
            </a>
            <a class="link-more" href={href(pricingHref)}>Or send an inquiry <Icon name="chevron-right" /></a>
          </Fragment>
        </SectionHeading>
      </div>
    </section>

    {
      arrival && (
        <section class="section" aria-labelledby="location-heading">
          <div class="container">
            <ImageTextSplit
              photo={arrival}
              id="location-heading"
              eyebrow="Getting here"
              heading="Find us in north Suffolk"
              lead={`${fullAddress}.`}
            >
              <Fragment slot="actions">
                <a class="btn btn--outline" href={site.address.directionsUrl} rel="noopener" target="_blank">
                  Get Directions<span class="visually-hidden">, opens in a new tab</span>
                </a>
              </Fragment>
            </ImageTextSplit>
          </div>
        </section>
      )
    }

    <CtaBand />
  </div>
</BaseLayout>

<script>
  /*
    The morph (see the note at the top of this file). Transforms only: each word is translated and scaled
    from where it rests in the welcome to where its twin sits in the header lockup, in step with the scroll.
  */
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const words = [...document.querySelectorAll<SVGSVGElement>('.welcome__word')];
  const fades = [...document.querySelectorAll<HTMLElement>('[data-welcome-fade]')];
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  const short = window.matchMedia('(max-height: 500px)');

  interface Track {
    el: SVGSVGElement;
    rest: { left: number; top: number; width: number };
    to: { left: number; top: number; width: number };
  }

  if (nav && hero && words.length > 0) {
    let tracks: Track[] = [];
    let distance = 1;
    let morphed = false;
    let ticking = false;
    let active = false;
    // Below 46.5rem the welcome stacks its two words (see the styles below).
    const compact = window.matchMedia('(width < 46.5rem)');
    let stacked = compact.matches;

    /** The lockup the header shows at this width. */
    const lockup = () =>
      [...nav.querySelectorAll<SVGSVGElement>('[data-lockup]')].find((el) => el.getBoundingClientRect().width > 0) ?? null;

    function setMorphed(on: boolean) {
      if (on === morphed) return;
      morphed = on;
      nav!.toggleAttribute('data-morphed', on);
      for (const w of words) w.style.visibility = on ? 'hidden' : '';
    }

    function apply() {
      ticking = false;
      const y = window.scrollY;
      const p = Math.min(1, Math.max(0, y / distance));
      // Ease-out: the name leaves quickly and settles gently into the bar.
      const e = 1 - Math.pow(1 - p, 2);
      if (p < 1 || !morphed) {
        for (const t of tracks) {
          const s = 1 + (t.to.width / t.rest.width - 1) * e;
          const dx = (t.to.left - t.rest.left) * e;
          // Where the word would sit on screen with the page's scroll alone, and where it is headed. Once the
          // scroll would carry it above its place in the bar, it holds there and shrinks into place instead.
          const natural = t.rest.top - y;
          const top = Math.max(natural + (t.to.top - natural) * e, t.to.top);
          const dy = top - natural;
          t.el.style.transform = `translate3d(${dx.toFixed(2)}px, ${dy.toFixed(2)}px, 0) scale(${s.toFixed(4)})`;
          // Phones stack the two words, so "@ NCC" would cross "The Venue" on the way: there it fades out as
          // the morph starts, and the lockup's own "@ NCC" fades in with the ring.
          if (stacked && t.el.dataset.part === 'at-ncc') t.el.style.opacity = Math.max(0, 1 - p * 2.5).toFixed(3);
        }
      }
      setMorphed(p >= 1);
      nav!.style.setProperty('--nav-ring', Math.min(1, Math.max(0, (p - 0.6) / 0.4)).toFixed(3));
      const fade = Math.max(0, 1 - p * 2.5).toFixed(3);
      for (const f of fades) f.style.opacity = fade;
    }

    function schedule() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(apply);
    }

    /** Where each word rests (with no transform) and where its twin sits in the header. */
    function measure() {
      const lk = lockup();
      if (!lk) return;
      for (const w of words) {
        w.style.transform = '';
        w.style.opacity = '';
      }
      stacked = compact.matches;
      nav!.toggleAttribute('data-morph-stack', stacked);
      const y = window.scrollY;
      tracks = words.flatMap((el) => {
        const twin = lk.querySelector<SVGGraphicsElement>(`[data-part="${el.dataset.part}"]`);
        if (!twin) return [];
        const r = el.getBoundingClientRect();
        const t = twin.getBoundingClientRect();
        return [{ el, rest: { left: r.left, top: r.top + y, width: r.width }, to: { left: t.left, top: t.top, width: t.width } }];
      });
      if (tracks.length === 0) return;
      // The morph runs over the hero's height less the bar: the same scroll after which the bar turns solid.
      distance = Math.max(1, hero!.offsetHeight - nav!.offsetHeight);
      apply();
    }

    function stop() {
      active = false;
      for (const w of words) {
        w.style.transform = '';
        w.style.visibility = '';
        w.style.opacity = '';
      }
      for (const f of fades) f.style.opacity = '';
      nav!.style.removeProperty('--nav-ring');
      nav!.removeAttribute('data-morph');
      nav!.removeAttribute('data-morphed');
      nav!.removeAttribute('data-morph-stack');
    }

    function start() {
      if (still.matches || short.matches) {
        stop();
        return;
      }
      if (!active) {
        active = true;
        nav!.setAttribute('data-morph', '');
        morphed = false;
      }
      measure();
    }

    let resizeTimer = 0;
    const onResize = () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(start, 80);
    };

    window.addEventListener('scroll', () => active && schedule(), { passive: true });
    window.addEventListener('resize', onResize);
    window.addEventListener('load', onResize);
    still.addEventListener('change', start);
    short.addEventListener('change', start);
    // Larger text or a late font can move the welcome; measure again when it changes size.
    if ('ResizeObserver' in window) new ResizeObserver(onResize).observe(hero);
    start();
  }
</script>

<style>
  /* ---------- Welcome ---------- */

  /*
    The first screen: "Welcome to" and the business name, the largest type on the site, centred over the
    petals. --u is one unit of the lockup's own grid in pixels: the two words keep the lockup's proportions
    (The Venue is 289.49 units wide and 53.07 tall; @ NCC is 143.5 by 38.63 and sits 20.47 units lower on the
    same baseline, 18.69 units to the right), so a scroll later they fit the header exactly. On one line the
    row is 451.68 units wide; phones stack the two words and "The Venue" spans the screen (92vw), which also
    keeps the name whole on a 320px screen.
  */
  .welcome__inner {
    --u: calc(min(92vw, 30rem) / 289.49);
    display: grid;
    justify-items: center;
    gap: clamp(1.25rem, 0.75rem + 1.5vw, 2rem);
    text-align: center;
  }

  .welcome__h1 {
    display: grid;
    justify-items: center;
    gap: clamp(0.5rem, 0.25rem + 1vw, 1.25rem);
    font-weight: 400;
    text-wrap: initial;
  }

  /* A quiet serif line above the name: the reader's eye goes to the name. */
  .welcome__eyebrow {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.375rem, 1.1rem + 1.2vw, 2rem);
    line-height: 1.2;
    color: var(--label-2);
  }

  .welcome__name {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: calc(12 * var(--u));
    width: 100%;
  }

  /* The words rise above the sticky bar (z-index 60) while they travel into it. */
  .welcome__word {
    position: relative;
    z-index: 61;
    transform-origin: 0 0;
    will-change: transform;
    /* Plum and Berry, whatever the appearance: the name stays the darkest thing on the surface. */
    --logo-ink: var(--label);
    --logo-accent: var(--accent-text);
    /* A soft halo in the page color behind the glyphs, so the name reads on the clip's pinkest frame. */
    filter: drop-shadow(0 0 10px var(--bg)) drop-shadow(0 0 2px var(--bg));
  }

  .welcome__eyebrow,
  .welcome__line {
    text-shadow: 0 0 12px var(--bg), 0 0 3px var(--bg);
  }

  .welcome__line {
    font-family: var(--font-serif);
    font-size: var(--t-subhead);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  /*
    Phones and portrait tablets: over the pinkest video frames, and the Rose tint the portrait crop adds
    (HeroVideo), the Berry line can dip below 4.5:1, so it is set in the text color there.
  */
  @media (width < 46.5rem), (orientation: portrait) {
    .welcome__line {
      color: var(--label);
    }
  }

  .welcome__actions {
    display: flex;
    justify-content: center;
  }

  /* From 46.5rem the two words share one line, as they do in the lockup. */
  @media (min-width: 46.5rem) {
    .welcome__inner {
      --u: calc(min(74vw, 68rem) / 451.68);
    }

    .welcome__name {
      flex-direction: row;
      align-items: flex-start;
      justify-content: center;
      gap: calc(18.69 * var(--u));
    }

    .welcome__word--ncc {
      margin-top: calc(20.47 * var(--u));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .welcome__word {
      will-change: auto;
    }
  }

  /* ---------- The page over the fixed video ---------- */

  .page {
    position: relative;
    z-index: 1;
    background: var(--bg);
  }

  /* ---------- Check a date ---------- */

  .checker {
    display: grid;
    gap: 2rem 4rem;
    align-items: center;
  }

  @media (min-width: 60rem) {
    .checker {
      grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
      justify-content: space-between;
    }
  }

  .checker__copy :global(.section-head) {
    margin-bottom: 0;
  }

  .checker__panel :global(.bk-dc) {
    max-width: none;
    margin-inline: 0;
  }

  .checker__panel :global(:focus-visible) {
    outline-color: var(--focus-ring);
  }

  /* ---------- Events as text (while the staged set is incomplete) ---------- */

  .event-links {
    display: grid;
    gap: 0.25rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 36rem) {
    .event-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- Rates ---------- */

  .rates {
    background: var(--band);
  }

  .rates :global(.section-head) {
    margin-bottom: 0;
  }
</style>
