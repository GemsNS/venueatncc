---
/**
 * Home, per docs/design/brand.md "Page direction: Home":
 * full-bleed hero on the building at dusk with the date checker, a short statement with three facts,
 * The Hall and The Grove as photo cards, events as photo tiles, a rates teaser, the booking steps,
 * the arrival band, four questions, and the closing call to action.
 * No image appears twice in the default view: the Hall card uses hall-fireplace, because the showers
 * tile shows hall-windows.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import EventIndex from '../components/EventIndex.astro';
import LocationBand from '../components/LocationBand.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import DateChecker from '../components/booking/DateChecker';
import { site } from '../data/site';
import { heroPhoto, photoByName, photosFor, type VenuePhoto } from '../data/photos';
import { publishedFaqs } from '../data/faq';
import { bookHref, pricingHref } from '../data/nav';
import { pricing, priceSummary, formatUSD, type DayType } from '../shared/pricing';
import { href } from '../lib/paths';

const hero = photoByName('exterior-dusk') ?? heroPhoto();
const hall = site.spaces.find((s) => s.id === 'indoor');
const grove = site.spaces.find((s) => s.id === 'outdoor');
const hallName = hall?.name ?? 'The Hall';
const groveName = grove?.name ?? 'The Grove';

/* The two spaces. Features are only what the photos show (brand.md, Photography). */
interface SpaceCard {
  id: 'hall' | 'grove';
  name: string;
  capacity: number | undefined;
  sentence: string;
  features: string[];
  photo: VenuePhoto | undefined;
  href: string;
}
const spaceCards: SpaceCard[] = [
  {
    id: 'hall',
    name: hallName,
    capacity: hall?.capacity,
    sentence: 'Our indoor space: an open room for receptions, banquets, showers, and meetings.',
    features: ['Arched windows', 'Fireplace feature wall', 'Dark wood-look floors'],
    // hall-windows leads the showers tile below, so the card shows the fireplace view.
    photo: photoByName('hall-fireplace') ?? photosFor('hall')[0],
    href: '/the-space/#hall',
  },
  {
    id: 'grove',
    name: groveName,
    capacity: grove?.capacity,
    sentence: 'Our outdoor space among tall pines, for ceremonies, reunions, and community gatherings.',
    features: ['Timber gazebo', 'Picnic tables on a paved patio', 'Open lawn under tall pines'],
    photo: photosFor('grove')[0],
    href: '/the-space/#grove',
  },
];

/* Rates teaser: the lowest hourly rate for each space, straight from the rate card. */
const spaceNames = { indoor: hallName, outdoor: groveName, both: `${hallName} and ${groveName}` } as const;
const rates = (['indoor', 'outdoor', 'both'] as const).map((id) => {
  const [day, rate] = (Object.entries(pricing.hourly[id]) as [DayType, number][]).reduce((low, cur) => (cur[1] < low[1] ? cur : low));
  return { id, name: spaceNames[id], rate, days: pricing.dayTypes[day].label };
});
const rateDays = [...new Set(rates.map((r) => r.days))];
const { lowestPackage } = priceSummary();
const ratesLead = `Hourly rates by day and space,${lowestPackage ? ` packages from ${formatUSD(lowestPackage)},` : ''} and an instant estimate for any date.`;
const ratesNote =
  rateDays.length === 1
    ? `Starting rates apply ${rateDays[0]}. Every rate, package, and fee is on the pricing page.`
    : 'Rates vary by day. Every rate, package, and fee is on the pricing page.';

/* Four questions, chosen by their exact text. A question missing from src/data/faq.ts is skipped. */
const HOME_QUESTIONS = [
  'How many guests can the venue hold?',
  'Who can book the venue?',
  'How do deposits and payments work?',
  'How do I check if my date is available?',
];
const homeFaqs = HOME_QUESTIONS.map((q) => publishedFaqs.find((f) => f.q === q)).filter((f) => f !== undefined);

const title = 'Event venue in Suffolk, VA | The Venue at NCC';
const description = `An event venue among the pines in Suffolk, Virginia: ${hallName} for up to ${hall?.capacity} guests, ${groveName} for up to ${grove?.capacity}, and on-site parking. Check your date online.`;
---
<BaseLayout title={title} description={description} og="home" venueDetails>
  <section class="hero" aria-labelledby="hero-title">
    {
      hero && (
        <div class="hero__media">
          <Photo photo={hero} ratio="fill" rounded={false} priority sizes="(max-width: 46.49rem) 150vw, 100vw" />
        </div>
      )
    }
    <div class="hero__scrim" aria-hidden="true"></div>
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__h1">
        <span class="hero__kicker">Event venue in Suffolk, Virginia<span class="visually-hidden">:</span></span>
        <span class="hero__title t-display">Celebrate among the pines.</span>
      </h1>
      <p class="hero__lead">
        Gather up to {hall?.capacity} guests in {hallName} or {grove?.capacity} in {groveName}, with on-site parking included.
      </p>
      <div class="btn-row btn-row--stack hero__actions">
        <a class="btn btn--filled btn--lg" href={href(bookHref)}>Check Availability</a>
        <a class="btn btn--outline-light btn--lg" href={href('/the-space/')}>Tour the Space</a>
      </div>
    </div>
    <div class="hero__checker">
      <DateChecker client:load bookHref={href(bookHref)} />
    </div>
  </section>

  <section class="section intro" aria-labelledby="intro-heading">
    <div class="container">
      <h2 id="intro-heading" class="visually-hidden">About the venue</h2>
      <p class="intro__statement">
        {site.name} is an event venue among the pines in north Suffolk. We host weddings,
        banquets, showers, reunions, and meetings in two distinct spaces, and we confirm every booking personally.
      </p>
      <dl class="intro__facts">
        <div class="intro__fact">
          <dt>Two distinct spaces</dt>
          <dd>{hallName} indoors and {groveName} outdoors, on one campus.</dd>
        </div>
        <div class="intro__fact">
          <dt>On-site parking</dt>
          <dd>A large paved lot, included with every booking.</dd>
        </div>
        <div class="intro__fact">
          <dt>On Godwin Boulevard</dt>
          <dd>Minutes from downtown Suffolk.</dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="section section--grouped" aria-labelledby="spaces-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="spaces-heading">Two spaces, one address</h2>
        <p class="t-lead">Choose {hallName}, {groveName}, or request both for the same event.</p>
      </div>
      <div class="spaces">
        {
          spaceCards.map((card) => {
            return (
              <article class="space card" aria-labelledby={`space-${card.id}`}>
                {card.photo && (
                  <Photo photo={card.photo} caption={false} sizes="(min-width: 75rem) 570px, (min-width: 56rem) 46vw, 92vw" />
                )}
                <div class="space__body">
                  <h3 id={`space-${card.id}`} class="space__name t-title-1">
                    {card.name}
                  </h3>
                  {card.capacity && (
                    <p class="space__cap">
                      <Icon name="users" />
                      Up to {card.capacity} guests
                    </p>
                  )}
                  <p class="space__sentence secondary">{card.sentence}</p>
                  <ul class="space__features">
                    {card.features.map((f) => (
                      <li>
                        <Icon name="check" />
                        {f}
                      </li>
                    ))}
                  </ul>
                  <a class="link-more space__link" href={href(card.href)}>
                    Explore {card.name} <Icon name="chevron-right" />
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="events-heading">
    <div class="container">
      <div class="section-head section-head--split">
        <div class="section-head__text">
          <h2 id="events-heading">Events we host</h2>
          <p class="t-lead">Weddings, banquets, showers, birthdays, repasts, meetings, reunions, and community gatherings.</p>
        </div>
        <a class="link-more" href={href('/events/')}>See All Events <Icon name="chevron-right" /></a>
      </div>
      <EventIndex layout="shelf" />
    </div>
  </section>

  <section class="section section--grouped" aria-labelledby="rates-heading">
    <div class="container rates">
      <div class="rates__copy">
        <h2 id="rates-heading">Clear rates, published up front</h2>
        <p class="t-lead">{ratesLead}</p>
      </div>
      <div class="rates__panel">
        <dl class="list-group rates__list">
          {
            rates.map((r) => (
              <div class="rates__row">
                <dt class="rates__name">{r.name}</dt>
                <dd class="rates__price">
                  <span class="rates__from">from</span>
                  <span class="rates__num num">{formatUSD(r.rate)}</span>
                  <span class="rates__unit">an hour</span>
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="rates__note">{ratesNote}</p>
        <div class="btn-row rates__action">
          <a class="btn btn--tinted" href={href(pricingHref)}>
            <Icon name="tag" />
            See Pricing
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="steps-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="steps-heading">How booking works</h2>
        <p class="t-lead">Three steps from choosing a date to a confirmed booking.</p>
      </div>
      <ol class="steps">
        {
          site.bookingSteps.map((step, i) => (
            <li class="steps__item">
              <span class="steps__num num" aria-hidden="true">
                {i + 1}
              </span>
              <h3>{step.title}</h3>
              <p class="secondary">{step.body}</p>
            </li>
          ))
        }
      </ol>
      <div class="btn-row steps__cta">
        <a class="btn btn--filled btn--lg" href={href(bookHref)}>Check Availability</a>
      </div>
    </div>
  </section>

  <LocationBand />

  {
    homeFaqs.length > 0 && (
      <section class="section" aria-labelledby="faq-heading">
        <div class="container faq-grid">
          <div class="section-head faq-grid__head">
            <h2 id="faq-heading">Before you book</h2>
            <p class="t-lead">Answers to the questions we hear most.</p>
            <a class="link-more" href={href('/faq/')}>
              See All Questions <Icon name="chevron-right" />
            </a>
          </div>
          <FaqList items={homeFaqs} />
        </div>
      </section>
    )
  }

  <CtaBand />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */

  /*
    One grid for the hero. Row 1 is the photo, full bleed, with the copy at the bottom left.
    Row 2 holds the date checker below 64rem; from 64rem it floats in row 1 at the bottom right.
    The DateChecker island renders once (its ids are fixed), so CSS alone moves it.
  */
  .hero {
    --hero-h: min(88svh, 56rem);
    --checker-w: 23.75rem;
    /* Where the photo is cropped: the lit entry and the cross sit right of center. */
    --photo-pos: 50% 62%;
    display: grid;
    grid-template-columns:
      [full-start] minmax(var(--gutter), 1fr)
      [content-start] minmax(0, var(--max))
      [content-end] minmax(var(--gutter), 1fr)
      [full-end];
    grid-template-rows: [photo-start] minmax(var(--hero-h), auto) [photo-end] auto;
    background: var(--bg-grouped);
  }

  .hero__media,
  .hero__scrim {
    grid-column: full;
    grid-row: photo;
  }

  .hero__media {
    position: relative;
    overflow: hidden;
  }

  .hero__media :global(.photo) {
    position: absolute;
    inset: 0;
  }

  /*
    Legibility scrim in Deep Olive (its deeper dark-mode value, 30 34 20), strongest at the bottom left where the copy sits
    over the pale paving. The only gradients on the site are scrims like this one.
  */
  .hero__scrim {
    /* Positioned like the photo, so it paints above it. */
    position: relative;
    background:
      linear-gradient(
        to top,
        rgb(30 34 20 / 0.86) 0%,
        rgb(30 34 20 / 0.62) 30%,
        rgb(30 34 20 / 0.22) 55%,
        rgb(30 34 20 / 0) 72%
      ),
      linear-gradient(to right, rgb(30 34 20 / 0.62) 0%, rgb(30 34 20 / 0.32) 40%, rgb(30 34 20 / 0) 66%);
  }

  .hero__copy {
    grid-column: content;
    grid-row: photo;
    align-self: end;
    z-index: 1;
    display: grid;
    gap: 1.25rem;
    max-width: 42rem;
    padding-block: clamp(6rem, 20svh, 12rem) clamp(2rem, 1.5rem + 2vw, 3.5rem);
    color: var(--on-deep);
  }

  .hero__h1 {
    display: grid;
    gap: 0.9rem;
    color: var(--on-deep);
  }

  .hero__kicker {
    font-family: var(--font);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--on-deep-accent);
    text-shadow: 0 1px 2px rgb(30 34 20 / 0.6);
  }

  /* With very large text the title stays well above the lead's size, not just the vw cap. */
  .hero__title {
    font-size: max(var(--t-display), 1.7rem);
    color: var(--on-deep);
    text-shadow: 0 1px 24px rgb(30 34 20 / 0.35);
  }

  .hero__lead {
    max-width: 34rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.5;
    color: rgb(254 250 224 / 0.92);
  }

  .hero__actions {
    margin-top: 0.5rem;
  }

  .hero :global(:focus-visible) {
    outline-color: var(--on-deep);
  }

  .hero__checker :global(:focus-visible) {
    outline-color: var(--accent-text);
  }

  /* Below 64rem the checker sits under the photo, as a plain card on the grouped background. */
  .hero__checker {
    grid-column: content;
    grid-row: 2;
    padding-block: 1.5rem 2.5rem;
  }

  .hero__checker :global(.bk-dc) {
    margin-inline: auto;
  }

  /* The copy spans the width here, so the scrim rises from the bottom only. */
  @media (width < 64rem) {
    .hero {
      --photo-pos: 72% 50%;
    }

    .hero__scrim {
      background: linear-gradient(
        to top,
        rgb(30 34 20 / 0.9) 0%,
        rgb(30 34 20 / 0.76) 30%,
        rgb(30 34 20 / 0.52) 55%,
        rgb(30 34 20 / 0.18) 75%,
        rgb(30 34 20 / 0) 90%
      );
    }
  }

  /*
    Phones: no text over the building. The photo is a square block cropped to the lit entry, and the
    copy follows on a Deep Olive panel that continues from it, then the date checker.
  */
  @media (width < 46.5rem) {
    .hero {
      --photo-pos: 100% 50%;
      grid-template-rows: [photo-start] auto [photo-end] auto auto;
    }

    .hero__media {
      aspect-ratio: 1 / 1;
    }

    .hero__scrim {
      display: none;
    }

    .hero__copy {
      grid-column: full;
      grid-row: 2;
      max-width: none;
      gap: 1rem;
      padding: 1.75rem var(--gutter) 2rem;
      background: var(--olive-deep);
    }

    .hero__title,
    .hero__kicker {
      text-shadow: none;
    }

    .hero__actions {
      margin-top: 0.25rem;
    }

    .hero__checker {
      grid-row: 3;
    }
  }

  /* From 64rem the checker floats over the photo at the bottom right, on glass. */
  @media (min-width: 64rem) {
    .hero__copy {
      max-width: min(42rem, calc(100% - var(--checker-w) - 3rem));
    }

    .hero__checker {
      grid-row: photo;
      align-self: end;
      justify-self: end;
      z-index: 1;
      width: var(--checker-w);
      padding-block: 2.5rem clamp(2rem, 1.5rem + 2vw, 3.5rem);
    }

    /*
      The card becomes a glass panel. The glass tokens turn solid under Reduce Transparency, Increase
      Contrast, and where backdrop-filter is not supported (global.css).
    */
    .hero__checker :global(.bk-dc) {
      max-width: none;
      margin-inline: 0;
      background-color: var(--glass-bg-strong);
      -webkit-backdrop-filter: var(--glass-blur);
      backdrop-filter: var(--glass-blur);
      border: 1px solid var(--glass-border);
      box-shadow: var(--glass-edge), var(--glass-shadow);
    }
  }

  /* ---------- Statement ---------- */

  .intro__statement {
    max-width: 52rem;
    font-family: var(--font-serif);
    font-size: clamp(1.375rem, 1.1rem + 1.1vw, 2.125rem);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: -0.005em;
    color: var(--label);
  }

  .intro__facts {
    display: grid;
    gap: 1.5rem clamp(1.5rem, 4vw, 3rem);
    margin: clamp(2.5rem, 2rem + 2vw, 4rem) 0 0;
  }

  @media (min-width: 48rem) {
    .intro__facts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .intro__fact {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--separator);
  }

  .intro__fact dt {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--label);
  }

  .intro__fact dd {
    margin: 0;
    color: var(--label-2);
  }

  /* ---------- The two spaces ---------- */

  .spaces {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  @media (min-width: 56rem) {
    .spaces {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* 12px around a 20px photo radius makes the card's 32px corner concentric. */
  .space {
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    border-radius: var(--r-xl);
  }

  .space__body {
    display: grid;
    flex: 1;
    align-content: start;
    justify-items: start;
    gap: 0.75rem;
    padding: 1.25rem 0.75rem 0.5rem;
  }

  .space__name {
    margin-top: 0.25rem;
  }

  .space__cap {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent-text);
    font-weight: 600;
  }

  .space__sentence {
    max-width: 34rem;
  }

  .space__features {
    display: grid;
    gap: 0.5rem;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .space__features li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--t-callout);
  }

  .space__features :global(.icon) {
    width: 1.1em;
    height: 1.1em;
    color: var(--accent-text);
  }

  .space__link {
    margin-top: 0.25rem;
  }

  /* ---------- Section heads with a trailing link ---------- */

  .section-head--split {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    max-width: none;
  }

  .section-head__text {
    display: grid;
    gap: 0.75rem;
    max-width: 44rem;
  }

  /* ---------- Rates ---------- */

  .rates {
    display: grid;
    gap: 2rem clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .rates {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .rates__copy {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 34rem;
  }

  .rates__action {
    margin-top: 0.5rem;
    padding-inline: 1.25rem;
  }

  .rates__panel {
    display: grid;
    gap: 0.85rem;
  }

  .rates__list {
    margin: 0;
  }

  .rates__row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    min-height: 64px;
    padding: 1rem 1.25rem;
  }

  .rates__row + .rates__row::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1.25rem;
    right: 0;
    border-top: 1px solid var(--separator);
  }

  .rates__name {
    font-weight: 600;
  }

  /* The price is right-aligned on every row, also when a long name pushes it onto its own line. */
  .rates__price {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0 0 0 auto;
    color: var(--label-2);
    font-size: var(--t-subhead);
  }

  .rates__num {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.875rem);
    line-height: 1;
    color: var(--label);
  }

  .rates__note {
    padding-inline: 1.25rem;
    color: var(--label-2);
    font-size: var(--t-footnote);
  }

  /* ---------- Steps ---------- */

  .steps {
    display: grid;
    gap: 2rem clamp(1.5rem, 4vw, 3rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .steps__item {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--separator);
  }

  .steps__num {
    font-family: var(--font-serif);
    font-size: 2.5rem;
    line-height: 1;
    color: var(--accent-text);
    margin-bottom: 0.5rem;
  }

  /* One column: the numeral stands beside its step. */
  @media (width < 48rem) {
    .steps__item {
      grid-template-columns: 2.25rem minmax(0, 1fr);
      column-gap: 1rem;
    }

    .steps__num {
      grid-row: span 2;
      margin-bottom: 0;
    }
  }

  .steps__cta {
    margin-top: clamp(2rem, 1.5rem + 2vw, 3rem);
  }

  /* ---------- Questions ---------- */

  .faq-grid {
    display: grid;
    gap: 2rem clamp(2rem, 6vw, 5rem);
  }

  .faq-grid__head {
    justify-items: start;
    margin-bottom: 0;
  }

  /* On the white section the list is set off by a hairline, as on the pricing page, not a faint shadow. */
  .faq-grid :global(.faqs) {
    border: 1px solid var(--separator);
    box-shadow: none;
  }

  @media (min-width: 56rem) {
    .faq-grid {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
      align-items: start;
    }
  }
</style>
