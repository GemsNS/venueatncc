---
/**
 * Home, per docs/design/brand.md "Page direction: Home", in this order:
 * the hero (the title and lead, a pair of real portrait photos of The Hall and The Grove, and the date
 * checker), the two spaces as real-photo cards, the events, a rates teaser, the arrival band, and the
 * closing band.
 *
 * Each fact has one place on the page (brand.md, "Redundancy rules"): capacities on the space cards,
 * parking and the address in the arrival band, prices in the rates teaser, and how booking works in the
 * closing band. The hero's one primary button is the date checker's Continue to Booking; the header CTA
 * and the closing band carry Check Availability.
 * Photos follow the one photo rule (src/data/photos.ts): real photos for the spaces, and event tiles that
 * are all staged or all text. No image appears twice.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import EventIndex from '../components/EventIndex.astro';
import LocationBand from '../components/LocationBand.astro';
import CtaBand from '../components/CtaBand.astro';
import DateChecker from '../components/booking/DateChecker';
import { site } from '../data/site';
import { EVENTS_STYLED_NOTE, eventsStaged, photoByName, photosFor, type VenuePhoto } from '../data/photos';
import { bookHref, pricingHref } from '../data/nav';
import { pricing, priceSummary, formatUSD, type DayType } from '../shared/pricing';
import { href } from '../lib/paths';

/*
  The hero pair: one real portrait of each space, The Hall then The Grove, in the order the lead names them.
  Each is drawn from its own 4:5 portrait file in a 4:5 frame at every width, so the frame never crops the
  photo. Neither is a space card photo, and each is a different framing from the staged tile made from the
  same original (brand.md, "No repeats").
*/
const heroPair = [photoByName('hall-daylight'), photoByName('grove-pines')]
  .filter((p): p is VenuePhoto & { tall: NonNullable<VenuePhoto['tall']> } => p?.tall !== undefined)
  .map((p) => ({ ...p, src: p.tall }));
const hall = site.spaces.find((s) => s.id === 'indoor');
const grove = site.spaces.find((s) => s.id === 'outdoor');
const hallName = hall?.name ?? 'The Hall';
const groveName = grove?.name ?? 'The Grove';

/*
  The two spaces: the teaser for The Space, which carries the full description. Each card shows its space's
  primary real photo, its capacity (the only capacity on this page), one sentence on what the space is (the
  hero lead already says which is indoors and which is outdoors, and the event tiles below say what each
  hosts), and a link.
*/
interface SpaceCard {
  id: 'hall' | 'grove';
  name: string;
  capacity: number | undefined;
  sentence: string;
  photo: VenuePhoto | undefined;
  href: string;
}
const spaceCards: SpaceCard[] = [
  {
    id: 'hall',
    name: hallName,
    capacity: hall?.capacity,
    sentence: 'Arched windows, a fireplace feature wall, and dark wood-look floors.',
    photo: photosFor('hall')[0],
    href: '/the-space/#hall',
  },
  {
    id: 'grove',
    name: groveName,
    capacity: grove?.capacity,
    sentence: 'A timber gazebo and picnic tables on a paved patio under tall pines.',
    photo: photosFor('grove')[0],
    href: '/the-space/#grove',
  },
];

/*
  Every photo shown elsewhere on this page, so the event tiles never repeat one. LocationBand picks the drive
  at dusk itself, so it is named here.
*/
const pagePhotos = [...heroPair.map((p) => p.name), ...spaceCards.map((c) => c.photo?.name), 'approach-dusk'].filter((n): n is string => Boolean(n));

/* Rates teaser: the lowest hourly rate for each space, straight from the rate card. */
const spaceNames = { indoor: hallName, outdoor: groveName, both: `${hallName} and ${groveName}` } as const;
const rates = (['indoor', 'outdoor', 'both'] as const).map((id) => {
  const [day, rate] = (Object.entries(pricing.hourly[id]) as [DayType, number][]).reduce((low, cur) => (cur[1] < low[1] ? cur : low));
  return { id, name: spaceNames[id], rate, days: pricing.dayTypes[day].label };
});
const rateDays = [...new Set(rates.map((r) => r.days))];
const { lowestPackage } = priceSummary();
const ratesLead = lowestPackage
  ? `Hourly rates by day and space, and packages from ${formatUSD(lowestPackage)}.`
  : 'Hourly rates by day and space.';
const ratesNote = rateDays.length === 1 ? `Starting rates apply ${rateDays[0]}.` : 'Rates vary by day.';

const title = 'Event venue in Suffolk, VA | The Venue at NCC';
const description = `An event venue among the pines in Suffolk, Virginia: ${hallName} for up to ${hall?.capacity} guests, ${groveName} for up to ${grove?.capacity}, and on-site parking. Check your date online.`;
---
<BaseLayout title={title} description={description} og="home" venueDetails>
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__inner container">
      <div class="hero__copy">
        <h1 id="hero-title" class="hero__h1">
          <span class="hero__kicker">Event venue in Suffolk, Virginia<span class="visually-hidden">:</span></span>
          <span class="hero__title t-display"><span class="hero__line">Celebrate</span> <span class="hero__line">among the pines.</span></span>
        </h1>
        <p class="hero__lead">
          <span class="hero__clause">Host your event indoors in {hallName}</span>
          <span class="hero__clause">or outdoors in {groveName}.</span>
        </p>
      </div>
      {
        heroPair.length > 0 && (
          <div class="hero__pair">
            {heroPair.map((p) => (
              <Photo photo={p} ratio="4 / 5" priority caption={false} sizes="(min-width: 75rem) 330px, (min-width: 64rem) 27vw, 47vw" />
            ))}
          </div>
        )
      }
      <div class="hero__checker">
        <DateChecker client:load bookHref={href(bookHref)} />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="spaces-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="spaces-heading">Two spaces, one address</h2>
      </div>
      <div class="spaces">
        {
          spaceCards.map((card) => {
            return (
              <article class="space card" aria-labelledby={`space-${card.id}`}>
                {card.photo && (
                  <Photo photo={card.photo} caption={false} sizes="(min-width: 75rem) 570px, (min-width: 56rem) 46vw, 92vw" />
                )}
                <div class="space__body">
                  <h3 id={`space-${card.id}`} class="space__name t-title-1">
                    {card.name}
                  </h3>
                  {card.capacity && (
                    <p class="space__cap">
                      <Icon name="users" />
                      Up to {card.capacity} guests
                    </p>
                  )}
                  <p class="space__sentence secondary">{card.sentence}</p>
                  <a class="link-more" href={href(card.href)}>
                    Explore {card.name} <Icon name="chevron-right" />
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section section--grouped" aria-labelledby="events-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="events-heading">Events we host</h2>
        {eventsStaged && <p class="t-lead">{EVENTS_STYLED_NOTE}</p>}
      </div>
      <EventIndex layout="shelf" avoid={pagePhotos} />
    </div>
  </section>

  <section class="section" aria-labelledby="rates-heading">
    <div class="container rates">
      <div class="rates__copy">
        <h2 id="rates-heading">Clear rates, published up front</h2>
        <p class="t-lead">{ratesLead}</p>
      </div>
      <div class="rates__panel">
        <dl class="list-group rates__list">
          {
            rates.map((r) => (
              <div class="rates__row">
                <dt class="rates__name">{r.name}</dt>
                <dd class="rates__price">
                  <span class="rates__from">from</span>
                  <span class="rates__num num">{formatUSD(r.rate)}</span>
                  <span class="rates__unit">an hour</span>
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="rates__note">{ratesNote}</p>
        <div class="btn-row rates__action">
          <a class="btn btn--tinted" href={href(pricingHref)}>
            <Icon name="tag" />
            See Pricing
          </a>
        </div>
      </div>
    </div>
  </section>

  <LocationBand />

  <CtaBand />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */

  /*
    Text-led, on the calm grouped background: the kicker, the title, and the lead, then a pair of real
    portraits (The Hall, then The Grove) and the date checker. Below 64rem they stack in that order; from
    64rem the copy spans the top and the pair sits beside the checker. Each photo is its own 4:5 portrait
    file in a 4:5 frame, so no screen size crops it. The DateChecker island renders once (its ids are
    fixed), so CSS alone places it.
  */
  .hero {
    --checker-w: 23.75rem;
    padding-block: clamp(1.75rem, 1rem + 3vw, 4rem) clamp(2.5rem, 1.25rem + 3.5vw, 4.5rem);
    background: var(--bg-grouped);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'copy'
      'pair'
      'checker';
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .hero__copy {
    grid-area: copy;
    display: grid;
    gap: clamp(0.875rem, 0.75rem + 0.5vw, 1.25rem);
  }

  .hero__h1 {
    display: grid;
    gap: clamp(0.625rem, 0.5rem + 0.5vw, 1rem);
    color: var(--label);
  }

  .hero__kicker {
    font-family: var(--font);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--accent-text);
  }

  /*
    With very large text the title stays well above the lead's size, not just the vw cap, and "among the
    pines." still fits one line of a phone at 200% text.
  */
  .hero__title {
    font-size: max(var(--t-display), 1.6rem);
    color: var(--label);
  }

  /*
    When the title needs two lines it breaks after "Celebrate", and when the lead needs two it breaks
    between its clauses; each part still wraps within itself when it must.
  */
  .hero__line,
  .hero__clause {
    display: inline-block;
  }

  .hero__lead {
    max-width: 36rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.5;
    color: var(--label-2);
  }

  .hero__pair {
    grid-area: pair;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(0.75rem, 0.5rem + 1vw, 1.5rem);
    align-items: start;
  }

  .hero__checker {
    grid-area: checker;
  }

  .hero__checker :global(.bk-dc) {
    margin-inline: auto;
  }

  /* From tablet widths the title sets on one line, larger, and the checker lines up with the copy's left edge. */
  @media (min-width: 46.5rem) {
    .hero__title {
      font-size: clamp(3rem, 1.2rem + 5.4vw, 6.5rem);
    }

    .hero__checker :global(.bk-dc) {
      margin-inline: 0;
    }
  }

  /*
    From 64rem the pair and the checker share a row under the copy. The pair grows to 42.25rem, where each
    photo comes out as tall as the checker, and the checker takes the rest, so on wide screens the row reads
    as one even band. Where the pair is narrower (below about 74rem) the photos are shorter than the
    checker, so they step: The Hall aligns with the checker's top and The Grove with its bottom.
  */
  @media (min-width: 64rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 42.25rem) minmax(var(--checker-w), 1fr);
      grid-template-areas:
        'copy copy'
        'pair checker';
      column-gap: clamp(2rem, 4vw, 4rem);
      align-items: start;
    }

    .hero__pair {
      align-self: stretch;
    }

    .hero__pair > :global(.photo:last-child) {
      align-self: end;
    }

    .hero__checker :global(.bk-dc) {
      max-width: none;
    }
  }

  /* ---------- The two spaces ---------- */

  .spaces {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  @media (min-width: 56rem) {
    .spaces {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* 12px around a 20px photo radius makes the card's 32px corner concentric. */
  .space {
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    border-radius: var(--r-xl);
  }

  .space__body {
    display: grid;
    flex: 1;
    align-content: start;
    justify-items: start;
    gap: 0.75rem;
    padding: 1.25rem 0.75rem 0.5rem;
  }

  .space__name {
    margin-top: 0.25rem;
  }

  .space__cap {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent-text);
    font-weight: 600;
  }

  .space__sentence {
    max-width: 34rem;
  }

  /* ---------- Rates ---------- */

  .rates {
    display: grid;
    gap: 2rem clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .rates {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .rates__copy {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 34rem;
  }

  .rates__action {
    margin-top: 0.5rem;
    padding-inline: 1.25rem;
  }

  .rates__panel {
    display: grid;
    gap: 0.85rem;
  }

  /* On the White section the white list is set off by a hairline, not a shadow. */
  .rates__list {
    margin: 0;
    border: 1px solid var(--separator);
  }

  .rates__row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    min-height: 64px;
    padding: 1rem 1.25rem;
  }

  .rates__row + .rates__row::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1.25rem;
    right: 0;
    border-top: 1px solid var(--separator);
  }

  .rates__name {
    font-weight: 600;
  }

  /*
    The price is right-aligned on every row, also when a long name pushes it onto its own line. "from" and
    "an hour" never break inside, so with very large text the price wraps between its parts, not mid-phrase.
  */
  .rates__price {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0 0 0 auto;
    color: var(--label-2);
    font-size: var(--t-subhead);
  }

  .rates__from,
  .rates__unit {
    white-space: nowrap;
  }

  /* 200% text on a phone: the price takes its own line under the name, aligned with it, and the note and button use the full width. */
  @media (width < 20rem) {
    .rates__price {
      margin-left: 0;
      justify-content: flex-start;
    }

    .rates__action,
    .rates__note {
      padding-inline: 0;
    }
  }

  .rates__num {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.875rem);
    line-height: 1;
    color: var(--label);
  }

  .rates__note {
    padding-inline: 1.25rem;
    color: var(--label-2);
    font-size: var(--t-footnote);
  }
</style>
