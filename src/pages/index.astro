---
/**
 * Home, per docs/design/brand.md "Page direction: Home", in this order:
 * the hero (the pines and the gazebo in The Grove as a whole portrait photograph, beside the copy and the
 * date checker), the two spaces as real-photo cards, the events, a rates teaser, the arrival band, and the
 * closing band.
 *
 * Each fact has one place on the page (brand.md, "Redundancy rules"): capacities on the space cards,
 * parking and the address in the arrival band, prices in the rates teaser, and how booking works in the
 * closing band. The hero's one primary button is the date checker's Continue to Booking; the header CTA
 * and the closing band carry Check Availability.
 * Photos follow the one photo rule (src/data/photos.ts): real photos for the spaces, and event tiles that
 * are all staged or all text. No image appears twice.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import EventIndex from '../components/EventIndex.astro';
import LocationBand from '../components/LocationBand.astro';
import CtaBand from '../components/CtaBand.astro';
import DateChecker from '../components/booking/DateChecker';
import { site } from '../data/site';
import { EVENTS_STYLED_NOTE, eventsStaged, heroPhoto, photoByName, photosFor, type VenuePhoto } from '../data/photos';
import { bookHref, pricingHref } from '../data/nav';
import { pricing, priceSummary, formatUSD, type DayType } from '../shared/pricing';
import { href } from '../lib/paths';

/*
  The hero photo is shown whole at every size, never cropped to a landscape frame: its 2:3 portrait file
  (grove-pines-tall), passed to Photo as the main source so wide screens get it too (Photo swaps in a tall
  file only on phones). It is a second framing of the photo behind grove-path and its staged
  community-events tile: the full height of the pines and the sky, where those are a landscape band.
*/
const heroSource = photoByName('grove-pines') ?? heroPhoto();
const hero: VenuePhoto | null = heroSource?.tall ? { ...heroSource, src: heroSource.tall, tall: undefined } : heroSource;
const hall = site.spaces.find((s) => s.id === 'indoor');
const grove = site.spaces.find((s) => s.id === 'outdoor');
const hallName = hall?.name ?? 'The Hall';
const groveName = grove?.name ?? 'The Grove';

/*
  The two spaces: the teaser for The Space, which carries the full description. Each card shows its space's
  primary real photo, its capacity (the only capacity on this page), one sentence on what the space is (the
  hero lead already says which is indoors and which is outdoors, and the event tiles below say what each
  hosts), and a link.
*/
interface SpaceCard {
  id: 'hall' | 'grove';
  name: string;
  capacity: number | undefined;
  sentence: string;
  photo: VenuePhoto | undefined;
  href: string;
}
const spaceCards: SpaceCard[] = [
  {
    id: 'hall',
    name: hallName,
    capacity: hall?.capacity,
    sentence: 'Arched windows, a fireplace feature wall, and dark wood-look floors.',
    photo: photosFor('hall')[0],
    href: '/the-space/#hall',
  },
  {
    id: 'grove',
    name: groveName,
    capacity: grove?.capacity,
    sentence: 'A timber gazebo and picnic tables on a paved patio under tall pines.',
    photo: photosFor('grove')[0],
    href: '/the-space/#grove',
  },
];

/*
  Every photo shown elsewhere on this page, so the event tiles never repeat one. LocationBand picks the drive
  at dusk itself, so it is named here.
*/
const pagePhotos = [hero?.name, ...spaceCards.map((c) => c.photo?.name), 'approach-dusk'].filter((n): n is string => Boolean(n));

/* Rates teaser: the lowest hourly rate for each space, straight from the rate card. */
const spaceNames = { indoor: hallName, outdoor: groveName, both: `${hallName} and ${groveName}` } as const;
const rates = (['indoor', 'outdoor', 'both'] as const).map((id) => {
  const [day, rate] = (Object.entries(pricing.hourly[id]) as [DayType, number][]).reduce((low, cur) => (cur[1] < low[1] ? cur : low));
  return { id, name: spaceNames[id], rate, days: pricing.dayTypes[day].label };
});
const rateDays = [...new Set(rates.map((r) => r.days))];
const { lowestPackage } = priceSummary();
const ratesLead = lowestPackage
  ? `Hourly rates by day and space, and packages from ${formatUSD(lowestPackage)}.`
  : 'Hourly rates by day and space.';
const ratesNote = rateDays.length === 1 ? `Starting rates apply ${rateDays[0]}.` : 'Rates vary by day.';

const title = 'Event venue in Suffolk, VA | The Venue at NCC';
const description = `An event venue among the pines in Suffolk, Virginia: ${hallName} for up to ${hall?.capacity} guests, ${groveName} for up to ${grove?.capacity}, and on-site parking. Check your date online.`;
---
<BaseLayout title={title} description={description} og="home" venueDetails>
  <section class="hero" aria-labelledby="hero-title">
    {
      hero && (
        <div class="hero__media">
          <Photo photo={hero} ratio="fill" rounded={false} priority sizes="(min-width: 64rem) 683px, (min-width: 46.5rem) 44vw, 100vw" />
        </div>
      )
    }
    <div class="hero__copy">
      <h1 id="hero-title" class="hero__h1">
        <span class="hero__kicker">Event venue in Suffolk, Virginia<span class="visually-hidden">:</span></span>
        <span class="hero__title t-display">Celebrate among the pines.</span>
      </h1>
      <p class="hero__lead">
        <span class="hero__clause">Host your event indoors in {hallName}</span>
        <span class="hero__clause">or outdoors in {groveName}.</span>
      </p>
    </div>
    <div class="hero__checker">
      <DateChecker client:load bookHref={href(bookHref)} />
    </div>
  </section>

  <section class="section" aria-labelledby="spaces-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="spaces-heading">Two spaces, one address</h2>
      </div>
      <div class="spaces">
        {
          spaceCards.map((card) => {
            return (
              <article class="space card" aria-labelledby={`space-${card.id}`}>
                {card.photo && (
                  <Photo photo={card.photo} caption={false} sizes="(min-width: 75rem) 570px, (min-width: 56rem) 46vw, 92vw" />
                )}
                <div class="space__body">
                  <h3 id={`space-${card.id}`} class="space__name t-title-1">
                    {card.name}
                  </h3>
                  {card.capacity && (
                    <p class="space__cap">
                      <Icon name="users" />
                      Up to {card.capacity} guests
                    </p>
                  )}
                  <p class="space__sentence secondary">{card.sentence}</p>
                  <a class="link-more" href={href(card.href)}>
                    Explore {card.name} <Icon name="chevron-right" />
                  </a>
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section section--grouped" aria-labelledby="events-heading">
    <div class="container">
      <div class="section-head">
        <h2 id="events-heading">Events we host</h2>
        {eventsStaged && <p class="t-lead">{EVENTS_STYLED_NOTE}</p>}
      </div>
      <EventIndex layout="shelf" avoid={pagePhotos} />
    </div>
  </section>

  <section class="section" aria-labelledby="rates-heading">
    <div class="container rates">
      <div class="rates__copy">
        <h2 id="rates-heading">Clear rates, published up front</h2>
        <p class="t-lead">{ratesLead}</p>
      </div>
      <div class="rates__panel">
        <dl class="list-group rates__list">
          {
            rates.map((r) => (
              <div class="rates__row">
                <dt class="rates__name">{r.name}</dt>
                <dd class="rates__price">
                  <span class="rates__from">from</span>
                  <span class="rates__num num">{formatUSD(r.rate)}</span>
                  <span class="rates__unit">an hour</span>
                </dd>
              </div>
            ))
          }
        </dl>
        <p class="rates__note">{ratesNote}</p>
        <div class="btn-row rates__action">
          <a class="btn btn--tinted" href={href(pricingHref)}>
            <Icon name="tag" />
            See Pricing
          </a>
        </div>
      </div>
    </div>
  </section>

  <LocationBand />

  <CtaBand />
</BaseLayout>

<style>
  /* ---------- Hero ---------- */

  /*
    A split hero around one portrait photograph, shown whole. The file is 2:3 and so is its frame at every
    size from 46.5rem, so nothing is cropped away; on phones a 4:5 frame gives way only at the top of the sky.
    One grid, three layouts. The DateChecker island renders once (its ids are fixed), so CSS alone places it.
      Phones (below 46.5rem): the photo, the copy on a Navy panel, then the date checker.
      Tablets (46.5rem to 64rem): the copy on Navy beside the photo, then the date checker.
      Wide (from 64rem): the copy and the date checker on Navy, beside the photo at the hero's full height.
  */
  .hero {
    /*
      Where a frame trims the photo: the phone's 4:5 frame, and a row grown past the photo's own height by
      very large text. Anchored at the bottom, only sky and treetops give way, never the gazebo or the path.
    */
    --photo-pos: 45% 100%;
    display: grid;
    background: var(--bg-grouped);
  }

  /* The Navy panel behind the copy. On wide screens the whole hero is Navy instead. */
  .hero::before {
    content: '';
    background: var(--navy);
  }

  .hero__media {
    position: relative;
    overflow: hidden;
    background: var(--navy);
  }

  .hero__media :global(.photo) {
    position: absolute;
    inset: 0;
  }

  .hero__copy {
    display: grid;
    align-content: center;
    gap: 1.25rem;
    color: var(--on-navy);
  }

  .hero__h1 {
    display: grid;
    gap: 0.9rem;
    color: var(--on-navy);
  }

  /* Mist on Navy, 7.5:1. */
  .hero__kicker {
    font-family: var(--font);
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.1875rem);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: normal;
    color: var(--on-navy-accent);
  }

  /* With very large text the title stays well above the lead's size, not just the vw cap. */
  .hero__title {
    font-size: max(var(--t-display), 1.7rem);
    color: var(--on-navy);
    text-wrap: balance;
  }

  /* Ice on Navy, 9.4:1. */
  .hero__lead {
    max-width: 34rem;
    font-size: clamp(1.0625rem, 1rem + 0.35vw, 1.25rem);
    line-height: 1.5;
    color: var(--on-navy-2);
  }

  /* When the sentence needs two lines, it breaks between its clauses; a clause still wraps within itself when it must. */
  .hero__clause {
    display: inline-block;
  }

  .hero :global(:focus-visible) {
    outline-color: var(--on-navy);
  }

  .hero__checker :global(:focus-visible) {
    outline-color: var(--focus-ring);
  }

  .hero__checker :global(.bk-dc) {
    margin-inline: auto;
  }

  /* Phones: the photo first, whole from the treetops down, then the copy on Navy, then the checker. */
  @media (width < 46.5rem) {
    .hero {
      grid-template-columns: [full-start] var(--gutter) [content-start] minmax(0, 1fr) [content-end] var(--gutter) [full-end];
      grid-template-rows: auto auto auto;
    }

    .hero::before {
      grid-column: full;
      grid-row: 2;
    }

    .hero__media {
      grid-column: full;
      grid-row: 1;
      aspect-ratio: 4 / 5;
    }

    .hero__copy {
      grid-column: content;
      grid-row: 2;
      gap: 1rem;
      padding-block: 1.75rem 2rem;
    }

    .hero__checker {
      grid-column: content;
      grid-row: 3;
      padding-block: 1.5rem 2.5rem;
    }
  }

  /* Tablets: the copy on Navy beside the whole photo, then the checker centered below. */
  @media (46.5rem <= width < 64rem) {
    .hero {
      --media-w: min(44vw, 28rem);
      grid-template-columns:
        [full-start] var(--gutter)
        [copy-start] minmax(0, 1fr)
        [copy-end] clamp(1.5rem, 4vw, 2.5rem)
        [media-start] var(--media-w)
        [media-end full-end];
      grid-template-rows: auto auto;
    }

    .hero::before {
      grid-column: full-start / media-start;
      grid-row: 1;
    }

    /* The row is at least as tall as a 2:3 photo of the column's width, so the photo fills it whole. */
    .hero__media {
      grid-column: media;
      grid-row: 1;
      min-height: calc(var(--media-w) * 3 / 2);
    }

    .hero__copy {
      grid-column: copy;
      grid-row: 1;
      padding-block: 2.5rem;
      container-type: inline-size;
    }

    .hero__title {
      font-size: max(min(var(--t-display), 15cqi), 1.7rem);
    }

    .hero__checker {
      grid-column: full;
      grid-row: 2;
      padding: 1.5rem var(--gutter) 2.5rem;
    }
  }

  /*
    Wide: the hero is one Navy band as tall as the screen allows below the header, within 43rem to 64rem, and
    never so tall that the photo leaves the copy less than about 27rem (a 1024 x 1366 tablet in portrait). The
    photo column is exactly as wide as a 2:3 photo of that height, so the photo fills it whole. The copy and
    the checker start on the header's content edge (the logo) and are centered top to bottom.
  */
  @media (width >= 64rem) {
    .hero {
      --hero-h: min(clamp(43rem, 100svh - var(--nav-h) - 1px, 64rem), (100vw - 32rem) * 1.5);
      --media-w: calc(var(--hero-h) * 2 / 3);
      grid-template-columns:
        [full-start] max(var(--gutter), (100% - var(--max)) / 2)
        [copy-start] minmax(0, 36rem)
        [copy-end] minmax(clamp(2rem, 4vw, 4rem), 1fr)
        [media-start] var(--media-w)
        [media-end full-end];
      grid-template-rows: 1fr auto auto 1fr;
      min-height: var(--hero-h);
      background: var(--navy);
    }

    .hero::before {
      display: none;
    }

    .hero__media {
      grid-column: media;
      grid-row: 1 / -1;
    }

    .hero__copy {
      grid-column: copy;
      grid-row: 2;
      padding-top: 2rem;
      container-type: inline-size;
    }

    .hero__title {
      font-size: max(min(var(--t-display), 13.5cqi), 1.7rem);
    }

    .hero__checker {
      grid-column: copy;
      grid-row: 3;
      padding-block: 1.75rem 2rem;
    }

    /* On Navy the card needs no shadow (a Navy shadow bands on Navy); its hairline edge still shows in dark mode. */
    .hero__checker :global(.bk-dc) {
      margin-inline: 0;
      box-shadow: var(--bk-card-edge);
    }
  }

  /*
    Short wide screens (a 1024 x 768 tablet in landscape, a 1366 x 768 laptop): tighter spacing and a title
    sized to the screen's height keep the copy and the checker within the photo's height, so the whole hero,
    photo included, fits the first screen.
  */
  @media (width >= 64rem) and (height < 53rem) {
    .hero__copy {
      gap: 1rem;
      padding-top: 1rem;
    }

    .hero__h1 {
      gap: 0.6rem;
    }

    .hero__title {
      font-size: max(min(var(--t-display), 13.5cqi, 7svh), 1.7rem);
    }

    .hero__checker {
      padding-block: 1.25rem 1rem;
    }
  }

  /* ---------- The two spaces ---------- */

  .spaces {
    display: grid;
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  @media (min-width: 56rem) {
    .spaces {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* 12px around a 20px photo radius makes the card's 32px corner concentric. */
  .space {
    display: flex;
    flex-direction: column;
    padding: 0.75rem;
    border-radius: var(--r-xl);
  }

  .space__body {
    display: grid;
    flex: 1;
    align-content: start;
    justify-items: start;
    gap: 0.75rem;
    padding: 1.25rem 0.75rem 0.5rem;
  }

  .space__name {
    margin-top: 0.25rem;
  }

  .space__cap {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent-text);
    font-weight: 600;
  }

  .space__sentence {
    max-width: 34rem;
  }

  /* ---------- Rates ---------- */

  .rates {
    display: grid;
    gap: 2rem clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  @media (min-width: 56rem) {
    .rates {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    }
  }

  .rates__copy {
    display: grid;
    gap: 1rem;
    justify-items: start;
    max-width: 34rem;
  }

  .rates__action {
    margin-top: 0.5rem;
    padding-inline: 1.25rem;
  }

  .rates__panel {
    display: grid;
    gap: 0.85rem;
  }

  /* On the White section the white list is set off by a hairline, not a shadow. */
  .rates__list {
    margin: 0;
    border: 1px solid var(--separator);
  }

  .rates__row {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    min-height: 64px;
    padding: 1rem 1.25rem;
  }

  .rates__row + .rates__row::before {
    content: '';
    position: absolute;
    top: 0;
    left: 1.25rem;
    right: 0;
    border-top: 1px solid var(--separator);
  }

  .rates__name {
    font-weight: 600;
  }

  /*
    The price is right-aligned on every row, also when a long name pushes it onto its own line. "from" and
    "an hour" never break inside, so with very large text the price wraps between its parts, not mid-phrase.
  */
  .rates__price {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: baseline;
    gap: 0.4rem;
    margin: 0 0 0 auto;
    color: var(--label-2);
    font-size: var(--t-subhead);
  }

  .rates__from,
  .rates__unit {
    white-space: nowrap;
  }

  /* 200% text on a phone: the price takes its own line under the name, aligned with it, and the note and button use the full width. */
  @media (width < 20rem) {
    .rates__price {
      margin-left: 0;
      justify-content: flex-start;
    }

    .rates__action,
    .rates__note {
      padding-inline: 0;
    }
  }

  .rates__num {
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 1.3rem + 0.6vw, 1.875rem);
    line-height: 1;
    color: var(--label);
  }

  .rates__note {
    padding-inline: 1.25rem;
    color: var(--label-2);
    font-size: var(--t-footnote);
  }
</style>
