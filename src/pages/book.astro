---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import BookingApp from '../components/booking/BookingApp';
import { site } from '../data/site';
import { breadcrumbs } from '../lib/schema';

const title = 'Check availability | Book The Venue @ NCC, Suffolk, VA';
const description =
  'Check open dates at The Venue @ NCC in Suffolk, VA. Choose a date and a space and send your booking request in about two minutes. We confirm availability and send your quote personally.';
const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Check availability', path: '/book/' },
];
---
<BaseLayout title={title} description={description} og="book" pageType="ContactPage" schema={[breadcrumbs(crumbs)]}>
  <section class="book-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <div class="book-hero__copy">
        <h1 class="t-large-title">Check availability</h1>
        <p class="t-lead">Choose a date and a space, and send your request in about two minutes.</p>
      </div>
    </div>
  </section>

  <section class="book-app">
    <div class="container">
      <BookingApp client:load />
      <noscript>
        <div class="card noscript">
          <h2 class="t-title-1">Book by phone or email</h2>
          <p>The booking calendar needs JavaScript. You can still book with us directly:</p>
          <p>
            <a href={`tel:${site.contact.phoneE164}`}>{site.contact.phone}</a> or
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </p>
        </div>
      </noscript>
    </div>
  </section>
</BaseLayout>

<style>
  .book-hero {
    padding-block: clamp(1.5rem, 1rem + 2vw, 2.5rem) clamp(1.75rem, 1.25rem + 2vw, 3rem);
  }

  /* A short Caslon title and one lead, so the calendar stays close to the top of the page. */
  .book-hero__copy {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
    margin-top: clamp(1.25rem, 1rem + 1.5vw, 2.25rem);
  }

  .book-app {
    padding-bottom: clamp(3rem, 2rem + 4vw, 6rem);
  }

  .noscript {
    display: grid;
    gap: 0.75rem;
    padding: 2rem;
  }
</style>
