---
/**
 * Check availability (docs/design/redesign-v7.md, "Version 8"): the title band (global.css), then the
 * booking wizard, which also carries the visit request (?visit=1). The island gets the one real photo of each
 * space (SUBJECT_PHOTO in src/data/photos.ts; the file's own 3:2 shape, so nothing is cropped) for the space
 * rows and the summary card. The combined choice (The Fireside Room and The Pine Garden together) has no
 * photo of its own: the site keeps one real photo per subject (version 9), and showing the two rooms' photos
 * again on that row would repeat them on the page (brand.md, "No repeats"). The summary shows the chosen
 * space's photo only on the steps where the rows are not on screen.
 */
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingApp, { type SpacePhoto, type SpacePhotos } from '../components/booking/BookingApp';
import { site } from '../data/site';
import { spacePhoto, type VenuePhoto } from '../data/photos';

const title = 'Check availability | Book The Venue @ NCC, Suffolk, VA';
const description =
  'Check open dates at The Venue @ NCC in Suffolk, VA. Choose a date and a space and send your booking request in about two minutes. We confirm availability and send your quote personally.';

/**
 * A responsive rendering of one real photo for the island (WebP). 240 and 480 serve the 76px space rows;
 * 960 and 1280 serve the summary card's photo, 360px wide on desktop, so it is never drawn past its file at 2x or 3x
 * (brand.md, "The client's rules of October 1, 2026", rule 3).
 */
async function thumb(photo: VenuePhoto | null): Promise<SpacePhoto | null> {
  if (!photo) return null;
  const widths = [240, 480, 960, 1280];
  const files = await Promise.all(widths.map((width) => getImage({ src: photo.src, width, format: 'webp' })));
  return { src: files[0].src, srcset: files.map((f, i) => `${f.src} ${widths[i]}w`).join(', '), alt: photo.alt };
}

/* The Fireside Room, The Stage Hall, and The Pine Garden each get their one photo; the combined choice shows none. */
const spacePhotos: SpacePhotos = {
  indoor: await thumb(spacePhoto('hall')),
  main: await thumb(spacePhoto('main')),
  outdoor: await thumb(spacePhoto('grove')),
  bothA: null,
  bothB: null,
};
---
<BaseLayout title={title} description={description} og="book" pageType="ContactPage">
  <section class="title-band">
    <div class="container title-band__inner">
      <h1 data-visit-title>Check availability</h1>
      <p class="t-lead" data-visit-lead>Choose a date and a space, and send your request in about two minutes.</p>
    </div>
  </section>
  <script is:inline>
    /*
      Request a Visit links here with ?visit=1, which ticks "I would like to see the space before I book" in
      the wizard. The title says so from the first paint (an inline script, so the words never flash), and a
      reader who asked for a tour knows they are in the right place.
    */
    if (new URLSearchParams(location.search).get('visit') === '1') {
      var set = function (sel, text) {
        var el = document.querySelector(sel);
        if (el) el.textContent = text;
      };
      set('[data-visit-title]', 'Request a visit');
      set('[data-visit-lead]', 'Choose the date and the space you are considering, and we will arrange a time for you to see it before you book. Or call us to set up a tour.');
      document.title = 'Request a visit | The Venue @ NCC, Suffolk, VA';
    }
  </script>

  <section class="section book-app">
    <div class="container">
      <BookingApp client:load spacePhotos={spacePhotos} />
      <noscript>
        <div class="book-noscript">
          <h2 class="t-title-2">Book by phone or email</h2>
          <p class="t-copy">The booking calendar needs JavaScript. You can still book with us directly:</p>
          <p class="t-copy">
            <a href={`tel:${site.contact.phoneE164}`}>{site.contact.phone}</a> or
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </p>
        </div>
      </noscript>
    </div>
  </section>
</BaseLayout>

<style>
  .book-app {
    padding-top: clamp(2.5rem, 1.75rem + 3vw, 4rem);
  }

  .book-noscript {
    display: grid;
    gap: 0.75rem;
    max-width: 36rem;
    padding: clamp(1.25rem, 1rem + 1.5vw, 2rem);
    border-radius: var(--r-lg);
    background: var(--bg-elevated);
    box-shadow: 0 0 0 1px var(--separator);
  }
</style>
