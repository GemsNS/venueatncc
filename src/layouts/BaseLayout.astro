---
import '@fontsource/libre-caslon-display/latin-400.css';
import '@fontsource/libre-caslon-text/latin-400.css';
import '@fontsource/libre-caslon-text/latin-400-italic.css';
import '../styles/global.css';
import interFont from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url';
import caslonDisplayFont from '@fontsource/libre-caslon-display/files/libre-caslon-display-latin-400-normal.woff2?url';
import caslonTextFont from '@fontsource/libre-caslon-text/files/libre-caslon-text-latin-400-normal.woff2?url';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { site } from '../data/site';
import { heroPhoto } from '../data/photos';
import { abs, graph, venue, website, webPage } from '../lib/schema';
import { isDemo } from '../lib/env';
import { href, withoutBase } from '../lib/paths';
import { bookHref } from '../data/nav';
import { shareCardAlt } from '../pages/og/_cards';

interface Props {
  /** Full <title>. Keep under 60 characters. */
  title: string;
  /** Meta description. Aim for 140 to 160 characters. */
  description?: string;
  /** Share image key from /og/<key>.jpg. */
  og?: string;
  /** Share image description. Defaults to the text on the share card. */
  ogAlt?: string;
  noindex?: boolean;
  /** schema.org WebPage subtype, e.g. 'AboutPage', 'FAQPage', 'ContactPage', 'CollectionPage'. */
  pageType?: string;
  /** Extra JSON-LD nodes for this page. */
  schema?: Record<string, unknown>[];
  /** Include room and amenity details in the venue JSON-LD (only where they are visible). */
  venueDetails?: boolean;
  /** Hide the site chrome (used by the admin app). */
  bare?: boolean;
  /** What sits under the transparent header at the top of the page: a light surface (default) or a photo hero. */
  headerOver?: 'light' | 'photo';
  /**
   * Where the header's Check Availability goes, base-relative. An event page passes the booking page
   * with its event chosen, e.g. '/book/?event=weddings'. Defaults to '/book/'.
   */
  bookPath?: string;
  /** Home only: the header lockup waits for the welcome's name to morph into it (Header.astro). */
  morphLogo?: boolean;
}

const path = withoutBase(Astro.url.pathname);

const {
  title,
  description = site.description,
  og = 'home',
  ogAlt = shareCardAlt(og) ?? `${site.name}, an event venue in Suffolk, Virginia`,
  noindex = false,
  pageType,
  schema = [],
  venueDetails = false,
  bare = false,
  headerOver = 'light',
  bookPath = bookHref,
  morphLogo = false,
} = Astro.props;

// Canonical URLs point at the real domain. The demo and noindex pages (404, admin) carry none:
// a canonical beside noindex sends mixed signals, and the 404 page has no real URL of its own.
const canonical = abs(path);
const withCanonical = !isDemo && !noindex;
// Share images must resolve where the page is actually hosted.
const ogImage = new URL(href(`/og/${og}.jpg`), Astro.site).href;

const hero = heroPhoto();
const venueImages: string[] = [];
if (hero) {
  const img = await getImage({ src: hero.src, width: 1200, format: 'jpg' });
  venueImages.push(abs(withoutBase(img.src)));
}

// Noindex pages (404, admin) carry no structured data: the 404 page has no URL of its own for a WebPage
// node, and the admin is not a public page about the venue.
const jsonLd = noindex
  ? null
  : graph(venue(venueImages, { details: venueDetails }), website(), webPage({ path, title, description, type: pageType }), ...schema);
const robots = isDemo ? 'noindex, nofollow' : noindex ? 'noindex, follow' : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{isDemo ? `Demo: ${title}` : title}</title>
    <meta name="description" content={description} />
    {withCanonical && <link rel="canonical" href={canonical} />}
    {robots && <meta name="robots" content={robots} />}

    <link rel="preload" href={interFont} as="font" type="font/woff2" crossorigin />
    {/* The page titles' face. The admin (bare) sets no titles in it. */}
    {!bare && <link rel="preload" href={caslonDisplayFont} as="font" type="font/woff2" crossorigin />}
    {/* The interface serif: nav links and buttons sit above the fold on every page. */}
    {!bare && <link rel="preload" href={caslonTextFont} as="font" type="font/woff2" crossorigin />}

    <meta name="theme-color" content="#FBF1F3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#2A151F" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href={href('/favicon.ico')} sizes="32x32" />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={href('/favicon-32.png')} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={href('/apple-touch-icon.png')} />
    <link rel="manifest" href={href('/site.webmanifest')} />
    {!isDemo && <link rel="sitemap" href={href('/sitemap-index.xml')} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {withCanonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <meta name="geo.region" content="US-VA" />
    <meta name="geo.placename" content={site.address.city} />
    <meta name="geo.position" content={`${site.address.geo.lat};${site.address.geo.lng}`} />
    <meta name="ICBM" content={`${site.address.geo.lat}, ${site.address.geo.lng}`} />

    {jsonLd && <JsonLd data={jsonLd} />}
    <slot name="head" />
  </head>
  <body class:list={{ 'is-bare': bare }}>
    <a class="skip-link" href="#main">Skip to content</a>
    {!bare && <Header ctaHref={bookPath} morph={morphLogo} over={headerOver} />}
    <main id="main" tabindex="-1">
      <slot />
    </main>
    {!bare && <Footer bookHref={bookPath} />}
  </body>
</html>
